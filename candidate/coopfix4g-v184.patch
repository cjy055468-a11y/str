diff --git a/Code/encoding/Structs/OwnedInventory.h b/Code/encoding/Structs/OwnedInventory.h
new file mode 100644
index 00000000..c4e3842d
--- /dev/null
+++ b/Code/encoding/Structs/OwnedInventory.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <Structs/Inventory.h>
+#include <algorithm>
+#include <cstdint>
+
+// A native drop has already happened on its owning client. The server cache
+// can lag changes to charge, tempering and equipment; it is not an inventory
+// transaction authority. Keep this reconciliation scoped to owner snapshots
+// and the dedicated drop protocol, never container/corpse deltas.
+inline int64_t CachedItemCount(const Inventory& acInventory, const GameId& acBase) noexcept
+{
+    int64_t count = 0;
+    for (const auto& entry : acInventory.Entries)
+        if (entry.BaseId == acBase)
+            count += entry.Count;
+    return count;
+}
+
+inline int32_t DebitOwnedDropCache(Inventory& aInventory, const Inventory::Entry& acItem) noexcept
+{
+    if (acItem.Count <= 0)
+        return 0;
+    const int32_t debit = static_cast<int32_t>(std::clamp<int64_t>(CachedItemCount(aInventory, acItem.BaseId), 0, acItem.Count));
+    int32_t remaining = debit;
+    // Prefer matching metadata, then tolerate stale extra data for this base.
+    for (int pass = 0; pass != 2 && remaining; ++pass)
+        for (auto& entry : aInventory.Entries)
+        {
+            auto candidate = entry;
+            candidate.ExtraWorn = candidate.ExtraWornLeft = false;
+            auto wanted = acItem;
+            wanted.ExtraWorn = wanted.ExtraWornLeft = false;
+            if (entry.BaseId != acItem.BaseId || entry.Count <= 0
+                || (pass == 0 && !candidate.CanBeMerged(wanted)))
+                continue;
+            const int32_t amount = std::min(remaining, entry.Count);
+            entry.Count -= amount;
+            remaining -= amount;
+            if (!remaining)
+                break;
+        }
+    aInventory.Entries.erase(std::remove_if(aInventory.Entries.begin(), aInventory.Entries.end(),
+        [](const auto& entry) { return entry.Count == 0; }), aInventory.Entries.end());
+    return debit;
+}
+
+inline void ApplyOwnedEquipmentSnapshot(Inventory& aInventory, const Inventory& acEquipment) noexcept
+{
+    for (auto& entry : aInventory.Entries)
+        entry.ExtraWorn = entry.ExtraWornLeft = false;
+    // Reserve each actually worn stack from the cached base count, replacing
+    // stale metadata rather than adding a second copy. An outfit missing from
+    // the old assignment cache is supplied only by its current owner.
+    for (const auto& wanted : acEquipment.Entries)
+    {
+        if (!wanted.BaseId || !wanted.IsWorn() || wanted.Count <= 0)
+            continue;
+        Inventory available;
+        for (const auto& entry : aInventory.Entries)
+            if (!entry.IsWorn())
+                available.Entries.push_back(entry);
+        DebitOwnedDropCache(available, wanted);
+        aInventory.Entries.erase(std::remove_if(aInventory.Entries.begin(), aInventory.Entries.end(),
+            [](const auto& entry) { return !entry.IsWorn(); }), aInventory.Entries.end());
+        aInventory.Entries.insert(aInventory.Entries.end(), available.Entries.begin(), available.Entries.end());
+        aInventory.Entries.push_back(wanted);
+    }
+    aInventory.CurrentMagicEquipment = acEquipment.CurrentMagicEquipment;
+}
diff --git a/Code/server/Game/Inventory/DroppedItemLedger.h b/Code/server/Game/Inventory/DroppedItemLedger.h
new file mode 100644
index 00000000..f330b3dd
--- /dev/null
+++ b/Code/server/Game/Inventory/DroppedItemLedger.h
@@ -0,0 +1,136 @@
+#pragma once
+
+#include <Structs/DroppedItemData.h>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <vector>
+#include <limits>
+#include <cmath>
+
+// Independent of actor lifetime: tombstones must survive cell unloads and player
+// disconnects. The lock makes first-winner selection indivisible even if packet
+// dispatch is moved to multiple threads later.
+class DroppedItemLedger
+{
+public:
+    struct Record
+    {
+        DroppedItemData Data{};
+        uint64_t Creator{};
+        uint64_t Nonce{};
+        uint64_t Winner{};
+        uint32_t CreditedActor{};
+        uint32_t WinnerActor{};
+        bool PlayerWinner{true};
+        bool Acknowledged{};
+        bool Active{true};
+        bool Networked{true};
+    };
+    enum class ClaimResult { Granted, AlreadyGranted, Lost, Unknown };
+
+    std::optional<Record> UpdatePlacement(uint64_t aId, uint64_t aCreator, const DroppedItemData& acPose)
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (!aCreator || it == m_records.end() || it->second.Creator != aCreator || !it->second.Active || !it->second.Networked
+            || !acPose.Cell || !std::isfinite(acPose.Position.x) || !std::isfinite(acPose.Position.y) || !std::isfinite(acPose.Position.z)
+            || !std::isfinite(acPose.Rotation.x) || !std::isfinite(acPose.Rotation.y) || !std::isfinite(acPose.Rotation.z))
+            return std::nullopt;
+        auto& data = it->second.Data;
+        data.Cell = acPose.Cell;
+        data.WorldSpace = acPose.WorldSpace;
+        data.Position = acPose.Position;
+        data.Rotation = acPose.Rotation;
+        data.PlacementReady = true;
+        return it->second;
+    }
+
+    std::optional<Record> FindCreated(uint64_t aClient, uint64_t aNonce) const
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_origins.find({aClient, aNonce});
+        if (it == m_origins.end())
+            return std::nullopt;
+        return m_records.find(it->second)->second;
+    }
+
+    std::optional<Record> Create(uint64_t aClient, uint64_t aNonce, DroppedItemData aData, bool aNetworked = true)
+    {
+        std::lock_guard lock(m_lock);
+        if (!aClient || !aNonce || !aData.Item.BaseId || aData.Item.Count <= 0)
+            return std::nullopt;
+        if (const auto it = m_origins.find({aClient, aNonce}); it != m_origins.end())
+            return m_records.find(it->second)->second;
+        if (m_nextId == std::numeric_limits<uint64_t>::max())
+            return std::nullopt;
+        aData.Id = m_nextId++;
+        Record record;
+        record.Data = std::move(aData);
+        record.Creator = aClient;
+        record.Nonce = aNonce;
+        record.Networked = aNetworked;
+        record.Active = aNetworked;
+        m_origins.emplace(std::make_pair(aClient, aNonce), record.Data.Id);
+        m_records.emplace(record.Data.Id, record);
+        return record;
+    }
+
+    ClaimResult Claim(uint64_t aId, uint64_t aClient, uint32_t aActor, bool aPlayer = true)
+    {
+        std::lock_guard lock(m_lock);
+        if (!aClient || !aActor)
+            return ClaimResult::Lost;
+        const auto it = m_records.find(aId);
+        if (it == m_records.end())
+            return ClaimResult::Unknown;
+        auto& record = it->second;
+        if (!record.Active)
+            return record.Winner == aClient && record.WinnerActor == aActor ? ClaimResult::AlreadyGranted : ClaimResult::Lost;
+        record.Active = false;
+        record.Winner = aClient;
+        record.CreditedActor = aActor;
+        record.WinnerActor = aActor;
+        record.PlayerWinner = aPlayer;
+        record.Acknowledged = !aPlayer;
+        return ClaimResult::Granted;
+    }
+
+    // Freshly applied recovered grants need one server inventory correction if
+    // reconnecting created a different player actor. Duplicate ACKs cannot add.
+    bool Acknowledge(uint64_t aId, uint64_t aClient, uint32_t aActor, bool aAppliedFresh)
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (it == m_records.end() || it->second.Active || !it->second.PlayerWinner || it->second.Winner != aClient || !aActor)
+            return false;
+        auto& record = it->second;
+        const bool credit = record.CreditedActor != aActor && aAppliedFresh;
+        record.CreditedActor = aActor;
+        record.Acknowledged = true;
+        return credit;
+    }
+
+    std::optional<Record> Get(uint64_t aId) const
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() ? std::nullopt : std::optional<Record>(it->second);
+    }
+
+    std::vector<Record> Snapshot(uint64_t aClient) const
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> records;
+        for (const auto& [id, record] : m_records)
+            if (record.Networked && (record.Active || (record.PlayerWinner && record.Winner == aClient && !record.Acknowledged)))
+                records.push_back(record);
+        return records;
+    }
+
+private:
+    mutable std::mutex m_lock;
+    uint64_t m_nextId{1};
+    std::map<uint64_t, Record> m_records;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_origins;
+};
