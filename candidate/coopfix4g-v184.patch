+        uint64_t PhysicsWarningAfter{};
+        uint64_t WaitSince{};
+    };
+
+    void OnConnected(const ConnectedEvent&) noexcept;
+    void OnDisconnected(const DisconnectedEvent&) noexcept;
+    void OnUpdate(const UpdateEvent&) noexcept;
+    void OnNotify(const NotifyDroppedItem& acMessage) noexcept;
+    void PrepareDrop(uint64_t aNonce) noexcept;
+    void RefundDrop(const Pending& acPending) noexcept;
+    void RequestClaim(uint64_t aId, uint32_t aActorForm = 0x14) noexcept;
+    void ClearReferences(bool aIncludePending) noexcept;
+    void RemoveReference(uint64_t aId) noexcept;
+    void Spawn(LocalDrop& aDrop) noexcept;
+    void UpdateProxy(LocalDrop& aDrop) noexcept;
+    void UpdateSourcePlacement(LocalDrop& aDrop) noexcept;
+    void ApplyGrant(const NotifyDroppedItem& acMessage) noexcept;
+    static void DeleteReference(uint32_t aHandle) noexcept;
