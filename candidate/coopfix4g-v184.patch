+FurnitureService::FurnitureService(World& aWorld, TransportService& aTransport, entt::dispatcher& aDispatcher) noexcept
+    : m_world(aWorld)
+    , m_transport(aTransport)
+{
+    m_updateConnection = aDispatcher.sink<UpdateEvent>().connect<&FurnitureService::OnUpdate>(this);
+    m_disconnectConnection = aDispatcher.sink<DisconnectedEvent>().connect<&FurnitureService::OnDisconnected>(this);
+    m_localRemovedConnection = m_world.on_destroy<LocalComponent>().connect<&FurnitureService::OnLocalRemoved>(this);
+    m_hitConnection = aDispatcher.sink<HitEvent>().connect<&FurnitureService::OnHit>(this);
+}
+
+void FurnitureService::OnDisconnected(const DisconnectedEvent&) noexcept
+{
+    m_world.clear<RecoveryState>();
+    m_nextUpdate = {};
+    m_nextHitAudit = {};
+}
+
+void FurnitureService::OnHit(const HitEvent& acEvent) noexcept
+{
+    const auto cNow = std::chrono::steady_clock::now();
+    if (!m_transport.IsConnected() || cNow < m_nextHitAudit)
+        return;
+    Actor* pActor = Cast<Actor>(TESForm::GetById(acEvent.HitteeId));
+    if (!pActor || pActor->IsDeleted() || pActor->GetExtension()->IsPlayer() || !pActor->GetNiNode())
+        return;
+    const void* pGetSitState = m_world.ctx().at<PapyrusService>().Get("Actor", "GetSitState");
+    if (!pGetSitState)
+        return;
+    const PapyrusFunction<int32_t, Actor> getSitState(pGetSitState);
+    const int32_t cSit = getSitState(pActor);
+    m_nextHitAudit = cNow + std::chrono::milliseconds(500);
+    uint32_t furniture = 0;
+    NiPoint3 furniturePosition{};
+    if (pActor->currentProcess && pActor->currentProcess->middleProcess)
+        if (auto* pRef = TESObjectREFR::GetByHandle(pActor->currentProcess->middleProcess->occupiedFurniture.handle.iBits))
+        {
+            furniture = pRef->formID;
+            furniturePosition = pRef->position;
+        }
+    Actor* pTarget = pActor->GetCombatTarget();
+    spdlog::info("STR furniture hit audit: actor {:X}, hitter {:X}, remote {}, combat {}, sit {}, furniture {:X}, target {:X}, scene {}, position ({}, {}, {}), state ({:X}, {:X}), furniture position ({}, {}, {}), latest {}",
+        pActor->formID, acEvent.HitterId, pActor->GetExtension()->IsRemote(), pActor->IsInCombat(), cSit,
+        furniture, pTarget ? pTarget->formID : 0, pActor->GetCurrentScene() != nullptr,
+        pActor->position.x, pActor->position.y, pActor->position.z, pActor->actorState.flags1, pActor->actorState.flags2,
+        furniturePosition.x, furniturePosition.y, furniturePosition.z, pActor->GetExtension()->LatestAnimation.EventName.c_str());
+}
+
+void FurnitureService::OnLocalRemoved(entt::registry&, entt::entity aEntity) noexcept
+{
+    m_world.remove<RecoveryState>(aEntity);
+}
+
+void FurnitureService::OnUpdate(const UpdateEvent&) noexcept
+{
+    const auto cNow = std::chrono::steady_clock::now();
+    if (!m_transport.IsConnected() || cNow < m_nextUpdate)
+        return;
+    m_nextUpdate = cNow + std::chrono::milliseconds(500);
+    UI* pUI = UI::Get();
+    if (pUI && (pUI->numPausesGame != 0 || pUI->GetMenuOpen(BSFixedString("Loading Menu"))))
+    {
+        m_world.clear<RecoveryState>();
+        return;
+    }
+
+    const auto& cPapyrus = m_world.ctx().at<PapyrusService>();
+    const void* pGetSitState = cPapyrus.Get("Actor", "GetSitState");
+    const void* pEvaluatePackage = cPapyrus.Get("Actor", "EvaluatePackage");
+    if (!pGetSitState || !pEvaluatePackage)
+        return;
+    const PapyrusFunction<int32_t, Actor> getSitState(pGetSitState);
+    const PapyrusFunction<void, Actor> evaluatePackage(pEvaluatePackage);
+    const uint64_t cMilliseconds = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(cNow.time_since_epoch()).count());
+
+    auto view = m_world.view<FormIdComponent, LocalComponent, LocalAnimationComponent>();
+    for (const auto entity : view)
+    {
+        const auto& cLocal = view.get<LocalComponent>(entity);
+        Actor* pActor = Cast<Actor>(TESForm::GetById(view.get<FormIdComponent>(entity).Id));
+        auto* pCell = pActor ? pActor->GetParentCellEx() : nullptr;
+        if (!pActor || pActor->IsDeleted() || pActor->IsDisabled() || pActor->IsDead()
+            || pActor->GetExtension()->IsPlayer() || pActor->GetExtension()->IsRemote()
+            || !pCell || !pCell->IsAttached() || !pActor->GetNiNode() || !pActor->animationGraphHolder.IsReady()
+            || pActor->GetCurrentScene() || !pActor->IsInCombat() || !pActor->currentProcess || !pActor->currentProcess->middleProcess)
+        {
+            m_world.remove<RecoveryState>(entity);
+            continue;
+        }
+
+        Actor* pTarget = pActor->GetCombatTarget();
+        const int32_t cSitState = getSitState(pActor);
+        const uint32_t cFurnitureHandle = pActor->currentProcess->middleProcess->occupiedFurniture.handle.iBits;
+        TESObjectREFR* pFurniture = cFurnitureHandle ? TESObjectREFR::GetByHandle(cFurnitureHandle) : nullptr;
+        // A real furniture reference is required: sit state alone also covers
+        // mounted actors. Do not clear orphan state bits or force hostility.
+        if (!pTarget || pTarget == pActor || pTarget->IsDeleted() || pTarget->IsDead()
+            || cSitState != 3 || !pFurniture || pFurniture->IsDeleted()
+            || !pFurniture->baseForm || pFurniture->baseForm->formType != FormType::Furniture)
+        {
+            m_world.remove<RecoveryState>(entity);
+            continue;
+        }
+
+        auto& state = m_world.get_or_emplace<RecoveryState>(entity);
+        const uint32_t cActorHandle = pActor->GetHandle().handle.iBits;
+        if (state.ActorHandle != cActorHandle || state.FurnitureHandle != cFurnitureHandle || state.OwnershipEpoch != cLocal.OwnershipEpoch)
+        {
+            state = {};
+            state.ActorHandle = cActorHandle;
+            state.FurnitureHandle = cFurnitureHandle;
+            state.OwnershipEpoch = cLocal.OwnershipEpoch;
+            spdlog::info("STR furniture recovery observed: actor {:X}, server {:X}, epoch {}, furniture {:X}, target {:X}, sit {}, position ({}, {}, {})",
+                pActor->formID, cLocal.Id, cLocal.OwnershipEpoch, pFurniture->formID, pTarget->formID, cSitState,
+                pActor->position.x, pActor->position.y, pActor->position.z);
+        }
+        const auto cAction = state.Recovery.Advance(true, cMilliseconds);
+        if (cAction == FurnitureRecovery::Action::Reevaluate)
+        {
+            evaluatePackage(pActor);
+            spdlog::info("STR furniture recovery reevaluate: actor {:X}, server {:X}, epoch {}", pActor->formID, cLocal.Id, cLocal.OwnershipEpoch);
+        }
+        else if (cAction == FurnitureRecovery::Action::Exit)
+        {
+            // Capture the same pre-action state as HookPerformAction. Feed the
+            // exit through the existing action stream/cache, not a second AI.
+            ActionEvent exit;
+            exit.ActorId = pActor->formID;
+            exit.Tick = m_world.GetTick();
+            exit.Type = 2;
+            exit.State1 = pActor->actorState.flags1;
+            exit.State2 = pActor->actorState.flags2;
+            exit.EventName = String("ForceFurnExit");
+            exit.TargetEventName = String("ForceFurnExit");
+            pActor->SaveAnimationVariables(exit.Variables);
+            BSFixedString eventName("ForceFurnExit");
+            const bool cAccepted = pActor->SendAnimationEvent(&eventName);
+            if (cAccepted)
+            {
+                view.get<LocalAnimationComponent>(entity).Append(exit);
+                pActor->GetExtension()->LatestAnimation = exit;
+                evaluatePackage(pActor);
+            }
+            spdlog::info("STR furniture recovery exit: actor {:X}, server {:X}, epoch {}, furniture {:X}, target {:X}, accepted {}",
