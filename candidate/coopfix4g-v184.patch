diff --git a/Code/client/Systems/DropPlacementClock.h b/Code/client/Systems/DropPlacementClock.h
new file mode 100644
index 00000000..59406c80
--- /dev/null
+++ b/Code/client/Systems/DropPlacementClock.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <glm/glm.hpp>
+#include <optional>
+#include <cstdint>
+
+// Sample only the original native drop. A failed send must not consume the
+// pending placement; replicas never become a second physics authority.
+class DropPlacementClock
+{
+public:
+    bool Observe(bool aReady, const glm::vec3& acPosition, const glm::vec3& acRotation, uint64_t aNow) noexcept
+    {
+        if (!aReady)
+        {
+            m_sample.reset();
+            m_stable = 0;
+            return false;
+        }
+        const bool stable = m_sample && Near(m_sample->Position, acPosition, 1.f) && Near(m_sample->Rotation, acRotation, 0.0004f);
+        m_stable = stable ? m_stable + 1 : 0;
+        m_sample = Pose{acPosition, acRotation};
+        if (!m_published && m_stable < 2)
+            return false;
+        return !m_published || (aNow >= m_nextSend && (!Near(m_published->Position, acPosition, 1.f) || !Near(m_published->Rotation, acRotation, 0.0004f)));
+    }
+
+    void Published(const glm::vec3& acPosition, const glm::vec3& acRotation, uint64_t aNow) noexcept
+    {
+        m_published = Pose{acPosition, acRotation};
+        m_nextSend = aNow + 500;
+    }
+
+private:
+    struct Pose { glm::vec3 Position; glm::vec3 Rotation; };
+    static bool Near(const glm::vec3& acA, const glm::vec3& acB, float aSquaredDistance) noexcept
+    {
+        const auto delta = acA - acB;
+        return glm::dot(delta, delta) <= aSquaredDistance;
+    }
+    std::optional<Pose> m_sample;
+    std::optional<Pose> m_published;
+    uint64_t m_nextSend{};
+    uint32_t m_stable{};
+};
diff --git a/Code/client/Systems/DropProxySetup.h b/Code/client/Systems/DropProxySetup.h
new file mode 100644
index 00000000..ae974999
--- /dev/null
+++ b/Code/client/Systems/DropProxySetup.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// Geometry and collision attach asynchronously. The reference is positioned
+// before enabling; make bounded wake attempts only after both are ready.
+class DropProxySetup
+{
+public:
+    enum class Action { Wait, PlaceAndWake, Wake, Done };
+
+    Action Advance(bool aHas3D, bool aCellAttached, uint64_t aMilliseconds, bool aHasCollision = true) noexcept
+    {
+        if (!aHas3D || !aCellAttached || !aHasCollision)
+        {
+            m_first3D.reset();
+            m_attempts = 0;
+            m_nextAttempt = 0;
+            return Action::Wait;
+        }
+        if (!m_first3D)
+            m_first3D = aMilliseconds;
+        if (m_attempts >= 3)
+            return Action::Done;
+        if (aMilliseconds - *m_first3D < 100 || aMilliseconds < m_nextAttempt)
+            return Action::Wait;
+        m_nextAttempt = aMilliseconds + 500;
+        return m_attempts++ == 0 ? Action::PlaceAndWake : Action::Wake;
+    }
+
+private:
+    std::optional<uint64_t> m_first3D;
+    uint64_t m_nextAttempt{};
+    uint32_t m_attempts{};
+};
diff --git a/Code/client/Systems/DroppedItemBinding.h b/Code/client/Systems/DroppedItemBinding.h
new file mode 100644
index 00000000..d604d18b
--- /dev/null
+++ b/Code/client/Systems/DroppedItemBinding.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstdint>
+
+// Pure client identity state shared by the hook reservation and registration
+// acknowledgement. A queued pickup must retain its creation nonce across ACK.
+struct DroppedItemBinding
+{
+    uint32_t Handle{};
+    uint64_t Id{};
+    uint64_t Nonce{};
+    bool Busy{};
+
+    void BindRegistered(uint32_t aHandle, uint64_t aId, uint64_t aNonce, bool aWantPick) noexcept
+    {
+        const bool cReserved = Handle == aHandle && Nonce == aNonce && Busy;
+        *this = {aHandle, aId, aNonce, cReserved || aWantPick};
+    }
+
+    uint64_t ResolveQueuedPickup(uint32_t aHandle, uint64_t aNonce) const noexcept
+    {
+        return Handle == aHandle && Nonce == aNonce ? Id : 0;
+    }
+};
diff --git a/Code/client/Systems/FurnitureRecovery.h b/Code/client/Systems/FurnitureRecovery.h
new file mode 100644
index 00000000..c7f06f6c
--- /dev/null
+++ b/Code/client/Systems/FurnitureRecovery.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// Timing only. Engine eligibility is checked anew on the simulation owner.
+class FurnitureRecovery
+{
+public:
+    enum class Action { Wait, Reevaluate, Exit };
+
+    Action Advance(bool aEligible, uint64_t aMilliseconds) noexcept
+    {
+        if (!aEligible)
+        {
+            m_since.reset();
+            m_stage = 0;
+            return Action::Wait;
+        }
+        if (!m_since || aMilliseconds < *m_since)
+            m_since = aMilliseconds;
+        const uint64_t cElapsed = aMilliseconds - *m_since;
+        if (m_stage == 0 && cElapsed >= 2000)
+        {
+            m_stage = 1;
+            m_reevaluatedAt = aMilliseconds;
+            return Action::Reevaluate;
+        }
+        if (m_stage == 1 && aMilliseconds >= m_reevaluatedAt && aMilliseconds - m_reevaluatedAt >= 2000)
+        {
+            m_stage = 2;
+            return Action::Exit;
+        }
+        return Action::Wait;
+    }
+
+private:
+    std::optional<uint64_t> m_since;
+    uint8_t m_stage{};
+    uint64_t m_reevaluatedAt{};
+};
diff --git a/Code/client/Systems/PendingActorUpdates.h b/Code/client/Systems/PendingActorUpdates.h
new file mode 100644
index 00000000..5b69398f
--- /dev/null
+++ b/Code/client/Systems/PendingActorUpdates.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <Messages/CharacterSpawnRequest.h>
+#include <Messages/NotifyDeathStateChange.h>
+#include <Messages/NotifyInventoryChanges.h>
+#include <Messages/NotifyOwnershipTransfer.h>
+#include <Messages/NotifyEquipmentChanges.h>
+#include <Structs/OwnedInventory.h>
+
+inline bool ApplyPendingEquipment(CharacterSpawnRequest& aSpawn, const NotifyEquipmentChanges& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch)
+        return false;
+    // A late equip must not put looted equipment back on a corpse.
+    if (!aSpawn.IsDead)
+        ApplyOwnedEquipmentSnapshot(aSpawn.InventoryContent, acUpdate.CurrentInventory);
+    return true;
+}
+
+inline bool ApplyPendingOwnership(CharacterSpawnRequest& aSpawn, const NotifyOwnershipTransfer& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || acUpdate.OwnershipEpoch <= aSpawn.OwnershipEpoch)
+        return false;
+    aSpawn.OwnershipEpoch = acUpdate.OwnershipEpoch;
+    aSpawn.InitialActorValues = acUpdate.CurrentActorData.InitialActorValues;
+    aSpawn.InventoryContent = acUpdate.CurrentActorData.InitialInventory;
+    aSpawn.IsDead = acUpdate.CurrentActorData.IsDead;
+    aSpawn.IsWeaponDrawn = acUpdate.CurrentActorData.IsWeaponDrawn;
+    aSpawn.LeveledNpcPickId = acUpdate.LeveledNpcPickId;
+    return true;
+}
+
+// Reliable updates can arrive after the spawn snapshot, before its 3D exists.
+// Update that snapshot so materialization cannot restore an older corpse state.
+inline bool ApplyPendingDeath(CharacterSpawnRequest& aSpawn, const NotifyDeathStateChange& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.Id || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch || aSpawn.IsPlayer)
+        return false;
+    aSpawn.IsDead = acUpdate.IsDead;
+    return true;
+}
+
+inline bool ApplyPendingInventory(CharacterSpawnRequest& aSpawn, const NotifyInventoryChanges& acUpdate) noexcept
+{
+    if (acUpdate.Drop || !acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch)
+        return false;
+    aSpawn.InventoryContent.AddOrRemoveEntry(acUpdate.Item);
+    return true;
+}
