+class DroppedItemService
+{
+public:
+    DroppedItemService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept;
+    static DroppedItemService* Get() noexcept;
+    bool HandlesDrops() const noexcept;
+    bool DefersPlayerDrops() const noexcept;
+    bool TrackDrop(TESObjectREFR* apReference, Inventory::Entry aItem) noexcept;
+    bool InterceptPickup(Actor* apActor, TESObjectREFR* apReference) noexcept;
+    bool IsTracked(TESObjectREFR* apReference) const noexcept;
+
+private:
+    struct Binding
+    {
+        uint32_t Handle{};
+        uint64_t Id{};
+        uint64_t Nonce{};
+        bool Busy{};
+    };
+    struct Pending
+    {
+        DroppedItemData Data{};
+        uint32_t Handle{};
+        uint32_t FormId{};
+        uint32_t CellForm{};
+        uint32_t WorldForm{};
+        bool Prepared{};
+        bool Sent{};
+        bool InventoryAlreadyReflected{};
+        bool WantPick{};
+        uint32_t WantActorForm{0x14};
+    };
+    struct LocalDrop
+    {
+        DroppedItemData Data{};
+        std::shared_ptr<TESObjectREFR> Reference;
+        DropProxySetup Setup;
+        uint32_t Handle{};
+        bool Taken{};
+        bool IsProxy{};
+        uint64_t RetryAfter{};
+    };
+
+    void OnConnected(const ConnectedEvent&) noexcept;
+    void OnDisconnected(const DisconnectedEvent&) noexcept;
+    void OnUpdate(const UpdateEvent&) noexcept;
+    void OnNotify(const NotifyDroppedItem& acMessage) noexcept;
+    void PrepareDrop(uint64_t aNonce) noexcept;
+    void RequestClaim(uint64_t aId, uint32_t aActorForm = 0x14) noexcept;
+    void ClearReferences(bool aIncludePending) noexcept;
+    void RemoveReference(uint64_t aId) noexcept;
+    void Spawn(LocalDrop& aDrop) noexcept;
+    void UpdateProxy(LocalDrop& aDrop) noexcept;
+    void ApplyGrant(const NotifyDroppedItem& acMessage) noexcept;
+    static void DeleteReference(uint32_t aHandle) noexcept;
+    static void DeleteReference(TESObjectREFR* apReference) noexcept;
+    static std::shared_ptr<TESObjectREFR> RetainReference(TESObjectREFR* apReference);
+
+    World& m_world;
+    TransportService& m_transport;
+    uint64_t m_clientSession{};
+    uint64_t m_serverSession{};
+    std::atomic<uint64_t> m_nonce{1};
+    std::atomic<bool> m_online{false};
+    std::atomic<bool> m_ready{false};
+    std::atomic<int> m_enabled{-1};
+    bool m_snapshotReady{};
+    bool m_querySent{};
+    GameId m_lastCell{};
+    GameId m_lastWorld{};
+    std::chrono::steady_clock::time_point m_nextUpdate{};
+    // The engine interception can run off the ECS thread. This small index is
+    // locked; authoritative record handling remains on the main runner thread.
+    mutable std::mutex m_lock;
+    std::map<uint32_t, Binding> m_bindings;
+    std::map<uint64_t, Pending> m_pending;
+    std::map<uint64_t, LocalDrop> m_drops;
+    std::map<uint64_t, uint64_t> m_claims;
+    std::map<uint64_t, uint32_t> m_claimActors;
+    std::set<uint64_t> m_applied;
+    std::map<uint64_t, bool> m_acks;
+    entt::scoped_connection m_connectedConnection;
+    entt::scoped_connection m_disconnectedConnection;
+    entt::scoped_connection m_updateConnection;
+    entt::scoped_connection m_notifyConnection;
+};
