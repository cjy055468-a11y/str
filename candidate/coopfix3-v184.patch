+DroppedItemService::DroppedItemService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept
+    : m_world(aWorld)
+    , m_transport(aTransport)
+{
+    if (BCryptGenRandom(nullptr, reinterpret_cast<PUCHAR>(&m_clientSession), sizeof(m_clientSession), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0 || !m_clientSession)
+        spdlog::error("STR drop sync: could not create a private reconnect identity");
+    m_connectedConnection = aDispatcher.sink<ConnectedEvent>().connect<&DroppedItemService::OnConnected>(this);
+    m_disconnectedConnection = aDispatcher.sink<DisconnectedEvent>().connect<&DroppedItemService::OnDisconnected>(this);
+    m_updateConnection = aDispatcher.sink<UpdateEvent>().connect<&DroppedItemService::OnUpdate>(this);
+    m_notifyConnection = aDispatcher.sink<NotifyDroppedItem>().connect<&DroppedItemService::OnNotify>(this);
+}
+
+DroppedItemService* DroppedItemService::Get() noexcept
+{
+    return World::Get().ctx().find<DroppedItemService>();
+}
+
+bool DroppedItemService::HandlesDrops() const noexcept
+{
+    return m_clientSession && m_online.load() && m_enabled.load() != 0 && m_ready.load();
+}
+
+bool DroppedItemService::DefersPlayerDrops() const noexcept
+{
+    return m_clientSession && m_online.load() && m_enabled.load() != 0 && !m_ready.load();
+}
+
+bool DroppedItemService::TrackDrop(TESObjectREFR* apReference, Inventory::Entry aItem) noexcept
+{
+    if (!HandlesDrops() || !apReference || !apReference->IsTemporary() || aItem.Count <= 0)
+        return false;
+    Pending pending;
+    pending.Handle = apReference->GetHandle().handle.iBits;
+    if (!pending.Handle)
+        return false;
+    pending.FormId = apReference->formID;
+    pending.Data.Item = std::move(aItem);
+    pending.Data.Item.ExtraWorn = pending.Data.Item.ExtraWornLeft = false;
+    pending.Data.Position = apReference->position;
+    pending.Data.Rotation = apReference->rotation;
+    if (const auto* pCell = apReference->GetParentCellEx())
+    {
+        pending.CellForm = pCell->formID;
+        if (!(pCell->cellFlags & 1) && pCell->worldspace)
+            pending.WorldForm = pCell->worldspace->formID;
+    }
+    const uint64_t nonce = m_nonce.fetch_add(1);
+    {
+        std::lock_guard lock(m_lock);
+        m_bindings[pending.FormId] = {pending.Handle, 0, nonce, false};
+        m_pending.emplace(nonce, std::move(pending));
+    }
+    // Do not save a client-generated overlay that could reappear from a save.
+    apReference->SetSkipSaveFlag(true);
+    m_world.GetRunner().Queue([this, nonce]() { PrepareDrop(nonce); });
+    return true;
+}
+
+bool DroppedItemService::IsTracked(TESObjectREFR* apReference) const noexcept
+{
+    if (!apReference)
+        return false;
+    std::lock_guard lock(m_lock);
+    const auto it = m_bindings.find(apReference->formID);
+    return it != m_bindings.end() && it->second.Handle == apReference->GetHandle().handle.iBits;
+}
+
+bool DroppedItemService::InterceptPickup(Actor* apActor, TESObjectREFR* apReference) noexcept
+{
+    if (!apReference)
+        return false;
+    uint64_t id = 0;
+    uint64_t nonce = 0;
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_bindings.find(apReference->formID);
+        if (it == m_bindings.end() || it->second.Handle != apReference->GetHandle().handle.iBits)
+            return false;
+        // Only the authoritative actor may request consumption. Its inventory
+        // still waits for the server, including an NPC taking a dropped weapon.
+        if (!apActor || apActor->GetExtension()->IsRemote() || !m_online.load() || it->second.Busy)
+            return true;
+        it->second.Busy = true;
+        id = it->second.Id;
+        nonce = it->second.Nonce;
+    }
+    // Never take the runner's queue lock while holding the hook index lock.
+    const uint32_t actorForm = apActor->formID;
+    m_world.GetRunner().Queue([this, id, nonce, actorForm]()
+    {
+        if (id)
+            RequestClaim(id, actorForm);
+        else
+        {
+            std::lock_guard pendingLock(m_lock);
+            if (const auto pending = m_pending.find(nonce); pending != m_pending.end())
+            {
+                pending->second.WantPick = true;
+                pending->second.WantActorForm = actorForm;
+            }
+        }
+    });
+    return true;
+}
+
+void DroppedItemService::PrepareDrop(uint64_t aNonce) noexcept
+{
+    std::optional<Pending> failed;
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_pending.find(aNonce);
+        if (it == m_pending.end())
+            return;
+        auto& pending = it->second;
+        pending.Prepared = pending.CellForm && m_world.GetModSystem().GetServerModId(pending.CellForm, pending.Data.Cell);
+        if (pending.WorldForm)
+            pending.Prepared = pending.Prepared && m_world.GetModSystem().GetServerModId(pending.WorldForm, pending.Data.WorldSpace);
+        if (!pending.Prepared)
+        {
+            failed = pending;
+            if (auto binding = m_bindings.find(pending.FormId); binding != m_bindings.end())
+                binding->second.Busy = true;
+            m_pending.erase(it);
+        }
+    }
+    if (failed)
+    {
+        ScopedInventoryOverride inventoryOverride;
+        PlayerCharacter::Get()->AddOrRemoveItem(failed->Data.Item);
+        DeleteReference(failed->Handle);
+        spdlog::warn("STR drop registration rolled back: cell could not be mapped");
+    }
+}
+
+void DroppedItemService::OnConnected(const ConnectedEvent&) noexcept
+{
+    m_online = m_clientSession != 0;
+    m_ready = false;
+    m_enabled = -1;
+    m_snapshotReady = false;
+    m_querySent = false;
+    m_lastCell = {};
+    m_lastWorld = {};
+    m_nextUpdate = {};
+}
+
+std::shared_ptr<TESObjectREFR> DroppedItemService::RetainReference(TESObjectREFR* apReference)
+{
+    if (!apReference)
+        return {};
+    apReference->handleRefObject.IncRef();
+    return std::shared_ptr<TESObjectREFR>(apReference, [](TESObjectREFR* pReference) {
+        pReference->handleRefObject.DecRefHandle();
+    });
+}
+
+void DroppedItemService::DeleteReference(uint32_t aHandle) noexcept
+{
+    if (!aHandle)
+        return;
+    DeleteReference(TESObjectREFR::GetByHandle(aHandle));
+}
+
+void DroppedItemService::DeleteReference(TESObjectREFR* reference) noexcept
+{
+    if (reference && reference->IsTemporary() && !reference->IsDeleted())
+    {
+        const void* pDisable = World::Get().ctx().at<PapyrusService>().Get("ObjectReference", "Disable");
+        if (pDisable)
+        {
+            const PapyrusFunction<void, TESObjectREFR, bool> disable(pDisable);
+            disable(reference, false); // No fade: retire the physical pickup now.
+        }
+        else
+            reference->Disable();
+        reference->Delete();
+    }
+}
+
+void DroppedItemService::ClearReferences(bool aIncludePending) noexcept
+{
+    Vector<uint32_t> handles;
+    {
+        std::lock_guard lock(m_lock);
+        for (auto& [form, binding] : m_bindings)
+        {
+            if (aIncludePending || binding.Id)
+            {
+                binding.Busy = true;
+                handles.push_back(binding.Handle);
+            }
+        }
+        if (aIncludePending)
+            for (auto& [nonce, pending] : m_pending)
+            {
+                pending.Handle = 0;
+                pending.Sent = false;
+                pending.InventoryAlreadyReflected = true;
+            }
+    }
+    // Retire the scene nodes while our strong reference still owns the proxy.
+    for (auto& [id, drop] : m_drops)
+        if (drop.Reference)
+            DeleteReference(drop.Reference.get());
+    for (uint32_t handle : handles)
+        DeleteReference(handle);
+    m_drops.clear();
+}
+
+void DroppedItemService::OnDisconnected(const DisconnectedEvent&) noexcept
+{
+    m_online = false;
+    m_ready = false;
+    m_snapshotReady = false;
+    m_querySent = false;
+    ClearReferences(true);
+    m_claims.clear();
+    m_claimActors.clear();
+    // The next actor snapshot includes everything already granted locally.
+    // Any recovered grant must acknowledge its new application state afresh.
+    m_acks.clear();
+    // Retain process identity and applied grants. An unacknowledged grant can
+    // then be replayed by the same server without awarding another copy.
+}
+
+void DroppedItemService::OnUpdate(const UpdateEvent&) noexcept
+{
+    if (!m_online.load() || std::chrono::steady_clock::now() < m_nextUpdate)
+        return;
+    m_nextUpdate = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+    auto* pPlayer = PlayerCharacter::Get();
+    auto* pCell = pPlayer ? pPlayer->GetParentCellEx() : nullptr;
+    const auto token = pPlayer ? Utils::GetLocalOwnershipToken(pPlayer->formID) : std::nullopt;
+    UI* pUI = UI::Get();
+    if (!pPlayer || !pCell || !pCell->IsAttached() || !token
+        || (pUI && pUI->GetMenuOpen(BSFixedString("Loading Menu"))))
+    {
+        m_ready = false;
+        return;
+    }
+    GameId cell{};
+    GameId world{};
+    if (!m_world.GetModSystem().GetServerModId(pCell->formID, cell))
+        return;
+    if (auto* pWorld = pPlayer->GetWorldSpace())
+        if (!m_world.GetModSystem().GetServerModId(pWorld->formID, world))
+            return;
+
+    if (!m_querySent || cell != m_lastCell || world != m_lastWorld)
+    {
+        RequestDroppedItem request;
+        request.Action = RequestDroppedItem::Operation::Snapshot;
+        request.ClientSession = m_clientSession;
+        request.Nonce = m_nonce.fetch_add(1);
+        if (m_transport.Send(request))
+        {
+            m_ready = false;
+            m_snapshotReady = false;
+            m_querySent = true;
+            m_lastCell = cell;
+            m_lastWorld = world;
+        }
+    }
+    if (!m_snapshotReady)
+        return;
+    m_ready = true;
+
+    {
+        std::lock_guard lock(m_lock);
+        for (auto& [nonce, pending] : m_pending)
+        {
+            if (!pending.Prepared || pending.Sent)
+                continue;
+            RequestDroppedItem request;
+            request.Action = RequestDroppedItem::Operation::Create;
+            request.ClientSession = m_clientSession;
+            request.ServerSession = m_serverSession;
+            request.Nonce = nonce;
+            request.ActorId = token->ServerId;
+            request.OwnershipEpoch = token->OwnershipEpoch;
+            request.Data = pending.Data;
+            request.InventoryAlreadyReflected = pending.InventoryAlreadyReflected;
+            pending.Sent = m_transport.Send(request);
+        }
+    }
+    for (auto& [id, drop] : m_drops)
+    {
+        if (!drop.Taken)
+            Spawn(drop);
+    }
+    for (auto it = m_acks.begin(); it != m_acks.end();)
+    {
+        RequestDroppedItem request;
+        request.Action = RequestDroppedItem::Operation::Acknowledge;
+        request.ClientSession = m_clientSession;
+        request.ServerSession = m_serverSession;
+        request.Nonce = m_nonce.fetch_add(1);
+        request.ActorId = token->ServerId;
+        request.OwnershipEpoch = token->OwnershipEpoch;
+        request.Data.Id = it->first;
+        request.AppliedFresh = it->second;
+        if (m_transport.Send(request))
+            it = m_acks.erase(it);
+        else
+            ++it;
+    }
+}
+
+void DroppedItemService::RequestClaim(uint64_t aId, uint32_t aActorForm) noexcept
+{
+    const auto it = m_drops.find(aId);
+    const auto token = Utils::GetLocalOwnershipToken(aActorForm);
+    if (m_claims.count(aId))
+        return;
+    if (!m_online.load() || !m_serverSession || !token || it == m_drops.end() || it->second.Taken)
+    {
+        std::lock_guard lock(m_lock);
+        for (auto& [ref, binding] : m_bindings)
+            if (binding.Id == aId && (it == m_drops.end() || !it->second.Taken))
+                binding.Busy = false;
+        return;
+    }
+    RequestDroppedItem request;
+    request.Action = RequestDroppedItem::Operation::Claim;
+    request.ClientSession = m_clientSession;
+    request.ServerSession = m_serverSession;
+    request.Nonce = m_nonce.fetch_add(1);
+    request.ActorId = token->ServerId;
+    request.OwnershipEpoch = token->OwnershipEpoch;
+    request.Data.Id = aId;
+    if (m_transport.Send(request))
+    {
+        m_claims[aId] = request.Nonce;
+        m_claimActors[aId] = aActorForm;
+    }
+    else
+    {
+        std::lock_guard lock(m_lock);
+        for (auto& [ref, binding] : m_bindings)
+            if (binding.Id == aId)
+                binding.Busy = false;
+    }
+}
+
+void DroppedItemService::UpdateProxy(LocalDrop& aDrop) noexcept
+{
+    if (!aDrop.IsProxy || !aDrop.Reference || aDrop.Taken)
+        return;
+    TESObjectREFR* pReference = aDrop.Reference.get();
+    const uint64_t cNow = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+    const auto cAction = aDrop.Setup.Advance(pReference->GetNiNode() != nullptr && !pReference->IsDisabled(), cNow);
+    if (cAction == DropProxySetup::Action::Wait || cAction == DropProxySetup::Action::Done)
+        return;
+    if (cAction == DropProxySetup::Action::PlaceAndWake)
+    {
+        TESObjectCELL* pCell = pReference->GetParentCellEx();
+        if (!pCell || !pCell->IsAttached())
+            return;
+        pReference->SetRotation(aDrop.Data.Rotation.x, aDrop.Data.Rotation.y, aDrop.Data.Rotation.z);
+        pReference->MoveTo(pCell, NiPoint3(aDrop.Data.Position));
+        if (pReference->IsDeleted())
+            return;
+    }
+    const auto& cPapyrus = m_world.ctx().at<PapyrusService>();
+    const void* pSetMotionType = cPapyrus.Get("ObjectReference", "SetMotionType");
+    const void* pApplyImpulse = cPapyrus.Get("ObjectReference", "ApplyHavokImpulse");
+    if (pSetMotionType)
+    {
+        const PapyrusFunction<void, TESObjectREFR, int32_t, bool> setMotionType(pSetMotionType);
+        setMotionType(pReference, 1, true); // Dynamic; keep ground collision and activate the body.
+    }
+    if (pApplyImpulse)
+    {
+        const PapyrusFunction<void, TESObjectREFR, float, float, float, float> applyImpulse(pApplyImpulse);
+        applyImpulse(pReference, 0.f, 0.f, -1.f, 0.02f);
+    }
+    spdlog::info("STR drop proxy physics: id {}, ref {:X}, first {}, motion {}, impulse {}",
+        aDrop.Data.Id, pReference->formID, cAction == DropProxySetup::Action::PlaceAndWake, pSetMotionType != nullptr, pApplyImpulse != nullptr);
+}
+
+void DroppedItemService::Spawn(LocalDrop& aDrop) noexcept
+{
+    if (!aDrop.Reference && aDrop.Handle)
+        aDrop.Reference = RetainReference(TESObjectREFR::GetByHandle(aDrop.Handle));
+    if (aDrop.Reference && !aDrop.Reference->IsDeleted())
+    {
+        UpdateProxy(aDrop);
+        return;
+    }
+    const uint64_t cNow = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+    if (cNow < aDrop.RetryAfter)
+        return;
+    aDrop.Reference.reset();
+    aDrop.Handle = 0;
+    auto* pPlayer = PlayerCharacter::Get();
+    auto* pCell = Cast<TESObjectCELL>(TESForm::GetById(m_world.GetModSystem().GetGameId(aDrop.Data.Cell)));
+    if (!pPlayer || !pCell || !pCell->IsAttached())
+        return;
+    if (aDrop.Data.WorldSpace)
+    {
+        GameId world{};
+        auto* pWorld = pPlayer->GetWorldSpace();
+        if (!pWorld || !m_world.GetModSystem().GetServerModId(pWorld->formID, world) || world != aDrop.Data.WorldSpace
+            || glm::distance(pPlayer->position, static_cast<const glm::vec3&>(aDrop.Data.Position)) > 8192.f)
+            return;
+    }
+    else if (pPlayer->GetParentCellEx() != pCell)
+        return;
+    auto* pBase = TESForm::GetById(m_world.GetModSystem().GetGameId(aDrop.Data.Item.BaseId));
+    const void* pFunction = m_world.ctx().at<PapyrusService>().Get("ObjectReference", "PlaceAtMe");
+    if (!pBase || pBase->formType == FormType::Npc || pBase->formType == FormType::Character || pBase->formType == FormType::LeveledCharacter || !pFunction)
+        return;
+    aDrop.RetryAfter = cNow + 5000;
+    const PapyrusFunction<TESObjectREFR*, TESObjectREFR, TESForm*, int32_t, bool, bool> place(pFunction);
+    auto* pRef = place(pPlayer, pBase, 1, false, true);
+    if (!pRef || !pRef->IsTemporary())
+        return;
+    // PlaceAtMe/GetByHandle return raw pointers in this project. Keep the new
+    // reference alive across asynchronous model/Havok attachment.
+    aDrop.Reference = RetainReference(pRef);
+    aDrop.IsProxy = true;
+    aDrop.Setup = {};
+    const uint32_t handle = pRef->GetHandle().handle.iBits;
+    if (!handle)
+    {
+        DeleteReference(pRef);
+        aDrop.Reference.reset();
+        return;
+    }
+    aDrop.Handle = handle;
+    pRef->SetSkipSaveFlag(true);
+    {
+        std::lock_guard lock(m_lock);
+        m_bindings[pRef->formID] = {handle, aDrop.Data.Id, 0, false};
+    }
+    pRef->SetRotation(aDrop.Data.Rotation.x, aDrop.Data.Rotation.y, aDrop.Data.Rotation.z);
+    pRef->MoveTo(pCell, NiPoint3(aDrop.Data.Position));
+    if (pRef->IsDeleted())
+        return;
+    pRef->EnableImpl();
+    spdlog::info("STR drop proxy spawned: id {}, ref {:X}, stack {}", aDrop.Data.Id, pRef->formID, aDrop.Data.Item.Count);
+}
+
+void DroppedItemService::RemoveReference(uint64_t aId) noexcept
+{
+    const auto it = m_drops.find(aId);
+    if (it != m_drops.end())
+    {
+        it->second.Taken = true;
+        const uint32_t handle = it->second.Handle;
+        it->second.Handle = 0;
+        {
+            std::lock_guard lock(m_lock);
+            for (auto& [form, binding] : m_bindings)
+                if (binding.Id == aId)
+                    binding.Busy = true;
+        }
+        // Keep the handle-qualified tombstone while the engine retires the
+        // reference. It must not become a vanilla pickup during that interval.
+        if (it->second.Reference)
+            DeleteReference(it->second.Reference.get());
+        else
+            DeleteReference(handle);
+        it->second.Reference.reset();
+    }
+}
+
+void DroppedItemService::ApplyGrant(const NotifyDroppedItem& acMessage) noexcept
+{
+    const uint64_t id = acMessage.Data.Id;
+    const auto claim = m_claims.find(id);
+    if (!id || acMessage.Data.Item.Count <= 0 || (!acMessage.Recovery && !m_applied.count(id)
+        && (claim == m_claims.end() || claim->second != acMessage.Nonce)))
+        return;
+    if (!acMessage.Recovery)
+    {
+        const auto actor = m_claimActors.find(id);
+        if (actor != m_claimActors.end() && actor->second != 0x14)
+        {
+            // NPC inventory was updated via the existing epoch-checked
+            // inventory broadcast, including the owner. Do not credit twice.
+            RemoveReference(id);
+            m_claims.erase(id);
+            m_claimActors.erase(id);
+            return;
+        }
+    }
+    auto* pPlayer = PlayerCharacter::Get();
+    if (!pPlayer || !TESForm::GetById(m_world.GetModSystem().GetGameId(acMessage.Data.Item.BaseId)))
+        return;
+    const bool fresh = m_applied.insert(id).second;
+    if (fresh)
+    {
+        ScopedInventoryOverride inventoryOverride;
+        pPlayer->AddOrRemoveItem(acMessage.Data.Item);
+    }
+    RemoveReference(id);
+    m_claims.erase(id);
+    m_claimActors.erase(id);
+    m_acks[id] = m_acks[id] || fresh;
+    spdlog::info("STR drop grant applied: id {}, count {}, fresh {}", id, acMessage.Data.Item.Count, fresh);
+}
+
+void DroppedItemService::OnNotify(const NotifyDroppedItem& acMessage) noexcept
+{
+    if (!m_online.load() || !acMessage.ServerSession)
+        return;
+    if (acMessage.Action == NotifyDroppedItem::Operation::SnapshotBegin)
+    {
+        if (m_serverSession && m_serverSession != acMessage.ServerSession)
+        {
+            m_applied.clear();
+            m_acks.clear();
+            m_claims.clear();
+            m_claimActors.clear();
+            std::lock_guard lock(m_lock);
+            for (auto& [nonce, pending] : m_pending)
+            {
+                pending.Sent = false;
+                pending.InventoryAlreadyReflected = true;
+            }
+        }
+        m_serverSession = acMessage.ServerSession;
+        m_enabled = acMessage.Enabled ? 1 : 0;
+        m_snapshotReady = false;
+        m_ready = false;
+        ClearReferences(false);
+        return;
+    }
+    if (!m_serverSession)
+        m_serverSession = acMessage.ServerSession;
+    if (m_serverSession != acMessage.ServerSession)
+        return;
+    if (acMessage.Action == NotifyDroppedItem::Operation::SnapshotEnd)
+    {
+        m_snapshotReady = true;
+        return;
+    }
+    if (acMessage.Action == NotifyDroppedItem::Operation::Grant)
+    {
+        ApplyGrant(acMessage);
+        return;
+    }
+
+    std::optional<Pending> origin;
+    if (acMessage.Nonce)
+    {
+        std::lock_guard lock(m_lock);
+        if (const auto pending = m_pending.find(acMessage.Nonce); pending != m_pending.end())
+        {
+            origin = pending->second;
+            if (auto binding = m_bindings.find(pending->second.FormId); binding != m_bindings.end()
+                && binding->second.Handle == pending->second.Handle)
+                binding->second.Busy = true;
+            m_pending.erase(pending);
+        }
+    }
+    if (acMessage.Action == NotifyDroppedItem::Operation::Spawn)
+    {
+        if (!acMessage.Data.Id || m_applied.count(acMessage.Data.Id))
+        {
+            if (origin)
+                DeleteReference(origin->Handle);
+            return;
+        }
+        auto& drop = m_drops[acMessage.Data.Id];
+        drop.Data = acMessage.Data;
+        if (origin && origin->Handle)
+        {
+            auto reference = TESObjectREFR::GetByHandle(origin->Handle);
+            if (reference && !reference->IsDeleted())
+            {
+                drop.Handle = origin->Handle;
+                drop.Reference = RetainReference(reference);
+                drop.IsProxy = false;
+                std::lock_guard lock(m_lock);
+                m_bindings[reference->formID] = {origin->Handle, drop.Data.Id, 0, origin->WantPick};
+            }
+        }
+        if (origin && origin->WantPick)
+            RequestClaim(drop.Data.Id, origin->WantActorForm);
+        return;
+    }
+    if (origin)
+    {
+        if (acMessage.Action == NotifyDroppedItem::Operation::Rejected)
+        {
+            // Registration failed: restore precisely the local stack that was
+            // removed, and remove its world ref. Server did not debit it.
+            ScopedInventoryOverride inventoryOverride;
+            PlayerCharacter::Get()->AddOrRemoveItem(origin->Data.Item);
+            DeleteReference(origin->Handle);
+            if (origin->InventoryAlreadyReflected)
+            {
+                if (const auto token = Utils::GetLocalOwnershipToken(0x14))
+                {
+                    InventoryChangeEvent event(0x14, origin->Data.Item);
+                    event.ServerId = token->ServerId;
+                    event.OwnershipEpoch = token->OwnershipEpoch;
+                    m_world.GetRunner().Trigger(std::move(event));
+                }
+            }
+        }
+        else if (acMessage.Action == NotifyDroppedItem::Operation::Disabled)
+        {
+            auto reference = TESObjectREFR::GetByHandle(origin->Handle);
+            if (reference)
+                reference->SetSkipSaveFlag(false);
+            if (!origin->WantPick || origin->WantActorForm != 0x14)
+            {
+                std::lock_guard lock(m_lock);
+                const auto binding = m_bindings.find(origin->FormId);
+                if (binding != m_bindings.end() && binding->second.Handle == origin->Handle)
+                    m_bindings.erase(binding);
+            }
+            if (origin->WantPick && origin->WantActorForm == 0x14)
+            {
+                {
+                    ScopedInventoryOverride inventoryOverride;
+                    PlayerCharacter::Get()->AddOrRemoveItem(origin->Data.Item);
+                }
+                DeleteReference(origin->Handle);
+                if (const auto token = Utils::GetLocalOwnershipToken(0x14))
+                {
+                    InventoryChangeEvent event(0x14, origin->Data.Item);
+                    event.ServerId = token->ServerId;
+                    event.OwnershipEpoch = token->OwnershipEpoch;
+                    m_world.GetRunner().Trigger(std::move(event));
+                }
+            }
+        }
+        else if (acMessage.Action == NotifyDroppedItem::Operation::Taken)
+            DeleteReference(origin->Handle);
+    }
+    if (acMessage.Action == NotifyDroppedItem::Operation::Taken
+        || (acMessage.Action == NotifyDroppedItem::Operation::Rejected && !acMessage.Active))
+        RemoveReference(acMessage.Data.Id);
+    if (acMessage.Action == NotifyDroppedItem::Operation::Rejected)
+    {
+        m_claims.erase(acMessage.Data.Id);
+        m_claimActors.erase(acMessage.Data.Id);
+        std::lock_guard lock(m_lock);
+        for (auto& [ref, binding] : m_bindings)
+            if (binding.Id == acMessage.Data.Id && acMessage.Active)
+                binding.Busy = false;
+    }
+}
