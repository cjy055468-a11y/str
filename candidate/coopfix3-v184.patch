+#include <Messages/NotifyDroppedItem.h>
+
+void NotifyDroppedItem::SerializeRaw(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    Serialization::WriteVarInt(aWriter, static_cast<uint8_t>(Action));
+    Serialization::WriteVarInt(aWriter, ServerSession);
+    Serialization::WriteVarInt(aWriter, Nonce);
+    Serialization::WriteVarInt(aWriter, ActorId);
+    Serialization::WriteBool(aWriter, Enabled);
+    Serialization::WriteBool(aWriter, Active);
+    Serialization::WriteBool(aWriter, Recovery);
+    Data.Serialize(aWriter);
+}
+
+void NotifyDroppedItem::DeserializeRaw(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    ServerMessage::DeserializeRaw(aReader);
+    Action = static_cast<Operation>(Serialization::ReadVarInt(aReader));
+    ServerSession = Serialization::ReadVarInt(aReader);
+    Nonce = Serialization::ReadVarInt(aReader);
+    ActorId = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+    Enabled = Serialization::ReadBool(aReader);
+    Active = Serialization::ReadBool(aReader);
+    Recovery = Serialization::ReadBool(aReader);
+    Data.Deserialize(aReader);
+}
