diff --git a/Code/client/ModCompat/MissivesLetterCompat.h b/Code/client/ModCompat/MissivesLetterCompat.h
new file mode 100644
--- /dev/null
+++ b/Code/client/ModCompat/MissivesLetterCompat.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <Games/TES.h>
+#include <Forms/TESForm.h>
+
+// Missives quests own local aliases and generated book text. Generic quest
+// sharing cannot reproduce that context on another player's client.
+namespace MissivesLetterCompat
+{
+inline bool IsPrivateForm(const TESForm* apForm) noexcept
+{
+    if (!apForm)
+        return false;
+
+    const ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    if (!pMod || !pMod->IsLoaded())
+        return false;
+
+    const uint32_t cMask = pMod->IsLite() ? 0xFFFu : 0xFFFFFFu;
+    return pMod->GetFormId(apForm->formID & cMask) == apForm->formID;
+}
+
+inline bool IsPrivateLetter(const TESForm* apForm) noexcept
+{
+    // Courier delivery letters are MISC records, not readable BOOK records.
+    // 0xBA9B is _M_MiscLetter in the supplied Missives.esp.
+    return apForm && IsPrivateForm(apForm)
+        && (apForm->formType == FormType::Book || (apForm->formID & 0xFFFFFFu) == 0xBA9Bu);
+}
+}
