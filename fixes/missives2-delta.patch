+namespace
+{
+const Mod* Plugin(const char* apName) noexcept
+{
+    auto* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName(apName) : nullptr;
+    return pMod && pMod->IsLoaded() ? pMod : nullptr;
+}
+struct AliasPrefix
+{
+    void* Vtable;
+    BSFixedString Name;
+    TESQuest* Quest;
+    uint32_t Id;
+};
+static_assert(offsetof(AliasPrefix, Id) == 0x18);
+}
+
+MissivesService::MissivesService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept
+    : m_world(aWorld), m_transport(aTransport)
+{
+    BCryptGenRandom(nullptr, reinterpret_cast<PUCHAR>(&m_nonce), sizeof(m_nonce), BCRYPT_USE_SYSTEM_PREFERRED_RNG);
+    m_connectedConnection = aDispatcher.sink<ConnectedEvent>().connect<&MissivesService::OnConnected>(this);
+    m_disconnectedConnection = aDispatcher.sink<DisconnectedEvent>().connect<&MissivesService::OnDisconnected>(this);
+    m_updateConnection = aDispatcher.sink<UpdateEvent>().connect<&MissivesService::OnUpdate>(this);
+    m_notifyConnection = aDispatcher.sink<NotifyMissives>().connect<&MissivesService::OnNotify>(this);
+}
+
+uint64_t MissivesService::ProfileToken() noexcept
+{
+    // Local character identity only. No hardware identifiers, credentials or
+    // player names are sent to the server or included in diagnostics.
+    const auto* pPlayer = PlayerCharacter::Get();
+    const char* pName = pPlayer ? pPlayer->GetName() : nullptr;
+    if (!pName || !*pName) return 0;
+    uint64_t nameHash = 14695981039346656037ULL;
+    for (const char* p = pName; *p; ++p) { nameHash ^= static_cast<uint8_t>(*p); nameHash *= 1099511628211ULL; }
+    wchar_t directory[32768]{};
+    const DWORD cLength = GetEnvironmentVariableW(L"LOCALAPPDATA", directory, 32768);
+    if (!cLength || cLength >= 32768) return 0;
+    std::filesystem::path folder = std::filesystem::path(directory) / L"SkyrimTogetherReborn" / L"Missives";
+    std::error_code error;
+    std::filesystem::create_directories(folder, error);
+    if (error) return 0;
+    const auto file = folder / (std::to_wstring(nameHash) + L".bin");
+    uint64_t token{};
+    std::ifstream input(file, std::ios::binary);
+    if (input.read(reinterpret_cast<char*>(&token), sizeof(token)) && token) return token;
+    input.close();
+    if (BCryptGenRandom(nullptr, reinterpret_cast<PUCHAR>(&token), sizeof(token), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0 || !token) return 0;
+    std::ofstream output(file, std::ios::binary | std::ios::trunc);
+    output.write(reinterpret_cast<const char*>(&token), sizeof(token));
+    output.flush();
+    return output ? token : 0;
+}
+
+const MissiveQuestSpec* MissivesService::Spec(uint32_t aRuntimeId) const noexcept
+{
+    const auto* pMod = Plugin("Missives.esp");
+    if (!pMod) return nullptr;
+    for (const auto& spec : cMissiveQuestSpecs)
+        if (pMod->GetFormId(spec.Quest) == aRuntimeId) return &spec;
+    return nullptr;
+}
+
+void MissivesService::OnConnected(const ConnectedEvent&) noexcept
+{
+    m_enabled = Plugin("Missives.esp") && Plugin("STR_Missives_Compat.esp");
+    m_hello = m_ready = m_authority = m_snapshot = false;
+    m_boards.clear();
+    m_boardQueries.clear();
+    m_generators.clear();
+    m_assigning.clear();
+    m_actorRequests.clear();
+    m_reserved.clear();
+    m_sentReservations.clear();
+    m_claims.clear();
+    if (!m_enabled) return;
+    m_token = ProfileToken();
+    MissivesBridge::SetConnection(true, false, false);
+    const auto* pMod = Plugin("Missives.esp");
+    for (const auto& spec : cMissiveQuestSpecs)
+    {
+        const uint32_t cQuest = pMod->GetFormId(spec.Quest);
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(cQuest));
+        // Existing offline missions stay personal and reserve their reusable
+        // quest slot. Available stage-zero quests are safe to canonicalize.
+        if (pQuest && !pQuest->IsStopped() && pQuest->currentStage >= 20 && pQuest->currentStage < 110 && !m_current.contains(cQuest))
+            m_personal.insert(cQuest);
+        Cache(cQuest, spec, nullptr);
+    }
+}
+
+void MissivesService::OnDisconnected(const DisconnectedEvent&) noexcept
+{
+    m_ready = m_hello = m_authority = false;
+    MissivesBridge::SetConnection(false, false, false);
+    for (const auto& [quest, id] : m_current)
+    {
+        const auto record = m_postings.find(id);
+        if (record != m_postings.end() && record->second.Mine) m_personal.insert(quest);
+    }
+    // Stop background replicas without running claimant reward fragments.
+    for (auto& [quest, context] : m_contexts)
+        if (!m_personal.contains(quest)) context->SetStage(110);
+    m_boards.clear();
+    m_claims.clear();
+}
+
+void MissivesService::Send(RequestMissives::Operation aAction, const MissivesData& acData, uint64_t aSequence) noexcept
+{
+    if (!m_token || !m_transport.IsOnline()) return;
+    RequestMissives request;
+    request.Action = aAction;
+    request.ClientSession = m_token;
+    request.ServerSession = m_server;
+    request.Sequence = aSequence;
+    request.Data = acData;
+    m_transport.Send(request);
+}
+
+void MissivesService::Cache(uint32_t aQuest, const MissiveQuestSpec& acSpec, const Posting* apPosting) noexcept
+{
+    MissivesBridge::QuestState state;
+    state.Personal = m_personal.contains(aQuest) || (apPosting && apPosting->Mine);
+    state.State = apPosting ? apPosting->State : -1;
+    state.Reserved = m_reserved.contains(aQuest) || m_personal.contains(aQuest)
+        || (apPosting && ((apPosting->State > 0 && apPosting->State < 4)
+            || (apPosting->State >= 4 && !m_terminal.contains(apPosting->Data.Id))));
+    state.PostingAlias = acSpec.PostingAlias;
+    state.BoardAlias = acSpec.BoardAlias;
+    if (apPosting)
+        if (auto* pRecipient = ResolveActor(apPosting->Recipient)) state.Recipient = pRecipient->formID;
+    MissivesBridge::SetQuest(aQuest, state);
+}
+
+uint32_t MissivesService::ActorId(TESObjectREFR* apReference) noexcept
+{
+    if (!apReference) return 0;
+    const auto view = m_world.view<FormIdComponent>();
+    for (const auto entity : view)
+        if (view.get<FormIdComponent>(entity).Id == apReference->formID)
+            if (const auto id = Utils::GetServerId(entity)) return *id;
+    const auto remote = m_world.view<RemoteComponent>();
+    for (const auto entity : remote)
+        if (remote.get<RemoteComponent>(entity).CachedRefId == apReference->formID) return remote.get<RemoteComponent>(entity).Id;
+    auto* pActor = Cast<Actor>(apReference);
+    if (pActor && !pActor->IsStillLoading() && pActor->parentCell)
+    {
+        const auto key = std::make_pair(pActor->formID, pActor->GetHandle().handle.iBits);
+        if (key.second && !m_assigning.contains(key))
+        {
+            m_assigning.insert(key);
+            // Existing discovery/assignment owns the network identity. Never
+            // create an alternative Missives-only actor identifier.
+            if (std::none_of(view.begin(), view.end(), [view, pActor](auto entity) { return view.get<FormIdComponent>(entity).Id == pActor->formID; }))
+                m_world.GetCharacterService().OnActorAdded(ActorAddedEvent(pActor->formID));
+        }
+    }
+    return 0;
+}
+
+TESObjectREFR* MissivesService::ResolveActor(uint32_t aId) noexcept
+{
+    if (!aId) return nullptr;
+    const auto entity = Utils::FindEntityByServerId(aId);
+    if (!entity) return nullptr;
+    if (const auto* pForm = m_world.try_get<FormIdComponent>(*entity))
+        return Cast<TESObjectREFR>(TESForm::GetById(pForm->Id));
+    if (const auto* pRemote = m_world.try_get<RemoteComponent>(*entity))
+        return Cast<TESObjectREFR>(TESForm::GetById(pRemote->CachedRefId));
+    return nullptr;
+}
+
+void MissivesService::CaptureGlobals(const MissiveQuestSpec& acSpec, MissivesData& aData) noexcept
+{
+    aData.Globals.clear();
+    const auto* pMod = Plugin("Missives.esp");
+    if (!pMod) return;
+    for (uint32_t i = 0; i < acSpec.GlobalCount; ++i)
+    {
+        const uint32_t cForm = pMod->GetFormId(cMissiveGlobalSpecs[acSpec.GlobalBegin + i]);
+        auto* pGlobal = Cast<TESGlobal>(TESForm::GetById(cForm));
+        MissivesGlobal entry;
+        if (pGlobal && m_world.GetModSystem().GetServerModId(cForm, entry.Id))
+        {
+            entry.Value = pGlobal->f;
+            aData.Globals.push_back(entry);
+        }
+    }
+}
+
+bool MissivesService::Capture(const MissiveQuestSpec& acSpec, TESQuest* apQuest, MissivesData& aData) noexcept
+{
+    auto& mods = m_world.GetModSystem();
+    auto* pPost = apQuest->GetAliasedRef(acSpec.PostingAlias);
+    auto* pBoard = apQuest->GetAliasedRef(acSpec.BoardAlias);
+    if (!pPost || !pPost->baseForm || !MissivesCompat::IsBoard(pBoard) || !m_boards.contains(pBoard->formID)) return false;
+    if (!mods.GetServerModId(apQuest->formID, aData.Quest) || !mods.GetServerModId(pBoard->formID, aData.Board)
+        || !mods.GetServerModId(pPost->baseForm->formID, aData.Book)) return false;
+    const uint32_t cHandle = pPost->GetHandle().handle.iBits;
+    if (!cHandle) return false;
+    auto& source = m_sources[apQuest->formID];
+    if (!source.second || source.first != cHandle) source = {cHandle, ++m_nonce};
+    aData.SourceNonce = source.second;
+    aData.Stage = apQuest->currentStage;
+    for (uint32_t i = 0; i < acSpec.AliasCount; ++i)
+    {
+        const auto& spec = cMissiveAliasSpecs[acSpec.AliasBegin + i];
+        MissivesAlias entry;
+        entry.Id = spec.Id;
+        if (spec.Location)
+        {
+            const void* pFunction = m_world.ctx().at<PapyrusService>().Get("LocationAlias", "GetLocation");
+            void* pAlias = nullptr;
+            for (void* p : apQuest->aliases) if (p && static_cast<AliasPrefix*>(p)->Id == spec.Id) pAlias = p;
+            TESForm* pLocation = pAlias && pFunction ? PapyrusFunction<TESForm*, void>(pFunction)(pAlias) : nullptr;
+            if (!pLocation) continue;
+            entry.Type = MissivesAlias::Kind::Location;
+            if (!mods.GetServerModId(pLocation->formID, entry.Form)) return false;
+        }
+        else
+        {
+            auto* pRef = apQuest->GetAliasedRef(spec.Id);
+            if (!pRef) continue;
+            void* pAlias = nullptr;
+            for (void* p : apQuest->aliases) if (p && static_cast<AliasPrefix*>(p)->Id == spec.Id) pAlias = p;
+            if (pAlias && static_cast<AliasPrefix*>(pAlias)->Name && !_stricmp(static_cast<AliasPrefix*>(pAlias)->Name.AsAscii(), "Player"))
+                entry.Type = MissivesAlias::Kind::Player;
+            else if (!pRef->IsTemporary())
+            {
+                entry.Type = MissivesAlias::Kind::Reference;
+                if (!mods.GetServerModId(pRef->formID, entry.Form)) return false;
+            }
+            else if (Cast<Actor>(pRef))
+            {
+                entry.Type = MissivesAlias::Kind::Actor;
+                entry.ActorId = ActorId(pRef);
+                if (!entry.ActorId) return false;
+            }
+            else
+            {
+                entry.Type = MissivesAlias::Kind::Item;
+                if (!pRef->baseForm || !mods.GetServerModId(pRef->baseForm->formID, entry.Base)) return false;
+            }
+        }
+        aData.Aliases.push_back(entry);
+    }
+    CaptureGlobals(acSpec, aData);
+    return true;
+}
+
+void MissivesService::PublishBoards() noexcept
+{
+    const auto* pMod = Plugin("Missives.esp");
+    if (!pMod || !m_ready || m_snapshot || m_generators.empty()) return;
+    for (const auto& spec : cMissiveQuestSpecs)
+    {
+        const uint32_t cQuest = pMod->GetFormId(spec.Quest);
+        if (m_reserved.contains(cQuest) || m_personal.contains(cQuest)) continue;
+        if (const auto current = m_current.find(cQuest); current != m_current.end())
+        {
+            const auto record = m_postings.find(current->second);
+            if (record != m_postings.end() && record->second.State < 4)
+            {
+                auto* pCurrentQuest = Cast<TESQuest>(TESForm::GetById(cQuest));
+                const uint32_t cBoard = m_world.GetModSystem().GetGameId(record->second.Data.Board);
+                if (record->second.State == 0 && m_generators.contains(cBoard)
+                    && pCurrentQuest && (pCurrentQuest->IsStopped() || pCurrentQuest->currentStage >= 110))
+                    Send(RequestMissives::Operation::Retire, record->second.Data);
+                continue;
+            }
+            if (!m_terminal.contains(current->second)) continue;
+        }
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(cQuest));
+        if (!pQuest || pQuest->IsStopped() || pQuest->currentStage >= 20) continue;
+        MissivesData data;
+        if (Capture(spec, pQuest, data) && m_generators.contains(m_world.GetModSystem().GetGameId(data.Board)))
+            Send(RequestMissives::Operation::Publish, data);
+    }
+}
+
+void MissivesService::ApplyPostings() noexcept
+{
+    const auto now = std::chrono::steady_clock::now();
+    for (const auto& [quest, id] : m_current)
+    {
+        const auto spec = Spec(quest);
+        const auto record = m_postings.find(id);
+        if (!spec || record == m_postings.end()) continue;
+        auto& post = record->second;
+        Cache(quest, *spec, &post);
+        if (m_personal.contains(quest) && !post.Mine) continue;
+        if (post.State == 0 && !m_boards.contains(m_world.GetModSystem().GetGameId(post.Data.Board)) && !m_contexts.contains(quest))
+            continue;
+        auto& context = m_contexts[quest];
+        if (context && m_contextIds[quest] != id)
+        {
+            if (!m_terminal.contains(m_contextIds[quest]))
+            {
+                context->Stop();
+                if (context->IsRunning()) continue;
+            }
+            context.reset();
+        }
+        if (m_terminal.contains(id)) continue;
+        if (!context) context = std::make_unique<MissivesContext>(*spec);
+        m_contextIds[quest] = id;
+        context->SetPersonal(post.Mine);
+        if (post.State >= 4)
+        {
+            if (context->IsRunning()) context->SetStage(110);
+            else
+            {
+                context->Stop(); // Restore pinned definitions only after cleanup.
+                m_terminal.insert(id);
+                m_personal.erase(quest);
+            }
+            continue;
+        }
+        if (post.Recipient && !ResolveActor(post.Recipient) && now >= m_actorRequests[post.Recipient])
+        {
+            MissivesData request = post.Data;
+            request.Stage = post.Recipient;
+            Send(RequestMissives::Operation::Actor, request);
+            m_actorRequests[post.Recipient] = now + 2s;
+        }
+        for (const auto& alias : post.Data.Aliases)
+            if (alias.Type == MissivesAlias::Kind::Actor && !ResolveActor(alias.ActorId) && now >= m_actorRequests[alias.ActorId])
+            {
+                MissivesData request = post.Data;
+                request.Stage = alias.ActorId;
+                Send(RequestMissives::Operation::Actor, request);
+                m_actorRequests[alias.ActorId] = now + 2s;
+            }
+        const auto source = m_sources.find(quest);
+        const bool cSource = source != m_sources.end() && source->second.second == post.Data.SourceNonce;
+        if (!post.Applied)
+            post.Applied = context->Apply(post.Data, cSource, post.Recipient, [this](uint32_t actor) { return ResolveActor(actor); });
+        if (!post.Applied) continue;
+        context->RebindPlayer(post.Recipient, [this](uint32_t actor) { return ResolveActor(actor); });
+        if (post.State == 2 || post.State == 3) context->SetStage(static_cast<uint16_t>(post.Data.Stage));
+        if (m_claims.contains(quest) && post.State == 0)
+        {
+            Send(RequestMissives::Operation::Claim, post.Data);
+            post.State = 1;
+            Cache(quest, *spec, &post);
+        }
+    }
+}
+
+void MissivesService::OnUpdate(const UpdateEvent&) noexcept
+{
+    if (!m_enabled) return;
+    if (!m_transport.IsOnline())
+    {
+        for (auto& [quest, context] : m_contexts)
+            if (!m_personal.contains(quest) && !context->IsRunning()) context->Stop();
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now < m_next) return;
+    m_next = now + 200ms;
+    const auto& papyrus = m_world.ctx().at<PapyrusService>();
+    if (!m_hello)
+    {
+        if (!m_token || !MissivesBridge::SawScript() || !papyrus.Get("ReferenceAlias", "ForceRefTo")) return;
+        if (!ActorId(PlayerCharacter::Get())) return;
+        Send(RequestMissives::Operation::Hello);
+        m_hello = true;
+    }
+    for (const auto& event : MissivesBridge::Drain())
+    {
+        using O = MissivesBridge::Operation;
+        if (event.Action == O::Open)
+        {
+            if (MissivesCompat::IsBoard(Cast<TESObjectREFR>(TESForm::GetById(event.Id)))) m_boards.insert(event.Id);
+            continue;
+        }
+        if (event.Action == O::Close)
+        {
+            m_boards.erase(event.Id);
+            m_boardQueries.erase(event.Id);
+            MissivesData data;
+            if (m_ready && m_world.GetModSystem().GetServerModId(event.Id, data.Board)) Send(RequestMissives::Operation::CloseBoard, data);
+            continue;
+        }
+        if (event.Action == O::Changed) continue;
+        const auto* pSpec = Spec(event.Id);
+        if (!pSpec) continue;
+        if (event.Action == O::Claim) m_claims.insert(event.Id);
+        const auto current = m_current.find(event.Id);
+        if (current == m_current.end()) continue;
+        const auto found = m_postings.find(current->second);
+        if (found == m_postings.end()) continue;
+        auto& post = found->second;
+        if (event.Action == O::Stage && post.Mine)
+        {
+            post.Data.Stage = event.Value;
+            CaptureGlobals(*pSpec, post.Data);
+            Send(event.Value >= 110 ? RequestMissives::Operation::Complete : RequestMissives::Operation::Progress, post.Data, ++post.Sequence);
+        }
+    }
+    if (!m_ready || m_snapshot) return;
+    for (uint32_t board : m_boards)
+        if (!m_boardQueries.contains(board))
+        {
+            MissivesData data;
+            if (m_world.GetModSystem().GetServerModId(board, data.Board))
+            {
+                Send(RequestMissives::Operation::OpenBoard, data);
+                m_boardQueries.insert(board);
+            }
+        }
+    std::vector<uint32_t> released;
+    for (const uint32_t quest : m_personal)
+    {
+        MissivesData data;
+        if (m_current.contains(quest)) continue;
+        if (m_world.GetModSystem().GetServerModId(quest, data.Quest))
+        {
+            auto* pQuest = Cast<TESQuest>(TESForm::GetById(quest));
+            const bool cRunning = pQuest && !pQuest->IsStopped() && pQuest->currentStage < 110;
+            if (cRunning && !m_sentReservations.contains(quest))
+            {
+                Send(RequestMissives::Operation::Reserve, data);
+                m_sentReservations.insert(quest);
+            }
+            else if (!cRunning)
+            {
+                if (m_sentReservations.erase(quest)) Send(RequestMissives::Operation::ReleaseReserve, data);
+                released.push_back(quest);
+            }
+        }
+    }
+    for (uint32_t quest : released) m_personal.erase(quest);
+    if (const auto* pMod = Plugin("Missives.esp"))
+        for (const auto& spec : cMissiveQuestSpecs)
+        {
+            const uint32_t cQuest = pMod->GetFormId(spec.Quest);
+            if (!m_current.contains(cQuest)) Cache(cQuest, spec, nullptr);
+        }
+    PublishBoards();
+    ApplyPostings();
+}
+
+void MissivesService::OnNotify(const NotifyMissives& acMessage) noexcept
+{
+    using O = NotifyMissives::Operation;
+    if (!m_enabled || !acMessage.Data.Valid || !acMessage.ServerSession) return;
+    if (acMessage.Action == O::Ready)
+    {
+        if (m_server && m_server != acMessage.ServerSession)
+        {
+            m_current.clear();
+            m_postings.clear();
+            m_sources.clear();
+            m_terminal.clear();
+        }
+        m_server = acMessage.ServerSession;
+        m_ready = true;
+    }
+    if (acMessage.ServerSession != m_server) return;
+    if (acMessage.Action == O::BoardControl)
+    {
+        const uint32_t cBoard = m_world.GetModSystem().GetGameId(acMessage.Data.Board);
+        if (acMessage.Authority) m_generators.insert(cBoard);
+        else m_generators.erase(cBoard);
+        MissivesBridge::SetBoardAuthority(cBoard, acMessage.Authority);
+        return;
+    }
+    if (acMessage.Action == O::Ready || acMessage.Action == O::SnapshotBegin)
+        m_authority = acMessage.Authority;
+    MissivesBridge::SetConnection(true, m_ready, m_authority);
+    if (acMessage.Action == O::SnapshotBegin) { m_snapshot = true; m_reserved.clear(); return; }
+    if (acMessage.Action == O::SnapshotEnd) { m_snapshot = false; return; }
+    const uint32_t cQuest = m_world.GetModSystem().GetGameId(acMessage.Data.Quest);
+    const auto* pSpec = Spec(cQuest);
+    if (!pSpec) return;
+    if (acMessage.Action == O::Reserved) { m_reserved.insert(cQuest); return; }
+    if (acMessage.Action == O::Unreserved) { m_reserved.erase(cQuest); return; }
+    if (!acMessage.Data.Id) return;
+    if (acMessage.Action == O::Rejected)
+    {
+        m_claims.erase(cQuest);
+        Send(RequestMissives::Operation::Snapshot);
+        return;
+    }
+    auto& post = m_postings[acMessage.Data.Id];
+    post.Data = acMessage.Data;
+    post.Mine = acMessage.Mine;
+    post.Sequence = std::max(post.Sequence, acMessage.Sequence);
+    post.Recipient = acMessage.RecipientActor;
+    post.State = acMessage.Action == O::Posting ? 0 : acMessage.Action == O::Retired ? 4 : acMessage.Action == O::Complete ? 5 : post.Mine ? 2 : 3;
+    post.Applied = false;
+    const auto current = m_current.find(cQuest);
+    if (current != m_current.end() && acMessage.Data.Id < current->second) return;
+    if (current == m_current.end() || acMessage.Data.Id >= current->second) m_current[cQuest] = acMessage.Data.Id;
+    if (post.State >= 2) m_claims.erase(cQuest);
+    Cache(cQuest, *pSpec, &post);
+}
