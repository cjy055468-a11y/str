diff --git a/Code/client/ModCompat/MissivesBridge.cpp b/Code/client/ModCompat/MissivesBridge.cpp
new file mode 100644
--- /dev/null
+++ b/Code/client/ModCompat/MissivesBridge.cpp
@@ -0,0 +1,140 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/MissivesBridge.h>
+#include <Misc/BSScript.h>
+#include <set>
+
+namespace
+{
+std::mutex s_lock;
+bool s_connected{};
+bool s_ready{};
+bool s_authority{};
+bool s_sawScript{};
+std::map<uint32_t, MissivesBridge::QuestState> s_quests;
+std::vector<MissivesBridge::Event> s_events;
+std::set<uint32_t> s_boards;
+}
+
+void MissivesBridge::SetConnection(bool aConnected, bool aReady, bool aAuthority) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_connected = aConnected;
+    s_ready = aReady;
+    s_authority = aAuthority;
+    if (!aConnected) s_boards.clear();
+}
+void MissivesBridge::SetBoardAuthority(uint32_t aBoard, bool aAuthority) noexcept
+{
+    std::lock_guard lock(s_lock);
+    if (aAuthority) s_boards.insert(aBoard);
+    else s_boards.erase(aBoard);
+}
+void MissivesBridge::SetQuest(uint32_t aId, const QuestState& acState) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_quests[aId] = acState;
+}
+void MissivesBridge::RemoveQuest(uint32_t aId) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_quests.erase(aId);
+}
+bool MissivesBridge::SawScript() noexcept
+{
+    std::lock_guard lock(s_lock);
+    return s_sawScript;
+}
+std::vector<MissivesBridge::Event> MissivesBridge::Drain() noexcept
+{
+    std::lock_guard lock(s_lock);
+    std::vector<Event> result;
+    result.swap(s_events);
+    return result;
+}
+int32_t MissivesBridge::Call(Operation aOperation, uint32_t aId, uint32_t aValue) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_sawScript = true;
+    const auto it = s_quests.find(aId);
+    switch (aOperation)
+    {
+    case Operation::Connected: return s_connected;
+    case Operation::Authority: return s_ready && !s_boards.empty();
+    case Operation::CanGenerate: return s_ready && s_boards.contains(aValue) && (it == s_quests.end() || !it->second.Reserved);
+    case Operation::Personal: return it == s_quests.end() ? !s_connected : it->second.Personal;
+    case Operation::State: return it == s_quests.end() ? -1 : it->second.State;
+    case Operation::PostingAlias: return it == s_quests.end() ? -1 : static_cast<int32_t>(it->second.PostingAlias);
+    case Operation::BoardAlias: return it == s_quests.end() ? -1 : static_cast<int32_t>(it->second.BoardAlias);
+    case Operation::Recipient: return it == s_quests.end() ? 0 : static_cast<int32_t>(it->second.Recipient);
+    default: break;
+    }
+    if (!s_connected) return 0;
+    if (aOperation == Operation::Claim)
+    {
+        if (it == s_quests.end()) { s_events.push_back({aOperation, aId, aValue}); return 1; }
+        if (it->second.State == 0) it->second.State = 1;
+    }
+    if (aOperation == Operation::Stage && (it == s_quests.end() || !it->second.Personal)) return 0;
+    s_events.push_back({aOperation, aId, aValue});
+    return 1;
+}
+
+namespace
+{
+void NativeCallbackMarker() {}
+class BridgeFunction final : public BSScript::NativeFunction
+{
+public:
+    BridgeFunction(const char* apName, MissivesBridge::Operation aOperation, uint32_t aArguments, BSScript::Variable::Type aResult)
+        : NativeFunction(apName, "STRMissivesBridge", true, aArguments), m_operation(aOperation), m_arguments(aArguments), m_result(aResult)
+    {
+        pFunction = reinterpret_cast<void*>(&NativeCallbackMarker);
+        returnType = aResult;
+        for (uint32_t i = 0; i < aArguments; ++i) parameters.data[i].type = BSScript::Variable::kInteger;
+        SetCallableFromTasklets(false);
+    }
+    bool MarshallAndDispatch(BSScript::Variable*, BSScript::IVirtualMachine*, uint32_t, BSScript::Variable* apResult, BSScript::StackFrame* apFrame) override
+    {
+        uint32_t values[2]{};
+        if (m_arguments)
+        {
+            const uint32_t cPage = apFrame->GetPageForFrame();
+            for (uint32_t i = 0; i < m_arguments; ++i)
+            {
+                auto* pArgument = apFrame->GetStackFrameVariable(i, cPage);
+                if (!pArgument || pArgument->type != BSScript::Variable::kInteger) return false;
+                values[i] = static_cast<uint32_t>(pArgument->data.i);
+            }
+        }
+        const int32_t cResult = MissivesBridge::Call(m_operation, values[0], values[1]);
+        if (m_result == BSScript::Variable::kBoolean) apResult->Set<bool>(cResult != 0);
+        else if (m_result == BSScript::Variable::kInteger) apResult->Set<int32_t>(cResult);
+        else apResult->Clear();
+        return true;
+    }
+private:
+    MissivesBridge::Operation m_operation;
+    uint32_t m_arguments;
+    BSScript::Variable::Type m_result;
+};
+}
+
+// Called from the existing native-registration hook. VM callbacks only read
+// the mutex-protected cache or enqueue IDs; all engine work stays on Update.
+void RegisterMissivesBridge(BSScript::IVirtualMachine* apVm) noexcept
+{
+    using O = MissivesBridge::Operation;
+    using V = BSScript::Variable;
+    struct Binding { const char* Name; O Operation; uint32_t Arguments; V::Type Result; };
+    const Binding bindings[] = {
+        {"IsConnected",O::Connected,0,V::kBoolean},{"IsAuthority",O::Authority,0,V::kBoolean},
+        {"CanGenerate",O::CanGenerate,2,V::kBoolean},{"IsPersonalQuest",O::Personal,1,V::kBoolean},
+        {"Claim",O::Claim,1,V::kBoolean},{"StageChanged",O::Stage,2,V::kEmpty},
+        {"OpenBoard",O::Open,2,V::kEmpty},{"CloseBoard",O::Close,1,V::kEmpty},
+        {"GetPostingState",O::State,1,V::kInteger},{"GetPostingAlias",O::PostingAlias,1,V::kInteger},
+        {"GetBoardAlias",O::BoardAlias,1,V::kInteger},{"GetRecipient",O::Recipient,1,V::kInteger},
+        {"Released",O::Released,1,V::kEmpty},{"BoardChanged",O::Changed,1,V::kEmpty}
+    };
+    for (const auto& binding : bindings)
+        apVm->BindNativeMethod(new BridgeFunction(binding.Name, binding.Operation, binding.Arguments, binding.Result));
+}
