+#pragma once
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <vector>
+
+struct BSScript;
+namespace MissivesBridge
+{
+enum class Operation { Connected, Authority, CanGenerate, Personal, Claim, Stage, Open, Close, State, PostingAlias, BoardAlias, Recipient, Released, Changed };
+struct Event { Operation Action; uint32_t Id; uint32_t Value; };
+struct QuestState
+{
+    int32_t State{-1};
+    bool Personal{true};
+    bool Reserved{};
+    uint32_t PostingAlias{};
+    uint32_t BoardAlias{};
+    uint32_t Recipient{};
+};
+void SetConnection(bool aConnected, bool aReady, bool aAuthority) noexcept;
+void SetQuest(uint32_t aId, const QuestState& acState) noexcept;
+void RemoveQuest(uint32_t aId) noexcept;
+void SetBoardAuthority(uint32_t aBoard, bool aAuthority) noexcept;
+bool SawScript() noexcept;
+std::vector<Event> Drain() noexcept;
+int32_t Call(Operation aOperation, uint32_t aId, uint32_t aValue) noexcept;
+}
diff --git a/Code/client/ModCompat/MissivesCompat.cpp b/Code/client/ModCompat/MissivesCompat.cpp
new file mode 100644
--- /dev/null
+++ b/Code/client/ModCompat/MissivesCompat.cpp
@@ -0,0 +1,94 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/MissivesCompat.h>
+#include <ModCompat/MissivesPostingAliases.h>
+#include <Forms/TESQuest.h>
+#include <ExtraData/ExtraTextDisplayData.h>
+#include <ExtraData/ExtraDataList.h>
+
+namespace
+{
+// CommonLibSSE-NG ExtraAliasInstanceArray/BGSRefAliasInstanceData source
+// layouts. Read only, under the engine's own alias-array read lock.
+struct AliasOwnerView
+{
+    TESQuest* pQuest;
+    const void* pAlias;
+    const void* pPackages;
+};
+struct AliasArrayView : BSExtraData
+{
+    GameArray<AliasOwnerView*> Aliases;
+    BSReadWriteLock Lock;
+};
+static_assert(sizeof(AliasOwnerView) == 0x18);
+static_assert(offsetof(AliasArrayView, Aliases) == 0x10);
+static_assert(offsetof(AliasArrayView, Lock) == 0x28);
+static_assert(sizeof(AliasArrayView) == 0x30);
+
+struct AliasReadGuard
+{
+    explicit AliasReadGuard(BSReadWriteLock& aLock) noexcept : Lock(aLock)
+    {
+        TP_THIS_FUNCTION(TLock, void, BSReadWriteLock);
+        POINTER_SKYRIMSE(TLock, s_lock, 68233);
+        TiltedPhoques::ThisCall(s_lock, &Lock);
+    }
+    ~AliasReadGuard() noexcept
+    {
+        TP_THIS_FUNCTION(TUnlock, void, BSReadWriteLock);
+        POINTER_SKYRIMSE(TUnlock, s_unlock, 68239);
+        TiltedPhoques::ThisCall(s_unlock, &Lock);
+    }
+    BSReadWriteLock& Lock;
+};
+}
+
+bool MissivesCompat::IsPersonalQuestData(ExtraDataList* apExtraData) noexcept
+{
+    if (!apExtraData)
+        return false;
+    const auto* pText = Cast<ExtraTextDisplayData>(apExtraData->GetByType(ExtraDataType::TextDisplayData));
+    if (pText && IsPluginForm(pText->pOwnerQuest))
+        return true;
+    auto* pAliases = reinterpret_cast<AliasArrayView*>(apExtraData->GetByType(ExtraDataType::AliasInstanceArray));
+    if (!pAliases)
+        return false;
+    AliasReadGuard guard(pAliases->Lock);
+    for (const auto* pOwner : pAliases->Aliases)
+        if (pOwner && IsPluginForm(pOwner->pQuest))
+            return true;
+    return false;
+}
+
+void MissivesCompat::AuditBoard(TESObjectREFR* apBoard, const char* apReason) noexcept
+{
+    if (!IsBoard(apBoard))
+        return;
+
+    const auto inventory = apBoard->GetInventory();
+    spdlog::info("STR Missives board audit: reason {}, board {:X}, entries {}", apReason, apBoard->formID, inventory.Entries.size());
+    for (const auto& item : inventory.Entries)
+        spdlog::info("STR Missives board entry: board {:X}, base {:X}:{:X}, count {}, quest {}",
+            apBoard->formID, item.BaseId.ModId, item.BaseId.BaseId, item.Count, item.IsQuestItem);
+
+    const Mod* pMod = ModManager::Get()->GetByName("Missives.esp");
+    if (!pMod)
+        return;
+
+    for (const auto& entry : cPostingAliases)
+    {
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(pMod->GetFormId(entry.QuestId)));
+        if (!pQuest || pQuest->IsStopped())
+            continue;
+        const auto* pQuestBoard = pQuest->GetAliasedRef(entry.BoardAlias);
+        if (!pQuestBoard || pQuestBoard->formID != apBoard->formID)
+            continue;
+
+        auto* pPosting = pQuest->GetAliasedRef(entry.PostingAlias);
+        const auto* pText = pPosting ? Cast<ExtraTextDisplayData>(pPosting->extraData.GetByType(ExtraDataType::TextDisplayData)) : nullptr;
+        spdlog::info("STR Missives local posting: board {:X}, quest {:X}, instance {}, stage {}, alias {}, reference {:X}, base {:X}, text_context {}, text_quest_matches {}, text_instance {}",
+            apBoard->formID, pQuest->formID, pQuest->currentInstanceID, pQuest->currentStage, entry.PostingAlias,
+            pPosting ? pPosting->formID : 0, pPosting && pPosting->baseForm ? pPosting->baseForm->formID : 0,
+            pText != nullptr, pText && pText->pOwnerQuest == pQuest, pText ? pText->iOwnerInstance : -1);
+    }
+}
diff --git a/Code/client/ModCompat/MissivesCompat.h b/Code/client/ModCompat/MissivesCompat.h
new file mode 100644
--- /dev/null
+++ b/Code/client/ModCompat/MissivesCompat.h
@@ -0,0 +1,72 @@
+#pragma once
+
+#include <Games/TES.h>
+#include <Forms/TESForm.h>
+#include <TESObjectREFR.h>
+#include <algorithm>
+#include <array>
+
+// Records verified against the supplied original and CHS Missives 2.03 ESPs.
+// These helpers do not alter ordinary books, containers or quest loot.
+namespace MissivesCompat
+{
+void AuditBoard(TESObjectREFR* apBoard, const char* apReason) noexcept;
+bool IsPersonalQuestData(ExtraDataList* apExtraData) noexcept;
+inline bool HasBoardPatch() noexcept
+{
+    ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("STR_Missives_Compat.esp") : nullptr;
+    return pMod && pMod->IsLoaded();
+}
+
+inline bool IsPluginForm(const TESForm* apForm) noexcept
+{
+    if (!apForm)
+        return false;
+    ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    return pMod && pMod->IsLoaded() && !pMod->IsLite()
+        && pMod->GetFormId(apForm->formID & 0xFFFFFFu) == apForm->formID;
+}
+
+inline bool IsPosting(const TESForm* apForm) noexcept
+{
+    if (!apForm || apForm->formType != FormType::Book)
+        return false;
+    static constexpr std::array<uint32_t, 26> cPostingIds = {
+        0x001D98u, // _M_MissiveKillAnimal
+        0x00332Fu, // _M_MissiveGatherIngrLow
+        0x003330u, // _M_MissiveGatherIngrMed
+        0x003331u, // _M_MissiveGatherIngrHigh
+        0x006E74u, // _M_MissiveRetrieveWilderness
+        0x008ED4u, // _M_MissiveGatherOreLow
+        0x008ED5u, // _M_MissiveGatherOreMed
+        0x008ED6u, // _M_MissiveGatherOreHigh
+        0x009A16u, // _M_MissiveGatherInn
+        0x009F90u, // _M_MissiveGatherSoulGemLow
+        0x009F91u, // _M_MissiveGatherSoulGemMed
+        0x009F92u, // _M_MissiveGatherSoulGemHigh
+        0x00B533u, // _M_MissiveRetrieveHideout
+        0x00B534u, // _M_MissiveRetrieveRuins
+        0x00B537u, // _M_MissiveGatherOreVeryHigh
+        0x00BA9Cu, // _M_MissiveCourierLetter
+        0x00BA9Du, // _M_MissiveCourierWeapon
+        0x00F0C5u, // _M_MissiveKillBandit
+        0x00F0C6u, // _M_MissiveKillGiant
+        0x00F0C7u, // _M_MissiveKillDragon
+        0x00F0D0u, // _M_MissiveKillForsworn
+        0x0331A6u, // _M_MissiveTrackThief
+        0x0331A7u, // _M_MissiveTrackVampire
+        0x0331A8u, // _M_MissiveTrackFugitive
+        0x0331A9u, // _M_MissiveKillWerewolves
+        0x0398A4u, // _M_MissiveCourierPotion
+    };
+    return std::find(cPostingIds.begin(), cPostingIds.end(), apForm->formID & 0xFFFFFFu) != cPostingIds.end() && IsPluginForm(apForm);
+}
+
+inline bool IsBoard(const TESObjectREFR* apReference) noexcept
+{
+    return apReference && apReference->baseForm && apReference->baseForm->formType == FormType::Container
+        && (apReference->baseForm->formID & 0xFFFFFFu) == 0x12CBu && IsPluginForm(apReference->baseForm);
+}
+}
