diff --git a/Code/encoding/Structs/MissivesData.cpp b/Code/encoding/Structs/MissivesData.cpp
new file mode 100644
--- /dev/null
+++ b/Code/encoding/Structs/MissivesData.cpp
@@ -0,0 +1,75 @@
+#include <Structs/MissivesData.h>
+#include <cmath>
+#include <TiltedCore/Serialization.hpp>
+using TiltedPhoques::Serialization;
+
+void MissivesAlias::Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    Serialization::WriteVarInt(aWriter, Id);
+    Serialization::WriteVarInt(aWriter, static_cast<uint8_t>(Type));
+    Form.Serialize(aWriter);
+    Base.Serialize(aWriter);
+    Serialization::WriteVarInt(aWriter, ActorId);
+    Serialization::WriteVarInt(aWriter, Count);
+}
+void MissivesAlias::Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    Id = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+    const uint64_t cType = Serialization::ReadVarInt(aReader);
+    Type = static_cast<Kind>(cType <= static_cast<uint64_t>(Kind::Actor) ? cType : 255);
+    Form.Deserialize(aReader);
+    Base.Deserialize(aReader);
+    ActorId = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+    Count = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+}
+void MissivesGlobal::Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    Id.Serialize(aWriter);
+    Serialization::WriteFloat(aWriter, Value);
+}
+void MissivesGlobal::Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    Id.Deserialize(aReader);
+    Value = Serialization::ReadFloat(aReader);
+}
+void MissivesData::Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    Serialization::WriteVarInt(aWriter, Id);
+    Serialization::WriteVarInt(aWriter, SourceNonce);
+    Board.Serialize(aWriter);
+    Quest.Serialize(aWriter);
+    Book.Serialize(aWriter);
+    Serialization::WriteVarInt(aWriter, Stage);
+    Serialization::WriteVarInt(aWriter, Aliases.size());
+    for (const auto& alias : Aliases) alias.Serialize(aWriter);
+    Serialization::WriteVarInt(aWriter, Globals.size());
+    for (const auto& global : Globals) global.Serialize(aWriter);
+}
+void MissivesData::Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    Valid = true;
+    Id = Serialization::ReadVarInt(aReader);
+    SourceNonce = Serialization::ReadVarInt(aReader);
+    Board.Deserialize(aReader);
+    Quest.Deserialize(aReader);
+    Book.Deserialize(aReader);
+    Stage = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+    Aliases.clear();
+    Globals.clear();
+    const uint64_t cAliases = Serialization::ReadVarInt(aReader);
+    if (cAliases > 64) { Valid = false; return; }
+    for (uint64_t i = 0; i < cAliases; ++i)
+    {
+        auto& alias = Aliases.emplace_back();
+        alias.Deserialize(aReader);
+        if (alias.Type > MissivesAlias::Kind::Actor || alias.Count <= 0 || alias.Count > 10000) Valid = false;
+    }
+    const uint64_t cGlobals = Serialization::ReadVarInt(aReader);
+    if (cGlobals > 32) { Valid = false; return; }
+    for (uint64_t i = 0; i < cGlobals; ++i)
+    {
+        auto& global = Globals.emplace_back();
+        global.Deserialize(aReader);
+        if (!std::isfinite(global.Value)) Valid = false;
+    }
+}
diff --git a/Code/encoding/Structs/MissivesData.h b/Code/encoding/Structs/MissivesData.h
new file mode 100644
--- /dev/null
+++ b/Code/encoding/Structs/MissivesData.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <Structs/GameId.h>
+#include <Structs/Vector3_NetQuantize.h>
+#include <Structs/Rotator2_NetQuantize.h>
+
+struct MissivesAlias
+{
+    enum class Kind : uint8_t { Reference, Location, Player, Item, Actor };
+    uint32_t Id{};
+    Kind Type{Kind::Reference};
+    GameId Form{};
+    GameId Base{};
+    uint32_t ActorId{};
+    int32_t Count{1};
+    void Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept;
+    void Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept;
+};
+
+struct MissivesGlobal
+{
+    GameId Id{};
+    float Value{};
+    void Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept;
+    void Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept;
+};
+
+struct MissivesData
+{
+    uint64_t Id{};
+    uint64_t SourceNonce{};
+    GameId Board{};
+    GameId Quest{};
+    GameId Book{};
+    uint32_t Stage{};
+    TiltedPhoques::Vector<MissivesAlias> Aliases;
+    TiltedPhoques::Vector<MissivesGlobal> Globals;
+    bool Valid{true};
+    void Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept;
+    void Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept;
+};
diff --git a/Code/server/Game/Inventory/MissivesLedger.h b/Code/server/Game/Inventory/MissivesLedger.h
new file mode 100644
--- /dev/null
+++ b/Code/server/Game/Inventory/MissivesLedger.h
@@ -0,0 +1,191 @@
+#pragma once
+#include <Structs/MissivesData.h>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <tuple>
+#include <vector>
+
+// Server-owned posting lifetimes. Tokens are private process/profile identities;
+// only the service translates ownership into a recipient-specific notification.
+class MissivesLedger
+{
+public:
+    enum class State { Available, Claimed, Retired, Completed };
+    struct Record
+    {
+        uint64_t Scope{};
+        uint64_t Publisher{};
+        uint64_t Owner{};
+        uint64_t ProgressSequence{};
+        uint32_t RecipientActor{};
+        State Status{State::Available};
+        MissivesData Data;
+    };
+    enum class ClaimResult { Won, AlreadyOwned, Unavailable };
+
+    void SetBoardAuthority(uint64_t aScope, const GameId& acBoard, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        m_boardAuthorities[{aScope, acBoard.LogFormat()}] = aToken;
+    }
+    uint64_t GetBoardAuthority(uint64_t aScope, const GameId& acBoard) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_boardAuthorities.find({aScope, acBoard.LogFormat()});
+        return it == m_boardAuthorities.end() ? 0 : it->second;
+    }
+
+    void SetAuthority(uint64_t aScope, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        m_authorities[aScope] = aToken;
+    }
+    uint64_t GetAuthority(uint64_t aScope) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_authorities.find(aScope);
+        return it == m_authorities.end() ? 0 : it->second;
+    }
+    std::optional<Record> Publish(uint64_t aScope, uint64_t aToken, const MissivesData& acData) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto board = m_boardAuthorities.find({aScope, acData.Board.LogFormat()});
+        const uint64_t cAuthority = board != m_boardAuthorities.end() ? board->second : m_authorities[aScope];
+        if (!aToken || cAuthority != aToken || !acData.Valid || !acData.SourceNonce || !acData.Board || !acData.Quest || !acData.Book)
+            return std::nullopt;
+        const auto creation = std::make_tuple(aScope, aToken, acData.SourceNonce);
+        if (const auto old = m_creations.find(creation); old != m_creations.end())
+            return m_records.find(old->second)->second;
+        const auto key = std::make_pair(aScope, acData.Quest.LogFormat());
+        if (const auto current = m_slots.find(key); current != m_slots.end())
+        {
+            const auto& record = m_records.find(current->second)->second;
+            if (record.Publisher == aToken && record.Data.SourceNonce == acData.SourceNonce && record.Status == State::Available)
+                return record;
+            return std::nullopt;
+        }
+        if (const auto reserve = m_reservations.find(key); reserve != m_reservations.end() && !reserve->second.empty())
+            return std::nullopt;
+        Record record;
+        record.Scope = aScope;
+        record.Publisher = aToken;
+        record.Data = acData;
+        record.Data.Id = ++m_nextId;
+        m_records.emplace(record.Data.Id, record);
+        m_creations.emplace(creation, record.Data.Id);
+        m_slots.emplace(key, record.Data.Id);
+        return record;
+    }
+    ClaimResult Claim(uint64_t aScope, uint64_t aId, uint64_t aToken, uint32_t aActor) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (!aToken || !aActor || it == m_records.end() || it->second.Scope != aScope)
+            return ClaimResult::Unavailable;
+        auto& record = it->second;
+        if (record.Status == State::Claimed && record.Owner == aToken)
+        {
+            record.RecipientActor = aActor;
+            return ClaimResult::AlreadyOwned;
+        }
+        if (record.Status != State::Available)
+            return ClaimResult::Unavailable;
+        record.Status = State::Claimed;
+        record.Owner = aToken;
+        record.RecipientActor = aActor;
+        record.Data.Stage = 20;
+        return ClaimResult::Won;
+    }
+    bool Retire(uint64_t aScope, uint64_t aId, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (it == m_records.end()) return false;
+        const auto board = m_boardAuthorities.find({aScope, it->second.Data.Board.LogFormat()});
+        const uint64_t cAuthority = board != m_boardAuthorities.end() ? board->second : m_authorities[aScope];
+        if (cAuthority != aToken || it->second.Scope != aScope || it->second.Status != State::Available)
+            return false;
+        it->second.Status = State::Retired;
+        m_slots.erase({aScope, it->second.Data.Quest.LogFormat()});
+        return true;
+    }
+    bool Progress(uint64_t aScope, uint64_t aId, uint64_t aToken, uint64_t aSequence, const MissivesData& acData) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (!acData.Valid || !aSequence || it == m_records.end()) return false;
+        auto& record = it->second;
+        if (record.Scope != aScope || record.Status != State::Claimed || record.Owner != aToken || aSequence <= record.ProgressSequence || acData.Stage > 65535)
+            return false;
+        record.ProgressSequence = aSequence;
+        record.Data.Stage = acData.Stage;
+        record.Data.Globals = acData.Globals;
+        return true;
+    }
+    bool Complete(uint64_t aScope, uint64_t aId, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (it == m_records.end()) return false;
+        auto& record = it->second;
+        if (record.Scope != aScope || record.Status != State::Claimed || record.Owner != aToken) return false;
+        record.Status = State::Completed;
+        record.Data.Stage = 110;
+        m_slots.erase({aScope, record.Data.Quest.LogFormat()});
+        return true;
+    }
+    bool Reserve(uint64_t aScope, const GameId& acQuest, uint64_t aToken, bool aSet) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto key = std::make_pair(aScope, acQuest.LogFormat());
+        if (!aToken || !acQuest || (aSet && m_slots.contains(key))) return false;
+        if (aSet) m_reservations[key].insert(aToken);
+        else if (auto it = m_reservations.find(key); it != m_reservations.end())
+        {
+            it->second.erase(aToken);
+            if (it->second.empty()) m_reservations.erase(it);
+        }
+        return true;
+    }
+    std::vector<GameId> Reserved(uint64_t aScope) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<GameId> result;
+        for (const auto& [key, owners] : m_reservations)
+            if (key.first == aScope && !owners.empty()) result.emplace_back(static_cast<uint32_t>(key.second >> 32), static_cast<uint32_t>(key.second));
+        for (const auto& [id, record] : m_records)
+            if (record.Scope == aScope && record.Status == State::Claimed) result.push_back(record.Data.Quest);
+        return result;
+    }
+    std::optional<Record> Get(uint64_t aScope, uint64_t aId) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() || it->second.Scope != aScope ? std::nullopt : std::optional<Record>(it->second);
+    }
+    std::optional<Record> Find(uint64_t aId) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() ? std::nullopt : std::optional<Record>(it->second);
+    }
+    std::vector<Record> Snapshot(uint64_t aScope) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> result;
+        for (const auto& [id, record] : m_records)
+            if (record.Scope == aScope) result.push_back(record);
+        return result;
+    }
+private:
+    mutable std::mutex m_lock;
+    uint64_t m_nextId{};
+    std::map<uint64_t, uint64_t> m_authorities;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_boardAuthorities;
+    std::map<uint64_t, Record> m_records;
+    std::map<std::tuple<uint64_t, uint64_t, uint64_t>, uint64_t> m_creations;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_slots;
+    std::map<std::pair<uint64_t, uint64_t>, std::set<uint64_t>> m_reservations;
+};
diff --git a/Code/server/Services/MissivesService.cpp b/Code/server/Services/MissivesService.cpp
new file mode 100644
--- /dev/null
+++ b/Code/server/Services/MissivesService.cpp
@@ -0,0 +1,278 @@
+#include <Services/MissivesService.h>
+#include <Services/CharacterService.h>
+#include <Services/PartyService.h>
+#include <Events/PlayerLeaveEvent.h>
+#include <Messages/CharacterSpawnRequest.h>
+#include <World.h>
+#include <Game/Player.h>
+#include <Game/PlayerManager.h>
+#include <Components.h>
+
+MissivesService::MissivesService(World& aWorld, entt::dispatcher& aDispatcher) noexcept
+    : m_world(aWorld), m_session(static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count()) | 1ULL)
+{
+    m_requestConnection = aDispatcher.sink<PacketEvent<RequestMissives>>().connect<&MissivesService::OnRequest>(this);
+    m_leaveConnection = aDispatcher.sink<PlayerLeaveEvent>().connect<&MissivesService::OnLeave>(this);
+}
+
+uint64_t MissivesService::GetScope(Player* apPlayer) const noexcept
+{
+    // A physical board is shared by the server's world, including visitors
+    // outside a party. Personal ownership is still per client profile.
+    return 1;
+}
+
+void MissivesService::Send(Player* apPlayer, uint64_t aToken, const MissivesLedger::Record& acRecord, NotifyMissives::Operation aOperation) const noexcept
+{
+    NotifyMissives notify;
+    notify.Action = aOperation;
+    notify.ServerSession = m_session;
+    notify.Scope = acRecord.Scope;
+    notify.Sequence = acRecord.ProgressSequence;
+    notify.RecipientActor = acRecord.RecipientActor;
+    notify.Mine = acRecord.Owner != 0 && acRecord.Owner == aToken;
+    notify.Authority = m_ledger.GetAuthority(acRecord.Scope) == aToken;
+    notify.Data = acRecord.Data;
+    if (notify.Mine && aOperation == NotifyMissives::Operation::Taken)
+        notify.Action = NotifyMissives::Operation::Grant;
+    apPlayer->Send(notify);
+}
+
+void MissivesService::Broadcast(const MissivesLedger::Record& acRecord, NotifyMissives::Operation aOperation) const noexcept
+{
+    for (const auto& [token, binding] : m_bindings)
+        if (binding.Scope == acRecord.Scope)
+            if (auto* pPlayer = m_world.GetPlayerManager().GetById(binding.PlayerId))
+                Send(pPlayer, token, acRecord, aOperation);
+}
+
+void MissivesService::Snapshot(Player* apPlayer, uint64_t aToken, uint64_t aScope) const noexcept
+{
+    NotifyMissives notify;
+    notify.ServerSession = m_session;
+    notify.Scope = aScope;
+    notify.Authority = m_ledger.GetAuthority(aScope) == aToken;
+    notify.Action = NotifyMissives::Operation::SnapshotBegin;
+    apPlayer->Send(notify);
+    for (const auto& record : m_ledger.Snapshot(aScope))
+    {
+        const auto operation = record.Status == MissivesLedger::State::Available ? NotifyMissives::Operation::Posting :
+            record.Status == MissivesLedger::State::Claimed ? NotifyMissives::Operation::Taken :
+            record.Status == MissivesLedger::State::Completed ? NotifyMissives::Operation::Complete : NotifyMissives::Operation::Retired;
+        Send(apPlayer, aToken, record, operation);
+    }
+    for (const auto& quest : m_ledger.Reserved(aScope))
+    {
+        notify.Action = NotifyMissives::Operation::Reserved;
+        notify.Data.Quest = quest;
+        apPlayer->Send(notify);
+    }
+    notify.Action = NotifyMissives::Operation::SnapshotEnd;
+    notify.Data = {};
+    apPlayer->Send(notify);
+    for (const auto& [board, visitors] : m_visitors)
+    {
+        notify.Action = NotifyMissives::Operation::BoardControl;
+        notify.Authority = m_ledger.GetBoardAuthority(aScope, board) == aToken;
+        notify.Data = {};
+        notify.Data.Board = board;
+        apPlayer->Send(notify);
+    }
+}
+
+void MissivesService::BoardControl(uint64_t aScope, const GameId& acBoard) const noexcept
+{
+    for (const auto& [token, binding] : m_bindings)
+        if (binding.Scope == aScope)
+            if (auto* pPlayer = m_world.GetPlayerManager().GetById(binding.PlayerId))
+            {
+                NotifyMissives notify;
+                notify.Action = NotifyMissives::Operation::BoardControl;
+                notify.ServerSession = m_session;
+                notify.Scope = aScope;
+                notify.Authority = m_ledger.GetBoardAuthority(aScope, acBoard) == token;
+                notify.Data.Board = acBoard;
+                pPlayer->Send(notify);
+            }
+}
+void MissivesService::ElectBoard(uint64_t aScope, const GameId& acBoard) noexcept
+{
+    const auto found = m_visitors.find(acBoard);
+    uint64_t token{};
+    if (found != m_visitors.end() && !found->second.empty())
+    {
+        token = m_ledger.GetBoardAuthority(aScope, acBoard);
+        if (!found->second.contains(token)) token = *found->second.begin();
+    }
+    m_ledger.SetBoardAuthority(aScope, acBoard, token);
+    BoardControl(aScope, acBoard);
+}
+
+void MissivesService::SendActor(Player* apPlayer, uint32_t aActorId) const noexcept
+{
+    const auto entity = static_cast<entt::entity>(aActorId);
+    if (!aActorId || !m_world.valid(entity) || !m_world.all_of<CharacterComponent, CellIdComponent, AnimationComponent>(entity))
+        return;
+    CharacterSpawnRequest spawn;
+    CharacterService::Serialize(m_world, entity, &spawn);
+    spawn.IsQuestReference = true;
+    spawn.QuestWorldSpace = m_world.get<CellIdComponent>(entity).WorldSpaceId;
+    apPlayer->Send(spawn);
+}
+
+void MissivesService::OnLeave(const PlayerLeaveEvent& acEvent) noexcept
+{
+    for (auto it = m_bindings.begin(); it != m_bindings.end();)
+    {
+        if (it->second.PlayerId != acEvent.pPlayer->GetId()) { ++it; continue; }
+        const uint64_t cScope = it->second.Scope;
+        const uint64_t cToken = it->first;
+        it = m_bindings.erase(it);
+        for (auto& [board, visitors] : m_visitors)
+            if (visitors.erase(cToken)) ElectBoard(cScope, board);
+        if (m_ledger.GetAuthority(cScope) == cToken)
+        {
+            m_ledger.SetAuthority(cScope, 0);
+            for (const auto& [token, binding] : m_bindings)
+                if (binding.Scope == cScope)
+                {
+                    m_ledger.SetAuthority(cScope, token);
+                    break;
+                }
+            for (const auto& [token, binding] : m_bindings)
+                if (binding.Scope == cScope)
+                    if (auto* pPlayer = m_world.GetPlayerManager().GetById(binding.PlayerId))
+                        Snapshot(pPlayer, token, cScope);
+        }
+    }
+    // Claims, retirements and per-profile reservations survive disconnects.
+}
+
+void MissivesService::OnRequest(const PacketEvent<RequestMissives>& acEvent) noexcept
+{
+    const auto& request = acEvent.Packet;
+    Player* pPlayer = acEvent.pPlayer;
+    if (!request.ClientSession || request.Revision != 2 || !request.Data.Valid || request.Action > RequestMissives::Operation::CloseBoard)
+        return;
+    const uint64_t cToken = request.ClientSession;
+    const uint64_t cScope = GetScope(pPlayer);
+    if (request.Action == RequestMissives::Operation::Hello)
+    {
+        const auto old = m_bindings.find(cToken);
+        if (old != m_bindings.end() && old->second.PlayerId != pPlayer->GetId())
+        {
+            NotifyMissives rejected;
+            rejected.Action = NotifyMissives::Operation::Rejected;
+            rejected.ServerSession = m_session;
+            rejected.Scope = cScope;
+            pPlayer->Send(rejected);
+            return;
+        }
+        m_bindings[cToken] = {pPlayer->GetId(), cScope};
+        if (!m_ledger.GetAuthority(cScope)) m_ledger.SetAuthority(cScope, cToken);
+        if (const auto actor = pPlayer->GetCharacter())
+            for (const auto& record : m_ledger.Snapshot(cScope))
+                if (record.Status == MissivesLedger::State::Claimed && record.Owner == cToken)
+                {
+                    m_ledger.Claim(cScope, record.Data.Id, cToken, World::ToInteger(*actor));
+                    Broadcast(*m_ledger.Get(cScope, record.Data.Id), NotifyMissives::Operation::Taken);
+                }
+        NotifyMissives ready;
+        ready.Action = NotifyMissives::Operation::Ready;
+        ready.ServerSession = m_session;
+        ready.Scope = cScope;
+        ready.Authority = m_ledger.GetAuthority(cScope) == cToken;
+        pPlayer->Send(ready);
+        Snapshot(pPlayer, cToken, cScope);
+        return;
+    }
+    const auto binding = m_bindings.find(cToken);
+    if (binding == m_bindings.end() || binding->second.PlayerId != pPlayer->GetId() || binding->second.Scope != cScope || request.ServerSession != m_session)
+        return;
+    if (request.Action == RequestMissives::Operation::Snapshot)
+    {
+        Snapshot(pPlayer, cToken, cScope);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::OpenBoard || request.Action == RequestMissives::Operation::CloseBoard)
+    {
+        if (!request.Data.Board) return;
+        auto& visitors = m_visitors[request.Data.Board];
+        if (request.Action == RequestMissives::Operation::OpenBoard) visitors.insert(cToken);
+        else visitors.erase(cToken);
+        ElectBoard(cScope, request.Data.Board);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Reserve || request.Action == RequestMissives::Operation::ReleaseReserve)
+    {
+        const bool cSet = request.Action == RequestMissives::Operation::Reserve;
+        if (m_ledger.Reserve(cScope, request.Data.Quest, cToken, cSet))
+        {
+            NotifyMissives notify;
+            notify.Action = cSet ? NotifyMissives::Operation::Reserved : NotifyMissives::Operation::Unreserved;
+            notify.ServerSession = m_session;
+            notify.Scope = cScope;
+            notify.Data.Quest = request.Data.Quest;
+            for (const auto& [token, recipient] : m_bindings)
+                if (recipient.Scope == cScope)
+                    if (auto* pRecipient = m_world.GetPlayerManager().GetById(recipient.PlayerId)) pRecipient->Send(notify);
+        }
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Publish)
+    {
+        if (const auto record = m_ledger.Publish(cScope, cToken, request.Data))
+            Broadcast(*record, record->Status == MissivesLedger::State::Available ? NotifyMissives::Operation::Posting :
+                record->Status == MissivesLedger::State::Claimed ? NotifyMissives::Operation::Taken :
+                record->Status == MissivesLedger::State::Completed ? NotifyMissives::Operation::Complete : NotifyMissives::Operation::Retired);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Actor)
+    {
+        const auto record = m_ledger.Get(cScope, request.Data.Id);
+        if (!record) return;
+        for (const auto& alias : record->Data.Aliases)
+            if (alias.Type == MissivesAlias::Kind::Actor && alias.ActorId == request.Data.Stage) SendActor(pPlayer, alias.ActorId);
+        if (record->RecipientActor == request.Data.Stage) SendActor(pPlayer, record->RecipientActor);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Claim)
+    {
+        const uint32_t cActor = pPlayer->GetCharacter() ? World::ToInteger(*pPlayer->GetCharacter()) : 0;
+        const auto result = m_ledger.Claim(cScope, request.Data.Id, cToken, cActor);
+        if (result != MissivesLedger::ClaimResult::Unavailable)
+        {
+            const auto record = m_ledger.Get(cScope, request.Data.Id);
+            Broadcast(*record, NotifyMissives::Operation::Taken);
+            spdlog::info("STR Missives claim accepted: posting {}, recipient actor {}", request.Data.Id, cActor);
+        }
+        else
+        {
+            NotifyMissives rejected;
+            rejected.Action = NotifyMissives::Operation::Rejected;
+            rejected.ServerSession = m_session;
+            rejected.Scope = cScope;
+            rejected.Data = request.Data;
+            pPlayer->Send(rejected);
+        }
+        return;
+    }
+    const auto existing = m_ledger.Find(request.Data.Id);
+    if (!existing) return;
+    bool changed = false;
+    NotifyMissives::Operation operation = NotifyMissives::Operation::Progress;
+    if (request.Action == RequestMissives::Operation::Retire)
+    {
+        changed = m_ledger.Retire(cScope, request.Data.Id, cToken);
+        operation = NotifyMissives::Operation::Retired;
+    }
+    else if (request.Action == RequestMissives::Operation::Progress)
+        changed = m_ledger.Progress(existing->Scope, request.Data.Id, cToken, request.Sequence, request.Data);
+    else if (request.Action == RequestMissives::Operation::Complete)
+    {
+        changed = m_ledger.Complete(existing->Scope, request.Data.Id, cToken);
+        operation = NotifyMissives::Operation::Complete;
+    }
+    if (changed)
+        Broadcast(*m_ledger.Find(request.Data.Id), operation);
+}
