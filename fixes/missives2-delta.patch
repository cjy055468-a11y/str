+#include <Messages/NotifyMissives.h>
+void NotifyMissives::SerializeRaw(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    Serialization::WriteVarInt(aWriter, static_cast<uint8_t>(Action));
+    Serialization::WriteVarInt(aWriter, ServerSession);
+    Serialization::WriteVarInt(aWriter, Scope);
+    Serialization::WriteVarInt(aWriter, Sequence);
+    Serialization::WriteVarInt(aWriter, RecipientActor);
+    Serialization::WriteBool(aWriter, Authority);
+    Serialization::WriteBool(aWriter, Mine);
+    Data.Serialize(aWriter);
+}
+void NotifyMissives::DeserializeRaw(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    ServerMessage::DeserializeRaw(aReader);
+    Action = static_cast<Operation>(Serialization::ReadVarInt(aReader));
+    ServerSession = Serialization::ReadVarInt(aReader);
+    Scope = Serialization::ReadVarInt(aReader);
+    Sequence = Serialization::ReadVarInt(aReader);
+    RecipientActor = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+    Authority = Serialization::ReadBool(aReader);
+    Mine = Serialization::ReadBool(aReader);
+    Data.Deserialize(aReader);
+}
