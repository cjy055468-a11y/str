+#pragma once
+#include <Events/PacketEvent.h>
+#include <Game/Inventory/MissivesLedger.h>
+#include <Messages/NotifyMissives.h>
+#include <Messages/RequestMissives.h>
+#include <unordered_map>
+
+struct World;
+struct PlayerLeaveEvent;
+struct MissivesService
+{
+    MissivesService(World& aWorld, entt::dispatcher& aDispatcher) noexcept;
+private:
+    struct Binding { uint32_t PlayerId{}; uint64_t Scope{}; };
+    uint64_t GetScope(Player* apPlayer) const noexcept;
+    void OnRequest(const PacketEvent<RequestMissives>& acEvent) noexcept;
+    void OnLeave(const PlayerLeaveEvent& acEvent) noexcept;
+    void Send(Player* apPlayer, uint64_t aToken, const MissivesLedger::Record& acRecord, NotifyMissives::Operation aOperation) const noexcept;
+    void Broadcast(const MissivesLedger::Record& acRecord, NotifyMissives::Operation aOperation) const noexcept;
+    void Snapshot(Player* apPlayer, uint64_t aToken, uint64_t aScope) const noexcept;
+    void SendActor(Player* apPlayer, uint32_t aActorId) const noexcept;
+    void BoardControl(uint64_t aScope, const GameId& acBoard) const noexcept;
+    void ElectBoard(uint64_t aScope, const GameId& acBoard) noexcept;
+    World& m_world;
+    uint64_t m_session;
+    MissivesLedger m_ledger;
+    std::map<uint64_t, Binding> m_bindings;
+    std::unordered_map<GameId, std::set<uint64_t>> m_visitors;
+    entt::scoped_connection m_requestConnection;
+    entt::scoped_connection m_leaveConnection;
+};
