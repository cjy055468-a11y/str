+
+TEST_CASE("A confirmed remote death invokes KillImpl once when IsDead was pre-set", "[corpse.state]")
+{
+    CHECK(NeedsRemoteNpcKillImpl(true, true, false));
+    CHECK_FALSE(NeedsRemoteNpcKillImpl(true, true, true));
+    CHECK_FALSE(NeedsRemoteNpcKillImpl(true, false, false));
+    CHECK_FALSE(NeedsRemoteNpcKillImpl(false, true, false));
+}

