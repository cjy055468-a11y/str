+bool ActorExtension::HasKillImplBeenInvoked() const noexcept
+{
+    return std::atomic_ref<uint32_t>(onlineFlags).load(std::memory_order_relaxed) & kKillImplInvoked;
+}
+
+void ActorExtension::SetKillImplInvoked(bool aSet) noexcept
+{
+    if (aSet)
+        std::atomic_ref<uint32_t>(onlineFlags).fetch_or(kKillImplInvoked, std::memory_order_relaxed);
+    else
+        std::atomic_ref<uint32_t>(onlineFlags).fetch_and(~kKillImplInvoked, std::memory_order_relaxed);
+}
