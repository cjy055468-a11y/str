diff --git a/Code/client/Systems/CorpseLifeState.h b/Code/client/Systems/CorpseLifeState.h
--- a/Code/client/Systems/CorpseLifeState.h
+++ b/Code/client/Systems/CorpseLifeState.h
@@ -37,3 +37,10 @@
     const uint32_t life = (aNative & 0x01E00000) >> 21;
     return life == 1 || life == 2;
 }
+
+// IsDead can already be true on a replica before its native KillImpl path ran.
+// The accepted server death gets one local attempt; the flag prevents replay.
+inline bool NeedsRemoteNpcKillImpl(bool aRemoteNpc, bool aAuthoritativeDeath, bool aKillImplInvoked) noexcept
+{
+    return aRemoteNpc && aAuthoritativeDeath && !aKillImplInvoked;
+}
