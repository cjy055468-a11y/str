diff --git a/Code/client/Systems/CorpseDeathTransition.h b/Code/client/Systems/CorpseDeathTransition.h
new file mode 100644
index 00000000..ff700c5e
--- /dev/null
+++ b/Code/client/Systems/CorpseDeathTransition.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <Systems/CorpseLifeState.h>
+
+#include <cstdint>
+#include <string_view>
+
+// A remote actor's terminal ragdoll action is a pose notification, not a
+// substitute for the local engine death transition. Let the health/death
+// message invoke KillImpl first when the owner snapshot carries dying/dead.
+inline bool ShouldDeferRemoteNpcTerminalDeathAction(const bool aRemoteNpc, const std::string_view acEventName,
+                                                    const uint32_t aState1) noexcept
+{
+    if (!aRemoteNpc || (acEventName != "Ragdoll" && acEventName != "RagdollInstant"))
+        return false;
+
+    return IsNativeDeathTransition(aState1);
+}
