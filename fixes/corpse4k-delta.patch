diff --git a/Code/tests/corpse_death_transition.cpp b/Code/tests/corpse_death_transition.cpp
new file mode 100644
index 00000000..483ce80d
--- /dev/null
+++ b/Code/tests/corpse_death_transition.cpp
@@ -0,0 +1,16 @@
+#include <catch2/catch.hpp>
+
+#include "../client/Systems/CorpseDeathTransition.h"
+
+TEST_CASE("Remote NPC terminal ragdoll actions defer to the native death message", "[corpse][death-order]")
+{
+    constexpr uint32_t kDying = 1u << 21;
+    constexpr uint32_t kDead = 2u << 21;
+
+    CHECK(ShouldDeferRemoteNpcTerminalDeathAction(true, "Ragdoll", kDying));
+    CHECK(ShouldDeferRemoteNpcTerminalDeathAction(true, "RagdollInstant", kDead));
+
+    CHECK_FALSE(ShouldDeferRemoteNpcTerminalDeathAction(true, "Ragdoll", 0));
+    CHECK_FALSE(ShouldDeferRemoteNpcTerminalDeathAction(true, "AttackStart", kDying));
+    CHECK_FALSE(ShouldDeferRemoteNpcTerminalDeathAction(false, "Ragdoll", kDead));
+}
