+inline bool HasSameInventoryEntryContents(const Inventory::Entry& acLeft, const Inventory::Entry& acRight) noexcept
+{
+    if (acLeft.BaseId != acRight.BaseId || !acLeft.IsExtraDataEquals(acRight)
+        || acLeft.EnchantData.IsWeapon != acRight.EnchantData.IsWeapon
+        || acLeft.EnchantData.Effects.size() != acRight.EnchantData.Effects.size())
+        return false;
+
+    for (std::size_t i = 0; i < acLeft.EnchantData.Effects.size(); ++i)
+    {
+        const auto& left = acLeft.EnchantData.Effects[i];
+        const auto& right = acRight.EnchantData.Effects[i];
+        if (left.Magnitude != right.Magnitude || left.Area != right.Area || left.Duration != right.Duration
+            || left.RawCost != right.RawCost || left.EffectId != right.EffectId)
+            return false;
+    }
+    return true;
+}
+
+inline bool HasSameInventoryContents(const Inventory& acLeft, const Inventory& acRight) noexcept
+{
+    if (acLeft.CurrentMagicEquipment != acRight.CurrentMagicEquipment)
+        return false;
+
+    const auto sameCountsFor = [](const Inventory& acA, const Inventory& acB, const Inventory::Entry& acKey)
+    {
+        int64_t countA = 0;
+        int64_t countB = 0;
+        for (const auto& entry : acA.Entries)
+            if (HasSameInventoryEntryContents(entry, acKey))
+                countA += entry.Count;
+        for (const auto& entry : acB.Entries)
+            if (HasSameInventoryEntryContents(entry, acKey))
+                countB += entry.Count;
+        return countA == countB;
+    };
+
+    // Entry order and stack splitting may differ after a network round trip.
+    // Avoid clearing and re-equipping an actor when equivalent stacks already match.
+    for (const auto& entry : acLeft.Entries)
+        if (!sameCountsFor(acLeft, acRight, entry))
+            return false;
+    for (const auto& entry : acRight.Entries)
+        if (!sameCountsFor(acLeft, acRight, entry))
+            return false;
+    return true;
 }
 
