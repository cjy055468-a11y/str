+void CharacterService::RunCorpseStateRefreshUpdates() noexcept
+{
+    if (!m_transport.IsConnected())
+        return;
+    const UI* pUI = UI::Get();
+    if (pUI && pUI->numPausesGame != 0)
+        return;
+
+    const uint64_t cNow = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+    auto view = m_world.view<RemoteComponent, FormIdComponent>(entt::exclude<LocalComponent, PlayerComponent, WaitingFor3D>);
+    for (auto entity : view)
+    {
+        auto* pActor = Cast<Actor>(TESForm::GetById(view.get<FormIdComponent>(entity).Id));
+        if (!pActor || pActor->IsDeleted())
+            continue;
+        auto* pExtension = pActor->GetExtension();
+        if (!pExtension->IsRemote() || pExtension->IsPlayer())
+            continue;
+
+        const auto& remote = view.get<RemoteComponent>(entity);
+        const bool cConfirmedDead = remote.AuthoritativeDeath.value_or(false);
+        auto* pRefresh = m_world.try_get<CorpseStateRefreshComponent>(entity);
+        if (!pRefresh && !cConfirmedDead)
+            continue;
+        if (!pRefresh)
+            pRefresh = &m_world.emplace<CorpseStateRefreshComponent>(entity);
+
+        // Use the accepted network death, not local IsDead/completion, to arm
+        // recovery: the local death state is precisely what may be stuck.
+        const bool cReady = pActor->GetNiNode() && pActor->parentCell && pActor->parentCell->IsAttached() &&
+            pActor->currentProcess && pActor->animationGraphHolder.IsReady() && pActor->unk10 != 0xFFFF;
+        const uint32_t cHandle = pActor->GetHandle().handle.iBits;
+        if (!pRefresh->Window.Observe(cHandle, remote.Id, remote.OwnershipEpoch, cConfirmedDead, cReady, cNow))
+            continue;
+
+        // Source-only experiment based on E5F7B's successful Ragdoll transition:
+        // state 0x01000041 carries lifeState 8 (bleedout), not alive/resurrected.
+        // Change only that life field, then call the existing native death path
+        // synchronously. Never leave an update/frame with a scheduled get-up.
+        // Do not replay graph actions, Resurrect, Reset, move, or refill loot.
+        constexpr uint32_t cLifeMask = 0x01E00000u;
+        constexpr uint32_t cBleedout = 8u << 21;
+        const uint32_t cBefore = pActor->actorState.flags1;
+        const NiPoint3 cBeforePosition = pActor->position;
+        const bool cBeforeRagdoll = pActor->IsInRagdollState();
+        pActor->actorState.flags1 = (cBefore & ~cLifeMask) | cBleedout;
+        const bool cTransitionDead = pActor->IsDead();
+        // Keep the actor remote: the existing remote death-loot hook remains
+        // active, and this client does not publish a resurrection to the server.
+        pActor->Kill();
+        const bool cAfterDead = pActor->IsDead();
+        if (!cAfterDead)
+        {
+            // A refused native death must not leave our artificial bleedout
+            // state behind. Roll back only the field we changed; never retry.
+            pActor->actorState.flags1 = (pActor->actorState.flags1 & ~cLifeMask) | (cBefore & cLifeMask);
+            spdlog::warn("STR corpse state refresh native death refused: actor {:X}, server {:X}, epoch {}, handle {:X}",
+                pActor->formID, remote.Id, remote.OwnershipEpoch, cHandle);
+        }
+        spdlog::info("STR corpse state refresh 1s: actor {:X}, server {:X}, epoch {}, handle {:X}, before {:X}, bleedout_dead {}, native_after_dead {}, after {:X}, ragdoll {}->{}, position ({}, {}, {})->({}, {}, {})",
+            pActor->formID, remote.Id, remote.OwnershipEpoch, cHandle, cBefore, cTransitionDead, cAfterDead,
+            pActor->actorState.flags1, cBeforeRagdoll, pActor->IsInRagdollState(),
+            cBeforePosition.x, cBeforePosition.y, cBeforePosition.z, pActor->position.x, pActor->position.y, pActor->position.z);
+    }
 }
 
