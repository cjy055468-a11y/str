+++ b/Code/server/Services/MissivesService.cpp
@@ -0,0 +1,285 @@
+#include <Services/MissivesService.h>
+#include <Services/CharacterService.h>
+#include <Services/PartyService.h>
+#include <Events/PlayerLeaveEvent.h>
+#include <Messages/CharacterSpawnRequest.h>
+#include <World.h>
+#include <Game/Player.h>
+#include <Game/PlayerManager.h>
+#include <Components.h>
+#include <Structs/MissivesActorId.h>
+
+MissivesService::MissivesService(World& aWorld, entt::dispatcher& aDispatcher) noexcept
+    : m_world(aWorld), m_session(static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count()) | 1ULL)
+{
+    m_requestConnection = aDispatcher.sink<PacketEvent<RequestMissives>>().connect<&MissivesService::OnRequest>(this);
+    m_leaveConnection = aDispatcher.sink<PlayerLeaveEvent>().connect<&MissivesService::OnLeave>(this);
+}
+
+uint64_t MissivesService::GetScope(Player* apPlayer) const noexcept
+{
+    // A physical board is shared by the server's world, including visitors
+    // outside a party. Personal ownership is still per client profile.
+    return 1;
+}
+
+void MissivesService::Send(Player* apPlayer, uint64_t aToken, const MissivesLedger::Record& acRecord, NotifyMissives::Operation aOperation) const noexcept
+{
+    NotifyMissives notify;
+    notify.Action = aOperation;
+    notify.ServerSession = m_session;
+    notify.Scope = acRecord.Scope;
+    notify.Sequence = acRecord.ProgressSequence;
+    notify.RecipientActor = acRecord.RecipientActor;
+    notify.Mine = acRecord.Owner != 0 && acRecord.Owner == aToken;
+    notify.Authority = m_ledger.GetAuthority(acRecord.Scope) == aToken;
+    notify.Data = acRecord.Data;
+    if (notify.Mine && aOperation == NotifyMissives::Operation::Taken)
+        notify.Action = NotifyMissives::Operation::Grant;
+    apPlayer->Send(notify);
+}
+
+void MissivesService::Broadcast(const MissivesLedger::Record& acRecord, NotifyMissives::Operation aOperation) const noexcept
+{
+    for (const auto& [token, binding] : m_bindings)
+        if (binding.Scope == acRecord.Scope)
+            if (auto* pPlayer = m_world.GetPlayerManager().GetById(binding.PlayerId))
+                Send(pPlayer, token, acRecord, aOperation);
+}
+
+void MissivesService::Snapshot(Player* apPlayer, uint64_t aToken, uint64_t aScope) const noexcept
+{
+    NotifyMissives notify;
+    notify.ServerSession = m_session;
+    notify.Scope = aScope;
+    notify.Authority = m_ledger.GetAuthority(aScope) == aToken;
+    notify.Action = NotifyMissives::Operation::SnapshotBegin;
+    apPlayer->Send(notify);
+    for (const auto& record : m_ledger.Snapshot(aScope))
+    {
+        const auto operation = record.Status == MissivesLedger::State::Available ? NotifyMissives::Operation::Posting :
+            record.Status == MissivesLedger::State::Claimed ? NotifyMissives::Operation::Taken :
+            record.Status == MissivesLedger::State::Completed ? NotifyMissives::Operation::Complete : NotifyMissives::Operation::Retired;
+        Send(apPlayer, aToken, record, operation);
+    }
+    for (const auto& quest : m_ledger.Reserved(aScope))
+    {
+        notify.Action = NotifyMissives::Operation::Reserved;
+        notify.Data.Quest = quest;
+        apPlayer->Send(notify);
+    }
+    notify.Action = NotifyMissives::Operation::SnapshotEnd;
+    notify.Data = {};
+    apPlayer->Send(notify);
+    for (const auto& [board, visitors] : m_visitors)
+    {
+        notify.Action = NotifyMissives::Operation::BoardControl;
+        notify.Authority = m_ledger.GetBoardAuthority(aScope, board) == aToken;
+        notify.Data = {};
+        notify.Data.Board = board;
+        apPlayer->Send(notify);
+    }
+}
+
+void MissivesService::BoardControl(uint64_t aScope, const GameId& acBoard) const noexcept
+{
+    for (const auto& [token, binding] : m_bindings)
+        if (binding.Scope == aScope)
+            if (auto* pPlayer = m_world.GetPlayerManager().GetById(binding.PlayerId))
+            {
+                NotifyMissives notify;
+                notify.Action = NotifyMissives::Operation::BoardControl;
+                notify.ServerSession = m_session;
+                notify.Scope = aScope;
+                notify.Authority = m_ledger.GetBoardAuthority(aScope, acBoard) == token;
+                notify.Data.Board = acBoard;
+                pPlayer->Send(notify);
+            }
+}
+void MissivesService::ElectBoard(uint64_t aScope, const GameId& acBoard) noexcept
+{
+    const auto found = m_visitors.find(acBoard);
+    uint64_t token{};
+    if (found != m_visitors.end() && !found->second.empty())
+    {
+        token = m_ledger.GetBoardAuthority(aScope, acBoard);
+        if (!found->second.contains(token)) token = *found->second.begin();
+    }
+    m_ledger.SetBoardAuthority(aScope, acBoard, token);
+    const auto player = m_bindings.find(token);
+    spdlog::info("STR Missives board authority: board {:X}:{:X}, generator player {}", acBoard.ModId, acBoard.BaseId,
+        player != m_bindings.end() ? player->second.PlayerId : 0);
+    BoardControl(aScope, acBoard);
+}
+
+void MissivesService::SendActor(Player* apPlayer, uint32_t aActorId) const noexcept
+{
+    const auto serverId = DecodeMissivesActorId(aActorId);
+    if (!serverId) return;
+    const auto entity = static_cast<entt::entity>(*serverId);
+    if (!m_world.valid(entity) || !m_world.all_of<CharacterComponent, CellIdComponent, AnimationComponent>(entity))
+        return;
+    CharacterSpawnRequest spawn;
+    CharacterService::Serialize(m_world, entity, &spawn);
+    spawn.IsQuestReference = true;
+    spawn.QuestWorldSpace = m_world.get<CellIdComponent>(entity).WorldSpaceId;
+    apPlayer->Send(spawn);
+}
+
+void MissivesService::OnLeave(const PlayerLeaveEvent& acEvent) noexcept
+{
+    for (auto it = m_bindings.begin(); it != m_bindings.end();)
+    {
+        if (it->second.PlayerId != acEvent.pPlayer->GetId()) { ++it; continue; }
+        const uint64_t cScope = it->second.Scope;
+        const uint64_t cToken = it->first;
+        it = m_bindings.erase(it);
+        for (auto& [board, visitors] : m_visitors)
+            if (visitors.erase(cToken)) ElectBoard(cScope, board);
+        if (m_ledger.GetAuthority(cScope) == cToken)
+        {
+            m_ledger.SetAuthority(cScope, 0);
+            for (const auto& [token, binding] : m_bindings)
+                if (binding.Scope == cScope)
+                {
+                    m_ledger.SetAuthority(cScope, token);
+                    break;
+                }
+            for (const auto& [token, binding] : m_bindings)
+                if (binding.Scope == cScope)
+                    if (auto* pPlayer = m_world.GetPlayerManager().GetById(binding.PlayerId))
+                        Snapshot(pPlayer, token, cScope);
+        }
+    }
+    // Claims, retirements and per-profile reservations survive disconnects.
+}
+
+void MissivesService::OnRequest(const PacketEvent<RequestMissives>& acEvent) noexcept
+{
+    const auto& request = acEvent.Packet;
+    Player* pPlayer = acEvent.pPlayer;
+    if (!request.ClientSession || request.Revision != 3 || !request.Data.Valid || request.Action > RequestMissives::Operation::CloseBoard)
+        return;
+    const uint64_t cToken = request.ClientSession;
+    const uint64_t cScope = GetScope(pPlayer);
+    if (request.Action == RequestMissives::Operation::Hello)
+    {
+        const auto old = m_bindings.find(cToken);
+        if (old != m_bindings.end() && old->second.PlayerId != pPlayer->GetId())
+        {
+            NotifyMissives rejected;
+            rejected.Action = NotifyMissives::Operation::Rejected;
+            rejected.ServerSession = m_session;
+            rejected.Scope = cScope;
+            pPlayer->Send(rejected);
+            return;
+        }
+        m_bindings[cToken] = {pPlayer->GetId(), cScope};
+        if (!m_ledger.GetAuthority(cScope)) m_ledger.SetAuthority(cScope, cToken);
+        if (const auto actor = pPlayer->GetCharacter())
+            for (const auto& record : m_ledger.Snapshot(cScope))
+                if (record.Status == MissivesLedger::State::Claimed && record.Owner == cToken)
+                {
+                    m_ledger.Claim(cScope, record.Data.Id, cToken, EncodeMissivesActorId(World::ToInteger(*actor)));
+                    Broadcast(*m_ledger.Get(cScope, record.Data.Id), NotifyMissives::Operation::Taken);
+                }
+        NotifyMissives ready;
+        ready.Action = NotifyMissives::Operation::Ready;
+        ready.ServerSession = m_session;
+        ready.Scope = cScope;
+        ready.Authority = m_ledger.GetAuthority(cScope) == cToken;
+        pPlayer->Send(ready);
+        spdlog::info("STR Missives hello accepted: player {}, revision 3", pPlayer->GetId());
+        Snapshot(pPlayer, cToken, cScope);
+        return;
+    }
+    const auto binding = m_bindings.find(cToken);
+    if (binding == m_bindings.end() || binding->second.PlayerId != pPlayer->GetId() || binding->second.Scope != cScope || request.ServerSession != m_session)
+        return;
+    if (request.Action == RequestMissives::Operation::Snapshot)
+    {
+        Snapshot(pPlayer, cToken, cScope);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::OpenBoard || request.Action == RequestMissives::Operation::CloseBoard)
+    {
+        if (!request.Data.Board) return;
+        auto& visitors = m_visitors[request.Data.Board];
+        if (request.Action == RequestMissives::Operation::OpenBoard) visitors.insert(cToken);
+        else visitors.erase(cToken);
+        ElectBoard(cScope, request.Data.Board);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Reserve || request.Action == RequestMissives::Operation::ReleaseReserve)
+    {
+        const bool cSet = request.Action == RequestMissives::Operation::Reserve;
+        if (m_ledger.Reserve(cScope, request.Data.Quest, cToken, cSet))
+        {
+            NotifyMissives notify;
+            notify.Action = cSet ? NotifyMissives::Operation::Reserved : NotifyMissives::Operation::Unreserved;
+            notify.ServerSession = m_session;
+            notify.Scope = cScope;
+            notify.Data.Quest = request.Data.Quest;
+            for (const auto& [token, recipient] : m_bindings)
+                if (recipient.Scope == cScope)
+                    if (auto* pRecipient = m_world.GetPlayerManager().GetById(recipient.PlayerId)) pRecipient->Send(notify);
+        }
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Publish)
+    {
+        if (const auto record = m_ledger.Publish(cScope, cToken, request.Data))
+            Broadcast(*record, record->Status == MissivesLedger::State::Available ? NotifyMissives::Operation::Posting :
+                record->Status == MissivesLedger::State::Claimed ? NotifyMissives::Operation::Taken :
+                record->Status == MissivesLedger::State::Completed ? NotifyMissives::Operation::Complete : NotifyMissives::Operation::Retired);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Actor)
+    {
+        const auto record = m_ledger.Get(cScope, request.Data.Id);
+        if (!record) return;
+        for (const auto& alias : record->Data.Aliases)
+            if (alias.Type == MissivesAlias::Kind::Actor && alias.ActorId == request.Data.Stage) SendActor(pPlayer, alias.ActorId);
+        if (record->RecipientActor == request.Data.Stage) SendActor(pPlayer, record->RecipientActor);
+        return;
+    }
+    if (request.Action == RequestMissives::Operation::Claim)
+    {
+        const uint32_t cActor = pPlayer->GetCharacter() ? EncodeMissivesActorId(World::ToInteger(*pPlayer->GetCharacter())) : 0;
+        const auto result = m_ledger.Claim(cScope, request.Data.Id, cToken, cActor);
+        if (result != MissivesLedger::ClaimResult::Unavailable)
+        {
+            const auto record = m_ledger.Get(cScope, request.Data.Id);
+            Broadcast(*record, NotifyMissives::Operation::Taken);
+            spdlog::info("STR Missives claim accepted: posting {}, recipient actor {}", request.Data.Id, cActor);
+        }
+        else
+        {
+            NotifyMissives rejected;
+            rejected.Action = NotifyMissives::Operation::Rejected;
+            rejected.ServerSession = m_session;
+            rejected.Scope = cScope;
+            rejected.Data = request.Data;
+            pPlayer->Send(rejected);
+        }
+        return;
+    }
+    const auto existing = m_ledger.Find(request.Data.Id);
+    if (!existing) return;
+    bool changed = false;
+    NotifyMissives::Operation operation = NotifyMissives::Operation::Progress;
+    if (request.Action == RequestMissives::Operation::Retire)
+    {
+        changed = m_ledger.Retire(cScope, request.Data.Id, cToken);
+        operation = NotifyMissives::Operation::Retired;
+    }
+    else if (request.Action == RequestMissives::Operation::Progress)
+        changed = m_ledger.Progress(existing->Scope, request.Data.Id, cToken, request.Sequence, request.Data);
+    else if (request.Action == RequestMissives::Operation::Complete)
+    {
+        changed = m_ledger.Complete(existing->Scope, request.Data.Id, cToken);
+        operation = NotifyMissives::Operation::Complete;
+    }
+    if (changed)
+        Broadcast(*m_ledger.Find(request.Data.Id), operation);
+}
