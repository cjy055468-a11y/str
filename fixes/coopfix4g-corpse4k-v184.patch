+#pragma once
+#include <Messages/NotifyMissives.h>
+#include <Messages/RequestMissives.h>
+#include <ModCompat/MissivesContext.h>
+#include <map>
+#include <set>
+#include <memory>
+#include <chrono>
+
+struct World;
+struct TransportService;
+struct UpdateEvent;
+struct ConnectedEvent;
+struct DisconnectedEvent;
+
+class MissivesService
+{
+public:
+    MissivesService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept;
+    bool RegisteredQuestActor(uint32_t aForm, uint32_t aHandle) const noexcept { return m_assigning.contains({aForm, aHandle}); }
+private:
+    struct Posting
+    {
+        MissivesData Data;
+        uint64_t Sequence{};
+        uint32_t Recipient{};
+        int32_t State{};
+        bool Mine{};
+        bool Applied{};
+    };
+    void OnConnected(const ConnectedEvent&) noexcept;
+    void OnDisconnected(const DisconnectedEvent&) noexcept;
+    void OnUpdate(const UpdateEvent&) noexcept;
+    void OnNotify(const NotifyMissives& acMessage) noexcept;
+    bool Send(RequestMissives::Operation aAction, const MissivesData& acData = {}, uint64_t aSequence = 0) noexcept;
+    void PublishBoards() noexcept;
+    void ApplyPostings() noexcept;
+    bool Capture(const MissiveQuestSpec& acSpec, TESQuest* apQuest, MissivesData& aData) noexcept;
+    void CaptureGlobals(const MissiveQuestSpec& acSpec, MissivesData& aData) noexcept;
+    TESObjectREFR* ResolveActor(uint32_t aId) noexcept;
+    uint32_t ActorId(TESObjectREFR* apReference) noexcept;
+    void Cache(uint32_t aQuest, const MissiveQuestSpec& acSpec, const Posting* apPosting) noexcept;
+    uint64_t ProfileToken() noexcept;
+    const MissiveQuestSpec* Spec(uint32_t aRuntimeId) const noexcept;
+
+    World& m_world;
+    TransportService& m_transport;
+    uint64_t m_token{};
+    uint64_t m_server{};
+    uint64_t m_nonce{};
+    bool m_enabled{};
+    bool m_hello{};
+    bool m_ready{};
+    bool m_authority{};
+    bool m_snapshot{};
+    int m_waitReason{-1};
+    std::map<uint64_t, Posting> m_postings;
+    std::map<uint32_t, std::unique_ptr<MissivesContext>> m_contexts;
+    std::map<uint32_t, uint64_t> m_current;
+    std::map<uint32_t, uint64_t> m_contextIds;
+    std::map<uint32_t, std::pair<uint32_t, uint64_t>> m_sources;
+    std::map<uint32_t, std::chrono::steady_clock::time_point> m_actorRequests;
+    std::set<std::pair<uint32_t, uint32_t>> m_assigning;
+    std::set<uint32_t> m_boards;
+    std::set<uint32_t> m_transientBoards;
+    std::set<uint32_t> m_boardQueries;
+    std::set<uint32_t> m_generators;
+    std::set<uint32_t> m_reserved;
+    std::set<uint32_t> m_personal;
+    std::set<uint32_t> m_sentReservations;
+    std::set<uint32_t> m_claims;
+    std::set<uint64_t> m_terminal;
+    std::chrono::steady_clock::time_point m_next{};
+    std::chrono::steady_clock::time_point m_nextBoardReport{};
+    entt::scoped_connection m_connectedConnection;
+    entt::scoped_connection m_disconnectedConnection;
+    entt::scoped_connection m_updateConnection;
+    entt::scoped_connection m_notifyConnection;
+};
diff --git a/Code/client/Systems/ActorIdentityCache.h b/Code/client/Systems/ActorIdentityCache.h
new file mode 100644
index 0000000000000000000000000000000000000000..652582fb378d9494e8e1807214648663d8cd0ba7
--- /dev/null
+++ b/Code/client/Systems/ActorIdentityCache.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <utility>
+
+// Discovery ECS entities are destroyed when references unload. Preserve the
+// session's network identity separately, qualified by the engine handle's
+// generation so a recycled temporary form ID cannot inherit another actor.
+class ActorIdentityCache
+{
+public:
+    void Remember(uint32_t aForm, uint32_t aHandle, uint32_t aServer)
+    {
+        if (aHandle)
+            m_entries[{aForm, aHandle}] = aServer;
+    }
+
+    std::optional<uint32_t> Find(uint32_t aForm, uint32_t aHandle) const
+    {
+        const auto it = m_entries.find({aForm, aHandle});
+        return it == m_entries.end() ? std::nullopt : std::optional<uint32_t>(it->second);
+    }
+
+    void Clear() { m_entries.clear(); }
+
+private:
+    std::map<std::pair<uint32_t, uint32_t>, uint32_t> m_entries;
+};
