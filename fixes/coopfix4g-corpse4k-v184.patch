index 0000000000000000000000000000000000000000..89b2da0ecf4a9b649a817cf400844a39bc91eca2
--- /dev/null
+++ b/Code/server/Game/Inventory/MissivesLedger.h
@@ -0,0 +1,191 @@
+#pragma once
+#include <Structs/MissivesData.h>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <tuple>
+#include <vector>
+
+// Server-owned posting lifetimes. Tokens are private process/profile identities;
+// only the service translates ownership into a recipient-specific notification.
+class MissivesLedger
+{
+public:
+    enum class State { Available, Claimed, Retired, Completed };
+    struct Record
+    {
+        uint64_t Scope{};
+        uint64_t Publisher{};
+        uint64_t Owner{};
+        uint64_t ProgressSequence{};
+        uint32_t RecipientActor{};
+        State Status{State::Available};
+        MissivesData Data;
+    };
+    enum class ClaimResult { Won, AlreadyOwned, Unavailable };
+
+    void SetBoardAuthority(uint64_t aScope, const GameId& acBoard, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        m_boardAuthorities[{aScope, acBoard.LogFormat()}] = aToken;
+    }
+    uint64_t GetBoardAuthority(uint64_t aScope, const GameId& acBoard) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_boardAuthorities.find({aScope, acBoard.LogFormat()});
+        return it == m_boardAuthorities.end() ? 0 : it->second;
+    }
+
+    void SetAuthority(uint64_t aScope, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        m_authorities[aScope] = aToken;
+    }
+    uint64_t GetAuthority(uint64_t aScope) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_authorities.find(aScope);
+        return it == m_authorities.end() ? 0 : it->second;
+    }
+    std::optional<Record> Publish(uint64_t aScope, uint64_t aToken, const MissivesData& acData) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto board = m_boardAuthorities.find({aScope, acData.Board.LogFormat()});
+        const uint64_t cAuthority = board != m_boardAuthorities.end() ? board->second : m_authorities[aScope];
+        if (!aToken || cAuthority != aToken || !acData.Valid || !acData.SourceNonce || !acData.Board || !acData.Quest || !acData.Book)
+            return std::nullopt;
+        const auto creation = std::make_tuple(aScope, aToken, acData.SourceNonce);
+        if (const auto old = m_creations.find(creation); old != m_creations.end())
+            return m_records.find(old->second)->second;
+        const auto key = std::make_pair(aScope, acData.Quest.LogFormat());
+        if (const auto current = m_slots.find(key); current != m_slots.end())
+        {
+            const auto& record = m_records.find(current->second)->second;
+            if (record.Publisher == aToken && record.Data.SourceNonce == acData.SourceNonce && record.Status == State::Available)
+                return record;
+            return std::nullopt;
+        }
+        if (const auto reserve = m_reservations.find(key); reserve != m_reservations.end() && !reserve->second.empty())
+            return std::nullopt;
+        Record record;
+        record.Scope = aScope;
+        record.Publisher = aToken;
+        record.Data = acData;
+        record.Data.Id = ++m_nextId;
+        m_records.emplace(record.Data.Id, record);
+        m_creations.emplace(creation, record.Data.Id);
+        m_slots.emplace(key, record.Data.Id);
+        return record;
+    }
+    ClaimResult Claim(uint64_t aScope, uint64_t aId, uint64_t aToken, uint32_t aActor) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (!aToken || !aActor || it == m_records.end() || it->second.Scope != aScope)
+            return ClaimResult::Unavailable;
+        auto& record = it->second;
+        if (record.Status == State::Claimed && record.Owner == aToken)
+        {
+            record.RecipientActor = aActor;
+            return ClaimResult::AlreadyOwned;
+        }
+        if (record.Status != State::Available)
+            return ClaimResult::Unavailable;
+        record.Status = State::Claimed;
+        record.Owner = aToken;
+        record.RecipientActor = aActor;
+        record.Data.Stage = 20;
+        return ClaimResult::Won;
+    }
+    bool Retire(uint64_t aScope, uint64_t aId, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (it == m_records.end()) return false;
+        const auto board = m_boardAuthorities.find({aScope, it->second.Data.Board.LogFormat()});
+        const uint64_t cAuthority = board != m_boardAuthorities.end() ? board->second : m_authorities[aScope];
+        if (cAuthority != aToken || it->second.Scope != aScope || it->second.Status != State::Available)
+            return false;
+        it->second.Status = State::Retired;
+        m_slots.erase({aScope, it->second.Data.Quest.LogFormat()});
+        return true;
+    }
+    bool Progress(uint64_t aScope, uint64_t aId, uint64_t aToken, uint64_t aSequence, const MissivesData& acData) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (!acData.Valid || !aSequence || it == m_records.end()) return false;
+        auto& record = it->second;
+        if (record.Scope != aScope || record.Status != State::Claimed || record.Owner != aToken || aSequence <= record.ProgressSequence || acData.Stage > 65535)
+            return false;
+        record.ProgressSequence = aSequence;
+        record.Data.Stage = acData.Stage;
+        record.Data.Globals = acData.Globals;
+        return true;
+    }
+    bool Complete(uint64_t aScope, uint64_t aId, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        auto it = m_records.find(aId);
+        if (it == m_records.end()) return false;
+        auto& record = it->second;
+        if (record.Scope != aScope || record.Status != State::Claimed || record.Owner != aToken) return false;
+        record.Status = State::Completed;
+        record.Data.Stage = 110;
+        m_slots.erase({aScope, record.Data.Quest.LogFormat()});
+        return true;
+    }
+    bool Reserve(uint64_t aScope, const GameId& acQuest, uint64_t aToken, bool aSet) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto key = std::make_pair(aScope, acQuest.LogFormat());
+        if (!aToken || !acQuest || (aSet && m_slots.contains(key))) return false;
+        if (aSet) m_reservations[key].insert(aToken);
+        else if (auto it = m_reservations.find(key); it != m_reservations.end())
+        {
+            it->second.erase(aToken);
+            if (it->second.empty()) m_reservations.erase(it);
+        }
+        return true;
+    }
+    std::vector<GameId> Reserved(uint64_t aScope) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<GameId> result;
+        for (const auto& [key, owners] : m_reservations)
+            if (key.first == aScope && !owners.empty()) result.emplace_back(static_cast<uint32_t>(key.second >> 32), static_cast<uint32_t>(key.second));
+        for (const auto& [id, record] : m_records)
+            if (record.Scope == aScope && record.Status == State::Claimed) result.push_back(record.Data.Quest);
+        return result;
+    }
+    std::optional<Record> Get(uint64_t aScope, uint64_t aId) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() || it->second.Scope != aScope ? std::nullopt : std::optional<Record>(it->second);
+    }
+    std::optional<Record> Find(uint64_t aId) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() ? std::nullopt : std::optional<Record>(it->second);
+    }
+    std::vector<Record> Snapshot(uint64_t aScope) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> result;
+        for (const auto& [id, record] : m_records)
+            if (record.Scope == aScope) result.push_back(record);
+        return result;
+    }
+private:
+    mutable std::mutex m_lock;
+    uint64_t m_nextId{};
+    std::map<uint64_t, uint64_t> m_authorities;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_boardAuthorities;
+    std::map<uint64_t, Record> m_records;
+    std::map<std::tuple<uint64_t, uint64_t, uint64_t>, uint64_t> m_creations;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_slots;
+    std::map<std::pair<uint64_t, uint64_t>, std::set<uint64_t>> m_reservations;
+};
