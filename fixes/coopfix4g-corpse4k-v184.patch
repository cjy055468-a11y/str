diff --git a/Code/client/ModCompat/MissivesCompat.cpp b/Code/client/ModCompat/MissivesCompat.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b8f64d570a5928868a1becf0f1c5997451f3d4bc
--- /dev/null
+++ b/Code/client/ModCompat/MissivesCompat.cpp
@@ -0,0 +1,94 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/MissivesCompat.h>
+#include <ModCompat/MissivesPostingAliases.h>
+#include <Forms/TESQuest.h>
+#include <ExtraData/ExtraTextDisplayData.h>
+#include <ExtraData/ExtraDataList.h>
+
+namespace
+{
+// CommonLibSSE-NG ExtraAliasInstanceArray/BGSRefAliasInstanceData source
+// layouts. Read only, under the engine's own alias-array read lock.
+struct AliasOwnerView
+{
+    TESQuest* pQuest;
+    const void* pAlias;
+    const void* pPackages;
+};
+struct AliasArrayView : BSExtraData
+{
+    GameArray<AliasOwnerView*> Aliases;
+    BSReadWriteLock Lock;
+};
+static_assert(sizeof(AliasOwnerView) == 0x18);
+static_assert(offsetof(AliasArrayView, Aliases) == 0x10);
+static_assert(offsetof(AliasArrayView, Lock) == 0x28);
+static_assert(sizeof(AliasArrayView) == 0x30);
+
+struct AliasReadGuard
+{
+    explicit AliasReadGuard(BSReadWriteLock& aLock) noexcept : Lock(aLock)
+    {
+        TP_THIS_FUNCTION(TLock, void, BSReadWriteLock);
+        POINTER_SKYRIMSE(TLock, s_lock, 68233);
+        TiltedPhoques::ThisCall(s_lock, &Lock);
+    }
+    ~AliasReadGuard() noexcept
+    {
+        TP_THIS_FUNCTION(TUnlock, void, BSReadWriteLock);
+        POINTER_SKYRIMSE(TUnlock, s_unlock, 68239);
+        TiltedPhoques::ThisCall(s_unlock, &Lock);
+    }
+    BSReadWriteLock& Lock;
+};
+}
+
+bool MissivesCompat::IsPersonalQuestData(ExtraDataList* apExtraData) noexcept
+{
+    if (!apExtraData)
+        return false;
+    const auto* pText = Cast<ExtraTextDisplayData>(apExtraData->GetByType(ExtraDataType::TextDisplayData));
+    if (pText && IsPluginForm(pText->pOwnerQuest))
+        return true;
+    auto* pAliases = reinterpret_cast<AliasArrayView*>(apExtraData->GetByType(ExtraDataType::AliasInstanceArray));
+    if (!pAliases)
+        return false;
+    AliasReadGuard guard(pAliases->Lock);
+    for (const auto* pOwner : pAliases->Aliases)
+        if (pOwner && IsPluginForm(pOwner->pQuest))
+            return true;
+    return false;
+}
+
+void MissivesCompat::AuditBoard(TESObjectREFR* apBoard, const char* apReason) noexcept
+{
+    if (!IsBoard(apBoard))
+        return;
+
+    const auto inventory = apBoard->GetInventory();
+    spdlog::info("STR Missives board audit: reason {}, board {:X}, entries {}", apReason, apBoard->formID, inventory.Entries.size());
+    for (const auto& item : inventory.Entries)
+        spdlog::info("STR Missives board entry: board {:X}, base {:X}:{:X}, count {}, quest {}",
+            apBoard->formID, item.BaseId.ModId, item.BaseId.BaseId, item.Count, item.IsQuestItem);
+
+    const Mod* pMod = ModManager::Get()->GetByName("Missives.esp");
+    if (!pMod)
+        return;
+
+    for (const auto& entry : cPostingAliases)
+    {
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(pMod->GetFormId(entry.QuestId)));
+        if (!pQuest || pQuest->IsStopped())
+            continue;
+        const auto* pQuestBoard = pQuest->GetAliasedRef(entry.BoardAlias);
+        if (!pQuestBoard || pQuestBoard->formID != apBoard->formID)
+            continue;
+
+        auto* pPosting = pQuest->GetAliasedRef(entry.PostingAlias);
+        const auto* pText = pPosting ? Cast<ExtraTextDisplayData>(pPosting->extraData.GetByType(ExtraDataType::TextDisplayData)) : nullptr;
+        spdlog::info("STR Missives local posting: board {:X}, quest {:X}, instance {}, stage {}, alias {}, reference {:X}, base {:X}, text_context {}, text_quest_matches {}, text_instance {}",
+            apBoard->formID, pQuest->formID, pQuest->currentInstanceID, pQuest->currentStage, entry.PostingAlias,
+            pPosting ? pPosting->formID : 0, pPosting && pPosting->baseForm ? pPosting->baseForm->formID : 0,
+            pText != nullptr, pText && pText->pOwnerQuest == pQuest, pText ? pText->iOwnerInstance : -1);
+    }
+}
diff --git a/Code/client/ModCompat/MissivesCompat.h b/Code/client/ModCompat/MissivesCompat.h
