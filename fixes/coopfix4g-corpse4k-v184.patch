-void AnimationSystem::Update(World& aWorld, Actor* apActor, RemoteAnimationComponent& aAnimationComponent, const uint64_t aTick) noexcept
+void AnimationSystem::Update(World& aWorld, Actor* apActor, RemoteAnimationComponent& aAnimationComponent, const uint64_t aTick, const bool aConfirmedDeath) noexcept
 {
     auto& actions = aAnimationComponent.TimePoints;
 
+    // The server deliberately removes the exit action from the replay chain.
