@@ -0,0 +1,72 @@
+#pragma once
+
+#include <Games/TES.h>
+#include <Forms/TESForm.h>
+#include <TESObjectREFR.h>
+#include <algorithm>
+#include <array>
+
+// Records verified against the supplied original and CHS Missives 2.03 ESPs.
+// These helpers do not alter ordinary books, containers or quest loot.
+namespace MissivesCompat
+{
+void AuditBoard(TESObjectREFR* apBoard, const char* apReason) noexcept;
+bool IsPersonalQuestData(ExtraDataList* apExtraData) noexcept;
+inline bool HasBoardPatch() noexcept
+{
+    ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("STR_Missives_Compat.esp") : nullptr;
+    return pMod && pMod->IsLoaded();
+}
+
+inline bool IsPluginForm(const TESForm* apForm) noexcept
+{
+    if (!apForm)
+        return false;
+    ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    return pMod && pMod->IsLoaded() && !pMod->IsLite()
+        && pMod->GetFormId(apForm->formID & 0xFFFFFFu) == apForm->formID;
+}
+
+inline bool IsPosting(const TESForm* apForm) noexcept
+{
+    if (!apForm || apForm->formType != FormType::Book)
+        return false;
+    static constexpr std::array<uint32_t, 26> cPostingIds = {
+        0x001D98u, // _M_MissiveKillAnimal
+        0x00332Fu, // _M_MissiveGatherIngrLow
+        0x003330u, // _M_MissiveGatherIngrMed
+        0x003331u, // _M_MissiveGatherIngrHigh
+        0x006E74u, // _M_MissiveRetrieveWilderness
+        0x008ED4u, // _M_MissiveGatherOreLow
+        0x008ED5u, // _M_MissiveGatherOreMed
+        0x008ED6u, // _M_MissiveGatherOreHigh
+        0x009A16u, // _M_MissiveGatherInn
+        0x009F90u, // _M_MissiveGatherSoulGemLow
+        0x009F91u, // _M_MissiveGatherSoulGemMed
+        0x009F92u, // _M_MissiveGatherSoulGemHigh
+        0x00B533u, // _M_MissiveRetrieveHideout
+        0x00B534u, // _M_MissiveRetrieveRuins
+        0x00B537u, // _M_MissiveGatherOreVeryHigh
+        0x00BA9Cu, // _M_MissiveCourierLetter
+        0x00BA9Du, // _M_MissiveCourierWeapon
+        0x00F0C5u, // _M_MissiveKillBandit
+        0x00F0C6u, // _M_MissiveKillGiant
+        0x00F0C7u, // _M_MissiveKillDragon
+        0x00F0D0u, // _M_MissiveKillForsworn
+        0x0331A6u, // _M_MissiveTrackThief
+        0x0331A7u, // _M_MissiveTrackVampire
+        0x0331A8u, // _M_MissiveTrackFugitive
+        0x0331A9u, // _M_MissiveKillWerewolves
+        0x0398A4u, // _M_MissiveCourierPotion
+    };
+    return std::find(cPostingIds.begin(), cPostingIds.end(), apForm->formID & 0xFFFFFFu) != cPostingIds.end() && IsPluginForm(apForm);
+}
+
+inline bool IsBoard(const TESObjectREFR* apReference) noexcept
+{
+    return apReference && apReference->baseForm && apReference->baseForm->formType == FormType::Container
+        && (apReference->baseForm->formID & 0xFFFFFFu) == 0x12CBu && IsPluginForm(apReference->baseForm);
+}
+}
diff --git a/Code/client/ModCompat/MissivesContext.cpp b/Code/client/ModCompat/MissivesContext.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..15531b9d053fbe6b3e877617f51138863261073a
--- /dev/null
+++ b/Code/client/ModCompat/MissivesContext.cpp
@@ -0,0 +1,288 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/MissivesContext.h>
+#include <ModCompat/MissivesCompat.h>
+#include <Services/PapyrusService.h>
+#include <Services/TransportService.h>
+#include <World.h>
+#include <PlayerCharacter.h>
+#include <Forms/TESQuest.h>
+#include <Forms/TESGlobal.h>
+#include <ExtraData/ExtraDataList.h>
+#include <ExtraData/ExtraTextDisplayData.h>
+#include <Games/Overrides.h>
+
+namespace
+{
+// Prefixes from CommonLibSSE-NG BGSBaseAlias/BGSRefAlias. No virtual slots are
+// installed or replaced. Locations use their existing native ForceLocationTo.
+struct AliasView
+{
+    void* Vtable;
+    BSFixedString Name;
+    TESQuest* Quest;
+    uint32_t Id;
+    uint32_t Flags;
+    uint16_t FillType;
+    uint16_t Pad22;
+    uint32_t Pad24;
+    std::array<uint64_t, 3> FillData;
+    void* Conditions;
+};
+static_assert(offsetof(AliasView, Id) == 0x18);
+static_assert(offsetof(AliasView, FillType) == 0x20);
+static_assert(offsetof(AliasView, FillData) == 0x28);
+static_assert(sizeof(AliasView) == 0x48);
+
+struct TextView
+{
+    uintptr_t Vtable{};
+    BSExtraData* Next{};
+    BSFixedString Name{};
+    BGSMessage* Message{};
+    TESQuest* Quest{};
+    int32_t Instance{-1};
+    float Temper{1.f};
+    uint16_t Length{};
+    uint16_t Pad32{};
+    uint32_t Pad34{};
+};
+static_assert(sizeof(TextView) == sizeof(ExtraTextDisplayData));
+static_assert(offsetof(TextView, Quest) == 0x20);
+
+const Mod* Plugin(const char* apName) noexcept
+{
+    auto* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName(apName) : nullptr;
+    return pMod && pMod->IsLoaded() ? pMod : nullptr;
+}
+}
+
+MissivesContext::MissivesContext(const MissiveQuestSpec& acSpec) noexcept : m_spec(acSpec)
+{
+    if (const auto* pMod = Plugin("Missives.esp"))
+        m_quest = Cast<TESQuest>(TESForm::GetById(pMod->GetFormId(m_spec.Quest)));
+    if (m_quest) m_originalType = static_cast<uint8_t>(m_quest->type);
+}
+
+void* MissivesContext::GetAlias(uint32_t aId) const noexcept
+{
+    if (m_quest)
+        for (void* pAlias : m_quest->aliases)
+            if (pAlias && static_cast<AliasView*>(pAlias)->Id == aId) return pAlias;
+    return nullptr;
+}
+
+bool MissivesContext::IsRunning() const noexcept { return m_quest && !m_quest->IsStopped(); }
+uint16_t MissivesContext::GetStage() const noexcept { return m_quest ? m_quest->currentStage : 0; }
+TESObjectREFR* MissivesContext::GetPosting() const noexcept { return m_quest ? m_quest->GetAliasedRef(m_spec.PostingAlias) : nullptr; }
+
+void MissivesContext::SetPersonal(bool aPersonal) noexcept
+{
+    const auto* pMod = Plugin("STR_Missives_Compat.esp");
+    auto* pGlobal = pMod ? Cast<TESGlobal>(TESForm::GetById(pMod->GetFormId(m_spec.RecipientFlag))) : nullptr;
+    // Mutable GLOB values are part of the save's global-variable data. Keep
+    // the existing direct-value path used for the other mission globals;
+    // the connection classifier reads this same role after loading a save.
+    if (pGlobal) pGlobal->f = aPersonal ? 1.f : 0.f;
+    if (m_quest)
+    {
+        m_quest->type = aPersonal ? static_cast<TESQuest::Type>(m_originalType) : TESQuest::Type::None;
+        if (!aPersonal) m_quest->SetActive(false);
+    }
+}
+
+void MissivesContext::ForceReference(uint32_t aAlias, TESObjectREFR* apReference) noexcept
+{
+    void* pAlias = GetAlias(aAlias);
+    const void* pFunction = World::Get().ctx().at<PapyrusService>().Get("ReferenceAlias", "ForceRefTo");
+    if (pAlias && pFunction)
+        PapyrusFunction<void, void, TESObjectREFR*>{pFunction}(pAlias, apReference);
+}
+void MissivesContext::ForceLocation(uint32_t aAlias, TESForm* apLocation) noexcept
+{
+    void* pAlias = GetAlias(aAlias);
+    const void* pFunction = World::Get().ctx().at<PapyrusService>().Get("LocationAlias", "ForceLocationTo");
+    if (pAlias && pFunction)
+        PapyrusFunction<void, void, TESForm*>{pFunction}(pAlias, apLocation);
+}
+
+TESObjectREFR* MissivesContext::MakeItem(const MissivesAlias& acAlias) noexcept
+{
+    if (const auto found = m_created.find(acAlias.Id); found != m_created.end()) return found->second;
+    auto& world = World::Get();
+    const void* pFunction = world.ctx().at<PapyrusService>().Get("ObjectReference", "PlaceAtMe");
+    auto* pBase = TESForm::GetById(world.GetModSystem().GetGameId(acAlias.Base));
+    if (!pFunction || !pBase || pBase->formType == FormType::Npc || pBase->formType == FormType::Character || pBase->formType == FormType::LeveledCharacter)
+        return nullptr;
+    auto* pReference = PapyrusFunction<TESObjectREFR*, TESObjectREFR, TESForm*, int32_t, bool, bool>{pFunction}(PlayerCharacter::Get(), pBase, 1, true, true);
+    if (!pReference) return nullptr;
+    m_created.try_emplace(acAlias.Id, pReference);
+    return pReference;
+}
+
+void MissivesContext::BindText() noexcept
+{
+    auto* pPosting = GetPosting();
+    if (!pPosting || !m_quest) return;
+    auto* pText = Cast<ExtraTextDisplayData>(pPosting->extraData.GetByType(ExtraDataType::TextDisplayData));
+    if (!pText)
+    {
+        // Construct the existing game extra-data type with its AE Address
+        // Library vtable. Never reuse the old commented raw address helper.
+        void* pMemory = Memory::Allocate(sizeof(TextView));
+        if (!pMemory) return;
+        auto* pView = new (pMemory) TextView{};
+        const VersionDbPtr<uintptr_t> cVtable(186855);
+        pView->Vtable = reinterpret_cast<uintptr_t>(cVtable.Get());
+        pText = reinterpret_cast<ExtraTextDisplayData*>(pView);
+        pPosting->extraData.Add(ExtraDataType::TextDisplayData, pText);
+    }
+    if (pText->pOwnerQuest != m_quest)
+    {
+        pText->DisplayName.Set("");
+        pText->pOwnerQuest = m_quest;
+        pText->iOwnerInstance = static_cast<int32_t>(m_quest->currentInstanceID);
+    }
+}
+
+bool MissivesContext::Apply(const MissivesData& acData, bool aSource, uint32_t aRecipientActor, const ActorResolver& acResolveActor) noexcept
+{
+    if (!m_quest || !acData.Valid) return false;
+    auto& world = World::Get();
+    m_board = Cast<TESObjectREFR>(TESForm::GetById(world.GetModSystem().GetGameId(acData.Board)));
+    if (!MissivesCompat::IsBoard(m_board)) return false;
+    m_source = aSource;
+    if (!m_initialized && !aSource)
+    {
+        if (IsRunning() && !m_pinned)
+        {
+            if (!m_stopRequested) { m_quest->ScriptSetStage(110); m_stopRequested = true; }
+            return false;
+        }
+        std::map<uint32_t, TESObjectREFR*> references;
+        for (const auto& alias : acData.Aliases)
+        {
+            if (!GetAlias(alias.Id)) return false;
+            if (alias.Type == MissivesAlias::Kind::Location) continue;
+            TESObjectREFR* pReference = nullptr;
+            if (alias.Type == MissivesAlias::Kind::Item) pReference = MakeItem(alias);
+            else if (alias.Type == MissivesAlias::Kind::Player)
+                pReference = aRecipientActor ? acResolveActor(aRecipientActor) : PlayerCharacter::Get();
+            else if (alias.Type == MissivesAlias::Kind::Actor) pReference = acResolveActor(alias.ActorId);
+            else pReference = Cast<TESObjectREFR>(TESForm::GetById(world.GetModSystem().GetGameId(alias.Form)));
+            if (!pReference) return false;
+            references.emplace(alias.Id, pReference);
+        }
+        if (!m_pinned)
+        {
+            for (uint32_t i = 0; i < m_spec.AliasCount; ++i)
+            {
+                const auto& spec = cMissiveAliasSpecs[m_spec.AliasBegin+i];
+                auto* pAlias = static_cast<AliasView*>(GetAlias(spec.Id));
+                if (!pAlias) return false;
+                Pin pin;
+                pin.Alias = pAlias;
+                pin.Flags = pAlias->Flags;
+                pin.Location = spec.Location;
+                if (!spec.Location)
+                {
+                    pin.FillType = pAlias->FillType;
+                    pin.Data = pAlias->FillData;
+                    pin.Conditions = pAlias->Conditions;
+                    pAlias->FillType = 1; // Forced reference, no local random spawn.
+                    pAlias->FillData = {};
+                    const auto ref = references.find(spec.Id);
+                    if (ref != references.end()) pAlias->FillData[0] = ref->second->GetHandle().handle.iBits;
+                    pAlias->Conditions = nullptr;
+                }
+                pAlias->Flags |= (1u<<1) | (1u<<3) | (1u<<4) | (1u<<7) | (1u<<9);
+                m_pins.push_back(pin);
+            }
+            m_pinned = true;
+        }
+        if (!IsRunning())
+        {
+            bool success = false;
+            m_quest->EnsureQuestStarted(success, true);
+            return false; // Startup/alias fill may finish after this frame.
+        }
+        for (const auto& alias : acData.Aliases)
+        {
+            if (alias.Type == MissivesAlias::Kind::Location)
+                ForceLocation(alias.Id, TESForm::GetById(world.GetModSystem().GetGameId(alias.Form)));
+            else if (const auto ref = references.find(alias.Id); ref != references.end()) ForceReference(alias.Id, ref->second);
+        }
+    }
+    const void* pUpdate = world.ctx().at<PapyrusService>().Get("Quest", "UpdateCurrentInstanceGlobal");
+    // A reconnecting claimant keeps its existing item references and executed
+    // reward stages. Repair only an absent actor link after replica recreation.
+    if (aSource)
+        for (const auto& alias : acData.Aliases)
+            if (alias.Type == MissivesAlias::Kind::Actor && !m_quest->GetAliasedRef(alias.Id))
+            {
+                auto* pActor = acResolveActor(alias.ActorId);
+                if (!pActor) return false;
+                ForceReference(alias.Id, pActor);
+            }
+    for (const auto& entry : acData.Globals)
+        if (auto* pGlobal = Cast<TESGlobal>(TESForm::GetById(world.GetModSystem().GetGameId(entry.Id))))
+        {
+            pGlobal->f = entry.Value;
+            if (pUpdate) PapyrusFunction<bool, TESQuest, TESGlobal*>{pUpdate}(m_quest, pGlobal);
+        }
+    RebindPlayer(aRecipientActor, acResolveActor);
+    BindText();
+    m_initialized = true;
+    return IsRunning();
+}
+
+void MissivesContext::RebindPlayer(uint32_t aRecipientActor, const ActorResolver& acResolveActor) noexcept
+{
+    auto* pPlayer = aRecipientActor ? acResolveActor(aRecipientActor) : PlayerCharacter::Get();
+    if (!pPlayer) return;
+    for (uint32_t i = 0; i < m_spec.AliasCount; ++i)
+    {
+        const auto& spec = cMissiveAliasSpecs[m_spec.AliasBegin+i];
+        const auto* pAlias = static_cast<const AliasView*>(GetAlias(spec.Id));
+        if (!spec.Location && pAlias && pAlias->Name && !_stricmp(pAlias->Name.AsAscii(), "Player"))
+            ForceReference(spec.Id, pPlayer);
+    }
+}
+
+void MissivesContext::PutLetter(bool, bool) noexcept
+{
+    // Inventory transfer runs through compiled Papyrus. Its VM supplies the
+    // exact ref/inventory argument ABI and preserves the alias-bound instance.
+}
+
+void MissivesContext::SetStage(uint16_t aStage) noexcept
+{
+    if (m_quest && IsRunning() && aStage && !m_quest->IsStageReached(aStage)) m_quest->ScriptSetStage(aStage);
+}
+
+void MissivesContext::Stop() noexcept
+{
+    if (!m_quest) return;
+    const void* pStop = World::Get().ctx().at<PapyrusService>().Get("Quest", "Stop");
+    if (pStop && IsRunning()) PapyrusFunction<void, TESQuest>{pStop}(m_quest);
+    if (!IsRunning())
+    {
+        for (const auto& pin : m_pins)
+        {
+            auto* pAlias = static_cast<AliasView*>(pin.Alias);
+            pAlias->Flags = pin.Flags;
+            if (!pin.Location)
+            {
+                pAlias->FillType = pin.FillType;
+                pAlias->FillData = pin.Data;
+                pAlias->Conditions = pin.Conditions;
+            }
+        }
+        m_pins.clear();
+        m_created.clear();
+        m_pinned = false;
+        m_initialized = false;
+        m_quest->type = static_cast<TESQuest::Type>(m_originalType);
+        SetPersonal(true); // A stopped slot returns to the original offline defaults.
+    }
+}
diff --git a/Code/client/ModCompat/MissivesContext.h b/Code/client/ModCompat/MissivesContext.h
new file mode 100644
index 0000000000000000000000000000000000000000..5e006d5b47e09025aa017497c21d63922405e924
--- /dev/null
+++ b/Code/client/ModCompat/MissivesContext.h
@@ -0,0 +1,51 @@
+#pragma once
+#include <Structs/MissivesData.h>
+#include <ModCompat/MissivesMissionCatalog.h>
+#include <Games/References.h>
+#include <array>
+#include <functional>
+#include <map>
+#include <vector>
+
+// Own bookkeeping only. All native alias changes are made on the game thread.
+class MissivesContext
+{
+public:
+    using ActorResolver = std::function<TESObjectREFR*(uint32_t)>;
+    explicit MissivesContext(const MissiveQuestSpec& acSpec) noexcept;
+    bool Apply(const MissivesData& acData, bool aSource, uint32_t aRecipientActor, const ActorResolver& acResolveActor) noexcept;
+    void RebindPlayer(uint32_t aRecipientActor, const ActorResolver& acResolveActor) noexcept;
+    void SetPersonal(bool aPersonal) noexcept;
+    void PutLetter(bool aInBoard, bool aInPlayer) noexcept;
+    void SetStage(uint16_t aStage) noexcept;
+    void Stop() noexcept;
+    bool IsRunning() const noexcept;
+    uint16_t GetStage() const noexcept;
+    TESQuest* GetQuest() const noexcept { return m_quest; }
+    TESObjectREFR* GetPosting() const noexcept;
+private:
+    struct Pin
+    {
+        void* Alias{};
+        uint32_t Flags{};
+        uint16_t FillType{};
