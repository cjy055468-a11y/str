+void GameServer::LogConnectionDiagnostic(ConnectionId_t aConnectionId, const char* apEvent, int aReason) const noexcept
+{
+    const auto info = GetConnectionInfo(aConnectionId);
+    const auto now = std::chrono::steady_clock::now();
+    int64_t lifetime = -1;
+    int64_t lastPacketAge = -1;
+    uint64_t packets = 0;
+    uint64_t bytes = 0;
+    int lastOpcode = -1;
+    if (const auto it = m_connectionDiagnostics.find(aConnectionId); it != m_connectionDiagnostics.end())
+    {
+        lifetime = std::chrono::duration_cast<std::chrono::milliseconds>(now - it->second.ConnectedAt).count();
+        packets = it->second.Packets;
+        bytes = it->second.Bytes;
+        lastOpcode = it->second.LastOpcode;
+        if (packets)
+            lastPacketAge = std::chrono::duration_cast<std::chrono::milliseconds>(now - it->second.LastPacketAt).count();
+    }
+    const auto* pPlayer = m_pWorld ? m_pWorld->GetPlayerManager().GetByConnectionId(aConnectionId) : nullptr;
+    spdlog::warn("STR network detail: event {}, connection {:X}, app_reason {}, sdk_state {}, sdk_end_reason {}, sdk_debug \"{}\", lifetime_ms {}, packets {}, bytes {}, last_opcode {}, last_packet_age_ms {}, player_bound {}, character_assigned {}",
+        apEvent, aConnectionId, aReason, static_cast<int>(info.m_eState), info.m_eEndReason, info.m_szEndDebug,
+        lifetime, packets, bytes, lastOpcode, lastPacketAge, pPlayer != nullptr, pPlayer && pPlayer->GetCharacter().has_value());
+}
+
