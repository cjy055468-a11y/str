+#pragma once
+
+#include "Message.h"
+#include <Structs/DroppedItemData.h>
+
+struct RequestDroppedItem final : ClientMessage
+{
+    static constexpr ClientOpcode Opcode = kRequestDroppedItem;
+    enum class Operation : uint8_t { Create, Claim, Snapshot, Acknowledge, Placement };
+    RequestDroppedItem() : ClientMessage(Opcode) {}
+    void SerializeRaw(TiltedPhoques::Buffer::Writer& aWriter) const noexcept override;
+    void DeserializeRaw(TiltedPhoques::Buffer::Reader& aReader) noexcept override;
+
+    Operation Action{Operation::Snapshot};
+    // Private process identity, sent only to the server; never broadcast/logged.
+    // Keeps grants idempotent when the same game process reconnects.
+    uint64_t ClientSession{};
+    uint64_t ServerSession{};
+    uint64_t Nonce{};
+    uint32_t ActorId{};
+    uint32_t OwnershipEpoch{};
+    bool AppliedFresh{};
+    // A reconnect's initial inventory already includes this pending drop's
+    // local removal; the new actor must not be debited a second time.
+    bool InventoryAlreadyReflected{};
+    DroppedItemData Data{};
+};
