+    Nonce = Serialization::ReadVarInt(aReader);
+    ActorId = Serialization::ReadVarInt(aReader) & 0xFFFFFFFF;
+    Enabled = Serialization::ReadBool(aReader);
+    Active = Serialization::ReadBool(aReader);
+    Recovery = Serialization::ReadBool(aReader);
+    Data.Deserialize(aReader);
+}
