diff --git a/Code/client/Systems/PendingActorUpdates.h b/Code/client/Systems/PendingActorUpdates.h
new file mode 100644
index 00000000..629f935e
--- /dev/null
+++ b/Code/client/Systems/PendingActorUpdates.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <Messages/CharacterSpawnRequest.h>
+#include <Messages/NotifyDeathStateChange.h>
+#include <Messages/NotifyInventoryChanges.h>
+
+// Reliable updates can arrive after the spawn snapshot, before its 3D exists.
+// Update that snapshot so materialization cannot restore an older corpse state.
+inline bool ApplyPendingDeath(CharacterSpawnRequest& aSpawn, const NotifyDeathStateChange& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.Id || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch || aSpawn.IsPlayer)
+        return false;
+    aSpawn.IsDead = acUpdate.IsDead;
+    return true;
+}
+
+inline bool ApplyPendingInventory(CharacterSpawnRequest& aSpawn, const NotifyInventoryChanges& acUpdate) noexcept
+{
+    if (acUpdate.Drop || !acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch)
+        return false;
+    aSpawn.InventoryContent.AddOrRemoveEntry(acUpdate.Item);
+    return true;
+}
