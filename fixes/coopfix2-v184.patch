diff --git a/Code/client/Systems/ActorIdentityCache.h b/Code/client/Systems/ActorIdentityCache.h
new file mode 100644
index 00000000..652582fb
--- /dev/null
+++ b/Code/client/Systems/ActorIdentityCache.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <utility>
+
+// Discovery ECS entities are destroyed when references unload. Preserve the
+// session's network identity separately, qualified by the engine handle's
+// generation so a recycled temporary form ID cannot inherit another actor.
+class ActorIdentityCache
+{
+public:
+    void Remember(uint32_t aForm, uint32_t aHandle, uint32_t aServer)
+    {
+        if (aHandle)
+            m_entries[{aForm, aHandle}] = aServer;
+    }
+
+    std::optional<uint32_t> Find(uint32_t aForm, uint32_t aHandle) const
+    {
+        const auto it = m_entries.find({aForm, aHandle});
+        return it == m_entries.end() ? std::nullopt : std::optional<uint32_t>(it->second);
+    }
+
+    void Clear() { m_entries.clear(); }
+
+private:
+    std::map<std::pair<uint32_t, uint32_t>, uint32_t> m_entries;
+};
