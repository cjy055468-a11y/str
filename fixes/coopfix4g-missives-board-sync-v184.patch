+void CharacterService::RunCorpseSpeechUpdates() noexcept
+{
+    const auto cNow = std::chrono::steady_clock::now();
+    if (!m_transport.IsConnected() || cNow < m_nextCorpseSpeechUpdate)
+        return;
+    m_nextCorpseSpeechUpdate = cNow + std::chrono::milliseconds(250);
+
+    for (auto entity : m_world.view<FormIdComponent>(entt::exclude<ObjectComponent, PlayerComponent>))
+    {
+        if (!m_world.any_of<LocalComponent, RemoteComponent>(entity))
+            continue;
+        Actor* pActor = Cast<Actor>(TESForm::GetById(m_world.get<FormIdComponent>(entity).Id));
+        if (pActor && !pActor->IsDeleted() && pActor->GetNiNode())
+            UpdateCorpseSpeech(entity, pActor);
+    }
+}
