+#pragma once
+
+#include <cstdint>
+
+// Pure client identity state shared by the hook reservation and registration
+// acknowledgement. A queued pickup must retain its creation nonce across ACK.
+struct DroppedItemBinding
+{
+    uint32_t Handle{};
+    uint64_t Id{};
+    uint64_t Nonce{};
+    bool Busy{};
+
+    void BindRegistered(uint32_t aHandle, uint64_t aId, uint64_t aNonce, bool aWantPick) noexcept
+    {
+        const bool cReserved = Handle == aHandle && Nonce == aNonce && Busy;
+        *this = {aHandle, aId, aNonce, cReserved || aWantPick};
+    }
+
+    uint64_t ResolveQueuedPickup(uint32_t aHandle, uint64_t aNonce) const noexcept
+    {
+        return Handle == aHandle && Nonce == aNonce ? Id : 0;
+    }
+};
diff --git a/Code/client/Systems/FurnitureRecovery.h b/Code/client/Systems/FurnitureRecovery.h
new file mode 100644
index 00000000..c7f06f6c
--- /dev/null
+++ b/Code/client/Systems/FurnitureRecovery.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// Timing only. Engine eligibility is checked anew on the simulation owner.
+class FurnitureRecovery
+{
+public:
+    enum class Action { Wait, Reevaluate, Exit };
+
+    Action Advance(bool aEligible, uint64_t aMilliseconds) noexcept
+    {
+        if (!aEligible)
+        {
+            m_since.reset();
+            m_stage = 0;
+            return Action::Wait;
+        }
+        if (!m_since || aMilliseconds < *m_since)
+            m_since = aMilliseconds;
+        const uint64_t cElapsed = aMilliseconds - *m_since;
+        if (m_stage == 0 && cElapsed >= 2000)
+        {
+            m_stage = 1;
+            m_reevaluatedAt = aMilliseconds;
+            return Action::Reevaluate;
+        }
+        if (m_stage == 1 && aMilliseconds >= m_reevaluatedAt && aMilliseconds - m_reevaluatedAt >= 2000)
+        {
+            m_stage = 2;
+            return Action::Exit;
+        }
+        return Action::Wait;
+    }
+
+private:
+    std::optional<uint64_t> m_since;
+    uint8_t m_stage{};
+    uint64_t m_reevaluatedAt{};
+};
