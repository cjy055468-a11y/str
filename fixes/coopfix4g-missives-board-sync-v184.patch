+
+namespace MissiveBoardBridge
+{
+enum class Operation : uint8_t { Connected, Ready, BoardReady, Authority, CanGenerate, Personal, Status, Count, PostingAlias, BoardAlias, Open, Close, Publish, Claim, Finish };
+struct Event
+{
+    Operation Action{};
+    uint32_t Quest{};
+    uint32_t Board{};
+};
+struct ListingState
+{
+    uint64_t Id{};
+    int32_t Status{-1};
+};
+struct QuestSpec
+{
+    uint16_t PostingAlias{};
+    uint16_t BoardAlias{};
+    uint32_t Book{};
+};
+
+void SetConnection(bool aConnected) noexcept;
+void SetReady(bool aReady) noexcept;
+void SetBoardReady(uint32_t aBoard, bool aReady) noexcept;
+void SetBoardAuthority(uint32_t aBoard, bool aAuthority) noexcept;
+void SetListing(uint32_t aQuest, uint32_t aBoard, uint64_t aId, int32_t aStatus) noexcept;
+void BeginSnapshot(uint32_t aBoard) noexcept;
+void EndSnapshot(uint32_t aBoard) noexcept;
+void SetPersonal(uint32_t aQuest, bool aPersonal) noexcept;
+void SetQuestSpec(uint32_t aQuest, const QuestSpec& acSpec) noexcept;
+std::vector<Event> Drain() noexcept;
+int32_t Call(Operation aOperation, uint32_t aQuest, uint32_t aBoard) noexcept;
+}
