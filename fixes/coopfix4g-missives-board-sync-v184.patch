diff --git a/Code/client/Services/Generic/MissiveBoardService.cpp b/Code/client/Services/Generic/MissiveBoardService.cpp
new file mode 100644
index 00000000..86aa5461
--- /dev/null
+++ b/Code/client/Services/Generic/MissiveBoardService.cpp
@@ -0,0 +1,284 @@
+#include <TiltedOnlinePCH.h>
+#include <Services/MissiveBoardService.h>
+#include <Services/TransportService.h>
+#include <Events/UpdateEvent.h>
+#include <Events/ConnectedEvent.h>
+#include <Events/DisconnectedEvent.h>
+#include <World.h>
+#include <Forms/TESQuest.h>
+#include <Games/TES.h>
+
+namespace
+{
+const Mod* MissivesPlugin() noexcept
+{
+    auto* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    return pMod && pMod->IsLoaded() ? pMod : nullptr;
+}
+}
+
+MissiveBoardService::MissiveBoardService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept
+    : m_world(aWorld), m_transport(aTransport)
+{
+    m_connectedConnection = aDispatcher.sink<ConnectedEvent>().connect<&MissiveBoardService::OnConnected>(this);
+    m_disconnectedConnection = aDispatcher.sink<DisconnectedEvent>().connect<&MissiveBoardService::OnDisconnected>(this);
+    m_updateConnection = aDispatcher.sink<UpdateEvent>().connect<&MissiveBoardService::OnUpdate>(this);
+    m_notifyConnection = aDispatcher.sink<NotifyMissivesBoard>().connect<&MissiveBoardService::OnNotify>(this);
+}
+
+const MissiveBoardEntry* MissiveBoardService::FindSpec(uint32_t aQuest) const noexcept
+{
+    const auto it = m_specs.find(aQuest);
+    return it == m_specs.end() ? nullptr : it->second;
+}
+
+void MissiveBoardService::RegisterLocalQuests() noexcept
+{
+    const Mod* pMod = MissivesPlugin();
+    if (!pMod) return;
+    for (const auto& entry : cMissiveBoardEntries)
+    {
+        const uint32_t questId = pMod->GetFormId(entry.Quest);
+        const uint32_t bookId = pMod->GetFormId(entry.Book);
+        if (!questId || !bookId) continue;
+        m_specs[questId] = &entry;
+        MissiveBoardBridge::SetQuestSpec(questId, {entry.PostingAlias, entry.BoardAlias, bookId});
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(questId));
+        if (pQuest && !pQuest->IsStopped() && pQuest->currentStage >= 20 && pQuest->currentStage < 103)
+        {
+            m_personal.insert(questId);
+            MissiveBoardBridge::SetPersonal(questId, true);
+        }
+    }
+}
+
+void MissiveBoardService::OnConnected(const ConnectedEvent&) noexcept
+{
+    m_serverSession = 0;
+    m_enabled = MissivesPlugin() != nullptr;
+    m_specs.clear();
+    m_listings.clear();
+    m_personal.clear();
+    m_owned.clear();
+    m_pendingPublish.clear();
+    m_pendingFinish.clear();
+    MissiveBoardBridge::SetConnection(m_enabled);
+    if (!m_enabled) return;
+    RegisterLocalQuests();
+    m_nextHello = std::chrono::steady_clock::now();
+    spdlog::info("STR Missives board sync detected Missives.esp: enabled {}, posting forms {}", m_enabled, m_specs.size());
+}
+
+void MissiveBoardService::OnDisconnected(const DisconnectedEvent&) noexcept
+{
+    m_serverSession = 0;
+    m_listings.clear();
+    m_pendingPublish.clear();
+    m_pendingFinish.clear();
+    MissiveBoardBridge::SetConnection(false);
+}
+
+bool MissiveBoardService::Send(RequestMissivesBoard::Operation aOperation, const MissiveBoardListing& acListing) noexcept
+{
+    if (!m_transport.IsOnline()) return false;
+    if (aOperation != RequestMissivesBoard::Operation::Hello && !m_serverSession) return false;
+    RequestMissivesBoard request;
+    request.Action = aOperation;
+    request.ServerSession = m_serverSession;
+    request.Listing = acListing;
+    return m_transport.Send(request);
+}
+
+void MissiveBoardService::OnUpdate(const UpdateEvent&) noexcept
+{
+    if (!m_enabled || !m_transport.IsOnline()) return;
+    const auto now = std::chrono::steady_clock::now();
+    if (!m_serverSession)
+    {
+        if (now >= m_nextHello)
+        {
+            Send(RequestMissivesBoard::Operation::Hello);
+            m_nextHello = now + std::chrono::seconds(2);
+        }
+        return;
+    }
+
+    for (const auto& event : MissiveBoardBridge::Drain()) Handle(event);
+
+    for (auto it = m_pendingPublish.begin(); it != m_pendingPublish.end();)
+        if (now - it->second > std::chrono::seconds(3)) it = m_pendingPublish.erase(it);
+        else ++it;
+
+    const Mod* pMod = MissivesPlugin();
+    if (!pMod) return;
+    for (auto it = m_personal.begin(); it != m_personal.end();)
+    {
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(*it));
+        if (pQuest && !pQuest->IsStopped() && pQuest->currentStage < 103)
+        {
+            ++it;
+            continue;
+        }
+        MissiveBoardBridge::SetPersonal(*it, false);
+        it = m_personal.erase(it);
+    }
+
+    for (auto it = m_owned.begin(); it != m_owned.end();)
+    {
+        const uint32_t questId = it->first;
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(questId));
+        if (pQuest && !pQuest->IsStopped() && pQuest->currentStage < 103)
+        {
+            ++it;
+            continue;
+        }
+        const auto listing = m_listings.find(*it);
+        if (listing != m_listings.end() && listing->second.State == 2)
+        {
+            if (Send(RequestMissivesBoard::Operation::Finish, listing->second.Data))
+            {
+                listing->second.State = 3;
+                MissiveBoardBridge::SetListing(it->first, it->second, listing->second.Data.Id, 3);
+            }
+        }
+        it = m_owned.erase(it);
+    }
+
+    for (auto& [key, listing] : m_listings)
+    {
+        if (listing.State != 0 || !MissiveBoardBridge::Call(MissiveBoardBridge::Operation::Authority, key.second)) continue;
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(key.first));
+        if (pQuest && !pQuest->IsStopped() && pQuest->currentStage < 103) continue;
+        if (m_pendingFinish.contains(key)) continue;
+        if (Send(RequestMissivesBoard::Operation::Finish, listing.Data))
+            m_pendingFinish[key] = now;
+    }
+    for (auto it = m_pendingFinish.begin(); it != m_pendingFinish.end();)
+        if (now - it->second > std::chrono::seconds(3)) it = m_pendingFinish.erase(it);
+        else ++it;
+}
+
+void MissiveBoardService::Handle(const MissiveBoardBridge::Event& acEvent) noexcept
+{
+    using O = MissiveBoardBridge::Operation;
+    MissiveBoardListing listing;
+    if (acEvent.Action == O::Open || acEvent.Action == O::Close)
+    {
+        if (!m_world.GetModSystem().GetServerModId(acEvent.Quest, listing.Board)) return;
+        if (acEvent.Action == O::Close)
+        {
+            MissiveBoardBridge::SetBoardReady(acEvent.Quest, false);
+            MissiveBoardBridge::SetBoardAuthority(acEvent.Quest, false);
+        }
+        Send(acEvent.Action == O::Open ? RequestMissivesBoard::Operation::Open : RequestMissivesBoard::Operation::Close, listing);
+        return;
+    }
+    const auto* pSpec = FindSpec(acEvent.Quest);
+    const Mod* pMod = MissivesPlugin();
+    if (!pSpec || !pMod || !m_world.GetModSystem().GetServerModId(acEvent.Quest, listing.Quest)
+        || !m_world.GetModSystem().GetServerModId(acEvent.Board, listing.Board))
+        return;
+    const ListingKey key{acEvent.Quest, acEvent.Board};
+    auto current = m_listings.find(key);
+
+    if (acEvent.Action == O::Publish)
+    {
+        if (current != m_listings.end() || m_pendingPublish.contains(key) || !MissiveBoardBridge::Call(O::CanGenerate, acEvent.Quest, acEvent.Board)) return;
+        auto* pQuest = Cast<TESQuest>(TESForm::GetById(acEvent.Quest));
+        auto* pPosting = pQuest ? pQuest->GetAliasedRef(pSpec->PostingAlias) : nullptr;
+        if (!pQuest || pQuest->IsStopped() || pQuest->currentStage != 0 || !pPosting || !pPosting->baseForm
+            || pPosting->baseForm->formID != pMod->GetFormId(pSpec->Book))
+            return;
+        if (!m_world.GetModSystem().GetServerModId(pPosting->baseForm->formID, listing.Book)) return;
+        listing.Valid = true;
+        if (Send(RequestMissivesBoard::Operation::Publish, listing)) m_pendingPublish[key] = std::chrono::steady_clock::now();
+        return;
+    }
+    if (acEvent.Action == O::Claim)
+    {
+        if (current == m_listings.end() || current->second.State != 0) return;
+        Send(RequestMissivesBoard::Operation::Claim, current->second.Data);
+        return;
+    }
+    if (acEvent.Action == O::Finish)
+    {
+        if (current == m_listings.end() || current->second.State != 0
+            || !MissiveBoardBridge::Call(MissiveBoardBridge::Operation::Authority, acEvent.Board)) return;
+        if (Send(RequestMissivesBoard::Operation::Finish, current->second.Data))
+            m_pendingFinish[key] = std::chrono::steady_clock::now();
+    }
+}
+
+void MissiveBoardService::OnNotify(const NotifyMissivesBoard& acMessage) noexcept
+{
+    if (!m_enabled) return;
+    if (acMessage.Action == NotifyMissivesBoard::Operation::Ready)
+    {
+        m_serverSession = acMessage.ServerSession;
+        if (!m_serverSession) return;
+        MissiveBoardBridge::SetReady(true);
+        spdlog::info("STR Missives board server handshake complete");
+        return;
+    }
+    if (!m_serverSession || acMessage.ServerSession != m_serverSession) return;
+
+    if (acMessage.Action == NotifyMissivesBoard::Operation::BoardControl)
+    {
+        const uint32_t boardId = m_world.GetModSystem().GetGameId(acMessage.Listing.Board);
+        MissiveBoardBridge::SetBoardAuthority(boardId, acMessage.Authority);
+        return;
+    }
+    const uint32_t boardId = m_world.GetModSystem().GetGameId(acMessage.Listing.Board);
+    if (acMessage.Action == NotifyMissivesBoard::Operation::SnapshotBegin)
+    {
+        if (!boardId) return;
+        for (auto it = m_listings.begin(); it != m_listings.end();)
+            if (it->first.second == boardId) it = m_listings.erase(it);
+            else ++it;
+        MissiveBoardBridge::SetBoardAuthority(boardId, acMessage.Authority);
+        MissiveBoardBridge::BeginSnapshot(boardId);
+        return;
+    }
+    if (acMessage.Action == NotifyMissivesBoard::Operation::SnapshotEnd)
+    {
+        if (boardId) MissiveBoardBridge::EndSnapshot(boardId);
+        return;
+    }
+
+    const uint32_t questId = m_world.GetModSystem().GetGameId(acMessage.Listing.Quest);
+    if (!boardId || !questId) return;
+    const ListingKey key{questId, boardId};
+    if (acMessage.Action == NotifyMissivesBoard::Operation::Posting
+        || acMessage.Action == NotifyMissivesBoard::Operation::Taken
+        || acMessage.Action == NotifyMissivesBoard::Operation::Grant
+        || acMessage.Action == NotifyMissivesBoard::Operation::Retired
+        || acMessage.Action == NotifyMissivesBoard::Operation::Rejected)
+    {
+        int32_t state = acMessage.Action == NotifyMissivesBoard::Operation::Posting ? 0
+            : acMessage.Action == NotifyMissivesBoard::Operation::Taken ? 1
+            : acMessage.Action == NotifyMissivesBoard::Operation::Grant ? 2 : 3;
+        LocalListing local;
+        local.Data = acMessage.Listing;
+        local.State = state;
+        MissiveBoardBridge::SetListing(questId, boardId, acMessage.Listing.Id, state);
+        m_pendingPublish.erase(key);
+        m_pendingFinish.erase(key);
+        if (state == 3)
+        {
+            m_listings.erase(key);
+            m_owned.erase(key);
+            return;
+        }
+        m_listings[key] = local;
+        if (state == 2)
+        {
+            m_owned.insert(key);
+            m_personal.insert(questId);
+            MissiveBoardBridge::SetPersonal(questId, true);
+        }
+        if (acMessage.Action == NotifyMissivesBoard::Operation::Posting)
+            spdlog::info("STR Missives board listing synchronized: board {:X}, quest {:X}, book {:X}", boardId, questId, m_world.GetModSystem().GetGameId(acMessage.Listing.Book));
+        return;
+    }
+}
