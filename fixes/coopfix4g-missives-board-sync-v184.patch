diff --git a/Code/client/ModCompat/MissiveBoardBridge.cpp b/Code/client/ModCompat/MissiveBoardBridge.cpp
new file mode 100644
index 00000000..b8ceabbf
--- /dev/null
+++ b/Code/client/ModCompat/MissiveBoardBridge.cpp
@@ -0,0 +1,199 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/MissiveBoardBridge.h>
+#include <Misc/BSScript.h>
+
+namespace
+{
+using Key = std::pair<uint32_t, uint32_t>;
+std::mutex s_lock;
+bool s_connected{};
+bool s_serverReady{};
+bool s_sawScript{};
+std::map<Key, MissiveBoardBridge::ListingState> s_listings;
+std::set<uint32_t> s_boardReady;
+std::set<uint32_t> s_authorities;
+std::set<uint32_t> s_personal;
+std::set<uint32_t> s_openRequested;
+std::map<uint32_t, MissiveBoardBridge::QuestSpec> s_questSpecs;
+std::vector<MissiveBoardBridge::Event> s_events;
+}
+
+void MissiveBoardBridge::SetConnection(bool aConnected) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_connected = aConnected;
+    s_serverReady = false;
+    s_boardReady.clear();
+    s_authorities.clear();
+    s_listings.clear();
+    s_openRequested.clear();
+    s_personal.clear();
+    if (!aConnected)
+    {
+        s_events.clear();
+    }
+}
+void MissiveBoardBridge::SetReady(bool aReady) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_serverReady = aReady;
+}
+void MissiveBoardBridge::SetBoardReady(uint32_t aBoard, bool aReady) noexcept
+{
+    std::lock_guard lock(s_lock);
+    if (aReady) s_boardReady.insert(aBoard);
+    else s_boardReady.erase(aBoard);
+}
+void MissiveBoardBridge::SetBoardAuthority(uint32_t aBoard, bool aAuthority) noexcept
+{
+    std::lock_guard lock(s_lock);
+    if (aAuthority) s_authorities.insert(aBoard);
+    else s_authorities.erase(aBoard);
+}
+void MissiveBoardBridge::SetListing(uint32_t aQuest, uint32_t aBoard, uint64_t aId, int32_t aStatus) noexcept
+{
+    std::lock_guard lock(s_lock);
+    if (aStatus >= 3)
+    {
+        s_listings.erase({aQuest, aBoard});
+        return;
+    }
+    s_listings[{aQuest, aBoard}] = {aId, aStatus};
+}
+void MissiveBoardBridge::BeginSnapshot(uint32_t aBoard) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_boardReady.erase(aBoard);
+    for (auto it = s_listings.begin(); it != s_listings.end();)
+        if (it->first.second == aBoard) it = s_listings.erase(it);
+        else ++it;
+}
+void MissiveBoardBridge::EndSnapshot(uint32_t aBoard) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_boardReady.insert(aBoard);
+}
+void MissiveBoardBridge::SetPersonal(uint32_t aQuest, bool aPersonal) noexcept
+{
+    std::lock_guard lock(s_lock);
+    if (aPersonal) s_personal.insert(aQuest);
+    else s_personal.erase(aQuest);
+}
+void MissiveBoardBridge::SetQuestSpec(uint32_t aQuest, const QuestSpec& acSpec) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_questSpecs[aQuest] = acSpec;
+}
+std::vector<MissiveBoardBridge::Event> MissiveBoardBridge::Drain() noexcept
+{
+    std::lock_guard lock(s_lock);
+    std::vector<Event> result;
+    result.swap(s_events);
+    return result;
+}
+int32_t MissiveBoardBridge::Call(Operation aOperation, uint32_t aQuest, uint32_t aBoard) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_sawScript = true;
+    const auto it = s_listings.find({aQuest, aBoard});
+    const int32_t state = it == s_listings.end() ? -1 : it->second.Status;
+    switch (aOperation)
+    {
+    case Operation::Connected: return s_connected;
+    case Operation::Ready: return s_connected && s_serverReady;
+    case Operation::BoardReady: return s_serverReady && s_boardReady.contains(aQuest);
+    case Operation::Authority: return s_serverReady && s_boardReady.contains(aQuest) && s_authorities.contains(aQuest);
+    case Operation::CanGenerate:
+        return s_serverReady && s_boardReady.contains(aBoard) && s_authorities.contains(aBoard)
+            && !s_personal.contains(aQuest) && it == s_listings.end();
+    case Operation::Personal: return s_personal.contains(aQuest);
+    case Operation::Status: return state;
+    case Operation::PostingAlias:
+        if (const auto spec = s_questSpecs.find(aQuest); spec != s_questSpecs.end()) return spec->second.PostingAlias;
+        return -1;
+    case Operation::BoardAlias:
+        if (const auto spec = s_questSpecs.find(aQuest); spec != s_questSpecs.end()) return spec->second.BoardAlias;
+        return -1;
+    case Operation::Count:
+    {
+        int32_t count{};
+        for (const auto& [key, listing] : s_listings)
+            if (key.second == aQuest && listing.Status == 0) ++count;
+        return count;
+    }
+    default: break;
+    }
+    if (!s_connected) return 0;
+    if (aOperation == Operation::Open)
+    {
+        if (s_openRequested.insert(aQuest).second) s_events.push_back({aOperation, aQuest, aBoard});
+        return 1;
+    }
+    if (aOperation == Operation::Close)
+    {
+        s_openRequested.erase(aQuest);
+        s_events.push_back({aOperation, aQuest, aBoard});
+        return 1;
+    }
+    s_events.push_back({aOperation, aQuest, aBoard});
+    return 1;
+}
+
+namespace
+{
+void NativeCallbackMarker() {}
+class BridgeFunction final : public BSScript::NativeFunction
+{
+public:
+    BridgeFunction(const char* apName, MissiveBoardBridge::Operation aOperation, uint32_t aArguments, BSScript::Variable::Type aResult)
+        : NativeFunction(apName, "STRMissivesBoardBridge", true, aArguments), m_operation(aOperation), m_arguments(aArguments), m_result(aResult)
+    {
+        pFunction = reinterpret_cast<void*>(&NativeCallbackMarker);
+        returnType = aResult;
+        for (uint32_t i = 0; i < aArguments; ++i) parameters.data[i].type = BSScript::Variable::kInteger;
+        SetCallableFromTasklets(false);
+    }
+    bool MarshallAndDispatch(BSScript::Variable*, BSScript::IVirtualMachine*, uint32_t, BSScript::Variable* apResult, BSScript::StackFrame* apFrame) override
+    {
+        uint32_t values[2]{};
+        if (m_arguments)
+        {
+            const uint32_t cPage = apFrame->GetPageForFrame();
+            for (uint32_t i = 0; i < m_arguments; ++i)
+            {
+                auto* pArgument = apFrame->GetStackFrameVariable(i, cPage);
+                if (!pArgument || pArgument->type != BSScript::Variable::kInteger) return false;
+                values[i] = static_cast<uint32_t>(pArgument->data.i);
+            }
+        }
+        const int32_t result = MissiveBoardBridge::Call(m_operation, values[0], values[1]);
+        if (m_result == BSScript::Variable::kBoolean) apResult->Set<bool>(result != 0);
+        else if (m_result == BSScript::Variable::kInteger) apResult->Set<int32_t>(result);
+        else apResult->Clear();
+        return true;
+    }
+private:
+    MissiveBoardBridge::Operation m_operation;
+    uint32_t m_arguments;
+    BSScript::Variable::Type m_result;
+};
+}
+
+void RegisterMissiveBoardBridge(BSScript::IVirtualMachine* apVm) noexcept
+{
+    using O = MissiveBoardBridge::Operation;
+    using V = BSScript::Variable;
+    struct Binding { const char* Name; O Operation; uint32_t Arguments; V::Type Result; };
+    const Binding bindings[] = {
+        {"IsConnected",O::Connected,0,V::kBoolean},{"IsReady",O::Ready,0,V::kBoolean},
+        {"IsBoardReady",O::BoardReady,1,V::kBoolean},{"IsBoardAuthority",O::Authority,1,V::kBoolean},
+        {"CanGenerate",O::CanGenerate,2,V::kBoolean},{"IsPersonalQuest",O::Personal,1,V::kBoolean},
+        {"GetPostingStatus",O::Status,2,V::kInteger},
+        {"GetPostingAlias",O::PostingAlias,1,V::kInteger},{"GetBoardAlias",O::BoardAlias,1,V::kInteger},
+        {"GetPostingCount",O::Count,1,V::kInteger},{"OpenBoard",O::Open,2,V::kEmpty},
+        {"CloseBoard",O::Close,1,V::kEmpty},{"Publish",O::Publish,2,V::kEmpty},
+        {"Claim",O::Claim,2,V::kBoolean},{"Finish",O::Finish,2,V::kEmpty}
+    };
+    for (const auto& binding : bindings)
+        apVm->BindNativeMethod(new BridgeFunction(binding.Name, binding.Operation, binding.Arguments, binding.Result));
+}
