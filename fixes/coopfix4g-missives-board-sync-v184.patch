+
+TEST_CASE("Exit-only replay requires a reset even when its action list is empty", "[animation.replay]")
+{
+    ActionReplayCache cache;
+    cache.AppendAll({MakeReplayAction("IdleChairFrontEnter"), MakeReplayAction("IdleChairExitToStand")});
