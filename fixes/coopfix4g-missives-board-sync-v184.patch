@@ -0,0 +1,28 @@
+#include <Structs/DroppedItemData.h>
+#include <TiltedCore/Serialization.hpp>
+
+void DroppedItemData::Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    TiltedPhoques::Serialization::WriteVarInt(aWriter, Id);
+    Item.Serialize(aWriter);
+    Cell.Serialize(aWriter);
+    WorldSpace.Serialize(aWriter);
+    Position.Serialize(aWriter);
+    TiltedPhoques::Serialization::WriteFloat(aWriter, Rotation.x);
+    TiltedPhoques::Serialization::WriteFloat(aWriter, Rotation.y);
+    TiltedPhoques::Serialization::WriteFloat(aWriter, Rotation.z);
+    TiltedPhoques::Serialization::WriteBool(aWriter, PlacementReady);
+}
+
+void DroppedItemData::Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    Id = TiltedPhoques::Serialization::ReadVarInt(aReader);
+    Item.Deserialize(aReader);
+    Cell.Deserialize(aReader);
+    WorldSpace.Deserialize(aReader);
+    Position.Deserialize(aReader);
+    Rotation.x = TiltedPhoques::Serialization::ReadFloat(aReader);
+    Rotation.y = TiltedPhoques::Serialization::ReadFloat(aReader);
+    Rotation.z = TiltedPhoques::Serialization::ReadFloat(aReader);
+    PlacementReady = TiltedPhoques::Serialization::ReadBool(aReader);
+}
