diff --git a/Code/client/ModCompat/MissiveBoardSync.cpp b/Code/client/ModCompat/MissiveBoardSync.cpp
new file mode 100644
index 00000000..524c8e18
--- /dev/null
+++ b/Code/client/ModCompat/MissiveBoardSync.cpp
@@ -0,0 +1,55 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/MissiveBoardSync.h>
+#include <ModCompat/MissiveBoardCatalog.h>
+#include <ExtraData/ExtraTextDisplayData.h>
+#include <ExtraData/ExtraDataList.h>
+#include <Forms/TESQuest.h>
+
+namespace
+{
+struct AliasOwnerView
+{
+    TESQuest* pQuest;
+    const void* pAlias;
+    const void* pPackages;
+};
+struct AliasArrayView : BSExtraData
+{
+    GameArray<AliasOwnerView*> Aliases;
+    BSReadWriteLock Lock;
+};
+static_assert(sizeof(AliasOwnerView) == 0x18);
+static_assert(offsetof(AliasArrayView, Aliases) == 0x10);
+static_assert(offsetof(AliasArrayView, Lock) == 0x28);
+static_assert(sizeof(AliasArrayView) == 0x30);
+
+struct AliasReadGuard
+{
+    explicit AliasReadGuard(BSReadWriteLock& aLock) noexcept : Lock(aLock)
+    {
+        TP_THIS_FUNCTION(TLock, void, BSReadWriteLock);
+        POINTER_SKYRIMSE(TLock, s_lock, 68233);
+        TiltedPhoques::ThisCall(s_lock, &Lock);
+    }
+    ~AliasReadGuard() noexcept
+    {
+        TP_THIS_FUNCTION(TUnlock, void, BSReadWriteLock);
+        POINTER_SKYRIMSE(TUnlock, s_unlock, 68239);
+        TiltedPhoques::ThisCall(s_unlock, &Lock);
+    }
+    BSReadWriteLock& Lock;
+};
+}
+
+bool MissiveBoardSync::IsPersonalQuestData(ExtraDataList* apExtraData) noexcept
+{
+    if (!apExtraData) return false;
+    const auto* pText = Cast<ExtraTextDisplayData>(apExtraData->GetByType(ExtraDataType::TextDisplayData));
+    if (pText && IsMissivesForm(pText->pOwnerQuest)) return true;
+    auto* pAliases = reinterpret_cast<AliasArrayView*>(apExtraData->GetByType(ExtraDataType::AliasInstanceArray));
+    if (!pAliases) return false;
+    AliasReadGuard guard(pAliases->Lock);
+    for (const auto* pOwner : pAliases->Aliases)
+        if (pOwner && IsMissivesForm(pOwner->pQuest)) return true;
+    return false;
+}
diff --git a/Code/client/ModCompat/MissiveBoardSync.h b/Code/client/ModCompat/MissiveBoardSync.h
new file mode 100644
index 00000000..9758ae03
--- /dev/null
+++ b/Code/client/ModCompat/MissiveBoardSync.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <Games/TES.h>
+#include <Forms/TESForm.h>
+#include <TESObjectREFR.h>
+#include <ModCompat/MissiveBoardCatalog.h>
+#include <algorithm>
+#include <array>
+
+namespace MissiveBoardSync
+{
+bool IsPersonalQuestData(ExtraDataList* apExtraData) noexcept;
+inline bool IsMissivesForm(const TESForm* apForm) noexcept
+{
+    if (!apForm) return false;
+    ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    return pMod && pMod->IsLoaded() && !pMod->IsLite()
+        && pMod->GetFormId(apForm->formID & 0xFFFFFFu) == apForm->formID;
+}
+inline bool IsPosting(const TESForm* apForm) noexcept
+{
+    if (!apForm || apForm->formType != FormType::Book) return false;
+    ModManager* pManager = ModManager::Get();
+    const Mod* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    if (!pMod || !pMod->IsLoaded()) return false;
+    for (const auto& entry : cMissiveBoardEntries)
+        if (pMod->GetFormId(entry.Book) == apForm->formID) return true;
+    return false;
+}
+inline bool IsBoard(const TESObjectREFR* apReference) noexcept
+{
+    return apReference && apReference->baseForm && apReference->baseForm->formType == FormType::Container
+        && (apReference->baseForm->formID & 0xFFFFFFu) == 0x12CBu && IsMissivesForm(apReference->baseForm);
+}
+}
