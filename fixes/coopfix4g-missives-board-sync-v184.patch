+    const auto replay = cache.FormRefinedReplayChain();
+    REQUIRE(replay.ResetAnimationGraph);
+    REQUIRE(replay.Actions.empty());
+
+    // Subsequent joining clients must receive the same exit/reset instruction.
+    const auto repeated = cache.FormRefinedReplayChain();
+    REQUIRE(repeated.ResetAnimationGraph);
+    REQUIRE(repeated.Actions.empty());
+
+    // The instruction must survive the real network payload round trip.
+    TiltedPhoques::Buffer buffer(4096);
+    TiltedPhoques::Buffer::Writer writer(&buffer);
+    replay.Serialize(writer);
+    TiltedPhoques::Buffer::Reader reader(&buffer);
+    ActionReplayChain decoded;
+    decoded.Deserialize(reader);
+    REQUIRE(decoded == replay);
+}
+
+TEST_CASE("A seated NPC replay preserves its enter state", "[animation.replay]")
+{
+    ActionReplayCache cache;
+    cache.AppendAll({MakeReplayAction("IdleChairFrontEnter")});
+    const auto replay = cache.FormRefinedReplayChain();
+    REQUIRE_FALSE(replay.ResetAnimationGraph);
+    REQUIRE(replay.Actions.size() == 1);
+    REQUIRE(replay.Actions.front().EventName == "IdleChairEnterInstant");
+}
+
+TEST_CASE("Exit followed by a different furniture enter retains the new action", "[animation.replay]")
+{
+    ActionReplayCache cache;
+    cache.AppendAll({MakeReplayAction("IdleChairFrontEnter"), MakeReplayAction("IdleChairExitToStand"), MakeReplayAction("IdleBedLeftEnterStart")});
+    const auto replay = cache.FormRefinedReplayChain();
+    REQUIRE(replay.ResetAnimationGraph);
+    REQUIRE(replay.Actions.size() == 1);
+    REQUIRE(replay.Actions.front().EventName == "IdleBedLeftEnterInstant");
+}
+
+TEST_CASE("A cache with no observed animations does not invent a reset or a pose", "[animation.replay]")
+{
+    ActionReplayCache cache;
+    const auto replay = cache.FormRefinedReplayChain();
+    REQUIRE_FALSE(replay.ResetAnimationGraph);
+    REQUIRE(replay.Actions.empty());
+}
+
+TEST_CASE("EnTT initializes the original replay counter on creation and replacement", "[animation.replay]")
+{
+    entt::registry registry;
+    const auto entity = registry.create();
+    auto& created = registry.emplace_or_replace<RemoteAnimationComponent>(entity);
+    REQUIRE(created.ReplayCount == 0);
+    REQUIRE_FALSE(created.ResetAnimationGraphForReplay);
+    created.ReplayCount = 7;
+    created.ResetAnimationGraphForReplay = true;
+    auto& replaced = registry.emplace_or_replace<RemoteAnimationComponent>(entity);
+    REQUIRE(replaced.ReplayCount == 0);
+    REQUIRE_FALSE(replaced.ResetAnimationGraphForReplay);
+}
+
+TEST_CASE("Furniture recovery exit replaces a stale chair replay", "[animation.replay][furniture]")
+{
+    ActionReplayCache cache;
+    cache.AppendAll({MakeReplayAction("IdleChairFrontEnter"), MakeReplayAction("ForceFurnExit")});
+    const auto replay = cache.FormRefinedReplayChain();
+    REQUIRE(replay.ResetAnimationGraph);
+    REQUIRE(replay.Actions.empty());
+    const auto repeated = cache.FormRefinedReplayChain();
+    REQUIRE(repeated.ResetAnimationGraph);
+    REQUIRE(repeated.Actions.empty());
+}
diff --git a/Code/tests/corpse_speech_window.cpp b/Code/tests/corpse_speech_window.cpp
new file mode 100644
index 00000000..bc6c3bac
--- /dev/null
+++ b/Code/tests/corpse_speech_window.cpp
@@ -0,0 +1,112 @@
+#include <catch2/catch.hpp>
+#include "../client/Systems/CorpseSpeechWindow.h"
+#include "../client/Systems/CorpseLifeState.h"
+
+#include <limits>
+
+TEST_CASE("Corpse speech allows a final line before a bounded death deadline", "[corpse.speech]")
+{
+    CorpseSpeechWindow window;
+    CHECK_FALSE(window.Observe(42, true, 100));
+    CHECK_FALSE(window.Observe(42, true, 4099));
+    CHECK(window.Observe(42, true, 4100));
+}
+
+TEST_CASE("Repeated late speech cannot extend an expired corpse deadline", "[corpse.speech]")
+{
+    CorpseSpeechWindow window;
+    CHECK_FALSE(window.Observe(42, true, 100));
+    for (uint64_t time = 200; time < 4100; time += 100)
+        CHECK_FALSE(window.Observe(42, true, time));
+    CHECK(window.Observe(42, true, 4100));
+    CHECK(window.Observe(42, true, 90000));
+}
+
+TEST_CASE("A revived actor regains speech and a later death receives a new grace period", "[corpse.speech]")
+{
+    CorpseSpeechWindow window;
+    CHECK_FALSE(window.Observe(42, true, 0));
+    REQUIRE(window.Observe(42, true, 4000));
+    CHECK_FALSE(window.Observe(42, false, 4100));
+    CHECK_FALSE(window.Observe(42, true, 10000));
+    CHECK_FALSE(window.Observe(42, true, 13999));
+    CHECK(window.Observe(42, true, 14000));
+}
+
+TEST_CASE("A recycled reference handle cannot inherit a corpse speech mute", "[corpse.speech]")
+{
+    CorpseSpeechWindow window;
+    CHECK_FALSE(window.Observe(42, true, 0));
+    REQUIRE(window.Observe(42, true, 4000));
+    CHECK_FALSE(window.Observe(43, true, 4000));
+    CHECK_FALSE(window.Observe(43, true, 7999));
+    CHECK(window.Observe(43, true, 8000));
+}
+
+TEST_CASE("Corpse speech timing handles a clock rollback without unsigned expiry", "[corpse.speech]")
+{
+    CorpseSpeechWindow window;
+    CHECK_FALSE(window.Observe(42, true, 5000));
+    CHECK_FALSE(window.Observe(42, true, 100));
+    CHECK_FALSE(window.Observe(42, true, 4099));
+    CHECK(window.Observe(42, true, 4100));
+    CHECK(window.Observe(42, true, 0));
+    CHECK(window.Observe(42, true, std::numeric_limits<uint64_t>::max()));
+}
+
+TEST_CASE("A stale live action preserves only a confirmed corpse life field", "[corpse.state]")
+{
+    constexpr uint32_t kLifeMask = 0x01E00000;
+    constexpr uint32_t kDead = 2u << 21;
+    constexpr uint32_t kIncoming = 0xA5A5A5A5 & ~kLifeMask;
+    const uint32_t result = PreserveConfirmedCorpseLifeState(kDead | 0x12345, kIncoming, true);
+    CHECK((result & kLifeMask) == kDead);
+    CHECK((result & ~kLifeMask) == (kIncoming & ~kLifeMask));
+}
+
+TEST_CASE("Dying actors retain their normal transition into a completed death", "[corpse.state]")
+{
+    constexpr uint32_t kDead = 2u << 21;
+    CHECK(PreserveConfirmedCorpseLifeState(1u << 21, kDead | 17, true) == (kDead | 17));
+    CHECK(PreserveConfirmedCorpseLifeState(1u << 21, 31, true) == 31);
+    CHECK(PreserveConfirmedCorpseLifeState(0, 47, true) == 47);
+}
+
+TEST_CASE("An accepted resurrection or unknown death state does not retain corpse bits", "[corpse.state]")
+{
+    constexpr uint32_t kDead = 2u << 21;
+    CHECK(PreserveConfirmedCorpseLifeState(kDead | 9, 23, false) == 23);
+    CHECK(PreserveConfirmedCorpseLifeState(kDead, 4u << 21, false) == (4u << 21));
+}
+
+TEST_CASE("Remote NPC pose cannot fabricate native death before KillImpl", "[corpse.state]")
+{
+    constexpr uint32_t mask = 0x01E00000;
+    for (bool confirmed : {false, true})
+        for (uint32_t life : {1u, 2u})
+        {
+            const uint32_t result = PreserveRemoteNpcDeathTransition(17, (life << 21) | 29, confirmed);
+            CHECK((result & mask) == 0);
+            CHECK((result & ~mask) == 29);
+        }
+}
+TEST_CASE("Remote dying NPC keeps its native transition instead of replaying a fake completion", "[corpse.state]")
+{
+    constexpr uint32_t mask = 0x01E00000;
+    for (uint32_t incoming : {0u, 1u, 2u})
+        CHECK((PreserveRemoteNpcDeathTransition(1u << 21, incoming << 21, true) & mask) == (1u << 21));
+}
+TEST_CASE("Native corpse completion and actual resurrection supersede stale pose life bits", "[corpse.state]")
+{
+    constexpr uint32_t mask = 0x01E00000;
+    CHECK((PreserveRemoteNpcDeathTransition(2u << 21, 17, true) & mask) == (2u << 21));
+    CHECK((PreserveRemoteNpcDeathTransition(0, 2u << 21, false) & mask) == 0);
+    CHECK(PreserveRemoteNpcDeathTransition(0, 8u << 21, false) == (8u << 21));
+}
+TEST_CASE("Native death processing excludes living unconscious and essential down states", "[corpse.state]")
+{
+    CHECK(IsNativeDeathTransition(1u << 21));
+    CHECK(IsNativeDeathTransition(2u << 21));
+    for (uint32_t state : {0u, 3u, 4u, 5u, 6u, 7u, 8u})
+        CHECK_FALSE(IsNativeDeathTransition(state << 21));
+}
diff --git a/Code/tests/corpse_state_refresh_window.cpp b/Code/tests/corpse_state_refresh_window.cpp
new file mode 100644
index 00000000..84408f73
--- /dev/null
+++ b/Code/tests/corpse_state_refresh_window.cpp
@@ -0,0 +1,59 @@
+#include <catch2/catch.hpp>
+#include "../client/Systems/CorpseStateRefreshWindow.h"
+
+TEST_CASE("Corpse refresh waits one second and fires only once per authoritative death", "[corpse.refresh]")
+{
+    CorpseStateRefreshWindow window;
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 100));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 1099));
+    REQUIRE(window.Observe(42, 7, 1, true, true, 1100));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 100000));
+}
+
+TEST_CASE("Unready corpses retain the deadline without consuming the attempt", "[corpse.refresh]")
+{
+    CorpseStateRefreshWindow window;
+    CHECK_FALSE(window.Observe(42, 7, 1, true, false, 100));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, false, 5000));
+    REQUIRE(window.Observe(42, 7, 1, true, true, 5001));
+}
+
+TEST_CASE("An authoritative resurrection cancels the old corpse refresh deadline", "[corpse.refresh]")
+{
+    CorpseStateRefreshWindow window;
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 0));
+    CHECK_FALSE(window.Observe(42, 7, 1, false, true, 1000));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 2000));
+    REQUIRE(window.Observe(42, 7, 1, true, true, 3000));
+}
+
+TEST_CASE("Recycled corpse handles and ownership epochs cannot inherit an old timer", "[corpse.refresh]")
+{
+    for (int identity = 0; identity < 3; ++identity)
+    {
+        CorpseStateRefreshWindow window;
+        CHECK_FALSE(window.Observe(42, 7, 1, true, true, 0));
+        const uint32_t handle = identity == 0 ? 43 : 42;
+        const uint32_t server = identity == 1 ? 8 : 7;
+        const uint32_t epoch = identity == 2 ? 2 : 1;
+        CHECK_FALSE(window.Observe(handle, server, epoch, true, true, 1000));
+        REQUIRE(window.Observe(handle, server, epoch, true, true, 2000));
+    }
+}
+
+TEST_CASE("Invalid corpse identities and backwards clocks cannot trigger a refresh", "[corpse.refresh]")
+{
+    CorpseStateRefreshWindow window;
+    CHECK_FALSE(window.Observe(0, 7, 1, true, true, 0));
+    CHECK_FALSE(window.Observe(0, 7, 1, true, true, 5000));
+    CHECK_FALSE(window.Observe(42, 0xFFFFFFFFu, 1, true, true, 5000));
+    CHECK_FALSE(window.Observe(42, 7, 0, true, true, 5000));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 5000));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 1000));
+    CHECK_FALSE(window.Observe(42, 7, 1, true, true, 1999));
+    REQUIRE(window.Observe(42, 7, 1, true, true, 2000));
+    // EnTT server entity zero is valid; only its null sentinel is invalid.
+    CorpseStateRefreshWindow zeroId;
+    CHECK_FALSE(zeroId.Observe(42, 0, 1, true, true, 0));
+    REQUIRE(zeroId.Observe(42, 0, 1, true, true, 1000));
+}
diff --git a/Code/tests/dropped_item_binding.cpp b/Code/tests/dropped_item_binding.cpp
new file mode 100644
index 00000000..ce28749c
--- /dev/null
+++ b/Code/tests/dropped_item_binding.cpp
@@ -0,0 +1,52 @@
+#include <catch2/catch.hpp>
+#include "../client/Systems/DroppedItemBinding.h"
+
+TEST_CASE("A registration ACK preserves a pickup reserved before its queue task runs", "[drops][identity]")
+{
+    DroppedItemBinding binding{0x123456, 0, 81, false};
+    binding.Busy = true; // Native hook reserves; its runner task is not drained yet.
+    REQUIRE(binding.ResolveQueuedPickup(0x123456, 81) == 0);
+    binding.BindRegistered(0x123456, 9001, 81, false);
+    REQUIRE(binding.Busy);
+    REQUIRE(binding.Nonce == 81);
+    REQUIRE(binding.ResolveQueuedPickup(0x123456, 81) == 9001);
+    // Repeated ACK does not clear the outstanding reservation.
+    binding.BindRegistered(0x123456, 9001, 81, false);
+    REQUIRE(binding.Busy);
+    REQUIRE(binding.ResolveQueuedPickup(0x123456, 81) == 9001);
+}
+
+TEST_CASE("Pickup-before-ACK and ACK-before-pickup retain the same registered identity", "[drops][identity]")
+{
+    DroppedItemBinding queuedFirst{100, 0, 4, true};
+    queuedFirst.BindRegistered(100, 77, 4, true);
+    DroppedItemBinding ackFirst{100, 0, 4, false};
+    ackFirst.BindRegistered(100, 77, 4, false);
+    ackFirst.Busy = true;
+    REQUIRE(queuedFirst.ResolveQueuedPickup(100, 4) == 77);
+    REQUIRE(ackFirst.ResolveQueuedPickup(100, 4) == 77);
+    REQUIRE(queuedFirst.Busy);
+    REQUIRE(ackFirst.Busy);
+}
+
+TEST_CASE("A delayed pickup cannot retarget a recycled reference or a different drop nonce", "[drops][identity]")
+{
+    DroppedItemBinding binding{100, 77, 4, true};
+    binding.BindRegistered(200, 88, 5, false);
+    REQUIRE_FALSE(binding.Busy);
+    binding.Busy = true;
+    REQUIRE(binding.ResolveQueuedPickup(100, 4) == 0);
+    REQUIRE(binding.ResolveQueuedPickup(200, 4) == 0);
+    REQUIRE(binding.ResolveQueuedPickup(100, 5) == 0);
+    REQUIRE(binding.ResolveQueuedPickup(200, 5) == 88);
+    REQUIRE(binding.Busy); // Ignoring a stale task must not release the new pickup.
+}
+
+TEST_CASE("An unreserved drop remains pickable after its registration ACK", "[drops][identity]")
+{
+    DroppedItemBinding binding{100, 0, 4, false};
+    binding.BindRegistered(100, 77, 4, false);
+    REQUIRE_FALSE(binding.Busy);
+    REQUIRE(binding.Nonce == 4);
+    REQUIRE(binding.ResolveQueuedPickup(100, 4) == 77);
+}
diff --git a/Code/tests/dropped_item_placement.cpp b/Code/tests/dropped_item_placement.cpp
new file mode 100644
index 00000000..3e09d34a
--- /dev/null
+++ b/Code/tests/dropped_item_placement.cpp
@@ -0,0 +1,148 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <TiltedCore/Serialization.hpp>
+#include <glm/glm.hpp>
+#include <optional>
+#include <catch2/catch.hpp>
+#include <Messages/ClientMessageFactory.h>
+#include <Messages/ServerMessageFactory.h>
+#include <Messages/RequestDroppedItem.h>
+#include <Messages/NotifyDroppedItem.h>
+#include <Game/Inventory/DroppedItemLedger.h>
+#include "../client/Systems/DropPlacementClock.h"
+#include <limits>
+
+namespace
+{
+DroppedItemData PlacedDrop()
+{
+    DroppedItemData data;
+    data.Item.BaseId = GameId(0, 0x123);
+    data.Item.Count = 2;
+    data.Cell = GameId(0, 0x200);
+    data.Position = glm::vec3(10.f, 20.f, 30.f);
+    return data;
+}
+}
+
+TEST_CASE("Only a drop creator can update placement without changing stack identity", "[drops][placement]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, PlacedDrop());
+    REQUIRE(created);
+    auto pose = PlacedDrop();
+    pose.Position.z = -10.f;
+    pose.Item.Count = 999;
+    pose.Item.BaseId = GameId(9, 0x999);
+    REQUIRE_FALSE(ledger.UpdatePlacement(created->Data.Id, 200, pose));
+    const auto update = ledger.UpdatePlacement(created->Data.Id, 100, pose);
+    REQUIRE(update);
+    REQUIRE(update->Data.PlacementReady);
+    REQUIRE(update->Data.Position.z == -10.f);
+    REQUIRE(update->Data.Item.Count == 2);
+    REQUIRE(update->Data.Item.BaseId == created->Data.Item.BaseId);
+    REQUIRE(ledger.Snapshot(300)[0].Data.PlacementReady);
+    REQUIRE(ledger.FindCreated(100, 1)->Data.Position.z == -10.f);
+}
+
+TEST_CASE("Placement updates cannot revive consumed drops or accept nonfinite coordinates", "[drops][placement]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, PlacedDrop());
+    REQUIRE(created);
+    auto pose = PlacedDrop();
+    pose.Position.z = std::numeric_limits<float>::quiet_NaN();
+    REQUIRE_FALSE(ledger.UpdatePlacement(created->Data.Id, 100, pose));
+    pose = PlacedDrop();
+    pose.Rotation.y = std::numeric_limits<float>::infinity();
+    REQUIRE_FALSE(ledger.UpdatePlacement(created->Data.Id, 100, pose));
+    pose = PlacedDrop();
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 9) == DroppedItemLedger::ClaimResult::Granted);
+    REQUIRE_FALSE(ledger.UpdatePlacement(created->Data.Id, 100, pose));
+    REQUIRE_FALSE(ledger.Get(created->Data.Id)->Active);
+    REQUIRE(ledger.Snapshot(300).empty());
+}
+
+TEST_CASE("Drop placement messages and snapshots retain placement through real factories", "[drops][encoding]")
+{
+    RequestDroppedItem request;
+    request.Action = RequestDroppedItem::Operation::Placement;
+    request.ClientSession = 100;
+    request.ServerSession = 200;
+    request.ActorId = 9;
+    request.OwnershipEpoch = 3;
+    request.Nonce = 8;
+    request.Data = PlacedDrop();
+    request.Data.Id = 77;
+    request.Data.PlacementReady = true;
+    TiltedPhoques::Buffer upstream(16384);
+    TiltedPhoques::Buffer::Writer writer(&upstream);
+    request.Serialize(writer);
+    TiltedPhoques::Buffer::Reader reader(&upstream);
+    auto decoded = ClientMessageFactory{}.Extract(reader);
+    REQUIRE(decoded);
+    REQUIRE(decoded->GetOpcode() == kRequestDroppedItem);
+    const auto* result = static_cast<RequestDroppedItem*>(decoded.get());
+    REQUIRE(result->Action == request.Action);
+    REQUIRE(result->Data.PlacementReady);
+    REQUIRE(result->Data.Id == 77);
+    REQUIRE(result->Data.Position == request.Data.Position);
+    for (const auto action : {NotifyDroppedItem::Operation::Placement, NotifyDroppedItem::Operation::Spawn})
+    {
+        NotifyDroppedItem notify;
+        notify.Action = action;
+        notify.Data = request.Data;
+        TiltedPhoques::Buffer buffer(16384);
+        TiltedPhoques::Buffer::Writer out(&buffer);
+        notify.Serialize(out);
+        TiltedPhoques::Buffer::Reader in(&buffer);
+        auto message = ServerMessageFactory{}.Extract(in);
+        REQUIRE(message);
+        REQUIRE(message->GetOpcode() == kNotifyDroppedItem);
+        const auto* received = static_cast<NotifyDroppedItem*>(message.get());
+        REQUIRE(received->Data.PlacementReady);
+        REQUIRE(received->Data.Item == notify.Data.Item);
+        REQUIRE(received->Data.Position == notify.Data.Position);
+    }
+}
+
+TEST_CASE("Drop placement waits for stable samples and rate limits later movement", "[drops][timing]")
+{
+    DropPlacementClock clock;
+    glm::vec3 p(0.f), r(0.f);
+    REQUIRE_FALSE(clock.Observe(true, p, r, 0));
+    p.z = -10.f;
+    REQUIRE_FALSE(clock.Observe(true, p, r, 250));
+    REQUIRE_FALSE(clock.Observe(true, p, r, 500));
+    REQUIRE(clock.Observe(true, p, r, 750));
+    clock.Published(p, r, 750);
+    REQUIRE_FALSE(clock.Observe(true, p, r, 900));
+    p.x += 20.f;
+    REQUIRE_FALSE(clock.Observe(true, p, r, 1000));
+    REQUIRE(clock.Observe(true, p, r, 1250));
+}
+
+TEST_CASE("An unsent placement remains pending until publication is confirmed", "[drops][timing]")
+{
+    DropPlacementClock clock;
+    glm::vec3 p(1.f), r(0.f);
+    REQUIRE_FALSE(clock.Observe(true, p, r, 0));
+    REQUIRE_FALSE(clock.Observe(true, p, r, 250));
+    REQUIRE(clock.Observe(true, p, r, 500));
+    REQUIRE(clock.Observe(true, p, r, 750));
+    clock.Published(p, r, 750);
+    REQUIRE_FALSE(clock.Observe(true, p, r, 1000));
+}
+
+TEST_CASE("Unattached native drops cannot invent an authoritative placement", "[drops][timing]")
+{
+    DropPlacementClock clock;
+    glm::vec3 p(1.f), r(0.f);
+    REQUIRE_FALSE(clock.Observe(false, p, r, 0));
+    REQUIRE_FALSE(clock.Observe(true, p, r, 250));
+    REQUIRE_FALSE(clock.Observe(true, p, r, 500));
+    REQUIRE_FALSE(clock.Observe(false, p, r, 750));
+    REQUIRE_FALSE(clock.Observe(true, p, r, 1000));
+    REQUIRE_FALSE(clock.Observe(true, p, r, 1250));
+    REQUIRE(clock.Observe(true, p, r, 1500));
+}
diff --git a/Code/tests/dropped_items.cpp b/Code/tests/dropped_items.cpp
new file mode 100644
index 00000000..71561908
--- /dev/null
+++ b/Code/tests/dropped_items.cpp
@@ -0,0 +1,254 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <TiltedCore/Serialization.hpp>
+#include <glm/glm.hpp>
+#include <optional>
+#include <catch2/catch.hpp>
+#include <Messages/ClientMessageFactory.h>
+#include <Messages/ServerMessageFactory.h>
+#include <Messages/RequestDroppedItem.h>
+#include <Messages/NotifyDroppedItem.h>
+#include <Game/Inventory/DroppedItemLedger.h>
+#include <atomic>
+#include <thread>
+
+namespace
+{
+DroppedItemData Drop(int32_t aCount = 1)
+{
+    DroppedItemData data;
+    data.Item.BaseId = GameId(1, 0x123);
+    data.Item.Count = aCount;
+    data.Item.ExtraHealth = 1.25f;
+    data.Item.ExtraCharge = 7.5f;
+    data.Item.ExtraEnchantId = GameId(1, 0x456);
+    data.Item.ExtraEnchantCharge = 90;
+    data.Cell = GameId(0, 0x200);
+    data.Position = glm::vec3(128.f, 64.f, 16.f);
+    data.Rotation = glm::vec3(0.f);
+    return data;
+}
+}
+
+TEST_CASE("Dropped instances retain distinct IDs and duplicate creation is idempotent", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto first = ledger.Create(100, 1, Drop(10));
+    const auto duplicate = ledger.Create(100, 1, Drop(10));
+    const auto second = ledger.Create(100, 2, Drop(10));
+    const auto otherClient = ledger.Create(200, 1, Drop(10));
+    REQUIRE(first);
+    REQUIRE(duplicate);
+    REQUIRE(second);
+    REQUIRE(otherClient);
+    REQUIRE(first->Data.Id == duplicate->Data.Id);
+    REQUIRE(first->Data.Id != second->Data.Id);
+    REQUIRE(first->Data.Id != otherClient->Data.Id);
+    REQUIRE(ledger.Snapshot(300).size() == 3);
+}
+
+TEST_CASE("Concurrent drop claims produce exactly one first winner", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, Drop(10));
+    REQUIRE(created);
+    std::atomic<bool> start{false};
+    std::atomic<int> firstWinners{0};
+    std::vector<std::thread> claimants;
+    for (uint32_t i = 0; i < 32; ++i)
+        claimants.emplace_back([&, i]()
+        {
+            while (!start.load())
+                std::this_thread::yield();
+            if (ledger.Claim(created->Data.Id, 1000 + i, 100 + i) == DroppedItemLedger::ClaimResult::Granted)
+                ++firstWinners;
+        });
+    start = true;
+    for (auto& claimant : claimants)
+        claimant.join();
+    REQUIRE(firstWinners == 1);
+    const auto consumed = ledger.Get(created->Data.Id);
+    REQUIRE(consumed);
+    REQUIRE_FALSE(consumed->Active);
+    REQUIRE(consumed->Data.Item.Count == 10);
+    REQUIRE(consumed->Data.Item.ExtraHealth == 1.25f);
+    REQUIRE(ledger.Claim(created->Data.Id, consumed->Winner, consumed->CreditedActor) == DroppedItemLedger::ClaimResult::AlreadyGranted);
+    REQUIRE(ledger.Claim(created->Data.Id, 9999, 9999) == DroppedItemLedger::ClaimResult::Lost);
+}
+
+TEST_CASE("Consumed drops stay absent from snapshots and creation retries", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, Drop());
+    REQUIRE(created);
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 5) == DroppedItemLedger::ClaimResult::Granted);
+    REQUIRE(ledger.Snapshot(300).empty());
+    const auto retried = ledger.Create(100, 1, Drop());
+    REQUIRE(retried);
+    REQUIRE_FALSE(retried->Active);
+    REQUIRE(retried->Data.Id == created->Data.Id);
+    REQUIRE(ledger.Claim(created->Data.Id, 100, 1) == DroppedItemLedger::ClaimResult::Lost);
+}
+
+TEST_CASE("Unacknowledged grants recover on reconnect without a second credit", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, Drop(5));
+    REQUIRE(created);
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 5) == DroppedItemLedger::ClaimResult::Granted);
+    REQUIRE(ledger.Snapshot(200).size() == 1);
+    REQUIRE(ledger.Snapshot(300).empty());
+    REQUIRE(ledger.Acknowledge(created->Data.Id, 200, 9, true));
+    REQUIRE_FALSE(ledger.Acknowledge(created->Data.Id, 200, 9, true));
+    REQUIRE(ledger.Snapshot(200).empty());
+    REQUIRE_FALSE(ledger.Acknowledge(created->Data.Id, 999, 9, true));
+    REQUIRE(ledger.Claim(created->Data.Id, 300, 12) == DroppedItemLedger::ClaimResult::Lost);
+}
+
+TEST_CASE("An already applied recovered grant does not add to the new actor again", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, Drop());
+    REQUIRE(created);
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 5) == DroppedItemLedger::ClaimResult::Granted);
+    REQUIRE_FALSE(ledger.Acknowledge(created->Data.Id, 200, 9, false));
+    REQUIRE_FALSE(ledger.Acknowledge(created->Data.Id, 200, 9, true));
+}
+
+TEST_CASE("Disabled drops are recorded for deduplication but are never public or claimable", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, Drop(), false);
+    REQUIRE(created);
+    REQUIRE_FALSE(created->Networked);
+    REQUIRE_FALSE(created->Active);
+    REQUIRE(ledger.Snapshot(100).empty());
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 9) == DroppedItemLedger::ClaimResult::Lost);
+    REQUIRE(ledger.Create(100, 1, Drop(), false)->Data.Id == created->Data.Id);
+}
+
+TEST_CASE("Invalid drop counts and unknown IDs cannot produce grants", "[drops]")
+{
+    DroppedItemLedger ledger;
+    REQUIRE_FALSE(ledger.Create(100, 1, Drop(0)));
+    REQUIRE_FALSE(ledger.Create(100, 2, Drop(-1)));
+    REQUIRE_FALSE(ledger.Create(0, 3, Drop()));
+    REQUIRE_FALSE(ledger.Create(100, 0, Drop()));
+    REQUIRE(ledger.Claim(1234, 200, 5) == DroppedItemLedger::ClaimResult::Unknown);
+    REQUIRE_FALSE(ledger.Acknowledge(1234, 200, 5, true));
+}
+
+TEST_CASE("An owned NPC can consume a drop without granting the same client's player a copy", "[drops]")
+{
+    DroppedItemLedger ledger;
+    const auto created = ledger.Create(100, 1, Drop());
+    REQUIRE(created);
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 50, false) == DroppedItemLedger::ClaimResult::Granted);
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 50, false) == DroppedItemLedger::ClaimResult::AlreadyGranted);
+    REQUIRE(ledger.Claim(created->Data.Id, 200, 5, true) == DroppedItemLedger::ClaimResult::Lost);
+    REQUIRE(ledger.Snapshot(200).empty());
+    REQUIRE_FALSE(ledger.Acknowledge(created->Data.Id, 200, 5, true));
+}
+
+TEST_CASE("Dropped-item request and notification factories preserve IDs and stack metadata", "[drops.encoding]")
+{
+    for (const auto operation : {RequestDroppedItem::Operation::Create, RequestDroppedItem::Operation::Claim,
+        RequestDroppedItem::Operation::Snapshot, RequestDroppedItem::Operation::Acknowledge})
+    {
+        RequestDroppedItem request;
+        request.Action = operation;
+        request.ClientSession = 0xABCDE01234567890ULL;
+        request.ServerSession = 0xBCDEF01234567890ULL;
+        request.Nonce = 0xFEDCBA0987654321ULL;
+        request.ActorId = 8;
+        request.OwnershipEpoch = 7;
+        request.AppliedFresh = true;
+        request.InventoryAlreadyReflected = operation == RequestDroppedItem::Operation::Create;
+        request.Data = Drop(10);
+        request.Data.Id = 0xCDEF0123456789ABULL;
+        TiltedPhoques::Buffer buffer(16384);
+        TiltedPhoques::Buffer::Writer writer(&buffer);
+        request.Serialize(writer);
+        TiltedPhoques::Buffer::Reader reader(&buffer);
+        auto decoded = ClientMessageFactory{}.Extract(reader);
+        REQUIRE(decoded);
+        REQUIRE(decoded->GetOpcode() == kRequestDroppedItem);
+        const auto* result = static_cast<RequestDroppedItem*>(decoded.get());
+        REQUIRE(result->Action == request.Action);
+        REQUIRE(result->ClientSession == request.ClientSession);
+        REQUIRE(result->ServerSession == request.ServerSession);
+        REQUIRE(result->Nonce == request.Nonce);
+        REQUIRE(result->ActorId == request.ActorId);
+        REQUIRE(result->OwnershipEpoch == request.OwnershipEpoch);
+        REQUIRE(result->AppliedFresh);
+        REQUIRE(result->InventoryAlreadyReflected == request.InventoryAlreadyReflected);
+        REQUIRE(result->Data.Id == request.Data.Id);
+        REQUIRE(result->Data.Item == request.Data.Item);
+        REQUIRE(result->Data.Cell == request.Data.Cell);
+        REQUIRE(result->Data.Position == request.Data.Position);
+    }
+    for (const auto operation : {NotifyDroppedItem::Operation::SnapshotBegin, NotifyDroppedItem::Operation::Spawn,
+        NotifyDroppedItem::Operation::Taken, NotifyDroppedItem::Operation::Grant, NotifyDroppedItem::Operation::Rejected,
+        NotifyDroppedItem::Operation::Disabled, NotifyDroppedItem::Operation::SnapshotEnd})
+    {
+        NotifyDroppedItem notify;
+        notify.Action = operation;
+        notify.ServerSession = 0xBCDEF01234567890ULL;
+        notify.Nonce = 0xFEDCBA0987654321ULL;
+        notify.ActorId = 23;
+        notify.Enabled = notify.Active = notify.Recovery = true;
+        notify.Data = Drop(10);
+        notify.Data.Id = 0xCDEF0123456789ABULL;
+        TiltedPhoques::Buffer buffer(16384);
+        TiltedPhoques::Buffer::Writer writer(&buffer);
+        notify.Serialize(writer);
+        TiltedPhoques::Buffer::Reader reader(&buffer);
+        auto decoded = ServerMessageFactory{}.Extract(reader);
+        REQUIRE(decoded);
+        REQUIRE(decoded->GetOpcode() == kNotifyDroppedItem);
+        const auto* result = static_cast<NotifyDroppedItem*>(decoded.get());
+        REQUIRE(result->Action == notify.Action);
+        REQUIRE(result->ServerSession == notify.ServerSession);
+        REQUIRE(result->Nonce == notify.Nonce);
+        REQUIRE(result->ActorId == notify.ActorId);
+        REQUIRE(result->Enabled);
+        REQUIRE(result->Active);
+        REQUIRE(result->Recovery);
+        REQUIRE(result->Data.Id == notify.Data.Id);
+        REQUIRE(result->Data.Item == notify.Data.Item);
+    }
+}
+
+TEST_CASE("Drop rotation keeps fractional and negative radians through both message factories", "[drops.encoding]")
+{
+    const glm::vec3 angles(-0.125f, 1.2345f, -2.7182f);
+    RequestDroppedItem request;
+    request.Action = RequestDroppedItem::Operation::Create;
+    request.Data = Drop();
+    request.Data.Rotation = angles;
+    TiltedPhoques::Buffer upstream(16384);
+    TiltedPhoques::Buffer::Writer writer(&upstream);
+    request.Serialize(writer);
+    TiltedPhoques::Buffer::Reader reader(&upstream);
+    auto decoded = ClientMessageFactory{}.Extract(reader);
+    REQUIRE(decoded);
+    REQUIRE(decoded->GetOpcode() == kRequestDroppedItem);
+    const auto* received = static_cast<RequestDroppedItem*>(decoded.get());
+    REQUIRE(received->Data.Rotation.x == angles.x);
+    REQUIRE(received->Data.Rotation.y == angles.y);
+    REQUIRE(received->Data.Rotation.z == angles.z);
+    NotifyDroppedItem notify;
+    notify.Action = NotifyDroppedItem::Operation::Spawn;
+    notify.Data = received->Data;
+    TiltedPhoques::Buffer downstream(16384);
+    TiltedPhoques::Buffer::Writer writer2(&downstream);
+    notify.Serialize(writer2);
+    TiltedPhoques::Buffer::Reader reader2(&downstream);
+    auto decoded2 = ServerMessageFactory{}.Extract(reader2);
+    REQUIRE(decoded2);
+    REQUIRE(decoded2->GetOpcode() == kNotifyDroppedItem);
+    const auto* received2 = static_cast<NotifyDroppedItem*>(decoded2.get());
+    REQUIRE(received2->Data.Rotation.x == angles.x);
+    REQUIRE(received2->Data.Rotation.y == angles.y);
+    REQUIRE(received2->Data.Rotation.z == angles.z);
+}
diff --git a/Code/tests/missives.cpp b/Code/tests/missives.cpp
new file mode 100644
index 00000000..b0e1192a
--- /dev/null
+++ b/Code/tests/missives.cpp
@@ -0,0 +1,142 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <TiltedCore/Serialization.hpp>
+#include <glm/glm.hpp>
+#include <catch2/catch.hpp>
+#include <Messages/ClientMessageFactory.h>
+#include <Messages/ServerMessageFactory.h>
+#include <Messages/RequestMissivesBoard.h>
+#include <Messages/NotifyMissivesBoard.h>
+#include <Game/Inventory/MissiveBoardLedger.h>
+#include <atomic>
+#include <thread>
+
+namespace
+{
+MissiveBoardListing Listing(uint32_t aBoard = 0x1000, uint32_t aQuest = 0x2000, uint32_t aBook = 0x3000)
+{
+    MissiveBoardListing listing;
+    listing.Board = GameId(3, aBoard);
+    listing.Quest = GameId(3, aQuest);
+    listing.Book = GameId(3, aBook);
+    return listing;
+}
+}
+
+TEST_CASE("Missives board has one public listing and an atomic board-local claimant", "[missives]")
+{
+    MissiveBoardLedger ledger;
+    const auto posting = Listing();
+    ledger.SetAuthority(posting.Board, 10);
+
+    const auto first = ledger.Publish(10, posting);
+    REQUIRE(first);
+    REQUIRE(ledger.Publish(10, posting)->Listing.Id == first->Listing.Id);
+    REQUIRE_FALSE(ledger.Publish(11, posting));
+
+    REQUIRE(ledger.Claim(20, first->Listing.Id, posting.Board, posting.Quest) == MissiveBoardLedger::ClaimResult::Won);
+    REQUIRE(ledger.Claim(21, first->Listing.Id, posting.Board, posting.Quest) == MissiveBoardLedger::ClaimResult::Unavailable);
+    REQUIRE(ledger.Claim(20, first->Listing.Id, posting.Board, posting.Quest) == MissiveBoardLedger::ClaimResult::AlreadyOwned);
+
+    const auto taken = ledger.Snapshot(posting.Board);
+    REQUIRE(taken.size() == 1);
+    REQUIRE(taken.front().Status == MissiveBoardLedger::State::Claimed);
+    REQUIRE(taken.front().Claimant == 20);
+    REQUIRE_FALSE(ledger.Retire(10, first->Listing.Id));
+    const auto retired = ledger.Retire(20, first->Listing.Id);
+    REQUIRE(retired);
+    REQUIRE(ledger.Snapshot(posting.Board).empty());
+}
+
+TEST_CASE("Concurrent claims on one Missives board row elect exactly one player", "[missives]")
+{
+    MissiveBoardLedger ledger;
+    const auto posting = Listing();
+    ledger.SetAuthority(posting.Board, 10);
+    const auto record = ledger.Publish(10, posting);
+    REQUIRE(record);
+
+    std::atomic<bool> start{false};
+    std::atomic<uint32_t> winners{0};
+    std::vector<std::thread> workers;
+    for (uint64_t session = 20; session < 44; ++session)
+        workers.emplace_back([&, session]() {
+            while (!start.load()) std::this_thread::yield();
+            if (ledger.Claim(session, record->Listing.Id, posting.Board, posting.Quest) == MissiveBoardLedger::ClaimResult::Won)
+                ++winners;
+        });
+
+    start = true;
+    for (auto& worker : workers) worker.join();
+    REQUIRE(winners == 1);
+}
+
+TEST_CASE("The same Missives quest can be listed independently on different boards", "[missives]")
+{
+    MissiveBoardLedger ledger;
+    const auto firstBoard = Listing(0x1000, 0x2000, 0x3000);
+    const auto secondBoard = Listing(0x1001, 0x2000, 0x3000);
+    ledger.SetAuthority(firstBoard.Board, 10);
+    ledger.SetAuthority(secondBoard.Board, 11);
+    const auto first = ledger.Publish(10, firstBoard);
+    const auto second = ledger.Publish(11, secondBoard);
+    REQUIRE(first);
+    REQUIRE(second);
+    REQUIRE(ledger.Claim(20, first->Listing.Id, firstBoard.Board, firstBoard.Quest) == MissiveBoardLedger::ClaimResult::Won);
+    REQUIRE(ledger.Get(first->Listing.Id)->Status == MissiveBoardLedger::State::Claimed);
+    REQUIRE(ledger.Get(second->Listing.Id)->Status == MissiveBoardLedger::State::Available);
+    REQUIRE(ledger.Claim(21, second->Listing.Id, secondBoard.Board, secondBoard.Quest) == MissiveBoardLedger::ClaimResult::Won);
+    REQUIRE(ledger.Snapshot(firstBoard.Board).size() == 1);
+    REQUIRE(ledger.Snapshot(secondBoard.Board).size() == 1);
+}
+
+TEST_CASE("A newly elected board authority can retire an expired public line", "[missives]")
+{
+    MissiveBoardLedger ledger;
+    const auto posting = Listing();
+    ledger.SetAuthority(posting.Board, 10);
+    const auto record = ledger.Publish(10, posting);
+    REQUIRE(record);
+    ledger.SetAuthority(posting.Board, 11);
+    REQUIRE_FALSE(ledger.Retire(10, record->Listing.Id));
+    REQUIRE(ledger.Retire(11, record->Listing.Id));
+}
+
+TEST_CASE("Missives board protocol serializes only the public line identifiers", "[missives][encoding]")
+{
+    RequestMissivesBoard request;
+    request.Action = RequestMissivesBoard::Operation::Publish;
+    request.ServerSession = 0x12345678;
+    request.Listing = Listing();
+    TiltedPhoques::Buffer buffer(4096);
+    TiltedPhoques::Buffer::Writer writer(&buffer);
+    request.Serialize(writer);
+    TiltedPhoques::Buffer::Reader reader(&buffer);
+    auto decoded = ClientMessageFactory{}.Extract(reader);
+    REQUIRE(decoded);
+    REQUIRE(decoded->GetOpcode() == kRequestMissivesBoard);
+    const auto* publish = static_cast<RequestMissivesBoard*>(decoded.get());
+    REQUIRE(publish->Action == RequestMissivesBoard::Operation::Publish);
+    REQUIRE(publish->ServerSession == request.ServerSession);
+    REQUIRE(publish->Listing.Valid);
+    REQUIRE(publish->Listing.Board == request.Listing.Board);
+    REQUIRE(publish->Listing.Quest == request.Listing.Quest);
+    REQUIRE(publish->Listing.Book == request.Listing.Book);
+
+    NotifyMissivesBoard notify;
+    notify.Action = NotifyMissivesBoard::Operation::Grant;
+    notify.ServerSession = request.ServerSession;
+    notify.Mine = true;
+    notify.Listing = request.Listing;
+    TiltedPhoques::Buffer answer(4096);
+    TiltedPhoques::Buffer::Writer answerWriter(&answer);
+    notify.Serialize(answerWriter);
+    TiltedPhoques::Buffer::Reader answerReader(&answer);
+    auto response = ServerMessageFactory{}.Extract(answerReader);
+    REQUIRE(response);
+    const auto* grant = static_cast<NotifyMissivesBoard*>(response.get());
+    REQUIRE(grant->Action == NotifyMissivesBoard::Operation::Grant);
+    REQUIRE(grant->Mine);
+    REQUIRE(grant->Listing.Id == notify.Listing.Id);
+    REQUIRE(grant->Listing.Quest == notify.Listing.Quest);
+}
diff --git a/Code/tests/npc_inventory_snapshot.cpp b/Code/tests/npc_inventory_snapshot.cpp
new file mode 100644
index 00000000..99b9534e
--- /dev/null
+++ b/Code/tests/npc_inventory_snapshot.cpp
@@ -0,0 +1,139 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <TiltedCore/Serialization.hpp>
+#include <glm/glm.hpp>
+#include <optional>
+#include <catch2/catch.hpp>
+#include <Structs/NpcInventorySnapshot.h>
+#include <Structs/OwnedInventory.h>
+#include <Messages/AssignCharacterRequest.h>
+#include <Messages/CharacterSpawnRequest.h>
+#include <Messages/ClientMessageFactory.h>
+#include <Messages/ServerMessageFactory.h>
+
+namespace
+{
+Inventory::Entry Equipment(uint32_t aBase, int32_t aCount = 1, bool aWorn = false)
+{
+    Inventory::Entry item;
+    item.BaseId = GameId(0, aBase);
+    item.Count = aCount;
+    item.ExtraWorn = aWorn;
+    return item;
+}
+}
+
+TEST_CASE("Resolved NPC equipment replaces template counts instead of duplicating armor and weapons", "[inventory][npc]")
+{
+    Inventory base;
+    base.Entries = {Equipment(0x100), Equipment(0x200)};
+    Inventory runtime;
+    runtime.Entries = {Equipment(0x100, 1, true), Equipment(0x200, 1, true)};
+    const auto snapshot = BuildNpcInventorySnapshot(base, runtime, {GameId(0, 0x100), GameId(0, 0x200)});
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x100)) == 1);
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x200)) == 1);
+    REQUIRE(snapshot.Entries.size() == 2);
+    REQUIRE(snapshot.Entries[0].IsWorn());
+    REQUIRE(snapshot.Entries[1].IsWorn());
+    REQUIRE(base.Entries[0].Count == 1);
+    REQUIRE(runtime.Entries[0].ExtraWorn);
+}
+
+TEST_CASE("NPC snapshot preserves legitimate spare equipment stacks and different enchantments", "[inventory][npc]")
+{
+    Inventory base;
+    base.Entries = {Equipment(0x100)};
+    Inventory runtime;
+    auto tempered = Equipment(0x100, 1, true);
+    tempered.ExtraHealth = 1.5f;
+    auto enchanted = Equipment(0x100);
+    enchanted.ExtraEnchantId = GameId(1, 0x999);
+    enchanted.ExtraCharge = 50.f;
+    runtime.Entries = {tempered, Equipment(0x100, 2), enchanted};
+    const auto snapshot = BuildNpcInventorySnapshot(base, runtime, {GameId(0, 0x100)});
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x100)) == 4);
+    REQUIRE(snapshot.Entries.size() == 3);
+    REQUIRE(snapshot.Entries[0].ExtraHealth == 1.5f);
+    REQUIRE(snapshot.Entries[0].IsWorn());
+    REQUIRE(snapshot.Entries[2].ExtraEnchantId == enchanted.ExtraEnchantId);
+    REQUIRE(snapshot.Entries[2].ExtraCharge == 50.f);
+}
+
+TEST_CASE("NPC ordinary signed inventory deltas still combine with every template row", "[inventory][npc]")
+{
+    Inventory base;
+    base.Entries = {Equipment(0x100, 2), Equipment(0x100, 3), Equipment(0x200, 10)};
+    Inventory runtime;
+    runtime.Entries = {Equipment(0x100, 1, true), Equipment(0x100, -3), Equipment(0x200, -4), Equipment(0x300, 7)};
+    const auto snapshot = BuildNpcInventorySnapshot(base, runtime, {});
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x100)) == 3);
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x200)) == 6);
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x300)) == 7);
+    REQUIRE(std::count_if(snapshot.Entries.begin(), snapshot.Entries.end(), [](const auto& e) { return e.IsWorn(); }) == 1);
+}
+
+TEST_CASE("An exhausted resolved NPC item cannot regain the default outfit count", "[inventory][npc]")
+{
+    Inventory base;
+    base.Entries = {Equipment(0x100, 1), Equipment(0x200, 2)};
+    Inventory runtime;
+    runtime.Entries = {Equipment(0x100, 1, true), Equipment(0x100, -1), Equipment(0x200, -1)};
+    const auto snapshot = BuildNpcInventorySnapshot(base, runtime, {GameId(0, 0x100)});
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x100)) == 0);
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x200)) == 1);
+    auto explicitZero = Equipment(0x100, 0);
+    runtime.Entries = {explicitZero};
+    const auto empty = BuildNpcInventorySnapshot(base, runtime, {GameId(0, 0x100)});
+    REQUIRE(CachedItemCount(empty, GameId(0, 0x100)) == 0);
+}
+
+TEST_CASE("Resolved NPC snapshots preserve quest equipment and both equipped hands", "[inventory][npc]")
+{
+    Inventory base;
+    base.Entries = {Equipment(0x100, 2), Equipment(0x200)};
+    Inventory runtime;
+    auto right = Equipment(0x100, 1, true);
+    auto left = Equipment(0x100);
+    left.ExtraWornLeft = true;
+    auto quest = Equipment(0x200);
+    quest.IsQuestItem = quest.IsPersonalQuestItem = true;
+    runtime.Entries = {right, left, quest};
+    const auto snapshot = BuildNpcInventorySnapshot(base, runtime, {GameId(0, 0x100), GameId(0, 0x200)});
+    REQUIRE(CachedItemCount(snapshot, GameId(0, 0x100)) == 2);
+    REQUIRE(snapshot.Entries.size() == 3);
+    REQUIRE(snapshot.Entries[0].ExtraWorn);
+    REQUIRE(snapshot.Entries[1].ExtraWornLeft);
+    REQUIRE(snapshot.Entries[2].IsQuestItem);
+    REQUIRE(snapshot.Entries[2].IsPersonalQuestItem);
+}
+
+TEST_CASE("Corrected NPC counts survive the actual assignment and spawn message factories", "[inventory][npc][encoding]")
+{
+    Inventory base;
+    base.Entries = {Equipment(0x100), Equipment(0x200)};
+    Inventory runtime;
+    runtime.Entries = {Equipment(0x100, 1, true), Equipment(0x200, 1, true)};
+    const auto snapshot = BuildNpcInventorySnapshot(base, runtime, {GameId(0, 0x100), GameId(0, 0x200)});
+    AssignCharacterRequest assign;
+    assign.CurrentActorData.InitialInventory = snapshot;
+    TiltedPhoques::Buffer up(16384);
+    TiltedPhoques::Buffer::Writer upWriter(&up);
+    assign.Serialize(upWriter);
+    TiltedPhoques::Buffer::Reader upReader(&up);
+    const auto decodedAssign = ClientMessageFactory{}.Extract(upReader);
+    REQUIRE(decodedAssign);
+    const auto& assigned = static_cast<const AssignCharacterRequest*>(decodedAssign.get())->CurrentActorData.InitialInventory;
+    REQUIRE(assigned.Entries == snapshot.Entries);
+    CharacterSpawnRequest spawn;
+    spawn.InventoryContent = assigned;
+    TiltedPhoques::Buffer down(16384);
+    TiltedPhoques::Buffer::Writer downWriter(&down);
+    spawn.Serialize(downWriter);
+    TiltedPhoques::Buffer::Reader downReader(&down);
+    const auto decodedSpawn = ServerMessageFactory{}.Extract(downReader);
+    REQUIRE(decodedSpawn);
+    const auto& received = static_cast<const CharacterSpawnRequest*>(decodedSpawn.get())->InventoryContent;
+    REQUIRE(received.Entries == snapshot.Entries);
+    REQUIRE(CachedItemCount(received, GameId(0, 0x100)) == 1);
+    REQUIRE(CachedItemCount(received, GameId(0, 0x200)) == 1);
+}
diff --git a/Code/tests/owned_inventory.cpp b/Code/tests/owned_inventory.cpp
new file mode 100644
index 00000000..f0f95c20
--- /dev/null
+++ b/Code/tests/owned_inventory.cpp
@@ -0,0 +1,226 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <TiltedCore/Serialization.hpp>
+#include <glm/glm.hpp>
+#include <optional>
+#include <catch2/catch.hpp>
+#include <Structs/OwnedInventory.h>
+#include <Messages/ServerMessageFactory.h>
+#include <Messages/ClientMessageFactory.h>
+#include <Messages/RequestEquipmentChanges.h>
+#include "../client/Systems/PendingActorUpdates.h"
+#include "../client/Systems/DropProxySetup.h"
+
+namespace
+{
+Inventory::Entry Item(int32_t aCount = 1)
+{
+    Inventory::Entry item;
+    item.BaseId = GameId(0, 0x330BC);
+    item.Count = aCount;
+    return item;
+}
+}
+
+TEST_CASE("Owner drop debit tolerates stale metadata and fragmented cached stacks", "[drops][inventory]")
+{
+    Inventory inventory;
+    auto first = Item(2);
+    first.ExtraWorn = true;
+    first.ExtraHealth = 1.f;
+    auto second = Item(3);
+    second.ExtraCharge = 50.f;
+    inventory.Entries = {first, second};
+    auto dropped = Item(4);
+    dropped.ExtraHealth = 1.25f;
+    dropped.ExtraCharge = 10.f;
+    REQUIRE(DebitOwnedDropCache(inventory, dropped) == 4);
+    REQUIRE(CachedItemCount(inventory, dropped.BaseId) == 1);
+    REQUIRE(dropped.ExtraHealth == 1.25f);
+    REQUIRE(dropped.Count == 4);
+}
+
+TEST_CASE("Owner drop debit never invents a negative delta from an unavailable cache", "[drops][inventory]")
+{
+    Inventory inventory;
+    inventory.Entries = {Item(-2), Item(3)};
+    auto unrelated = Item(7);
+    unrelated.BaseId = GameId(1, 0x999);
+    inventory.Entries.push_back(unrelated);
+    REQUIRE(DebitOwnedDropCache(inventory, Item(4)) == 1);
+    REQUIRE(CachedItemCount(inventory, Item().BaseId) == 0);
+    REQUIRE(CachedItemCount(inventory, unrelated.BaseId) == 7);
+    REQUIRE(DebitOwnedDropCache(inventory, Item(4)) == 0);
+    REQUIRE(CachedItemCount(inventory, Item().BaseId) == 0);
+    REQUIRE(DebitOwnedDropCache(inventory, Item(-1)) == 0);
+}
+
+TEST_CASE("Equivalent NPC inventory snapshots ignore entry order and split stacks", "[actors][inventory]")
+{
+    Inventory current;
+    current.Entries = {Item(1), Item(2)};
+    Inventory owner;
+    owner.Entries = {Item(3)};
+    REQUIRE(HasSameInventoryContents(current, owner));
+
+    auto worn = Item(1);
+    worn.ExtraWorn = true;
+    owner.Entries = {worn, Item(2)};
+    REQUIRE_FALSE(HasSameInventoryContents(current, owner));
+    current.Entries = {worn, Item(2)};
+    REQUIRE(HasSameInventoryContents(current, owner));
+}
+
+TEST_CASE("Equivalent NPC inventory snapshots retain custom enchantment identity", "[actors][inventory]")
+{
+    Inventory::Entry currentItem = Item();
+    currentItem.ExtraEnchantId = GameId(0xFFFFFFFF, 1);
+    currentItem.EnchantData.IsWeapon = true;
+    Inventory::EffectItem currentEffect;
+    currentEffect.Magnitude = 12.f;
+    currentEffect.Area = 3;
+    currentEffect.Duration = 4;
+    currentEffect.RawCost = 5.f;
+    currentEffect.EffectId = GameId(0, 0x1234);
+    currentItem.EnchantData.Effects.push_back(currentEffect);
+
+    auto ownerItem = currentItem;
+    ownerItem.EnchantData.Effects[0].Magnitude = 13.f;
+    Inventory current;
+    current.Entries = {currentItem};
+    Inventory owner;
+    owner.Entries = {ownerItem};
+    REQUIRE_FALSE(HasSameInventoryContents(current, owner));
+
+    owner.Entries[0].EnchantData.Effects[0].Magnitude = 12.f;
+    REQUIRE(HasSameInventoryContents(current, owner));
+}
+
+TEST_CASE("Equipment snapshots replace stale worn metadata without duplicating a cached item", "[equipment][inventory]")
+{
+    Inventory inventory;
+    inventory.Entries = {Item(5)};
+    Inventory equipment;
+    auto worn = Item();
+    worn.ExtraWorn = true;
+    worn.ExtraHealth = 1.5f;
+    equipment.Entries = {worn};
+    ApplyOwnedEquipmentSnapshot(inventory, equipment);
+    REQUIRE(CachedItemCount(inventory, worn.BaseId) == 5);
+    REQUIRE(std::count_if(inventory.Entries.begin(), inventory.Entries.end(), [](const auto& e) { return e.IsWorn(); }) == 1);
+    ApplyOwnedEquipmentSnapshot(inventory, equipment);
+    REQUIRE(CachedItemCount(inventory, worn.BaseId) == 5);
+    REQUIRE(inventory.Entries.back().ExtraHealth == 1.5f);
+}
+
+TEST_CASE("Equipment snapshots supply missing outfit entries and retain both worn hands", "[equipment][inventory]")
+{
+    Inventory inventory;
+    Inventory equipment;
+    auto right = Item();
+    right.ExtraWorn = true;
+    auto left = Item();
+    left.ExtraWornLeft = true;
+    equipment.Entries = {right, left};
+    ApplyOwnedEquipmentSnapshot(inventory, equipment);
+    REQUIRE(CachedItemCount(inventory, right.BaseId) == 2);
+    REQUIRE(inventory.Entries.size() == 2);
+    REQUIRE(inventory.Entries[0].ExtraWorn);
+    REQUIRE(inventory.Entries[1].ExtraWornLeft);
+    ApplyOwnedEquipmentSnapshot(inventory, equipment);
+    REQUIRE(CachedItemCount(inventory, right.BaseId) == 2);
+    REQUIRE(inventory.Entries.size() == 2);
+}
+
+TEST_CASE("An empty equipment snapshot clears worn flags without deleting owned inventory", "[equipment][inventory]")
+{
+    Inventory inventory;
+    auto worn = Item(3);
+    worn.ExtraWorn = true;
+    inventory.Entries = {worn};
+    ApplyOwnedEquipmentSnapshot(inventory, {});
+    REQUIRE(CachedItemCount(inventory, worn.BaseId) == 3);
+    REQUIRE_FALSE(inventory.Entries[0].IsWorn());
+}
+
+TEST_CASE("Pending equipment respects ownership epochs and never restores looted corpse armor", "[equipment][pending]")
+{
+    CharacterSpawnRequest spawn;
+    spawn.ServerId = 5;
+    spawn.OwnershipEpoch = 4;
+    NotifyEquipmentChanges update;
+    update.ServerId = 5;
+    update.OwnershipEpoch = 3;
+    auto worn = Item();
+    worn.ExtraWorn = true;
+    update.CurrentInventory.Entries = {worn};
+    REQUIRE_FALSE(ApplyPendingEquipment(spawn, update));
+    REQUIRE(spawn.InventoryContent.Entries.empty());
+    update.OwnershipEpoch = 4;
+    REQUIRE(ApplyPendingEquipment(spawn, update));
+    REQUIRE(spawn.InventoryContent.Entries[0].ExtraWorn);
+    spawn.IsDead = true;
+    spawn.InventoryContent.Entries.clear();
+    REQUIRE(ApplyPendingEquipment(spawn, update));
+    REQUIRE(spawn.InventoryContent.Entries.empty());
+    update.ServerId = 6;
+    REQUIRE_FALSE(ApplyPendingEquipment(spawn, update));
+}
+
+TEST_CASE("Equipment notifications preserve the authoritative worn snapshot through the real factory", "[equipment][encoding]")
+{
+    NotifyEquipmentChanges message;
+    message.ServerId = 9;
+    message.OwnershipEpoch = 3;
+    message.ItemId = Item().BaseId;
+    message.Count = 1;
+    message.SnapshotOnly = true;
+    auto worn = Item();
+    worn.ExtraWorn = true;
+    worn.ExtraHealth = 1.75f;
+    message.CurrentInventory.Entries = {worn};
+    TiltedPhoques::Buffer buffer(16384);
+    TiltedPhoques::Buffer::Writer writer(&buffer);
+    message.Serialize(writer);
+    TiltedPhoques::Buffer::Reader reader(&buffer);
+    auto decoded = ServerMessageFactory{}.Extract(reader);
+    REQUIRE(decoded);
+    REQUIRE(decoded->GetOpcode() == kNotifyEquipmentChanges);
+    REQUIRE(*static_cast<NotifyEquipmentChanges*>(decoded.get()) == message);
+}
+
+TEST_CASE("Visible drop geometry without collision does not consume physics setup attempts", "[drops][timing]")
+{
+    DropProxySetup setup;
+    using A = DropProxySetup::Action;
+    REQUIRE(setup.Advance(true, true, 1000, false) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10000, false) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10001, true) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10101, true) == A::PlaceAndWake);
+    REQUIRE(setup.Advance(true, true, 10601, true) == A::Wake);
+    REQUIRE(setup.Advance(true, true, 11101, true) == A::Wake);
+    REQUIRE(setup.Advance(true, true, 11601, true) == A::Done);
+}
+
+TEST_CASE("A drop outfit refresh round trips without requesting another native equip action", "[equipment][encoding]")
+{
+    RequestEquipmentChanges message;
+    message.ServerId = 9;
+    message.OwnershipEpoch = 3;
+    message.SnapshotOnly = true;
+    auto worn = Item();
+    worn.ExtraWorn = true;
+    message.CurrentInventory.Entries = {worn};
+    TiltedPhoques::Buffer buffer(16384);
+    TiltedPhoques::Buffer::Writer writer(&buffer);
+    message.Serialize(writer);
+    TiltedPhoques::Buffer::Reader reader(&buffer);
+    auto decoded = ClientMessageFactory{}.Extract(reader);
+    REQUIRE(decoded);
+    REQUIRE(decoded->GetOpcode() == kRequestEquipmentChanges);
+    const auto* result = static_cast<RequestEquipmentChanges*>(decoded.get());
+    REQUIRE(*result == message);
+    REQUIRE(result->SnapshotOnly);
+    REQUIRE_FALSE(result->ItemId);
+    REQUIRE(result->Count == 0);
+}
diff --git a/Code/tests/proxy_furniture_timing.cpp b/Code/tests/proxy_furniture_timing.cpp
new file mode 100644
index 00000000..2d39676a
--- /dev/null
+++ b/Code/tests/proxy_furniture_timing.cpp
@@ -0,0 +1,87 @@
+#include <catch2/catch.hpp>
+#include "../client/Systems/DropProxySetup.h"
+#include "../client/Systems/FurnitureRecovery.h"
+
+TEST_CASE("Drop proxies wait for attached geometry and make bounded wake attempts", "[drops][timing]")
+{
+    DropProxySetup setup;
+    using A = DropProxySetup::Action;
+    REQUIRE(setup.Advance(false, true, 0) == A::Wait);
+    REQUIRE(setup.Advance(false, true, 10000) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10000) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10099) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10100) == A::PlaceAndWake);
+    REQUIRE(setup.Advance(true, true, 10599) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10600) == A::Wake);
+    REQUIRE(setup.Advance(true, true, 11100) == A::Wake);
+    REQUIRE(setup.Advance(true, true, 9999999) == A::Done);
+}
+
+TEST_CASE("Reloaded drop geometry receives a new setup without repeated teleports", "[drops][timing]")
+{
+    DropProxySetup setup;
+    using A = DropProxySetup::Action;
+    REQUIRE(setup.Advance(true, true, 0) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 100) == A::PlaceAndWake);
+    REQUIRE(setup.Advance(true, true, 600) == A::Wake);
+    REQUIRE(setup.Advance(false, true, 700) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 1000) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 1100) == A::PlaceAndWake);
+    REQUIRE(setup.Advance(true, true, 1600) == A::Wake);
+}
+
+TEST_CASE("Furniture recovery waits then exits only once per eligible episode", "[furniture][timing]")
+{
+    FurnitureRecovery recovery;
+    using A = FurnitureRecovery::Action;
+    REQUIRE(recovery.Advance(false, 0) == A::Wait);
+    REQUIRE(recovery.Advance(true, 100) == A::Wait);
+    REQUIRE(recovery.Advance(true, 2099) == A::Wait);
+    REQUIRE(recovery.Advance(true, 2100) == A::Reevaluate);
+    REQUIRE(recovery.Advance(true, 4099) == A::Wait);
+    REQUIRE(recovery.Advance(true, 4100) == A::Exit);
+    REQUIRE(recovery.Advance(true, 9999999) == A::Wait);
+}
+
+TEST_CASE("Furniture recovery cancels when combat furniture or ownership eligibility ends", "[furniture][timing]")
+{
+    FurnitureRecovery recovery;
+    using A = FurnitureRecovery::Action;
+    REQUIRE(recovery.Advance(true, 0) == A::Wait);
+    REQUIRE(recovery.Advance(true, 2000) == A::Reevaluate);
+    REQUIRE(recovery.Advance(false, 3000) == A::Wait);
+    REQUIRE(recovery.Advance(true, 6000) == A::Wait);
+    REQUIRE(recovery.Advance(true, 7999) == A::Wait);
+    REQUIRE(recovery.Advance(true, 8000) == A::Reevaluate);
+    REQUIRE(recovery.Advance(true, 10000) == A::Exit);
+}
+
+TEST_CASE("A delayed furniture poll preserves the grace period after reevaluation", "[furniture][timing]")
+{
+    FurnitureRecovery recovery;
+    using A = FurnitureRecovery::Action;
+    REQUIRE(recovery.Advance(true, 0) == A::Wait);
+    REQUIRE(recovery.Advance(true, 20000) == A::Reevaluate);
+    REQUIRE(recovery.Advance(true, 20500) == A::Wait);
+    REQUIRE(recovery.Advance(true, 22000) == A::Exit);
+    REQUIRE(recovery.Advance(true, 30000) == A::Wait);
+}
+
+TEST_CASE("Drop setup waits for cell attachment even while the old geometry is present", "[drops][timing]")
+{
+    DropProxySetup setup;
+    using A = DropProxySetup::Action;
+    REQUIRE(setup.Advance(true, false, 0) == A::Wait);
+    REQUIRE(setup.Advance(true, false, 10000) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10000) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10099) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 10100) == A::PlaceAndWake);
+    // Detaching also cancels subsequent wake attempts and restarts the grace period.
+    REQUIRE(setup.Advance(true, false, 10600) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 20000) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 20099) == A::Wait);
+    REQUIRE(setup.Advance(true, true, 20100) == A::PlaceAndWake);
+    REQUIRE(setup.Advance(true, true, 20600) == A::Wake);
+    REQUIRE(setup.Advance(true, true, 21100) == A::Wake);
+    REQUIRE(setup.Advance(true, true, 21600) == A::Done);
+}
