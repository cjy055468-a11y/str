diff --git a/Code/server/Services/DroppedItemService.cpp b/Code/server/Services/DroppedItemService.cpp
new file mode 100644
index 00000000..1c1cfdc0
--- /dev/null
+++ b/Code/server/Services/DroppedItemService.cpp
@@ -0,0 +1,255 @@
+#include <Services/DroppedItemService.h>
+#include <Services/InventoryService.h>
+#include <Events/PlayerLeaveEvent.h>
+#include <Messages/RequestDroppedItem.h>
+#include <Messages/NotifyDroppedItem.h>
+#include <Messages/NotifyInventoryChanges.h>
+#include <Structs/OwnedInventory.h>
+#include <World.h>
+#include <GameServer.h>
+#include <Game/Player.h>
+#include <Components.h>
+#include <cmath>
+
+DroppedItemService::DroppedItemService(World& aWorld, entt::dispatcher& aDispatcher)
+    : m_world(aWorld)
+    , m_session(static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count()) | 1ULL)
+{
+    m_requestConnection = aDispatcher.sink<PacketEvent<RequestDroppedItem>>().connect<&DroppedItemService::OnRequest>(this);
+    m_leaveConnection = aDispatcher.sink<PlayerLeaveEvent>().connect<&DroppedItemService::OnPlayerLeave>(this);
+}
+
+void DroppedItemService::OnPlayerLeave(const PlayerLeaveEvent& acEvent) noexcept
+{
+    std::lock_guard lock(m_lock);
+    const auto it = m_playerSessions.find(acEvent.pPlayer->GetId());
+    if (it != m_playerSessions.end())
+    {
+        m_activeSessions.erase(it->second);
+        m_playerSessions.erase(it);
+    }
+    // Keep active drops, consumed tombstones and unacknowledged grants.
+}
+
+void DroppedItemService::BroadcastInventory(uint32_t aActor, const Inventory::Entry& acItem, Player* apExclude) noexcept
+{
+    const auto entity = static_cast<entt::entity>(aActor);
+    if (const auto* pOwner = m_world.try_get<OwnerComponent>(entity))
+    {
+        NotifyInventoryChanges notify;
+        notify.ServerId = aActor;
+        notify.OwnershipEpoch = pOwner->OwnershipEpoch;
+        notify.Item = acItem;
+        notify.Drop = false; // World instances use the dedicated protocol only.
+        GameServer::Get()->SendToPlayersInRange(notify, entity, apExclude);
+    }
+}
+
+void DroppedItemService::OnRequest(const PacketEvent<RequestDroppedItem>& acEvent) noexcept
+{
+    std::lock_guard lock(m_lock);
+    const auto& request = acEvent.Packet;
+    Player* pPlayer = acEvent.pPlayer;
+    if (!request.ClientSession || !request.Nonce)
+        return;
+
+    const auto binding = m_activeSessions.find(request.ClientSession);
+    if (binding != m_activeSessions.end() && binding->second != pPlayer->GetId())
+        return;
+    const auto playerBinding = m_playerSessions.find(pPlayer->GetId());
+    if (playerBinding != m_playerSessions.end() && playerBinding->second != request.ClientSession)
+        return;
+    m_activeSessions[request.ClientSession] = pPlayer->GetId();
+    m_playerSessions[pPlayer->GetId()] = request.ClientSession;
+
+    NotifyDroppedItem reply;
+    reply.ServerSession = m_session;
+    reply.Nonce = request.Nonce;
+    reply.Enabled = InventoryService::IsPlayerDropSyncEnabled();
+    reply.Data.Id = request.Data.Id;
+
+    const auto reject = [&](bool aActive)
+    {
+        reply.Action = NotifyDroppedItem::Operation::Rejected;
+        reply.Active = aActive;
+        pPlayer->Send(reply);
+    };
+
+    if (request.Action == RequestDroppedItem::Operation::Snapshot)
+    {
+        reply.Action = NotifyDroppedItem::Operation::SnapshotBegin;
+        pPlayer->Send(reply);
+        for (const auto& record : m_ledger.Snapshot(request.ClientSession))
+        {
+            reply.Data = record.Data;
+            reply.Active = record.Active;
+            reply.Nonce = record.Creator == request.ClientSession ? record.Nonce : 0;
+            reply.Recovery = !record.Active;
+            reply.ActorId = record.WinnerActor;
+            reply.Action = record.Active ? NotifyDroppedItem::Operation::Spawn : NotifyDroppedItem::Operation::Grant;
+            pPlayer->Send(reply);
+        }
+        reply.Action = NotifyDroppedItem::Operation::SnapshotEnd;
+        reply.Nonce = request.Nonce;
+        reply.Data = {};
+        reply.Recovery = false;
+        pPlayer->Send(reply);
+        return;
+    }
+
+    if (request.ServerSession != m_session)
+    {
+        reject(true);
+        return;
+    }
+
+    const auto character = pPlayer->GetCharacter();
+    const auto entity = static_cast<entt::entity>(request.ActorId);
+    if (!character || !m_world.valid(entity))
+    {
+        reject(true);
+        return;
+    }
+    const auto* pOwner = m_world.try_get<OwnerComponent>(entity);
+    auto* pInventory = m_world.try_get<InventoryComponent>(entity);
+    const auto* pCharacter = m_world.try_get<CharacterComponent>(entity);
+    if (!pOwner || !pInventory || !pCharacter
+        || pOwner->GetOwner() != pPlayer || pOwner->OwnershipEpoch != request.OwnershipEpoch)
+    {
+        reject(true);
+        return;
+    }
+    const bool cPlayerActor = pCharacter->IsPlayer() && *character == entity;
+    if ((request.Action == RequestDroppedItem::Operation::Create || request.Action == RequestDroppedItem::Operation::Acknowledge
+        || request.Action == RequestDroppedItem::Operation::Placement) && !cPlayerActor)
+    {
+        reject(true);
+        return;
+    }
+    if (pCharacter->IsPlayer() && !cPlayerActor)
+    {
+        reject(true);
+        return;
+    }
+
+    if (request.Action == RequestDroppedItem::Operation::Placement)
+    {
+        const auto updated = m_ledger.UpdatePlacement(request.Data.Id, request.ClientSession, request.Data);
+        if (updated)
+        {
+            reply.Action = NotifyDroppedItem::Operation::Placement;
+            reply.Nonce = 0;
+            reply.Active = true;
+            reply.Data = updated->Data;
+            GameServer::Get()->SendToPlayers(reply, pPlayer);
+        }
+        return;
+    }
+
+    if (request.Action == RequestDroppedItem::Operation::Create)
+    {
+        auto existing = m_ledger.FindCreated(request.ClientSession, request.Nonce);
+        if (existing)
+        {
+            reply.Data = existing->Data;
+            reply.Active = existing->Active;
+            reply.Action = !existing->Networked ? NotifyDroppedItem::Operation::Disabled
+                : (existing->Active ? NotifyDroppedItem::Operation::Spawn : NotifyDroppedItem::Operation::Taken);
+            pPlayer->Send(reply);
+            return;
+        }
+
+        auto data = request.Data;
+        data.Id = 0;
+        data.PlacementReady = false;
+        data.Item.ExtraWorn = data.Item.ExtraWornLeft = false;
+        if (!data.Item.BaseId || data.Item.BaseId.ModId == 0xFFFFFFFF || !data.Cell || data.Item.Count <= 0 || data.Item.IsQuestItem
+            || !std::isfinite(data.Position.x) || !std::isfinite(data.Position.y) || !std::isfinite(data.Position.z)
+            || !std::isfinite(data.Rotation.x) || !std::isfinite(data.Rotation.y) || !std::isfinite(data.Rotation.z))
+        {
+            reject(false);
+            return;
+        }
+
+        const auto created = m_ledger.Create(request.ClientSession, request.Nonce, data, reply.Enabled);
+        if (!created)
+        {
+            reject(false);
+            return;
+        }
+        // Like the original actor assignment, reconnect inventory is supplied
+        // by its owning client. It already reflects the local native removal.
+        if (!request.InventoryAlreadyReflected)
+        {
+            const int64_t cached = CachedItemCount(pInventory->Content, data.Item.BaseId);
+            const int32_t debited = DebitOwnedDropCache(pInventory->Content, data.Item);
+            if (debited != data.Item.Count)
+                spdlog::warn("STR drop cache lag: actor {:X}, item {:X}:{:X}, cached {}, dropped {}, debited {}",
+                    request.ActorId, data.Item.BaseId.ModId, data.Item.BaseId.BaseId, cached, data.Item.Count, debited);
+            auto removal = data.Item;
+            removal.Count = -data.Item.Count;
+            BroadcastInventory(request.ActorId, removal, pPlayer);
+        }
+        reply.Data = created->Data;
+        reply.Active = created->Active;
+        reply.Action = reply.Enabled ? NotifyDroppedItem::Operation::Spawn : NotifyDroppedItem::Operation::Disabled;
+        if (reply.Enabled)
+        {
+            auto broadcast = reply;
+            broadcast.Nonce = 0; // Origin correlation is private to its sender.
+            GameServer::Get()->SendToPlayers(broadcast, pPlayer);
+        }
+        pPlayer->Send(reply);
+        spdlog::info("STR drop registered: id {}, actor {:X}, count {}, networked {}", reply.Data.Id, request.ActorId, data.Item.Count, reply.Enabled);
+        return;
+    }
+
+    const auto record = m_ledger.Get(request.Data.Id);
+    if (!record)
+    {
+        reject(false);
+        return;
+    }
+    reply.Data = record->Data;
+    reply.Active = record->Active;
+    if (request.Action == RequestDroppedItem::Operation::Acknowledge)
+    {
+        if (m_ledger.Acknowledge(request.Data.Id, request.ClientSession, request.ActorId, request.AppliedFresh))
+        {
+            pInventory->Content.AddOrRemoveEntry(record->Data.Item);
+            BroadcastInventory(request.ActorId, record->Data.Item, pPlayer);
+        }
+        return;
+    }
+    if (request.Action != RequestDroppedItem::Operation::Claim)
+        return;
+
+    CellIdComponent cell(record->Data.Cell, record->Data.WorldSpace, GridCellCoords::CalculateGridCellCoords(record->Data.Position));
+    const auto* pActorCell = m_world.try_get<CellIdComponent>(entity);
+    if (!pActorCell || !pActorCell->IsInRange(cell, false))
+    {
+        reject(record->Active);
+        return;
+    }
+    const auto result = m_ledger.Claim(request.Data.Id, request.ClientSession, request.ActorId, cPlayerActor);
+    if (result == DroppedItemLedger::ClaimResult::Lost || result == DroppedItemLedger::ClaimResult::Unknown)
+    {
+        reject(false);
+        return;
+    }
+    if (result == DroppedItemLedger::ClaimResult::Granted)
+    {
+        pInventory->Content.AddOrRemoveEntry(record->Data.Item);
+        BroadcastInventory(request.ActorId, record->Data.Item, cPlayerActor ? pPlayer : nullptr);
+        NotifyDroppedItem taken;
+        taken.Action = NotifyDroppedItem::Operation::Taken;
+        taken.ServerSession = m_session;
+        taken.Data.Id = request.Data.Id;
+        GameServer::Get()->SendToPlayers(taken);
+    }
+    reply.Action = NotifyDroppedItem::Operation::Grant;
+    reply.ActorId = request.ActorId;
+    reply.Active = false;
+    pPlayer->Send(reply);
