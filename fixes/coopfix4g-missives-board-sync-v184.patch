diff --git a/Code/server/Services/MissiveBoardService.cpp b/Code/server/Services/MissiveBoardService.cpp
new file mode 100644
index 00000000..e18a1609
--- /dev/null
+++ b/Code/server/Services/MissiveBoardService.cpp
@@ -0,0 +1,190 @@
+#include <Services/MissiveBoardService.h>
+#include <Events/PlayerLeaveEvent.h>
+#include <World.h>
+#include <Game/Player.h>
+#include <Game/PlayerManager.h>
+#include <chrono>
+
+MissiveBoardService::MissiveBoardService(World& aWorld, entt::dispatcher& aDispatcher) noexcept
+    : m_world(aWorld)
+    , m_serverSession(static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count()) | 1ULL)
+{
+    m_requestConnection = aDispatcher.sink<PacketEvent<RequestMissivesBoard>>().connect<&MissiveBoardService::OnRequest>(this);
+    m_leaveConnection = aDispatcher.sink<PlayerLeaveEvent>().connect<&MissiveBoardService::OnLeave>(this);
+}
+
+uint64_t MissiveBoardService::Session(Player* apPlayer) noexcept
+{
+    if (!apPlayer) return 0;
+    if (const auto it = m_sessions.find(apPlayer); it != m_sessions.end()) return it->second;
+    const uint64_t session = ++m_nextSession;
+    m_sessions.emplace(apPlayer, session);
+    m_players.emplace(session, apPlayer);
+    return session;
+}
+
+void MissiveBoardService::Send(Player* apPlayer, uint64_t aSession, const MissiveBoardLedger::Record& acRecord,
+    NotifyMissivesBoard::Operation aOperation) const noexcept
+{
+    if (!apPlayer) return;
+    NotifyMissivesBoard notify;
+    notify.Action = aOperation;
+    notify.ServerSession = m_serverSession;
+    notify.Authority = m_ledger.GetAuthority(acRecord.Listing.Board) == aSession;
+    notify.Mine = acRecord.Status == MissiveBoardLedger::State::Claimed && acRecord.Claimant == aSession;
+    notify.Listing = acRecord.Listing;
+    if (notify.Mine && aOperation == NotifyMissivesBoard::Operation::Taken)
+        notify.Action = NotifyMissivesBoard::Operation::Grant;
+    apPlayer->Send(notify);
+}
+
+void MissiveBoardService::Broadcast(const MissiveBoardLedger::Record& acRecord, NotifyMissivesBoard::Operation aOperation) const noexcept
+{
+    for (const auto& [session, pPlayer] : m_players)
+        Send(pPlayer, session, acRecord, aOperation);
+}
+
+void MissiveBoardService::BroadcastBoard(const GameId& acBoard) const noexcept
+{
+    for (const auto& [session, pPlayer] : m_players)
+    {
+        if (!pPlayer) continue;
+        NotifyMissivesBoard notify;
+        notify.Action = NotifyMissivesBoard::Operation::BoardControl;
+        notify.ServerSession = m_serverSession;
+        notify.Authority = m_ledger.GetAuthority(acBoard) == session;
+        notify.Listing.Board = acBoard;
+        pPlayer->Send(notify);
+    }
+}
+
+void MissiveBoardService::Snapshot(Player* apPlayer, uint64_t aSession, const GameId& acBoard) const noexcept
+{
+    if (!apPlayer) return;
+    NotifyMissivesBoard notify;
+    notify.ServerSession = m_serverSession;
+    notify.Listing.Board = acBoard;
+    notify.Authority = m_ledger.GetAuthority(acBoard) == aSession;
+    notify.Action = NotifyMissivesBoard::Operation::SnapshotBegin;
+    apPlayer->Send(notify);
+    for (const auto& record : m_ledger.Snapshot(acBoard))
+    {
+        const auto operation = record.Status == MissiveBoardLedger::State::Available
+            ? NotifyMissivesBoard::Operation::Posting : NotifyMissivesBoard::Operation::Taken;
+        Send(apPlayer, aSession, record, operation);
+    }
+    notify.Action = NotifyMissivesBoard::Operation::SnapshotEnd;
+    notify.Listing = MissiveBoardListing{};
+    notify.Listing.Board = acBoard;
+    apPlayer->Send(notify);
+}
+
+void MissiveBoardService::Elect(const GameId& acBoard) noexcept
+{
+    auto found = m_visitors.find(acBoard.LogFormat());
+    uint64_t authority{};
+    if (found != m_visitors.end() && !found->second.Sessions.empty())
+    {
+        authority = m_ledger.GetAuthority(acBoard);
+        if (!found->second.Sessions.contains(authority)) authority = *found->second.Sessions.begin();
+    }
+    m_ledger.SetAuthority(acBoard, authority);
+    BroadcastBoard(acBoard);
+    if (found != m_visitors.end() && found->second.Sessions.empty()) m_visitors.erase(found);
+}
+
+void MissiveBoardService::OnLeave(const PlayerLeaveEvent& acEvent) noexcept
+{
+    Player* pPlayer = acEvent.pPlayer;
+    const auto sessionIt = m_sessions.find(pPlayer);
+    if (sessionIt == m_sessions.end()) return;
+    const uint64_t session = sessionIt->second;
+    m_sessions.erase(sessionIt);
+    m_players.erase(session);
+
+    std::vector<GameId> boards;
+    for (auto& [key, visitors] : m_visitors)
+    {
+        if (visitors.Sessions.erase(session)) boards.push_back(visitors.Board);
+    }
+    for (const auto& board : boards) Elect(board);
+
+    for (const auto& record : m_ledger.RemoveClaimedBy(session))
+        Broadcast(record, NotifyMissivesBoard::Operation::Retired);
+}
+
+void MissiveBoardService::OnRequest(const PacketEvent<RequestMissivesBoard>& acEvent) noexcept
+{
+    const auto& request = acEvent.Packet;
+    Player* pPlayer = acEvent.pPlayer;
+    if (!pPlayer || request.Action > RequestMissivesBoard::Operation::Finish) return;
+
+    if (request.Action == RequestMissivesBoard::Operation::Hello)
+    {
+        const uint64_t session = Session(pPlayer);
+        NotifyMissivesBoard ready;
+        ready.Action = NotifyMissivesBoard::Operation::Ready;
+        ready.ServerSession = m_serverSession;
+        pPlayer->Send(ready);
+        spdlog::info("STR Missives board session ready: player {}", pPlayer->GetId());
+        return;
+    }
+
+    const auto sessionIt = m_sessions.find(pPlayer);
+    if (sessionIt == m_sessions.end() || request.ServerSession != m_serverSession) return;
+    const uint64_t session = sessionIt->second;
+    const auto action = request.Action;
+    const auto& listing = request.Listing;
+
+    if (action == RequestMissivesBoard::Operation::Snapshot)
+    {
+        if (listing.Board) Snapshot(pPlayer, session, listing.Board);
+        return;
+    }
+    if (action == RequestMissivesBoard::Operation::Open || action == RequestMissivesBoard::Operation::Close)
+    {
+        if (!listing.Board) return;
+        auto& visitors = m_visitors[listing.Board.LogFormat()];
+        visitors.Board = listing.Board;
+        if (action == RequestMissivesBoard::Operation::Open) visitors.Sessions.insert(session);
+        else visitors.Sessions.erase(session);
+        Elect(listing.Board);
+        if (action == RequestMissivesBoard::Operation::Open) Snapshot(pPlayer, session, listing.Board);
+        return;
+    }
+    if (action == RequestMissivesBoard::Operation::Publish)
+    {
+        if (!listing.Valid) return;
+        if (const auto record = m_ledger.Publish(session, listing))
+            Broadcast(*record, NotifyMissivesBoard::Operation::Posting);
+        return;
+    }
+    if (action == RequestMissivesBoard::Operation::Claim)
+    {
+        const auto result = m_ledger.Claim(session, listing.Id, listing.Board, listing.Quest);
+        if (result != MissiveBoardLedger::ClaimResult::Unavailable)
+        {
+            if (const auto record = m_ledger.Get(listing.Id))
+            {
+                Broadcast(*record, NotifyMissivesBoard::Operation::Taken);
+                spdlog::info("STR Missives board posting claimed on board: listing {}, player {}", listing.Id, pPlayer->GetId());
+            }
+        }
+        else
+        {
+            NotifyMissivesBoard rejected;
+            rejected.Action = NotifyMissivesBoard::Operation::Rejected;
+            rejected.ServerSession = m_serverSession;
+            rejected.Listing = listing;
+            pPlayer->Send(rejected);
+        }
+        return;
+    }
+    if (action == RequestMissivesBoard::Operation::Finish)
+    {
+        if (const auto record = m_ledger.Retire(session, listing.Id))
+        {
+            Broadcast(*record, NotifyMissivesBoard::Operation::Retired);
+        }
+    }
+}
