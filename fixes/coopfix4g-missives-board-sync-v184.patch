+#include <Structs/MissiveBoardListing.h>
+#include <TiltedCore/Serialization.hpp>
+
+using TiltedPhoques::Serialization;
+
+void MissiveBoardListing::Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept
+{
+    Serialization::WriteVarInt(aWriter, Id);
+    Board.Serialize(aWriter);
+    Quest.Serialize(aWriter);
+    Book.Serialize(aWriter);
+}
+
+void MissiveBoardListing::Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    Valid = true;
+    Id = Serialization::ReadVarInt(aReader);
+    Board.Deserialize(aReader);
+    Quest.Deserialize(aReader);
+    Book.Deserialize(aReader);
+    if (!Board || !Quest || !Book)
+        Valid = false;
+}
