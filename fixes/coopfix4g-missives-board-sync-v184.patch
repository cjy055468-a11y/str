diff --git a/Code/encoding/Structs/NpcInventorySnapshot.h b/Code/encoding/Structs/NpcInventorySnapshot.h
new file mode 100644
index 00000000..46130954
--- /dev/null
+++ b/Code/encoding/Structs/NpcInventorySnapshot.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <Structs/Inventory.h>
+#include <algorithm>
+
+// A runtime entry marked ExtraLeveledItem already replaces the corresponding
+// template count. Preserve its complete stacks and metadata, rather than
+// serializing both the template equipment and its resolved replacement.
+// Ordinary runtime deltas must still be added to their template counts.
+inline Inventory BuildNpcInventorySnapshot(const Inventory& acBase, const Inventory& acChanges,
+    const Vector<GameId>& acResolvedBases) noexcept
+{
+    Inventory result = acBase;
+    result.RemoveByFilter([&](const auto& entry)
+    {
+        return std::find(acResolvedBases.begin(), acResolvedBases.end(), entry.BaseId) != acResolvedBases.end();
+    });
+
+    Inventory changes;
+    for (const auto& entry : acChanges.Entries)
+    {
+        const auto duplicate = std::find_if(changes.Entries.begin(), changes.Entries.end(),
+            [&](const auto& candidate) { return candidate.CanBeMerged(entry); });
+        if (duplicate == changes.Entries.end()) changes.Entries.push_back(entry);
+        else duplicate->Count += entry.Count;
+    }
+    for (auto& entry : changes.Entries)
+    {
+        if (entry.ContainsExtraData()) continue;
+        // A template may contain more than one row for the same base form.
+        for (auto& base : result.Entries)
+            if (base.CanBeMerged(entry))
+            {
+                entry.Count += base.Count;
+                base.Count = 0;
+            }
+    }
+    result.Entries.insert(result.Entries.end(), changes.Entries.begin(), changes.Entries.end());
+    result.RemoveByFilter([](const auto& entry) { return entry.Count == 0; });
+    return result;
+}
diff --git a/Code/encoding/Structs/OwnedInventory.h b/Code/encoding/Structs/OwnedInventory.h
new file mode 100644
index 00000000..50e51ae3
--- /dev/null
+++ b/Code/encoding/Structs/OwnedInventory.h
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <Structs/Inventory.h>
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+// A native drop has already happened on its owning client. The server cache
+// can lag changes to charge, tempering and equipment; it is not an inventory
+// transaction authority. Keep this reconciliation scoped to owner snapshots
+// and the dedicated drop protocol, never container/corpse deltas.
+inline int64_t CachedItemCount(const Inventory& acInventory, const GameId& acBase) noexcept
+{
+    int64_t count = 0;
+    for (const auto& entry : acInventory.Entries)
+        if (entry.BaseId == acBase)
+            count += entry.Count;
+    return count;
+}
+
+inline bool HasSameInventoryEntryContents(const Inventory::Entry& acLeft, const Inventory::Entry& acRight) noexcept
+{
+    if (acLeft.BaseId != acRight.BaseId || !acLeft.IsExtraDataEquals(acRight)
+        || acLeft.EnchantData.IsWeapon != acRight.EnchantData.IsWeapon
+        || acLeft.EnchantData.Effects.size() != acRight.EnchantData.Effects.size())
+        return false;
+
+    for (std::size_t i = 0; i < acLeft.EnchantData.Effects.size(); ++i)
+    {
+        const auto& left = acLeft.EnchantData.Effects[i];
+        const auto& right = acRight.EnchantData.Effects[i];
+        if (left.Magnitude != right.Magnitude || left.Area != right.Area || left.Duration != right.Duration
+            || left.RawCost != right.RawCost || left.EffectId != right.EffectId)
+            return false;
+    }
+    return true;
+}
+
+inline bool HasSameInventoryContents(const Inventory& acLeft, const Inventory& acRight) noexcept
+{
+    if (acLeft.CurrentMagicEquipment != acRight.CurrentMagicEquipment)
+        return false;
+
+    const auto sameCountsFor = [](const Inventory& acA, const Inventory& acB, const Inventory::Entry& acKey)
+    {
+        int64_t countA = 0;
+        int64_t countB = 0;
+        for (const auto& entry : acA.Entries)
+            if (HasSameInventoryEntryContents(entry, acKey))
+                countA += entry.Count;
+        for (const auto& entry : acB.Entries)
+            if (HasSameInventoryEntryContents(entry, acKey))
+                countB += entry.Count;
+        return countA == countB;
+    };
+
+    // Entry order and stack splitting may differ after a network round trip.
+    // Avoid clearing and re-equipping an actor when equivalent stacks already match.
+    for (const auto& entry : acLeft.Entries)
+        if (!sameCountsFor(acLeft, acRight, entry))
+            return false;
+    for (const auto& entry : acRight.Entries)
+        if (!sameCountsFor(acLeft, acRight, entry))
+            return false;
+    return true;
+}
+
+inline int32_t DebitOwnedDropCache(Inventory& aInventory, const Inventory::Entry& acItem) noexcept
+{
+    if (acItem.Count <= 0)
+        return 0;
+    const int32_t debit = static_cast<int32_t>(std::clamp<int64_t>(CachedItemCount(aInventory, acItem.BaseId), 0, acItem.Count));
+    int32_t remaining = debit;
+    // Prefer matching metadata, then tolerate stale extra data for this base.
+    for (int pass = 0; pass != 2 && remaining; ++pass)
+        for (auto& entry : aInventory.Entries)
+        {
+            auto candidate = entry;
+            candidate.ExtraWorn = candidate.ExtraWornLeft = false;
+            auto wanted = acItem;
+            wanted.ExtraWorn = wanted.ExtraWornLeft = false;
+            if (entry.BaseId != acItem.BaseId || entry.Count <= 0
+                || (pass == 0 && !candidate.CanBeMerged(wanted)))
+                continue;
+            const int32_t amount = std::min(remaining, entry.Count);
+            entry.Count -= amount;
+            remaining -= amount;
+            if (!remaining)
+                break;
+        }
+    aInventory.Entries.erase(std::remove_if(aInventory.Entries.begin(), aInventory.Entries.end(),
+        [](const auto& entry) { return entry.Count == 0; }), aInventory.Entries.end());
+    return debit;
+}
+
+inline void ApplyOwnedEquipmentSnapshot(Inventory& aInventory, const Inventory& acEquipment) noexcept
+{
+    for (auto& entry : aInventory.Entries)
+        entry.ExtraWorn = entry.ExtraWornLeft = false;
+    // Reserve each actually worn stack from the cached base count, replacing
+    // stale metadata rather than adding a second copy. An outfit missing from
+    // the old assignment cache is supplied only by its current owner.
+    for (const auto& wanted : acEquipment.Entries)
+    {
+        if (!wanted.BaseId || !wanted.IsWorn() || wanted.Count <= 0)
+            continue;
+        Inventory available;
+        for (const auto& entry : aInventory.Entries)
+            if (!entry.IsWorn())
+                available.Entries.push_back(entry);
+        DebitOwnedDropCache(available, wanted);
+        aInventory.Entries.erase(std::remove_if(aInventory.Entries.begin(), aInventory.Entries.end(),
+            [](const auto& entry) { return !entry.IsWorn(); }), aInventory.Entries.end());
+        aInventory.Entries.insert(aInventory.Entries.end(), available.Entries.begin(), available.Entries.end());
+        aInventory.Entries.push_back(wanted);
+    }
+    aInventory.CurrentMagicEquipment = acEquipment.CurrentMagicEquipment;
+}
diff --git a/Code/server/Game/Inventory/DroppedItemLedger.h b/Code/server/Game/Inventory/DroppedItemLedger.h
new file mode 100644
index 00000000..f330b3dd
--- /dev/null
+++ b/Code/server/Game/Inventory/DroppedItemLedger.h
@@ -0,0 +1,136 @@
+#pragma once
+
+#include <Structs/DroppedItemData.h>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <vector>
+#include <limits>
+#include <cmath>
+
+// Independent of actor lifetime: tombstones must survive cell unloads and player
+// disconnects. The lock makes first-winner selection indivisible even if packet
+// dispatch is moved to multiple threads later.
+class DroppedItemLedger
+{
+public:
+    struct Record
+    {
+        DroppedItemData Data{};
+        uint64_t Creator{};
+        uint64_t Nonce{};
+        uint64_t Winner{};
+        uint32_t CreditedActor{};
+        uint32_t WinnerActor{};
+        bool PlayerWinner{true};
+        bool Acknowledged{};
+        bool Active{true};
+        bool Networked{true};
+    };
+    enum class ClaimResult { Granted, AlreadyGranted, Lost, Unknown };
+
+    std::optional<Record> UpdatePlacement(uint64_t aId, uint64_t aCreator, const DroppedItemData& acPose)
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (!aCreator || it == m_records.end() || it->second.Creator != aCreator || !it->second.Active || !it->second.Networked
+            || !acPose.Cell || !std::isfinite(acPose.Position.x) || !std::isfinite(acPose.Position.y) || !std::isfinite(acPose.Position.z)
+            || !std::isfinite(acPose.Rotation.x) || !std::isfinite(acPose.Rotation.y) || !std::isfinite(acPose.Rotation.z))
+            return std::nullopt;
+        auto& data = it->second.Data;
+        data.Cell = acPose.Cell;
+        data.WorldSpace = acPose.WorldSpace;
+        data.Position = acPose.Position;
+        data.Rotation = acPose.Rotation;
+        data.PlacementReady = true;
+        return it->second;
+    }
+
+    std::optional<Record> FindCreated(uint64_t aClient, uint64_t aNonce) const
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_origins.find({aClient, aNonce});
+        if (it == m_origins.end())
+            return std::nullopt;
+        return m_records.find(it->second)->second;
+    }
+
+    std::optional<Record> Create(uint64_t aClient, uint64_t aNonce, DroppedItemData aData, bool aNetworked = true)
+    {
+        std::lock_guard lock(m_lock);
+        if (!aClient || !aNonce || !aData.Item.BaseId || aData.Item.Count <= 0)
+            return std::nullopt;
+        if (const auto it = m_origins.find({aClient, aNonce}); it != m_origins.end())
+            return m_records.find(it->second)->second;
+        if (m_nextId == std::numeric_limits<uint64_t>::max())
+            return std::nullopt;
+        aData.Id = m_nextId++;
+        Record record;
+        record.Data = std::move(aData);
+        record.Creator = aClient;
+        record.Nonce = aNonce;
+        record.Networked = aNetworked;
+        record.Active = aNetworked;
+        m_origins.emplace(std::make_pair(aClient, aNonce), record.Data.Id);
+        m_records.emplace(record.Data.Id, record);
+        return record;
+    }
+
+    ClaimResult Claim(uint64_t aId, uint64_t aClient, uint32_t aActor, bool aPlayer = true)
+    {
+        std::lock_guard lock(m_lock);
+        if (!aClient || !aActor)
+            return ClaimResult::Lost;
+        const auto it = m_records.find(aId);
+        if (it == m_records.end())
+            return ClaimResult::Unknown;
+        auto& record = it->second;
+        if (!record.Active)
+            return record.Winner == aClient && record.WinnerActor == aActor ? ClaimResult::AlreadyGranted : ClaimResult::Lost;
+        record.Active = false;
+        record.Winner = aClient;
+        record.CreditedActor = aActor;
+        record.WinnerActor = aActor;
+        record.PlayerWinner = aPlayer;
+        record.Acknowledged = !aPlayer;
+        return ClaimResult::Granted;
+    }
+
+    // Freshly applied recovered grants need one server inventory correction if
+    // reconnecting created a different player actor. Duplicate ACKs cannot add.
+    bool Acknowledge(uint64_t aId, uint64_t aClient, uint32_t aActor, bool aAppliedFresh)
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (it == m_records.end() || it->second.Active || !it->second.PlayerWinner || it->second.Winner != aClient || !aActor)
+            return false;
+        auto& record = it->second;
+        const bool credit = record.CreditedActor != aActor && aAppliedFresh;
+        record.CreditedActor = aActor;
+        record.Acknowledged = true;
+        return credit;
+    }
+
+    std::optional<Record> Get(uint64_t aId) const
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() ? std::nullopt : std::optional<Record>(it->second);
+    }
+
+    std::vector<Record> Snapshot(uint64_t aClient) const
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> records;
+        for (const auto& [id, record] : m_records)
+            if (record.Networked && (record.Active || (record.PlayerWinner && record.Winner == aClient && !record.Acknowledged)))
+                records.push_back(record);
+        return records;
+    }
+
+private:
+    mutable std::mutex m_lock;
+    uint64_t m_nextId{1};
+    std::map<uint64_t, Record> m_records;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_origins;
+};
diff --git a/Code/server/Game/Inventory/MissiveBoardLedger.h b/Code/server/Game/Inventory/MissiveBoardLedger.h
new file mode 100644
index 00000000..7bfb4756
--- /dev/null
+++ b/Code/server/Game/Inventory/MissiveBoardLedger.h
@@ -0,0 +1,125 @@
+#pragma once
+#include <Structs/MissiveBoardListing.h>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+// Server-owned public posting list. Claim and retirement state is scoped to one
+// physical board row. The ledger has no task-progress or objective data.
+class MissiveBoardLedger
+{
+public:
+    enum class State : uint8_t { Available, Claimed };
+    struct Record
+    {
+        MissiveBoardListing Listing;
+        uint64_t Publisher{};
+        uint64_t Claimant{};
+        State Status{State::Available};
+    };
+    enum class ClaimResult : uint8_t { Won, AlreadyOwned, Unavailable };
+
+    uint64_t GetAuthority(const GameId& acBoard) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_authorities.find(acBoard.LogFormat());
+        return it == m_authorities.end() ? 0 : it->second;
+    }
+    void SetAuthority(const GameId& acBoard, uint64_t aSession) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        if (aSession) m_authorities[acBoard.LogFormat()] = aSession;
+        else m_authorities.erase(acBoard.LogFormat());
+    }
+    std::optional<Record> Publish(uint64_t aSession, const MissiveBoardListing& acListing) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        if (!aSession || !acListing.Board || !acListing.Quest || !acListing.Book
+            || m_authorities[acListing.Board.LogFormat()] != aSession)
+            return std::nullopt;
+        const auto key = Key(acListing.Board, acListing.Quest);
+        if (const auto it = m_slots.find(key); it != m_slots.end())
+        {
+            const auto record = m_records.find(it->second);
+            if (record != m_records.end() && record->second.Status == State::Available)
+                return record->second;
+            return std::nullopt;
+        }
+        Record record;
+        record.Publisher = aSession;
+        record.Listing = acListing;
+        record.Listing.Id = ++m_nextId;
+        m_records.emplace(record.Listing.Id, record);
+        m_slots.emplace(key, record.Listing.Id);
+        return record;
+    }
+    ClaimResult Claim(uint64_t aSession, uint64_t aId, const GameId& acBoard, const GameId& acQuest) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (!aSession || it == m_records.end() || it->second.Listing.Board != acBoard || it->second.Listing.Quest != acQuest)
+            return ClaimResult::Unavailable;
+        auto& record = it->second;
+        if (record.Status == State::Claimed)
+            return record.Claimant == aSession ? ClaimResult::AlreadyOwned : ClaimResult::Unavailable;
+        record.Status = State::Claimed;
+        record.Claimant = aSession;
+        return ClaimResult::Won;
+    }
+    std::optional<Record> Retire(uint64_t aSession, uint64_t aId) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (it == m_records.end()) return std::nullopt;
+        const auto& current = it->second;
+        const bool authorized = current.Status == State::Available
+            ? m_authorities[current.Listing.Board.LogFormat()] == aSession
+            : current.Claimant == aSession;
+        if (!authorized) return std::nullopt;
+        Record record = current;
+        m_slots.erase(Key(current.Listing.Board, current.Listing.Quest));
+        m_records.erase(it);
+        return record;
+    }
+    std::optional<Record> Get(uint64_t aId) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() ? std::nullopt : std::optional<Record>(it->second);
+    }
+    std::vector<Record> Snapshot(const GameId& acBoard) const noexcept
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> result;
+        for (const auto& [id, record] : m_records)
+            if (record.Listing.Board == acBoard) result.push_back(record);
+        return result;
+    }
+    std::vector<Record> RemoveClaimedBy(uint64_t aSession) noexcept
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> result;
+        for (auto it = m_records.begin(); it != m_records.end();)
+        {
+            if (it->second.Status == State::Claimed && it->second.Claimant == aSession)
+            {
+                result.push_back(it->second);
+                m_slots.erase(Key(it->second.Listing.Board, it->second.Listing.Quest));
+                it = m_records.erase(it);
+            }
+            else ++it;
+        }
+        return result;
+    }
+private:
+    static std::pair<uint64_t, uint64_t> Key(const GameId& acBoard, const GameId& acQuest) noexcept
+    {
+        return {acBoard.LogFormat(), acQuest.LogFormat()};
+    }
+    mutable std::mutex m_lock;
+    uint64_t m_nextId{};
+    std::map<uint64_t, uint64_t> m_authorities;
+    std::map<uint64_t, Record> m_records;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_slots;
+};
