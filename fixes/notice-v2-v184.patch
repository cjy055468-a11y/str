@@ -0,0 +1,19 @@
+#pragma once
+#include <ModCompat/NoticeState.h>
+#include <vector>
+namespace NoticeBridge
+{
+enum class Operation : uint8_t { Connected, Ready, BoardReady, Authority, State, ProxyBook, OriginalBook, LocalTask, Pending, ProtectedBook, Count, Open, Close, Offer, Begin, Commit, Release, End, MarkLocal };
+struct Event { Operation Action{}; uint32_t Quest{}; uint32_t Board{}; uint64_t Id{}; uint64_t Token{}; };
+void Connect(bool aConnected) noexcept;
+void Ready(bool aReady) noexcept;
+void NewEpoch() noexcept;
+void BoardReady(uint32_t aBoard, bool aReady) noexcept;
+void Authority(uint32_t aBoard, bool aAuthority) noexcept;
+void Snapshot(uint32_t aBoard) noexcept;
+void Apply(uint32_t aQuest, uint32_t aBoard, uint64_t aId, int32_t aStatus, uint64_t aToken) noexcept;
+void Personal(uint32_t aQuest, bool aPersonal) noexcept;
+std::vector<Event> Drain() noexcept;
+std::vector<Event> Pending() noexcept;
+int32_t Call(Operation aOperation, uint32_t aFirst = 0, uint32_t aSecond = 0) noexcept;
+}
