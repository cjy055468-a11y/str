diff --git a/Code/client/ModCompat/NoticeIsolation.cpp b/Code/client/ModCompat/NoticeIsolation.cpp
new file mode 100644
index 0000000..7306da8
--- /dev/null
+++ b/Code/client/ModCompat/NoticeIsolation.cpp
@@ -0,0 +1,43 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/NoticeIsolation.h>
+#include <ExtraData/ExtraTextDisplayData.h>
+#include <ExtraData/ExtraDataList.h>
+#include <Forms/TESQuest.h>
+namespace
+{
+// Existing r6 engine alias-owner view, unchanged layout/address-library calls.
+// The rewritten notice protocol does not introduce an engine hook or offset.
+struct QuestAliasOwner { TESQuest* Quest; const void* Alias; const void* Packages; };
+struct QuestAliasOwners : BSExtraData { GameArray<QuestAliasOwner*> Owners; BSReadWriteLock Lock; };
+static_assert(sizeof(QuestAliasOwner) == 0x18);
+static_assert(offsetof(QuestAliasOwners, Owners) == 0x10);
+static_assert(offsetof(QuestAliasOwners, Lock) == 0x28);
+static_assert(sizeof(QuestAliasOwners) == 0x30);
+struct ReadAliases
+{
+    BSReadWriteLock& Lock;
+    explicit ReadAliases(BSReadWriteLock& aLock) noexcept : Lock(aLock)
+    {
+        TP_THIS_FUNCTION(TRead,void,BSReadWriteLock);
+        POINTER_SKYRIMSE(TRead,readLock,68233);
+        TiltedPhoques::ThisCall(readLock,&Lock);
+    }
+    ~ReadAliases() noexcept
+    {
+        TP_THIS_FUNCTION(TRelease,void,BSReadWriteLock);
+        POINTER_SKYRIMSE(TRelease,readUnlock,68239);
+        TiltedPhoques::ThisCall(readUnlock,&Lock);
+    }
+};
+}
+bool NoticeIsolation::IsPersonalQuestData(ExtraDataList* apExtra) noexcept
+{
+    if (!apExtra) return false;
+    const auto* text = Cast<ExtraTextDisplayData>(apExtra->GetByType(ExtraDataType::TextDisplayData));
+    if (text && IsPrivateQuest(text->pOwnerQuest)) return true;
+    auto* owners = reinterpret_cast<QuestAliasOwners*>(apExtra->GetByType(ExtraDataType::AliasInstanceArray));
+    if (!owners) return false;
+    ReadAliases guard(owners->Lock);
+    for (const auto* owner : owners->Owners) if (owner && IsPrivateQuest(owner->Quest)) return true;
+    return false;
+}
diff --git a/Code/client/ModCompat/NoticeIsolation.h b/Code/client/ModCompat/NoticeIsolation.h
new file mode 100644
index 0000000..e7fc1dc
--- /dev/null
+++ b/Code/client/ModCompat/NoticeIsolation.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <Games/TES.h>
+#include <Forms/TESForm.h>
+#include <TESObjectREFR.h>
+#include <ModCompat/NoticeCatalog.h>
+
+namespace NoticeIsolation
+{
+inline bool FromPlugin(const TESForm* apForm, const char* apPlugin) noexcept
+{
+    if (!apForm) return false;
+    auto* pManager = ModManager::Get();
+    const auto* pMod = pManager ? pManager->GetByName(apPlugin) : nullptr;
+    return pMod && pMod->IsLoaded() && !pMod->IsLite()
+        && pMod->GetFormId(apForm->formID & 0xFFFFFFu) == apForm->formID;
+}
+inline bool IsPrivateQuest(const TESForm* apQuest) noexcept
+{ return FromPlugin(apQuest,"Missives.esp"); }
+inline bool IsPosting(const TESForm* apForm) noexcept
+{
+    if (!apForm || apForm->formType != FormType::Book) return false;
+    if (FromPlugin(apForm,"STRNoticeBoard.esp")) return true;
+    if (!FromPlugin(apForm,"Missives.esp")) return false;
+    const uint32_t localId = apForm->formID & 0xFFFFFFu;
+    for (const auto& spec : kNoticeTemplates) if (spec.Book == localId) return true;
+    return false;
+}
+inline bool IsBoard(const TESObjectREFR* apReference) noexcept
+{
+    const auto* pBase = apReference ? apReference->baseForm : nullptr;
+    return pBase && pBase->formType == FormType::Container
+        && (pBase->formID & 0xFFFFFFu) == 0x12CBu && FromPlugin(pBase,"Missives.esp");
+}
+bool IsPersonalQuestData(ExtraDataList* apExtra) noexcept;
+}
diff --git a/Code/client/ModCompat/NoticeState.h b/Code/client/ModCompat/NoticeState.h
new file mode 100644
index 0000000..d537fa8
--- /dev/null
+++ b/Code/client/ModCompat/NoticeState.h
@@ -0,0 +1,87 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <vector>
+
+// Pure client bookkeeping. Public generations and the claimant's pending
+// receipt are separate: an old receipt must never hide a newer public slip.
+class NoticeState
+{
+public:
+    using Key = std::pair<uint32_t, uint32_t>;
+    struct Row { uint64_t Id{}; int32_t Status{-1}; };
+    struct Claim { uint64_t Id{}; uint64_t Token{}; int32_t Status{6}; };
+    int32_t Status(Key aKey) const noexcept
+    {
+        if (const auto it = Claims.find(aKey); it != Claims.end()) return it->second.Status;
+        const auto it = Rows.find(aKey);
+        return it == Rows.end() ? -1 : it->second.Status;
+    }
+    bool Begin(Key aKey) noexcept
+    {
+        if (const auto it = Claims.find(aKey); it != Claims.end())
+            return it->second.Status == 6 || it->second.Status == 2 || it->second.Status == 7;
+        for (const auto& [key, claim] : Claims)
+            if (key.first == aKey.first) return false;
+        const auto row = Rows.find(aKey);
+        if (row == Rows.end() || row->second.Status != 0) return false;
+        Claims[aKey] = {row->second.Id, 0, 6};
+        return true;
+    }
+    void Apply(Key aKey, uint64_t aId, int32_t aStatus, uint64_t aToken) noexcept
+    {
+        const auto pending = Claims.find(aKey);
+        if (aStatus == 5)
+        {
+            if (pending != Claims.end() && pending->second.Status != 4 && pending->second.Id == aId
+                && (aToken == pending->second.Token || (aToken == 0 && pending->second.Status == 6)))
+                pending->second.Status = 5;
+            return;
+        }
+        auto current = Rows.find(aKey);
+        if (current == Rows.end() || aId >= current->second.Id)
+            Rows[aKey] = {aId, aStatus == 4 ? 3 : aStatus == 2 ? 1 : aStatus};
+        if (pending == Claims.end() || pending->second.Id != aId) return;
+        auto& claim = pending->second;
+        if (aStatus == 4 && (claim.Status == 7 || claim.Status == 4) && aToken != 0 && aToken == claim.Token) claim.Status = 4;
+        else if (aStatus == 2 && aToken != 0 && (claim.Status == 6 || ((claim.Status == 2 || claim.Status == 7) && claim.Token == aToken)))
+        {
+            claim.Token = aToken;
+            if (claim.Status != 7) claim.Status = 2;
+        }
+        else if (claim.Status == 6 && (aStatus == 1 || aStatus == 3)) claim.Status = 5;
+        else if (claim.Status == 2 && aStatus == 0) claim.Status = 5;
+    }
+    void Snapshot(uint32_t aBoard) noexcept
+    {
+        for (auto it = Rows.begin(); it != Rows.end();)
+            if (it->first.second == aBoard) it = Rows.erase(it);
+            else ++it;
+    }
+    void Disconnect() noexcept
+    {
+        Rows.clear();
+        for (auto& [key, claim] : Claims)
+            if (claim.Status != 7 && claim.Status != 4) claim.Status = 5;
+    }
+    void NewEpoch() noexcept
+    {
+        Rows.clear();
+        for (auto& [key, claim] : Claims)
+            if (claim.Status != 4)
+            {
+                claim.Status = 5;
+                claim.Id = 0;
+                claim.Token = 0;
+            }
+    }
+    bool Pending(uint32_t aQuest) const noexcept
+    {
+        for (const auto& [key, claim] : Claims)
+            if (key.first == aQuest) return true;
+        return false;
+    }
+    std::map<Key, Row> Rows;
+    std::map<Key, Claim> Claims;
+};
