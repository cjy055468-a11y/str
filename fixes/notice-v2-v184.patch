diff --git a/Code/client/Systems/CorpseLifeState.h b/Code/client/Systems/CorpseLifeState.h
new file mode 100644
index 0000000..e505f37
--- /dev/null
+++ b/Code/client/Systems/CorpseLifeState.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+
+// Source reference: CommonLibSSE-NG ActorState1::lifeState occupies bits 21..24,
+// kDead is 2. This mask also matches this project's IsBleedingOut implementation.
+// Preserve only an already completed, authoritatively confirmed death; never
+// force a dying actor to dead or block an accepted resurrection.
+inline bool IsCompletedCorpseLifeState(uint32_t aNativeState) noexcept
+{
+    return (aNativeState & 0x01E00000) == (2u << 21);
+}
+
+inline uint32_t PreserveConfirmedCorpseLifeState(uint32_t aNativeState, uint32_t aActionState, bool aConfirmedDeath) noexcept
+{
+    constexpr uint32_t kLifeMask = 0x01E00000;
+    constexpr uint32_t kDead = 2u << 21;
+    if (aConfirmedDeath && IsCompletedCorpseLifeState(aNativeState))
+        return (aActionState & ~kLifeMask) | kDead;
+    return aActionState;
+}
+
+// Actor action snapshots carry pose state, not a completed native Kill call.
+// Copying their dead bit onto a still-live replica makes IsDead skip KillImpl.
+inline uint32_t PreserveRemoteNpcDeathTransition(uint32_t aNative, uint32_t aIncoming, bool aConfirmed) noexcept
+{
+    constexpr uint32_t kMask = 0x01E00000;
+    const uint32_t nativeLife = (aNative & kMask) >> 21;
+    const uint32_t incomingLife = (aIncoming & kMask) >> 21;
+    if (nativeLife <= 2 && incomingLife <= 2)
+        return (aIncoming & ~kMask) | (aNative & kMask);
+    return PreserveConfirmedCorpseLifeState(aNative, aIncoming, aConfirmed);
+}
+
+inline bool IsNativeDeathTransition(uint32_t aNative) noexcept
+{
+    const uint32_t life = (aNative & 0x01E00000) >> 21;
+    return life == 1 || life == 2;
+}
diff --git a/Code/client/Systems/CorpseSpeechWindow.h b/Code/client/Systems/CorpseSpeechWindow.h
new file mode 100644
index 0000000..49e9770
--- /dev/null
+++ b/Code/client/Systems/CorpseSpeechWindow.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// Timing and identity only. Repeated late packets cannot restart the grace
+// period. A revived actor or a recycled handle starts a separate lifetime.
+class CorpseSpeechWindow
+{
+public:
+    static constexpr uint64_t kGraceMilliseconds = 4000;
+
+    bool Observe(uint32_t aHandle, bool aDead, uint64_t aMilliseconds) noexcept
+    {
+        if (m_handle != aHandle || !aDead)
+        {
+            m_handle = aHandle;
+            m_deadSince.reset();
+            m_expired = false;
+        }
+        if (!aDead)
+            return false;
+        if (m_expired)
+            return true;
+        if (!m_deadSince || aMilliseconds < *m_deadSince)
+            m_deadSince = aMilliseconds;
+        m_expired = aMilliseconds - *m_deadSince >= kGraceMilliseconds;
+        return m_expired;
+    }
+
+private:
+    uint32_t m_handle{};
+    std::optional<uint64_t> m_deadSince;
+    bool m_expired{};
+};
diff --git a/Code/client/Systems/CorpseStateRefreshWindow.h b/Code/client/Systems/CorpseStateRefreshWindow.h
new file mode 100644
index 0000000..8a925ce
--- /dev/null
+++ b/Code/client/Systems/CorpseStateRefreshWindow.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// Pure lifetime/timing policy. Native IsDead is deliberately not an input:
+// our brief local transition must not schedule another refresh for this death.
+class CorpseStateRefreshWindow
+{
+public:
+    static constexpr uint64_t kDelayMilliseconds = 1000;
+
+    bool Observe(uint32_t aHandle, uint32_t aServerId, uint32_t aEpoch, bool aConfirmedDead, bool aReady, uint64_t aNow) noexcept
+    {
+        if (m_handle != aHandle || m_serverId != aServerId || m_epoch != aEpoch || !aConfirmedDead)
+        {
+            m_handle = aHandle;
+            m_serverId = aServerId;
+            m_epoch = aEpoch;
+            m_deadSince.reset();
+            m_consumed = false;
+        }
+        if (!aConfirmedDead || aHandle == 0 || aServerId == 0xFFFFFFFFu || aEpoch == 0 || m_consumed)
+            return false;
+        if (!m_deadSince || aNow < *m_deadSince)
+            m_deadSince = aNow;
+        if (!aReady || aNow - *m_deadSince < kDelayMilliseconds)
+            return false;
+        // Consume before entering the engine, including if the attempt fails.
+        m_consumed = true;
+        return true;
+    }
+
+private:
+    uint32_t m_handle{};
+    uint32_t m_serverId{};
+    uint32_t m_epoch{};
+    std::optional<uint64_t> m_deadSince;
+    bool m_consumed{};
+};
diff --git a/Code/client/Systems/DropPlacementClock.h b/Code/client/Systems/DropPlacementClock.h
new file mode 100644
index 0000000..59406c8
--- /dev/null
+++ b/Code/client/Systems/DropPlacementClock.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <glm/glm.hpp>
+#include <optional>
+#include <cstdint>
+
+// Sample only the original native drop. A failed send must not consume the
+// pending placement; replicas never become a second physics authority.
+class DropPlacementClock
+{
+public:
+    bool Observe(bool aReady, const glm::vec3& acPosition, const glm::vec3& acRotation, uint64_t aNow) noexcept
+    {
+        if (!aReady)
+        {
+            m_sample.reset();
+            m_stable = 0;
+            return false;
+        }
+        const bool stable = m_sample && Near(m_sample->Position, acPosition, 1.f) && Near(m_sample->Rotation, acRotation, 0.0004f);
+        m_stable = stable ? m_stable + 1 : 0;
+        m_sample = Pose{acPosition, acRotation};
+        if (!m_published && m_stable < 2)
+            return false;
+        return !m_published || (aNow >= m_nextSend && (!Near(m_published->Position, acPosition, 1.f) || !Near(m_published->Rotation, acRotation, 0.0004f)));
+    }
+
+    void Published(const glm::vec3& acPosition, const glm::vec3& acRotation, uint64_t aNow) noexcept
+    {
+        m_published = Pose{acPosition, acRotation};
+        m_nextSend = aNow + 500;
+    }
+
+private:
+    struct Pose { glm::vec3 Position; glm::vec3 Rotation; };
+    static bool Near(const glm::vec3& acA, const glm::vec3& acB, float aSquaredDistance) noexcept
+    {
+        const auto delta = acA - acB;
+        return glm::dot(delta, delta) <= aSquaredDistance;
+    }
+    std::optional<Pose> m_sample;
+    std::optional<Pose> m_published;
+    uint64_t m_nextSend{};
+    uint32_t m_stable{};
+};
diff --git a/Code/client/Systems/DropProxySetup.h b/Code/client/Systems/DropProxySetup.h
new file mode 100644
index 0000000..ae97499
--- /dev/null
+++ b/Code/client/Systems/DropProxySetup.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+// Geometry and collision attach asynchronously. The reference is positioned
+// before enabling; make bounded wake attempts only after both are ready.
+class DropProxySetup
+{
+public:
+    enum class Action { Wait, PlaceAndWake, Wake, Done };
+
+    Action Advance(bool aHas3D, bool aCellAttached, uint64_t aMilliseconds, bool aHasCollision = true) noexcept
+    {
+        if (!aHas3D || !aCellAttached || !aHasCollision)
+        {
+            m_first3D.reset();
+            m_attempts = 0;
+            m_nextAttempt = 0;
+            return Action::Wait;
+        }
+        if (!m_first3D)
+            m_first3D = aMilliseconds;
+        if (m_attempts >= 3)
+            return Action::Done;
+        if (aMilliseconds - *m_first3D < 100 || aMilliseconds < m_nextAttempt)
+            return Action::Wait;
+        m_nextAttempt = aMilliseconds + 500;
+        return m_attempts++ == 0 ? Action::PlaceAndWake : Action::Wake;
+    }
+
+private:
+    std::optional<uint64_t> m_first3D;
+    uint64_t m_nextAttempt{};
+    uint32_t m_attempts{};
+};
