+DroppedItemService* DroppedItemService::Get() noexcept
+{
+    return World::Get().ctx().find<DroppedItemService>();
+}
+
+bool DroppedItemService::HandlesDrops() const noexcept
+{
+    return m_clientSession && m_online.load() && m_enabled.load() != 0 && m_ready.load();
+}
+
+bool DroppedItemService::DefersPlayerDrops() const noexcept
+{
+    return m_clientSession && m_online.load() && m_enabled.load() != 0 && !m_ready.load();
+}
+
+bool DroppedItemService::TrackDrop(TESObjectREFR* apReference, Inventory::Entry aItem) noexcept
+{
+    if (!HandlesDrops() || !apReference || !apReference->IsTemporary() || aItem.Count <= 0)
+        return false;
+    Pending pending;
+    pending.Handle = apReference->GetHandle().handle.iBits;
+    if (!pending.Handle)
+        return false;
+    pending.FormId = apReference->formID;
+    pending.RefundItem = aItem;
+    pending.Data.Item = std::move(aItem);
+    pending.Data.Item.ExtraWorn = pending.Data.Item.ExtraWornLeft = false;
+    pending.Data.Position = apReference->position;
+    pending.Data.Rotation = apReference->rotation;
+    if (const auto* pCell = apReference->GetParentCellEx())
+    {
+        pending.CellForm = pCell->formID;
+        if (!(pCell->cellFlags & 1) && pCell->worldspace)
+            pending.WorldForm = pCell->worldspace->formID;
+    }
+    const uint64_t nonce = m_nonce.fetch_add(1);
+    {
+        std::lock_guard lock(m_lock);
+        m_bindings[pending.FormId] = {pending.Handle, 0, nonce, false};
+        m_pending.emplace(nonce, std::move(pending));
+    }
+    // Do not save a client-generated overlay that could reappear from a save.
+    // Save filtering is handled separately. SetSkipSaveFlag writes all runtime
+    // form bits, including deletion state; it is unsafe for live pickup refs.
+    m_world.GetRunner().Queue([this, nonce]() { PrepareDrop(nonce); });
+    return true;
+}
+
+bool DroppedItemService::IsTracked(TESObjectREFR* apReference) const noexcept
+{
+    if (!apReference)
+        return false;
+    std::lock_guard lock(m_lock);
+    const auto it = m_bindings.find(apReference->formID);
+    return it != m_bindings.end() && it->second.Handle == apReference->GetHandle().handle.iBits;
+}
