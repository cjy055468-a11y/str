diff --git a/Code/client/ModCompat/NoticeBridge.cpp b/Code/client/ModCompat/NoticeBridge.cpp
new file mode 100644
index 0000000..c408642
--- /dev/null
+++ b/Code/client/ModCompat/NoticeBridge.cpp
@@ -0,0 +1,180 @@
+#include <TiltedOnlinePCH.h>
+#include <ModCompat/NoticeBridge.h>
+#include <ModCompat/NoticeCatalog.h>
+#include <Games/TES.h>
+#include <Misc/BSScript.h>
+#include <mutex>
+#include <set>
+namespace
+{
+std::mutex s_lock;
+NoticeState s_state;
+bool s_connected{}, s_ready{};
+std::set<uint32_t> s_boards, s_authorities, s_open, s_personal;
+std::vector<NoticeBridge::Event> s_events;
+const NoticeTemplate* Spec(uint32_t aQuest) noexcept
+{
+    auto* pManager = ModManager::Get();
+    const auto* pMod = pManager ? pManager->GetByName("Missives.esp") : nullptr;
+    if (!pMod || !pMod->IsLoaded()) return nullptr;
+    for (const auto& spec : kNoticeTemplates)
+        if (pMod->GetFormId(spec.Quest) == aQuest) return &spec;
+    return nullptr;
+}
+uint32_t Form(const char* apPlugin, uint32_t aLocal) noexcept
+{
+    auto* pManager = ModManager::Get();
+    const auto* pMod = pManager ? pManager->GetByName(apPlugin) : nullptr;
+    return pMod && pMod->IsLoaded() ? pMod->GetFormId(aLocal) : 0;
+}
+}
+void NoticeBridge::Connect(bool aConnected) noexcept
+{
+    std::lock_guard lock(s_lock);
+    s_connected = aConnected; s_ready = false;
+    s_boards.clear(); s_authorities.clear(); s_open.clear(); s_events.clear();
+    s_state.Disconnect();
+}
+void NoticeBridge::Ready(bool aReady) noexcept { std::lock_guard lock(s_lock); s_ready = aReady; }
+void NoticeBridge::NewEpoch() noexcept { std::lock_guard lock(s_lock); s_state.NewEpoch(); }
+void NoticeBridge::BoardReady(uint32_t aBoard, bool aReady) noexcept
+{ std::lock_guard lock(s_lock); if (aReady) s_boards.insert(aBoard); else s_boards.erase(aBoard); }
+void NoticeBridge::Authority(uint32_t aBoard, bool aAuthority) noexcept
+{ std::lock_guard lock(s_lock); if (aAuthority) s_authorities.insert(aBoard); else s_authorities.erase(aBoard); }
+void NoticeBridge::Snapshot(uint32_t aBoard) noexcept
+{ std::lock_guard lock(s_lock); s_boards.erase(aBoard); s_state.Snapshot(aBoard); }
+void NoticeBridge::Apply(uint32_t aQuest, uint32_t aBoard, uint64_t aId, int32_t aStatus, uint64_t aToken) noexcept
+{ std::lock_guard lock(s_lock); s_state.Apply({aQuest,aBoard},aId,aStatus,aToken); }
+void NoticeBridge::Personal(uint32_t aQuest, bool aPersonal) noexcept
+{ std::lock_guard lock(s_lock); if (aPersonal) s_personal.insert(aQuest); else s_personal.erase(aQuest); }
+std::vector<NoticeBridge::Event> NoticeBridge::Drain() noexcept
+{ std::lock_guard lock(s_lock); std::vector<Event> result; result.swap(s_events); return result; }
+std::vector<NoticeBridge::Event> NoticeBridge::Pending() noexcept
+{
+    std::lock_guard lock(s_lock); std::vector<Event> result;
+    for (const auto& [key, claim] : s_state.Claims)
+        if (claim.Status == 6 || claim.Status == 2 || claim.Status == 7)
+            result.push_back({claim.Status == 7 ? Operation::Commit : Operation::Begin,key.first,key.second,claim.Id,claim.Token});
+    return result;
+}
+int32_t NoticeBridge::Call(Operation aOperation, uint32_t aFirst, uint32_t aSecond) noexcept
+{
+    std::lock_guard lock(s_lock);
+    const NoticeState::Key key{aFirst,aSecond};
+    using O = Operation;
+    switch (aOperation)
+    {
+    case O::Connected: return s_connected;
+    case O::Ready: return s_connected && s_ready;
+    case O::BoardReady: return s_ready && s_boards.contains(aFirst);
+    case O::Authority: return s_ready && s_boards.contains(aFirst) && s_authorities.contains(aFirst);
+    case O::State: return s_state.Status(key);
+    case O::ProxyBook: { const auto* spec = Spec(aFirst); return spec ? static_cast<int32_t>(Form("STRNoticeBoard.esp",spec->Proxy)) : 0; }
+    case O::OriginalBook: { const auto* spec = Spec(aFirst); return spec ? static_cast<int32_t>(Form("Missives.esp",spec->Book)) : 0; }
+    case O::LocalTask: return s_personal.contains(aFirst);
+    case O::Pending: return s_state.Pending(aFirst);
+    case O::ProtectedBook:
+    {
+        const auto* spec = Spec(aFirst); if (!spec) return false;
+        for (const auto& candidate : kNoticeTemplates)
+        {
+            if (candidate.Book != spec->Book) continue;
+            const uint32_t quest = Form("Missives.esp",candidate.Quest);
+            // A prepared alias letter still resides in its source board until
+            // delivery completes. Afterwards it belongs to the player's
+            // inventory: protecting its shared BOOK base on every board would
+            // leave unrelated, unaccepted solo letters visible only locally.
+            if (s_state.Pending(quest)) return true;
+        }
+        return false;
+    }
+    case O::Count:
+    {
+        int32_t count{};
+        for (const auto& [slot,row] : s_state.Rows)
+            if (slot.second == aFirst && (row.Status == 0 || row.Status == 1)) ++count;
+        return count;
+    }
+    case O::MarkLocal: s_personal.insert(aFirst); return 1;
+    case O::End: s_state.Claims.erase(key); return 1;
+    default: break;
+    }
+    if (!s_connected) return 0;
+    if (aOperation == O::Open)
+    { if (s_open.insert(aFirst).second) s_events.push_back({O::Open,aFirst,0}); return 1; }
+    if (aOperation == O::Close)
+    { s_open.erase(aFirst); s_boards.erase(aFirst); s_authorities.erase(aFirst); s_events.push_back({O::Close,aFirst,0}); return 1; }
+    if (aOperation == O::Offer)
+    {
+        if (Spec(aFirst) && s_ready && s_boards.contains(aSecond) && s_authorities.contains(aSecond))
+            s_events.push_back({O::Offer,aFirst,aSecond});
+        return 1;
+    }
+    if (aOperation == O::Begin)
+    {
+        if (!s_ready || !s_boards.contains(aSecond) || s_personal.contains(aFirst) || !s_state.Begin(key)) return 0;
+        const auto& claim = s_state.Claims.find(key)->second;
+        s_events.push_back({O::Begin,aFirst,aSecond,claim.Id,claim.Token});
+        return 1;
+    }
+    const auto it = s_state.Claims.find(key);
+    if (it == s_state.Claims.end()) return 0;
+    auto& claim = it->second;
+    if (aOperation == O::Commit && (claim.Status == 2 || claim.Status == 7))
+    { claim.Status = 7; s_events.push_back({O::Commit,aFirst,aSecond,claim.Id,claim.Token}); return 1; }
+    if (aOperation == O::Release && claim.Status != 4 && claim.Status != 7)
+    { s_events.push_back({O::Release,aFirst,aSecond,claim.Id,claim.Token}); claim.Status = 5; return 1; }
+    return 0;
+}
+namespace
+{
+void NoticeNativeMarker() {}
+class NoticeFunction final : public BSScript::NativeFunction
+{
+public:
+    NoticeFunction(const char* apName, NoticeBridge::Operation aOperation, uint32_t aCount, BSScript::Variable::Type aType)
+        : NativeFunction(apName,"STRNoticeBridge",true,aCount), m_operation(aOperation), m_count(aCount), m_type(aType)
+    {
+        pFunction = reinterpret_cast<void*>(&NoticeNativeMarker); returnType = aType;
+        for (uint32_t i=0;i<aCount;++i) parameters.data[i].type = BSScript::Variable::kInteger;
+        SetCallableFromTasklets(false);
+    }
+    bool MarshallAndDispatch(BSScript::Variable*,BSScript::IVirtualMachine*,uint32_t,BSScript::Variable* apResult,BSScript::StackFrame* apFrame) override
+    {
+        uint32_t args[2]{};
+        if (m_count)
+        {
+            const uint32_t page = apFrame->GetPageForFrame();
+            for (uint32_t i=0;i<m_count;++i)
+            {
+                const auto* pValue = apFrame->GetStackFrameVariable(i,page);
+                if (!pValue || pValue->type != BSScript::Variable::kInteger) return false;
+                args[i] = static_cast<uint32_t>(pValue->data.i);
+            }
+        }
+        const int32_t result = NoticeBridge::Call(m_operation,args[0],args[1]);
+        if (m_type == BSScript::Variable::kBoolean) apResult->Set<bool>(result != 0);
+        else if (m_type == BSScript::Variable::kInteger) apResult->Set<int32_t>(result);
+        else apResult->Clear();
+        return true;
+    }
+private:
+    NoticeBridge::Operation m_operation; uint32_t m_count; BSScript::Variable::Type m_type;
+};
+}
+void RegisterNoticeBridge(BSScript::IVirtualMachine* apVm) noexcept
+{
+    using O=NoticeBridge::Operation; using V=BSScript::Variable;
+    struct Binding { const char* Name; O Operation; uint32_t Count; V::Type Type; };
+    const Binding bindings[] = {
+        {"IsConnected",O::Connected,0,V::kBoolean},{"IsReady",O::Ready,0,V::kBoolean},
+        {"IsBoardReady",O::BoardReady,1,V::kBoolean},{"IsBoardAuthority",O::Authority,1,V::kBoolean},
+        {"GetNoticeState",O::State,2,V::kInteger},{"GetProxyBook",O::ProxyBook,1,V::kInteger},{"GetOriginalBook",O::OriginalBook,1,V::kInteger},
+        {"IsLocalTask",O::LocalTask,1,V::kBoolean},{"IsClaimPending",O::Pending,1,V::kBoolean},
+        {"IsOriginalBookProtected",O::ProtectedBook,1,V::kBoolean},{"GetPostingCount",O::Count,1,V::kInteger},
+        {"OpenBoard",O::Open,1,V::kEmpty},{"CloseBoard",O::Close,1,V::kEmpty},{"Offer",O::Offer,2,V::kEmpty},
+        {"BeginClaim",O::Begin,2,V::kBoolean},{"CommitClaim",O::Commit,2,V::kEmpty},{"ReleaseClaim",O::Release,2,V::kEmpty},
+        {"EndClaim",O::End,2,V::kEmpty},{"MarkLocalTask",O::MarkLocal,1,V::kEmpty}
+    };
+    for (const auto& binding:bindings) apVm->BindNativeMethod(new NoticeFunction(binding.Name,binding.Operation,binding.Count,binding.Type));
+}
