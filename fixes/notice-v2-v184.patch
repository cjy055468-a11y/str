+    Serialization::WriteVarInt(aWriter, ServerSession);
+    Notice.Serialize(aWriter);
+    Serialization::WriteVarInt(aWriter, Token);
+    Serialization::WriteBool(aWriter, Authority);
+}
+
+void NotifyNoticeBoard::DeserializeRaw(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    ServerMessage::DeserializeRaw(aReader);
