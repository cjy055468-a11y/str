diff --git a/Code/encoding/Structs/NpcInventorySnapshot.h b/Code/encoding/Structs/NpcInventorySnapshot.h
new file mode 100644
index 0000000..4613095
--- /dev/null
+++ b/Code/encoding/Structs/NpcInventorySnapshot.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <Structs/Inventory.h>
+#include <algorithm>
+
+// A runtime entry marked ExtraLeveledItem already replaces the corresponding
+// template count. Preserve its complete stacks and metadata, rather than
+// serializing both the template equipment and its resolved replacement.
+// Ordinary runtime deltas must still be added to their template counts.
+inline Inventory BuildNpcInventorySnapshot(const Inventory& acBase, const Inventory& acChanges,
+    const Vector<GameId>& acResolvedBases) noexcept
+{
+    Inventory result = acBase;
+    result.RemoveByFilter([&](const auto& entry)
+    {
+        return std::find(acResolvedBases.begin(), acResolvedBases.end(), entry.BaseId) != acResolvedBases.end();
+    });
+
+    Inventory changes;
+    for (const auto& entry : acChanges.Entries)
+    {
+        const auto duplicate = std::find_if(changes.Entries.begin(), changes.Entries.end(),
+            [&](const auto& candidate) { return candidate.CanBeMerged(entry); });
+        if (duplicate == changes.Entries.end()) changes.Entries.push_back(entry);
+        else duplicate->Count += entry.Count;
+    }
+    for (auto& entry : changes.Entries)
+    {
+        if (entry.ContainsExtraData()) continue;
+        // A template may contain more than one row for the same base form.
+        for (auto& base : result.Entries)
+            if (base.CanBeMerged(entry))
+            {
+                entry.Count += base.Count;
+                base.Count = 0;
+            }
+    }
+    result.Entries.insert(result.Entries.end(), changes.Entries.begin(), changes.Entries.end());
+    result.RemoveByFilter([](const auto& entry) { return entry.Count == 0; });
+    return result;
+}
diff --git a/Code/encoding/Structs/OwnedInventory.h b/Code/encoding/Structs/OwnedInventory.h
new file mode 100644
index 0000000..50e51ae
--- /dev/null
+++ b/Code/encoding/Structs/OwnedInventory.h
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <Structs/Inventory.h>
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+// A native drop has already happened on its owning client. The server cache
+// can lag changes to charge, tempering and equipment; it is not an inventory
+// transaction authority. Keep this reconciliation scoped to owner snapshots
+// and the dedicated drop protocol, never container/corpse deltas.
+inline int64_t CachedItemCount(const Inventory& acInventory, const GameId& acBase) noexcept
+{
+    int64_t count = 0;
+    for (const auto& entry : acInventory.Entries)
+        if (entry.BaseId == acBase)
+            count += entry.Count;
+    return count;
+}
+
+inline bool HasSameInventoryEntryContents(const Inventory::Entry& acLeft, const Inventory::Entry& acRight) noexcept
+{
+    if (acLeft.BaseId != acRight.BaseId || !acLeft.IsExtraDataEquals(acRight)
+        || acLeft.EnchantData.IsWeapon != acRight.EnchantData.IsWeapon
+        || acLeft.EnchantData.Effects.size() != acRight.EnchantData.Effects.size())
+        return false;
+
+    for (std::size_t i = 0; i < acLeft.EnchantData.Effects.size(); ++i)
+    {
+        const auto& left = acLeft.EnchantData.Effects[i];
+        const auto& right = acRight.EnchantData.Effects[i];
+        if (left.Magnitude != right.Magnitude || left.Area != right.Area || left.Duration != right.Duration
+            || left.RawCost != right.RawCost || left.EffectId != right.EffectId)
+            return false;
+    }
+    return true;
+}
+
+inline bool HasSameInventoryContents(const Inventory& acLeft, const Inventory& acRight) noexcept
+{
+    if (acLeft.CurrentMagicEquipment != acRight.CurrentMagicEquipment)
+        return false;
+
+    const auto sameCountsFor = [](const Inventory& acA, const Inventory& acB, const Inventory::Entry& acKey)
+    {
+        int64_t countA = 0;
+        int64_t countB = 0;
+        for (const auto& entry : acA.Entries)
+            if (HasSameInventoryEntryContents(entry, acKey))
+                countA += entry.Count;
+        for (const auto& entry : acB.Entries)
+            if (HasSameInventoryEntryContents(entry, acKey))
+                countB += entry.Count;
+        return countA == countB;
+    };
+
+    // Entry order and stack splitting may differ after a network round trip.
+    // Avoid clearing and re-equipping an actor when equivalent stacks already match.
+    for (const auto& entry : acLeft.Entries)
+        if (!sameCountsFor(acLeft, acRight, entry))
+            return false;
+    for (const auto& entry : acRight.Entries)
+        if (!sameCountsFor(acLeft, acRight, entry))
+            return false;
+    return true;
+}
+
+inline int32_t DebitOwnedDropCache(Inventory& aInventory, const Inventory::Entry& acItem) noexcept
+{
+    if (acItem.Count <= 0)
+        return 0;
+    const int32_t debit = static_cast<int32_t>(std::clamp<int64_t>(CachedItemCount(aInventory, acItem.BaseId), 0, acItem.Count));
+    int32_t remaining = debit;
+    // Prefer matching metadata, then tolerate stale extra data for this base.
+    for (int pass = 0; pass != 2 && remaining; ++pass)
+        for (auto& entry : aInventory.Entries)
+        {
+            auto candidate = entry;
+            candidate.ExtraWorn = candidate.ExtraWornLeft = false;
+            auto wanted = acItem;
+            wanted.ExtraWorn = wanted.ExtraWornLeft = false;
+            if (entry.BaseId != acItem.BaseId || entry.Count <= 0
+                || (pass == 0 && !candidate.CanBeMerged(wanted)))
+                continue;
+            const int32_t amount = std::min(remaining, entry.Count);
+            entry.Count -= amount;
+            remaining -= amount;
+            if (!remaining)
+                break;
+        }
+    aInventory.Entries.erase(std::remove_if(aInventory.Entries.begin(), aInventory.Entries.end(),
+        [](const auto& entry) { return entry.Count == 0; }), aInventory.Entries.end());
+    return debit;
+}
+
+inline void ApplyOwnedEquipmentSnapshot(Inventory& aInventory, const Inventory& acEquipment) noexcept
+{
+    for (auto& entry : aInventory.Entries)
+        entry.ExtraWorn = entry.ExtraWornLeft = false;
+    // Reserve each actually worn stack from the cached base count, replacing
+    // stale metadata rather than adding a second copy. An outfit missing from
+    // the old assignment cache is supplied only by its current owner.
+    for (const auto& wanted : acEquipment.Entries)
+    {
+        if (!wanted.BaseId || !wanted.IsWorn() || wanted.Count <= 0)
+            continue;
+        Inventory available;
+        for (const auto& entry : aInventory.Entries)
+            if (!entry.IsWorn())
+                available.Entries.push_back(entry);
+        DebitOwnedDropCache(available, wanted);
+        aInventory.Entries.erase(std::remove_if(aInventory.Entries.begin(), aInventory.Entries.end(),
+            [](const auto& entry) { return !entry.IsWorn(); }), aInventory.Entries.end());
+        aInventory.Entries.insert(aInventory.Entries.end(), available.Entries.begin(), available.Entries.end());
+        aInventory.Entries.push_back(wanted);
+    }
+    aInventory.CurrentMagicEquipment = acEquipment.CurrentMagicEquipment;
+}
