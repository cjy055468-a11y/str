new file mode 100644
index 0000000..98a10d8
--- /dev/null
+++ b/Code/client/Services/Generic/NoticeBoardService.cpp
@@ -0,0 +1,217 @@
+#include <TiltedOnlinePCH.h>
+#include <Services/NoticeBoardService.h>
+#include <Services/TransportService.h>
+#include <Events/ConnectedEvent.h>
+#include <Events/DisconnectedEvent.h>
+#include <Events/UpdateEvent.h>
+#include <ModCompat/NoticeCatalog.h>
+#include <Forms/TESQuest.h>
+#include <Games/TES.h>
+#include <World.h>
+
+namespace
+{
+const Mod* LoadedNoticeMod(const char* apName) noexcept
+{
+    auto* pManager = ModManager::Get();
+    const auto* pMod = pManager ? pManager->GetByName(apName) : nullptr;
+    return pMod && pMod->IsLoaded() ? pMod : nullptr;
+}
+}
+NoticeBoardService::NoticeBoardService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept
+    : m_world(aWorld), m_transport(aTransport)
+{
+    m_join = aDispatcher.sink<ConnectedEvent>().connect<&NoticeBoardService::OnConnected>(this);
+    m_leave = aDispatcher.sink<DisconnectedEvent>().connect<&NoticeBoardService::OnDisconnected>(this);
+    m_update = aDispatcher.sink<UpdateEvent>().connect<&NoticeBoardService::OnUpdate>(this);
+    m_notice = aDispatcher.sink<NotifyNoticeBoard>().connect<&NoticeBoardService::OnNotice>(this);
+}
+void NoticeBoardService::OnConnected(const ConnectedEvent&) noexcept
+{
+    m_serverSession = 0;
+    m_openBoards.clear(); m_offerRetry.clear(); m_claimRetry.clear(); m_badSnapshots.clear();
+    m_enabled = LoadedNoticeMod("Missives.esp") && LoadedNoticeMod("STRNoticeBoard.esp");
+    NoticeBridge::Connect(m_enabled);
+    m_nextHello = m_nextTasks = Clock::now();
+    if (m_enabled) RefreshPersonalTasks();
+    spdlog::info("STR fresh notice compatibility: enabled {}, original {}, proxy ESP {}", m_enabled,
+        LoadedNoticeMod("Missives.esp") != nullptr, LoadedNoticeMod("STRNoticeBoard.esp") != nullptr);
+}
+void NoticeBoardService::OnDisconnected(const DisconnectedEvent&) noexcept
+{
+    m_serverSession = 0;
+    m_openBoards.clear(); m_offerRetry.clear(); m_claimRetry.clear(); m_badSnapshots.clear();
+    NoticeBridge::Connect(false); // committed/pending-commit receipts survive this reconnect
+}
+bool NoticeBoardService::KnownQuest(uint32_t aQuest) const noexcept
+{
+    const auto* pMod = LoadedNoticeMod("Missives.esp");
+    if (!pMod) return false;
+    for (const auto& spec : kNoticeTemplates)
+        if (pMod->GetFormId(spec.Quest) == aQuest) return true;
+    return false;
+}
+void NoticeBoardService::RefreshPersonalTasks() noexcept
+{
+    const auto* pMod = LoadedNoticeMod("Missives.esp");
+    if (!pMod) return;
+    for (const auto& spec : kNoticeTemplates)
+    {
+        const uint32_t questId = pMod->GetFormId(spec.Quest);
+        const auto* pQuest = Cast<TESQuest>(TESForm::GetById(questId));
+        // MarkLocalTask precedes moving the original letter and stage 20. Do
+        // not clear it while that confirmed transaction is still delivering.
+        const bool delivering = NoticeBridge::Call(NoticeBridge::Operation::LocalTask,questId)
+            && NoticeBridge::Call(NoticeBridge::Operation::Pending,questId);
+        const bool active = pQuest && !pQuest->IsStopped() && pQuest->currentStage >= 20 && pQuest->currentStage < 103;
+        NoticeBridge::Personal(questId, active || delivering);
+    }
+}
+bool NoticeBoardService::Send(RequestNoticeBoard::Operation aOperation, const PublicNotice& acNotice, uint64_t aToken) noexcept
+{
+    if (!m_transport.IsOnline() || (aOperation != RequestNoticeBoard::Operation::Hello && !m_serverSession)) return false;
+    RequestNoticeBoard request;
+    request.Action = aOperation; request.ServerSession = m_serverSession; request.Notice = acNotice; request.Token = aToken;
+    return m_transport.Send(request);
+}
+bool NoticeBoardService::Map(const NoticeBridge::Event& acEvent, PublicNotice& aNotice) const noexcept
+{
+    aNotice.Id = acEvent.Id;
+    return KnownQuest(acEvent.Quest)
+        && m_world.GetModSystem().GetServerModId(acEvent.Quest,aNotice.Quest)
+        && m_world.GetModSystem().GetServerModId(acEvent.Board,aNotice.Board);
+}
+void NoticeBoardService::Handle(const NoticeBridge::Event& acEvent) noexcept
+{
+    using O = NoticeBridge::Operation;
+    if (acEvent.Action == O::Open || acEvent.Action == O::Close)
+    {
+        PublicNotice notice;
+        if (acEvent.Action == O::Open) m_openBoards[acEvent.Quest] = Clock::now();
+        else m_openBoards.erase(acEvent.Quest);
+        if (m_world.GetModSystem().GetServerModId(acEvent.Quest,notice.Board))
+        {
+            Send(acEvent.Action == O::Open ? RequestNoticeBoard::Operation::Open : RequestNoticeBoard::Operation::Close,notice);
+            if (acEvent.Action == O::Open) m_openBoards[acEvent.Quest] = Clock::now()+std::chrono::seconds(2);
+        }
+        return;
+    }
+    PublicNotice notice;
+    if (!Map(acEvent,notice)) return;
+    const Key key{acEvent.Quest,acEvent.Board};
+    const auto now = Clock::now();
+    if (acEvent.Action == O::Offer)
+    {
+        if (!NoticeBridge::Call(O::Authority,acEvent.Board)) return;
+        const int32_t status = NoticeBridge::Call(O::State,acEvent.Quest,acEvent.Board);
+        if (status != -1 && status != 3 && status != 5) return;
+        const auto retry = m_offerRetry.find(key);
+        if (retry != m_offerRetry.end() && now < retry->second) return;
+        if (Send(RequestNoticeBoard::Operation::Offer,notice))
+            m_offerRetry[key] = now+std::chrono::seconds(status == 3 ? 30 : 3);
+        return;
+    }
+    if (acEvent.Action == O::Begin || acEvent.Action == O::Commit || acEvent.Action == O::Release)
+    {
+        const auto operation = acEvent.Action == O::Begin ? RequestNoticeBoard::Operation::Reserve
+            : acEvent.Action == O::Commit ? RequestNoticeBoard::Operation::Commit : RequestNoticeBoard::Operation::Release;
+        if (Send(operation,notice,acEvent.Token)) m_claimRetry[key] = now+std::chrono::seconds(1);
+    }
+}
+void NoticeBoardService::OnUpdate(const UpdateEvent&) noexcept
+{
+    if (!m_enabled || !m_transport.IsOnline()) return;
+    const auto now = Clock::now();
+    if (!m_serverSession)
+    {
+        if (now >= m_nextHello) { Send(RequestNoticeBoard::Operation::Hello); m_nextHello = now+std::chrono::seconds(2); }
+        return;
+    }
+    for (const auto& event : NoticeBridge::Drain()) Handle(event);
+    for (auto& [board,next] : m_openBoards)
+    {
+        if (NoticeBridge::Call(NoticeBridge::Operation::BoardReady,board) || now < next) continue;
+        PublicNotice notice;
+        if (m_world.GetModSystem().GetServerModId(board,notice.Board)) Send(RequestNoticeBoard::Operation::Open,notice);
+        next = now+std::chrono::seconds(2);
+    }
+    for (const auto& event : NoticeBridge::Pending())
+    {
+        const Key key{event.Quest,event.Board};
+        const auto retry = m_claimRetry.find(key);
+        if (retry == m_claimRetry.end() || now >= retry->second) Handle(event);
+    }
+    if (now >= m_nextTasks) { RefreshPersonalTasks(); m_nextTasks = now+std::chrono::seconds(1); }
+}
+void NoticeBoardService::OnNotice(const NotifyNoticeBoard& acMessage) noexcept
+{
+    if (!m_enabled) return;
+    using N = NotifyNoticeBoard::Operation;
+    using O = NoticeBridge::Operation;
+    if (acMessage.Action == N::Ready)
+    {
+        if (!acMessage.ServerSession) return;
+        if (m_previousSession && m_previousSession != acMessage.ServerSession) NoticeBridge::NewEpoch();
+        m_previousSession = m_serverSession = acMessage.ServerSession;
+        NoticeBridge::Ready(true);
+        spdlog::info("STR notice session ready");
+        return;
+    }
+    if (!m_serverSession || acMessage.ServerSession != m_serverSession) return;
+    const uint32_t boardId = m_world.GetModSystem().GetGameId(acMessage.Notice.Board);
+    if (!boardId) { spdlog::warn("STR notice cannot map board {:X}",acMessage.Notice.Board.LogFormat()); return; }
+    if (acMessage.Action == N::BoardControl)
+    { NoticeBridge::Authority(boardId,acMessage.Authority); return; }
+    if (acMessage.Action == N::SnapshotBegin)
+    {
+        m_badSnapshots.erase(boardId);
+        NoticeBridge::Snapshot(boardId); NoticeBridge::Authority(boardId,acMessage.Authority);
+        return;
+    }
+    if (acMessage.Action == N::SnapshotEnd)
+    {
+        NoticeBridge::BoardReady(boardId,!m_badSnapshots.contains(boardId));
+        return;
+    }
+    const uint32_t questId = m_world.GetModSystem().GetGameId(acMessage.Notice.Quest);
+    if (!questId || !KnownQuest(questId))
+    {
+        m_badSnapshots.insert(boardId);
+        spdlog::warn("STR notice cannot map template {:X}",acMessage.Notice.Quest.LogFormat());
+        return;
+    }
+    int32_t status = -1;
+    switch (acMessage.Action)
+    {
+    case N::Available: status = 0; break;
+    case N::Reserved: status = 1; break;
+    case N::Granted: status = 2; break;
+    case N::Claimed: status = 3; break;
+    case N::Committed: status = 4; break;
+    case N::Removed: case N::Denied: status = 5; break;
+    default: return;
+    }
+    if (!acMessage.Notice.Id) return; // capacity/offer rejection has no claim receipt
+    if (status == 2)
+    {
+        bool waiting = false;
+        for (const auto& pending : NoticeBridge::Pending())
+            if (pending.Quest == questId && pending.Board == boardId && pending.Id == acMessage.Notice.Id
+                && (pending.Token == 0 || pending.Token == acMessage.Token)) { waiting = true; break; }
+        if (!waiting)
+        {
+            // A slip may be dropped before its reservation reply arrives.
+            // Release that orphan grant instead of giving it to another slip.
+            Send(RequestNoticeBoard::Operation::Release,acMessage.Notice,acMessage.Token);
+            status = 1;
+        }
+    }
+    NoticeBridge::Apply(questId,boardId,acMessage.Notice.Id,status,acMessage.Token);
+    if (status == 5)
+    {
+        // A denial need not carry the winner's row; request authoritative state.
+        const auto open = m_openBoards.find(boardId);
+        if (open != m_openBoards.end())
+        { NoticeBridge::BoardReady(boardId,false); open->second = Clock::now(); }
+    }
+}
