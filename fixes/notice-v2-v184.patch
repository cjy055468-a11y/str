+DroppedItemService::DroppedItemService(World& aWorld, entt::dispatcher& aDispatcher, TransportService& aTransport) noexcept
+    : m_world(aWorld)
+    , m_transport(aTransport)
+{
+    if (BCryptGenRandom(nullptr, reinterpret_cast<PUCHAR>(&m_clientSession), sizeof(m_clientSession), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0 || !m_clientSession)
+        spdlog::error("STR drop sync: could not create a private reconnect identity");
+    m_connectedConnection = aDispatcher.sink<ConnectedEvent>().connect<&DroppedItemService::OnConnected>(this);
+    m_disconnectedConnection = aDispatcher.sink<DisconnectedEvent>().connect<&DroppedItemService::OnDisconnected>(this);
+    m_updateConnection = aDispatcher.sink<UpdateEvent>().connect<&DroppedItemService::OnUpdate>(this);
+    m_notifyConnection = aDispatcher.sink<NotifyDroppedItem>().connect<&DroppedItemService::OnNotify>(this);
+}
