@@ -0,0 +1,221 @@
+#include <Services/NoticeBoardService.h>
+#include <Events/PlayerLeaveEvent.h>
+#include <Events/UpdateEvent.h>
+#include <Game/Player.h>
+#include <World.h>
+#include <chrono>
+
+uint64_t NoticeBoardService::Now() noexcept
+{
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+NoticeBoardService::NoticeBoardService(World& aWorld, entt::dispatcher& aDispatcher) noexcept
+    : m_world(aWorld)
+    , m_serverSession(static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count()) | 1ULL)
+{
+    m_requestConnection = aDispatcher.sink<PacketEvent<RequestNoticeBoard>>().connect<&NoticeBoardService::OnRequest>(this);
+    m_leaveConnection = aDispatcher.sink<PlayerLeaveEvent>().connect<&NoticeBoardService::OnLeave>(this);
+    m_updateConnection = aDispatcher.sink<UpdateEvent>().connect<&NoticeBoardService::OnUpdate>(this);
+}
+
+uint64_t NoticeBoardService::EnsureSession(Player* apPlayer) noexcept
+{
+    if (!apPlayer) return 0;
+    const auto found = m_sessions.find(apPlayer);
+    if (found != m_sessions.end()) return found->second;
+    const uint64_t session = ++m_nextSession;
+    m_sessions.emplace(apPlayer, session);
+    m_players.emplace(session, apPlayer);
+    return session;
+}
+
+void NoticeBoardService::SendState(Player* apPlayer, uint64_t aSession, const NoticeLedger::Record& acRow) const noexcept
+{
+    if (!apPlayer) return;
+    NotifyNoticeBoard reply;
+    reply.ServerSession = m_serverSession;
+    reply.Notice = acRow.Notice;
+    reply.Authority = m_ledger.GetAuthority(acRow.Notice.Board) == aSession;
+    const bool mine = acRow.Holder == aSession;
+    switch (acRow.Status)
+    {
+    case NoticeLedger::State::Available:
+        reply.Action = NotifyNoticeBoard::Operation::Available;
+        break;
+    case NoticeLedger::State::Reserved:
+        reply.Action = mine ? NotifyNoticeBoard::Operation::Granted : NotifyNoticeBoard::Operation::Reserved;
+        if (mine) reply.Token = acRow.Token;
+        break;
+    case NoticeLedger::State::Claimed:
+        reply.Action = mine ? NotifyNoticeBoard::Operation::Committed : NotifyNoticeBoard::Operation::Claimed;
+        if (mine) reply.Token = acRow.Token;
+        break;
+    }
+    apPlayer->Send(reply);
+}
+
+void NoticeBoardService::BroadcastState(const NoticeLedger::Record& acRow) const noexcept
+{
+    for (const auto& [session, pPlayer] : m_players) SendState(pPlayer, session, acRow);
+}
+
+void NoticeBoardService::SendDenied(Player* apPlayer, const PublicNotice& acNotice, uint64_t aToken) const noexcept
+{
+    if (!apPlayer) return;
+    NotifyNoticeBoard reply;
+    reply.Action = NotifyNoticeBoard::Operation::Denied;
+    reply.ServerSession = m_serverSession;
+    reply.Notice = acNotice;
+    reply.Token = aToken;
+    apPlayer->Send(reply);
+}
+
+void NoticeBoardService::SendSnapshot(Player* apPlayer, uint64_t aSession, const GameId& acBoard) const noexcept
+{
+    if (!apPlayer) return;
+    NotifyNoticeBoard boundary;
+    boundary.ServerSession = m_serverSession;
+    boundary.Notice.Board = acBoard;
+    boundary.Authority = m_ledger.GetAuthority(acBoard) == aSession;
+    boundary.Action = NotifyNoticeBoard::Operation::SnapshotBegin;
+    apPlayer->Send(boundary);
+    const auto rows = m_ledger.Snapshot(acBoard);
+    for (const auto& row : rows) SendState(apPlayer, aSession, row);
+    boundary.Action = NotifyNoticeBoard::Operation::SnapshotEnd;
+    apPlayer->Send(boundary);
+    spdlog::info("STR notice snapshot: board {:X}, rows {}, player {}", acBoard.LogFormat(), rows.size(), apPlayer->GetId());
+}
+
+void NoticeBoardService::SelectAuthority(const GameId& acBoard) noexcept
+{
+    const auto found = m_visitors.find(acBoard.LogFormat());
+    uint64_t authority = m_ledger.GetAuthority(acBoard);
+    if (found == m_visitors.end() || found->second.Sessions.empty()) authority = 0;
+    else if (!found->second.Sessions.contains(authority)) authority = *found->second.Sessions.begin();
+    m_ledger.SetAuthority(acBoard, authority);
+    for (const auto& [session, pPlayer] : m_players)
+    {
+        NotifyNoticeBoard reply;
+        reply.Action = NotifyNoticeBoard::Operation::BoardControl;
+        reply.ServerSession = m_serverSession;
+        reply.Notice.Board = acBoard;
+        reply.Authority = session == authority;
+        pPlayer->Send(reply);
+    }
+    if (found != m_visitors.end() && found->second.Sessions.empty()) m_visitors.erase(found);
+}
+
+void NoticeBoardService::ExpireReservations(uint64_t aNow) noexcept
+{
+    for (const auto& change : m_ledger.Expire(aNow))
+    {
+        BroadcastState(change.After);
+        const auto holder = m_players.find(change.Before.Holder);
+        if (holder != m_players.end()) SendDenied(holder->second, change.Before.Notice, change.Before.Token);
+        spdlog::info("STR notice reservation expired: board {:X}, notice {}", change.Before.Notice.Board.LogFormat(), change.Before.Notice.Id);
+    }
+}
+
+void NoticeBoardService::OnUpdate(const UpdateEvent&) noexcept
+{
+    const uint64_t now = Now();
+    if (now < m_nextExpiryCheck) return;
+    m_nextExpiryCheck = now + 250;
+    ExpireReservations(now);
+}
+
+void NoticeBoardService::OnLeave(const PlayerLeaveEvent& acEvent) noexcept
+{
+    const auto found = m_sessions.find(acEvent.pPlayer);
+    if (found == m_sessions.end()) return;
+    const uint64_t session = found->second;
+    m_sessions.erase(found);
+    m_players.erase(session);
+    for (const auto& change : m_ledger.Disconnect(session)) BroadcastState(change.After);
+    std::vector<GameId> changedBoards;
+    for (auto& [id, visitors] : m_visitors)
+        if (visitors.Sessions.erase(session)) changedBoards.push_back(visitors.Board);
+    for (const auto& board : changedBoards) SelectAuthority(board);
+}
+
+void NoticeBoardService::OnRequest(const PacketEvent<RequestNoticeBoard>& acEvent) noexcept
+{
+    const auto& request = acEvent.Packet;
+    Player* pPlayer = acEvent.pPlayer;
+    if (!pPlayer || request.Action > RequestNoticeBoard::Operation::Release) return;
+    if (request.Action == RequestNoticeBoard::Operation::Hello)
+    {
+        EnsureSession(pPlayer);
+        NotifyNoticeBoard reply;
+        reply.Action = NotifyNoticeBoard::Operation::Ready;
+        reply.ServerSession = m_serverSession;
+        pPlayer->Send(reply);
+        return;
+    }
+    const auto found = m_sessions.find(pPlayer);
+    if (found == m_sessions.end() || request.ServerSession != m_serverSession) return;
+    const uint64_t session = found->second;
+    const uint64_t now = Now();
+    ExpireReservations(now);
+    const auto& notice = request.Notice;
+    const auto action = request.Action;
+    if (action == RequestNoticeBoard::Operation::Open || action == RequestNoticeBoard::Operation::Close)
+    {
+        if (!notice.Board) return;
+        if (action == RequestNoticeBoard::Operation::Open)
+        {
+            auto& visitors = m_visitors[notice.Board.LogFormat()];
+            visitors.Board = notice.Board;
+            visitors.Sessions.insert(session);
+        }
+        else
+        {
+            const auto visitors = m_visitors.find(notice.Board.LogFormat());
+            if (visitors != m_visitors.end()) visitors->second.Sessions.erase(session);
+        }
+        SelectAuthority(notice.Board);
+        if (action == RequestNoticeBoard::Operation::Open) SendSnapshot(pPlayer, session, notice.Board);
+        return;
+    }
+    if (!notice.HasForms()) return;
+    if (action == RequestNoticeBoard::Operation::Offer)
+    {
+        if (notice.Id || request.Token) return;
+        const auto row = m_ledger.Offer(session, notice, now);
+        if (row) BroadcastState(*row);
+        else SendDenied(pPlayer, notice, 0);
+        return;
+    }
+    if (!notice.Id) return;
+    if (action == RequestNoticeBoard::Operation::Reserve)
+    {
+        const auto result = m_ledger.Reserve(session, notice, request.Token, now);
+        if (result.Result == NoticeLedger::Outcome::Granted && result.Current)
+        {
+            if (result.Changed) BroadcastState(*result.Current);
+            else SendState(pPlayer, session, *result.Current);
+        }
+        else SendDenied(pPlayer, notice, request.Token);
+        return;
+    }
+    if (action == RequestNoticeBoard::Operation::Commit)
+    {
+        const auto result = m_ledger.Commit(session, notice, request.Token, now);
+        if (result.Result == NoticeLedger::Outcome::Committed && result.Current)
+        {
+            if (result.Changed) BroadcastState(*result.Current);
+            else SendState(pPlayer, session, *result.Current);
+            spdlog::info("STR notice committed: board {:X}, notice {}, player {}, first {}", notice.Board.LogFormat(), notice.Id, pPlayer->GetId(), result.Changed);
+        }
+        else SendDenied(pPlayer, notice, request.Token);
+        return;
+    }
+    if (action == RequestNoticeBoard::Operation::Release)
+    {
+        const auto row = m_ledger.Release(session, notice, request.Token);
+        if (row) BroadcastState(*row);
+        else SendDenied(pPlayer, notice, request.Token);
+    }
+}
