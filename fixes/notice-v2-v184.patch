+void PublicNotice::Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept
+{
+    Id = TiltedPhoques::Serialization::ReadVarInt(aReader);
+    Board.Deserialize(aReader);
+    Quest.Deserialize(aReader);
+}
diff --git a/Code/encoding/Structs/PublicNotice.h b/Code/encoding/Structs/PublicNotice.h
new file mode 100644
index 0000000..7a3c7e3
--- /dev/null
+++ b/Code/encoding/Structs/PublicNotice.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <Structs/GameId.h>
+
+// A public board row identifies a local task template, never a task instance.
+struct PublicNotice
+{
+    uint64_t Id{};
+    GameId Board{0, 0};
+    GameId Quest{0, 0};
+
+    bool HasForms() const noexcept { return Board && Quest; }
+    bool operator==(const PublicNotice& acOther) const noexcept
+    {
+        return Id == acOther.Id && Board == acOther.Board && Quest == acOther.Quest;
+    }
+    void Serialize(TiltedPhoques::Buffer::Writer& aWriter) const noexcept;
+    void Deserialize(TiltedPhoques::Buffer::Reader& aReader) noexcept;
+};
diff --git a/Code/server/Game/Inventory/DroppedItemLedger.h b/Code/server/Game/Inventory/DroppedItemLedger.h
new file mode 100644
index 0000000..f330b3d
--- /dev/null
+++ b/Code/server/Game/Inventory/DroppedItemLedger.h
@@ -0,0 +1,136 @@
+#pragma once
+
+#include <Structs/DroppedItemData.h>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <vector>
+#include <limits>
+#include <cmath>
+
+// Independent of actor lifetime: tombstones must survive cell unloads and player
+// disconnects. The lock makes first-winner selection indivisible even if packet
+// dispatch is moved to multiple threads later.
+class DroppedItemLedger
+{
+public:
+    struct Record
+    {
+        DroppedItemData Data{};
+        uint64_t Creator{};
+        uint64_t Nonce{};
+        uint64_t Winner{};
+        uint32_t CreditedActor{};
+        uint32_t WinnerActor{};
+        bool PlayerWinner{true};
+        bool Acknowledged{};
+        bool Active{true};
+        bool Networked{true};
+    };
+    enum class ClaimResult { Granted, AlreadyGranted, Lost, Unknown };
+
+    std::optional<Record> UpdatePlacement(uint64_t aId, uint64_t aCreator, const DroppedItemData& acPose)
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (!aCreator || it == m_records.end() || it->second.Creator != aCreator || !it->second.Active || !it->second.Networked
+            || !acPose.Cell || !std::isfinite(acPose.Position.x) || !std::isfinite(acPose.Position.y) || !std::isfinite(acPose.Position.z)
+            || !std::isfinite(acPose.Rotation.x) || !std::isfinite(acPose.Rotation.y) || !std::isfinite(acPose.Rotation.z))
+            return std::nullopt;
+        auto& data = it->second.Data;
+        data.Cell = acPose.Cell;
+        data.WorldSpace = acPose.WorldSpace;
+        data.Position = acPose.Position;
+        data.Rotation = acPose.Rotation;
+        data.PlacementReady = true;
+        return it->second;
+    }
+
+    std::optional<Record> FindCreated(uint64_t aClient, uint64_t aNonce) const
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_origins.find({aClient, aNonce});
+        if (it == m_origins.end())
+            return std::nullopt;
+        return m_records.find(it->second)->second;
+    }
+
+    std::optional<Record> Create(uint64_t aClient, uint64_t aNonce, DroppedItemData aData, bool aNetworked = true)
+    {
+        std::lock_guard lock(m_lock);
+        if (!aClient || !aNonce || !aData.Item.BaseId || aData.Item.Count <= 0)
+            return std::nullopt;
+        if (const auto it = m_origins.find({aClient, aNonce}); it != m_origins.end())
+            return m_records.find(it->second)->second;
+        if (m_nextId == std::numeric_limits<uint64_t>::max())
+            return std::nullopt;
+        aData.Id = m_nextId++;
+        Record record;
+        record.Data = std::move(aData);
+        record.Creator = aClient;
+        record.Nonce = aNonce;
+        record.Networked = aNetworked;
+        record.Active = aNetworked;
+        m_origins.emplace(std::make_pair(aClient, aNonce), record.Data.Id);
+        m_records.emplace(record.Data.Id, record);
+        return record;
+    }
+
+    ClaimResult Claim(uint64_t aId, uint64_t aClient, uint32_t aActor, bool aPlayer = true)
+    {
+        std::lock_guard lock(m_lock);
+        if (!aClient || !aActor)
+            return ClaimResult::Lost;
+        const auto it = m_records.find(aId);
+        if (it == m_records.end())
+            return ClaimResult::Unknown;
+        auto& record = it->second;
+        if (!record.Active)
+            return record.Winner == aClient && record.WinnerActor == aActor ? ClaimResult::AlreadyGranted : ClaimResult::Lost;
+        record.Active = false;
+        record.Winner = aClient;
+        record.CreditedActor = aActor;
+        record.WinnerActor = aActor;
+        record.PlayerWinner = aPlayer;
+        record.Acknowledged = !aPlayer;
+        return ClaimResult::Granted;
+    }
+
+    // Freshly applied recovered grants need one server inventory correction if
+    // reconnecting created a different player actor. Duplicate ACKs cannot add.
+    bool Acknowledge(uint64_t aId, uint64_t aClient, uint32_t aActor, bool aAppliedFresh)
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        if (it == m_records.end() || it->second.Active || !it->second.PlayerWinner || it->second.Winner != aClient || !aActor)
+            return false;
+        auto& record = it->second;
+        const bool credit = record.CreditedActor != aActor && aAppliedFresh;
+        record.CreditedActor = aActor;
+        record.Acknowledged = true;
+        return credit;
+    }
+
+    std::optional<Record> Get(uint64_t aId) const
+    {
+        std::lock_guard lock(m_lock);
+        const auto it = m_records.find(aId);
+        return it == m_records.end() ? std::nullopt : std::optional<Record>(it->second);
+    }
+
+    std::vector<Record> Snapshot(uint64_t aClient) const
+    {
+        std::lock_guard lock(m_lock);
+        std::vector<Record> records;
+        for (const auto& [id, record] : m_records)
+            if (record.Networked && (record.Active || (record.PlayerWinner && record.Winner == aClient && !record.Acknowledged)))
+                records.push_back(record);
+        return records;
+    }
+
+private:
+    mutable std::mutex m_lock;
+    uint64_t m_nextId{1};
+    std::map<uint64_t, Record> m_records;
+    std::map<std::pair<uint64_t, uint64_t>, uint64_t> m_origins;
+};
diff --git a/Code/server/Game/Inventory/NoticeLedger.h b/Code/server/Game/Inventory/NoticeLedger.h
new file mode 100644
index 0000000..f9a26df
--- /dev/null
+++ b/Code/server/Game/Inventory/NoticeLedger.h
@@ -0,0 +1,208 @@
+#pragma once
+#include <Structs/PublicNotice.h>
+#include <limits>
+#include <cstddef>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+// Engine-independent reservation ledger. Only Commit permanently consumes a
+// row. Explicit monotonic time makes all lease boundaries deterministic.
+class NoticeLedger
+{
+public:
+    static constexpr uint64_t cLeaseMilliseconds = 15000;
+    static constexpr size_t cBoardCapacity = 6;
+    static constexpr uint64_t cRecycleMilliseconds = 300000;
+    enum class State : uint8_t { Available, Reserved, Claimed };
+    enum class Outcome : uint8_t { Granted, Committed, Denied };
+    struct Record
+    {
+        PublicNotice Notice;
+        State Status{State::Available};
+        uint64_t Holder{};
+        uint64_t Token{};
+        uint64_t LeaseUntil{};
+        uint64_t ClaimedAt{};
+    };
+    struct Transition
+    {
+        Outcome Result{Outcome::Denied};
+        std::optional<Record> Current;
+        bool Changed{};
+    };
+    struct Change
+    {
+        Record Before;
+        Record After;
+    };
+
+    uint64_t GetAuthority(const GameId& acBoard) const noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        const auto found = m_authorities.find(acBoard.LogFormat());
+        return found == m_authorities.end() ? 0 : found->second;
+    }
+    void SetAuthority(const GameId& acBoard, uint64_t aSession) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        if (!acBoard) return;
+        if (aSession) m_authorities[acBoard.LogFormat()] = aSession;
+        else m_authorities.erase(acBoard.LogFormat());
+    }
+    std::optional<Record> Offer(uint64_t aSession, const PublicNotice& acNotice, uint64_t aNow) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        const auto authority = m_authorities.find(acNotice.Board.LogFormat());
+        if (!aSession || !acNotice.HasForms() || authority == m_authorities.end() || authority->second != aSession)
+            return std::nullopt;
+        const auto slot = m_slots.find(Key(acNotice.Board, acNotice.Quest));
+        if (slot != m_slots.end())
+        {
+            const auto current = m_rows.find(slot->second);
+            if (current == m_rows.end()) return std::nullopt;
+            const auto& row = current->second;
+            if (row.Status != State::Claimed || aNow < row.ClaimedAt
+                || aNow - row.ClaimedAt < cRecycleMilliseconds)
+                return row;
+        }
+        size_t active{};
+        for (const auto& [id, row] : m_rows)
+            if (row.Notice.Board == acNotice.Board && row.Status != State::Claimed) ++active;
+        if (active >= cBoardCapacity) return std::nullopt;
+        Record row;
+        row.Notice = acNotice;
+        row.Notice.Id = Next(m_nextNotice);
+        m_rows.emplace(row.Notice.Id, row);
+        m_slots[Key(row.Notice.Board, row.Notice.Quest)] = row.Notice.Id;
+        return row;
+    }
+    Transition Reserve(uint64_t aSession, const PublicNotice& acNotice, uint64_t aToken, uint64_t aNow) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        Record* pRow = Find(acNotice);
+        if (!aSession || !pRow) return {};
+        const bool expired = ExpireOne(*pRow, aNow);
+        if (pRow->Status == State::Available)
+        {
+            // A nonzero token belongs to an older lease and must never acquire
+            // a replacement lease after it expired.
+            if (aToken) return {Outcome::Denied, *pRow, expired};
+            pRow->Status = State::Reserved;
+            pRow->Holder = aSession;
+            pRow->Token = Next(m_nextToken);
+            pRow->LeaseUntil = Deadline(aNow);
+            return {Outcome::Granted, *pRow, true};
+        }
+        if (pRow->Status == State::Reserved && pRow->Holder == aSession && (!aToken || aToken == pRow->Token))
+        {
+            pRow->LeaseUntil = Deadline(aNow);
+            return {Outcome::Granted, *pRow, false};
+        }
+        return {Outcome::Denied, *pRow, expired};
+    }
+    Transition Commit(uint64_t aSession, const PublicNotice& acNotice, uint64_t aToken, uint64_t aNow) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        Record* pRow = Find(acNotice);
+        if (!aSession || !pRow || !aToken) return {};
+        const bool expired = ExpireOne(*pRow, aNow);
+        if (pRow->Token != aToken) return {Outcome::Denied, *pRow, expired};
+        if (pRow->Status == State::Claimed)
+        {
+            // The receipt is proof of the earlier commit. A new connection can
+            // recover an acknowledgement without executing another claim.
+            pRow->Holder = aSession;
+            return {Outcome::Committed, *pRow, false};
+        }
+        if (pRow->Status != State::Reserved || pRow->Holder != aSession)
+            return {Outcome::Denied, *pRow, expired};
+        pRow->Status = State::Claimed;
+        pRow->LeaseUntil = 0;
+        pRow->ClaimedAt = aNow;
+        return {Outcome::Committed, *pRow, true};
+    }
+    std::optional<Record> Release(uint64_t aSession, const PublicNotice& acNotice, uint64_t aToken) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        Record* pRow = Find(acNotice);
+        if (!aSession || !pRow) return std::nullopt;
+        if (pRow->Status == State::Available) return *pRow;
+        if (pRow->Status != State::Reserved || pRow->Holder != aSession || !aToken || pRow->Token != aToken)
+            return std::nullopt;
+        MakeAvailable(*pRow);
+        return *pRow;
+    }
+    std::vector<Change> Expire(uint64_t aNow) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        std::vector<Change> changes;
+        for (auto& [id, row] : m_rows)
+        {
+            const Record before = row;
+            if (ExpireOne(row, aNow)) changes.push_back({before, row});
+        }
+        return changes;
+    }
+    std::vector<Change> Disconnect(uint64_t aSession) noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        std::vector<Change> changes;
+        for (auto& [id, row] : m_rows)
+        {
+            if (row.Status != State::Reserved || row.Holder != aSession) continue;
+            const Record before = row;
+            MakeAvailable(row);
+            changes.push_back({before, row});
+        }
+        return changes;
+    }
+    std::optional<Record> Get(const PublicNotice& acNotice) const noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        const auto found = m_rows.find(acNotice.Id);
+        if (found == m_rows.end() || !SameForms(found->second.Notice, acNotice)) return std::nullopt;
+        return found->second;
+    }
+    std::vector<Record> Snapshot(const GameId& acBoard) const noexcept
+    {
+        std::lock_guard lock(m_mutex);
+        std::vector<Record> result;
+        for (const auto& [slot, id] : m_slots)
+        {
+            if (slot.first != acBoard.LogFormat()) continue;
+            const auto row = m_rows.find(id);
+            if (row != m_rows.end()) result.push_back(row->second);
+        }
+        return result;
+    }
+private:
+    using Slot = std::pair<uint64_t, uint64_t>;
+    static Slot Key(const GameId& acBoard, const GameId& acQuest) noexcept { return {acBoard.LogFormat(), acQuest.LogFormat()}; }
+    static bool SameForms(const PublicNotice& acA, const PublicNotice& acB) noexcept { return acA.Board == acB.Board && acA.Quest == acB.Quest; }
+    static uint64_t Next(uint64_t& aCounter) noexcept { if (++aCounter == 0) ++aCounter; return aCounter; }
+    static uint64_t Deadline(uint64_t aNow) noexcept
+    {
+        return aNow > std::numeric_limits<uint64_t>::max() - cLeaseMilliseconds
+            ? std::numeric_limits<uint64_t>::max() : aNow + cLeaseMilliseconds;
+    }
+    static void MakeAvailable(Record& aRow) noexcept { aRow.Status = State::Available; aRow.Holder = 0; aRow.Token = 0; aRow.LeaseUntil = 0; }
+    static bool ExpireOne(Record& aRow, uint64_t aNow) noexcept
+    {
+        if (aRow.Status != State::Reserved || aNow < aRow.LeaseUntil) return false;
+        MakeAvailable(aRow);
+        return true;
+    }
+    Record* Find(const PublicNotice& acNotice) noexcept
+    {
+        const auto found = m_rows.find(acNotice.Id);
+        return found != m_rows.end() && SameForms(found->second.Notice, acNotice) ? &found->second : nullptr;
+    }
+    mutable std::mutex m_mutex;
+    uint64_t m_nextNotice{};
+    uint64_t m_nextToken{};
+    std::map<uint64_t, uint64_t> m_authorities;
+    std::map<uint64_t, Record> m_rows;
+    std::map<Slot, uint64_t> m_slots;
+};
