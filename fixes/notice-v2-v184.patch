@@ -0,0 +1,49 @@
+#pragma once
+
+#include <Messages/CharacterSpawnRequest.h>
+#include <Messages/NotifyDeathStateChange.h>
+#include <Messages/NotifyInventoryChanges.h>
+#include <Messages/NotifyOwnershipTransfer.h>
+#include <Messages/NotifyEquipmentChanges.h>
+#include <Structs/OwnedInventory.h>
+
+inline bool ApplyPendingEquipment(CharacterSpawnRequest& aSpawn, const NotifyEquipmentChanges& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch)
+        return false;
+    // A late equip must not put looted equipment back on a corpse.
+    if (!aSpawn.IsDead)
+        ApplyOwnedEquipmentSnapshot(aSpawn.InventoryContent, acUpdate.CurrentInventory);
+    return true;
+}
+
+inline bool ApplyPendingOwnership(CharacterSpawnRequest& aSpawn, const NotifyOwnershipTransfer& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || acUpdate.OwnershipEpoch <= aSpawn.OwnershipEpoch)
+        return false;
+    aSpawn.OwnershipEpoch = acUpdate.OwnershipEpoch;
+    aSpawn.InitialActorValues = acUpdate.CurrentActorData.InitialActorValues;
+    aSpawn.InventoryContent = acUpdate.CurrentActorData.InitialInventory;
+    aSpawn.IsDead = acUpdate.CurrentActorData.IsDead;
+    aSpawn.IsWeaponDrawn = acUpdate.CurrentActorData.IsWeaponDrawn;
+    aSpawn.LeveledNpcPickId = acUpdate.LeveledNpcPickId;
+    return true;
+}
+
+// Reliable updates can arrive after the spawn snapshot, before its 3D exists.
+// Update that snapshot so materialization cannot restore an older corpse state.
+inline bool ApplyPendingDeath(CharacterSpawnRequest& aSpawn, const NotifyDeathStateChange& acUpdate) noexcept
+{
+    if (!acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.Id || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch || aSpawn.IsPlayer)
+        return false;
+    aSpawn.IsDead = acUpdate.IsDead;
+    return true;
+}
+
+inline bool ApplyPendingInventory(CharacterSpawnRequest& aSpawn, const NotifyInventoryChanges& acUpdate) noexcept
+{
+    if (acUpdate.Drop || !acUpdate.OwnershipEpoch || aSpawn.ServerId != acUpdate.ServerId || aSpawn.OwnershipEpoch != acUpdate.OwnershipEpoch)
+        return false;
+    aSpawn.InventoryContent.AddOrRemoveEntry(acUpdate.Item);
+    return true;
+}
