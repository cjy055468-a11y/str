diff --git a/Code/tests/scene_sync_inbox.cpp b/Code/tests/scene_sync_inbox.cpp
new file mode 100644
index 00000000..25fe8f5f
--- /dev/null
+++ b/Code/tests/scene_sync_inbox.cpp
@@ -0,0 +1,201 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <TiltedCore/ViewBuffer.hpp>
+#include <TiltedCore/Serialization.hpp>
+#include <TiltedCore/ScratchAllocator.hpp>
+#include <glm/glm.hpp>
+#include <catch2/catch.hpp>
+#include <Messages/ServerMessageFactory.h>
+#include <StringCache.h>
+#include "../client/Services/SceneSyncInbox.h"
+
+namespace
+{
+void QueueByte(SceneSyncInbox& aInbox, uint8_t aValue, ServerOpcode aOpcode, double aTime = 100.0)
+{
+    REQUIRE(aInbox.Push(&aValue, 1, aTime, aOpcode));
+}
+
+void QueueEncoded(SceneSyncInbox& aInbox, const ServerMessage& acMessage, double aTime)
+{
+    TiltedPhoques::Buffer buffer(16384);
+    TiltedPhoques::Buffer::Writer writer(&buffer);
+    acMessage.Serialize(writer);
+    REQUIRE(aInbox.Push(buffer.GetWriteData(), writer.Size(), aTime, acMessage.GetOpcode()));
+}
+}
+
+TEST_CASE("Scene dispatch owns payloads beyond temporary packet and allocator lifetimes", "[scene.inbox]")
+{
+    TiltedPhoques::ScratchAllocator scratch(1 << 16);
+    TiltedPhoques::UniquePtr<SceneSyncInbox> inbox;
+    {
+        TiltedPhoques::ScopedAllocator scope(scratch);
+        // The inbox and payload explicitly choose persistent storage even if
+        // the caller happens to have selected a short-lived scratch allocator.
+        inbox = TiltedPhoques::MakeUnique<SceneSyncInbox>();
+        uint8_t bytes[]{10, 20, 30};
+        REQUIRE(inbox->Push(bytes, sizeof(bytes), 123.5, kNotifyChatMessageBroadcast));
+        bytes[0] = 99;
+    }
+    scratch.Reset();
+    TiltedPhoques::Vector<uint8_t> observed;
+    double arrival = 0.0;
+    REQUIRE(inbox->Drain([&](SceneSyncInbox::Packet& aPacket)
+    {
+        observed = aPacket.Bytes;
+        arrival = aPacket.ReceivedAt;
+        return true;
+    }) == 1);
+    REQUIRE(observed == TiltedPhoques::Vector<uint8_t>{10, 20, 30});
+    REQUIRE(arrival == 123.5);
+    REQUIRE(inbox->Bytes() == 0);
+}
+
+TEST_CASE("One scene change per update preserves FIFO for all live state", "[scene.inbox]")
+{
+    SceneSyncInbox inbox;
+    QueueByte(inbox, 1, kStringCacheUpdate);
+    QueueByte(inbox, 2, kAssignCharacterResponse);
+    QueueByte(inbox, 3, kNotifyDeathStateChange);
+    QueueByte(inbox, 4, kCharacterSpawnRequest);
+    QueueByte(inbox, 5, kNotifyEquipmentChanges);
+    QueueByte(inbox, 6, kNotifyOwnershipTransfer);
+    QueueByte(inbox, 7, kServerReferencesMoveRequest);
+    TiltedPhoques::Vector<uint8_t> order;
+    const auto consume = [&](SceneSyncInbox::Packet& aPacket)
+    {
+        order.push_back(aPacket.Bytes.front());
+        return true;
+    };
+    REQUIRE(inbox.Drain(consume) == 3);
+    REQUIRE(order == TiltedPhoques::Vector<uint8_t>{1, 2, 3});
+    REQUIRE(inbox.Drain(consume) == 2);
+    REQUIRE(order == TiltedPhoques::Vector<uint8_t>{1, 2, 3, 4, 5});
+    REQUIRE(inbox.Drain(consume) == 2);
+    REQUIRE(order == TiltedPhoques::Vector<uint8_t>{1, 2, 3, 4, 5, 6, 7});
+    REQUIRE(inbox.Size() == 0);
+}
+
+TEST_CASE("Light message bursts and elapsed frame budgets yield without dropping data", "[scene.inbox]")
+{
+    SceneSyncInbox inbox;
+    for (size_t i = 0; i < SceneSyncInbox::kMessagesPerUpdate + 3; ++i)
+        QueueByte(inbox, 1, kServerReferencesMoveRequest);
+    REQUIRE(inbox.Drain([](auto&) { return true; }) == SceneSyncInbox::kMessagesPerUpdate);
+    REQUIRE(inbox.Size() == 3);
+    REQUIRE(inbox.Drain([](auto&) { return false; }) == 1);
+    REQUIRE(inbox.Size() == 2);
+    REQUIRE(inbox.Drain([](auto&) { return true; }) == 2);
+}
+
+TEST_CASE("Playback horizon stops at the first undispatched arrival", "[scene.inbox]")
+{
+    SceneSyncInbox inbox;
+    QueueByte(inbox, 1, kCharacterSpawnRequest, 100.0);
+    QueueByte(inbox, 2, kCharacterSpawnRequest, 125.0);
+    QueueByte(inbox, 3, kServerReferencesMoveRequest, 130.0);
+    REQUIRE(inbox.GetHandledTime(90.0) == 90.0);
+    REQUIRE(inbox.GetHandledTime(200.0) == 100.0);
+    TiltedPhoques::Vector<double> times;
+    const auto consume = [&](auto& aPacket) { times.push_back(aPacket.ReceivedAt); return true; };
+    REQUIRE(inbox.Drain(consume) == 1);
+    REQUIRE(inbox.GetHandledTime(200.0) == 125.0);
+    REQUIRE(inbox.Drain(consume) == 2);
+    REQUIRE(times == TiltedPhoques::Vector<double>{100.0, 125.0, 130.0});
+    REQUIRE(inbox.GetHandledTime(200.0) == 200.0);
+}
+
+TEST_CASE("Disconnect clears old state and stops a drain before a new session", "[scene.inbox]")
+{
+    SceneSyncInbox inbox;
+    QueueByte(inbox, 1, kNotifyChatMessageBroadcast);
+    QueueByte(inbox, 2, kNotifyDeathStateChange);
+    uint8_t observed = 0;
+    REQUIRE(inbox.Drain([&](auto& aPacket)
+    {
+        inbox.Clear();
+        // The current callback owns its packet, despite clearing the inbox.
+        observed = aPacket.Bytes.front();
+        const uint8_t nextSession = 3;
+        inbox.Push(&nextSession, 1, 300.0, kAuthenticationResponse);
+        return true;
+    }) == 1);
+    REQUIRE(observed == 1);
+    REQUIRE(inbox.Size() == 1);
+    REQUIRE(inbox.Bytes() == 1);
+    REQUIRE(inbox.Drain([&](auto& aPacket) { observed = aPacket.Bytes.front(); return true; }) == 1);
+    REQUIRE(observed == 3);
+}
+
+TEST_CASE("Nested callbacks cannot drain later messages before the current handler returns", "[scene.inbox]")
+{
+    SceneSyncInbox inbox;
+    QueueByte(inbox, 1, kCharacterSpawnRequest);
+    QueueByte(inbox, 2, kCharacterSpawnRequest);
+    size_t nested = 99;
+    REQUIRE(inbox.Drain([&](auto&)
+    {
+        nested = inbox.Drain([](auto&) { return true; });
+        return true;
+    }) == 1);
+    REQUIRE(nested == 0);
+    REQUIRE(inbox.Size() == 1);
+}
+
+TEST_CASE("Inbox limits reject overflow before copying and clearing releases the budget", "[scene.inbox]")
+{
+    SceneSyncInbox inbox;
+    const uint8_t byte = 1;
+    REQUIRE_FALSE(inbox.Push(nullptr, 1, 0, kCharacterSpawnRequest));
+    REQUIRE_FALSE(inbox.Push(&byte, 0, 0, kCharacterSpawnRequest));
+    REQUIRE_FALSE(inbox.Push(&byte, SceneSyncInbox::kMaxBytes + 1, 0, kCharacterSpawnRequest));
+    for (size_t i = 0; i < SceneSyncInbox::kMaxMessages; ++i)
+        REQUIRE(inbox.Push(&byte, 1, 0, kCharacterSpawnRequest));
+    REQUIRE_FALSE(inbox.Push(&byte, 1, 0, kCharacterSpawnRequest));
+    inbox.Clear();
+    REQUIRE(inbox.Size() == 0);
+    REQUIRE(inbox.Bytes() == 0);
+    REQUIRE(inbox.Push(&byte, 1, 0, kCharacterSpawnRequest));
+}
+
+TEST_CASE("Deferred decode applies a preceding string cache update before an animation", "[scene.inbox][encoding]")
+{
+    SceneSyncInbox inbox;
+    auto& cache = StringCache::Get();
+    cache.Clear();
+    const TiltedPhoques::String animation("IdleDrink");
+    const TiltedPhoques::String event("IdleStop");
+    cache.Add(animation);
+    cache.Add(event);
+    StringCacheUpdate update;
+    update.Values = {animation, event};
+    NotifyScriptAnimation script;
+    script.FormID = 123;
+    script.Animation = animation;
+    script.EventName = event;
+    QueueByte(inbox, 1, kCharacterSpawnRequest);
+    QueueByte(inbox, 2, kCharacterSpawnRequest);
+    QueueEncoded(inbox, update, 101.0);
+    QueueEncoded(inbox, script, 102.0);
+    cache.Clear();
+    bool decoded = false;
+    const auto consume = [&](auto& aPacket)
+    {
+        if (aPacket.Opcode == kCharacterSpawnRequest)
+            return true;
+        TiltedPhoques::ViewBuffer buffer(aPacket.Bytes.data(), static_cast<uint32_t>(aPacket.Bytes.size()));
+        TiltedPhoques::Buffer::Reader reader(&buffer);
+        auto message = ServerMessageFactory{}.Extract(reader);
+        if (message->GetOpcode() == kStringCacheUpdate)
+            cache.Deserialize(*static_cast<StringCacheUpdate*>(message.get()));
+        else
+            decoded = *static_cast<NotifyScriptAnimation*>(message.get()) == script;
+        return true;
+    };
+    REQUIRE(inbox.Drain(consume) == 1);
+    REQUIRE(cache.Size() == 0);
+    REQUIRE(inbox.Drain(consume) == 3);
+    REQUIRE(decoded);
+    cache.Clear();
+}
