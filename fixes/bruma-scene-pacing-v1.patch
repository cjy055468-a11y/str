diff --git a/Code/client/Diagnostics/SceneSyncTrace.h b/Code/client/Diagnostics/SceneSyncTrace.h
new file mode 100644
index 00000000..8594858f
--- /dev/null
+++ b/Code/client/Diagnostics/SceneSyncTrace.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <spdlog/spdlog.h>
+
+// Diagnostics only: no game calls, hooks, sleeps, queues or state changes.
+namespace SceneSyncTrace
+{
+inline std::atomic<uint64_t> s_nextSpan{0};
+
+class Scope final
+{
+public:
+    Scope(const char* apName, const uint32_t aServerId = 0, const uint32_t aActorId = 0) noexcept
+        : m_pName(apName)
+        , m_span(s_nextSpan.fetch_add(1, std::memory_order_relaxed) + 1)
+        , m_serverId(aServerId)
+        , m_actorId(aActorId)
+        , m_started(std::chrono::steady_clock::now())
+    {
+        Write("begin");
+    }
+
+    ~Scope() noexcept { Write("end"); }
+
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+    void Mark(const char* apStage) const noexcept { Write(apStage); }
+
+private:
+    void Write(const char* apStage) const noexcept
+    {
+        const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - m_started).count();
+        spdlog::info("[STR scene-diag v1] span={} op={} stage={} server={:X} actor={:X} elapsed_us={}",
+            m_span, m_pName, apStage, m_serverId, m_actorId, elapsed);
+    }
+
+    const char* m_pName;
+    uint64_t m_span;
+    uint32_t m_serverId;
+    uint32_t m_actorId;
+    std::chrono::steady_clock::time_point m_started;
+};
+}
