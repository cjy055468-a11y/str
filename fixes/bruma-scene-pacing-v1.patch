diff --git a/Code/client/Services/SceneSyncInbox.h b/Code/client/Services/SceneSyncInbox.h
new file mode 100644
index 00000000..29908c44
--- /dev/null
+++ b/Code/client/Services/SceneSyncInbox.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include <Opcodes.h>
+#include <TiltedCore/Stl.hpp>
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+// Own wire bytes until dispatch, rather than retaining a network/decompression
+// buffer or decoding a cached string before the preceding cache update ran.
+class SceneSyncInbox final
+{
+    template <class T> static TiltedPhoques::StlAllocator<T> PersistentAllocator() noexcept
+    {
+        TiltedPhoques::StlAllocator<T> allocator;
+        allocator.m_pAllocator = TiltedPhoques::Allocator::GetDefault();
+        return allocator;
+    }
+
+public:
+    struct Packet
+    {
+        TiltedPhoques::Vector<uint8_t> Bytes{PersistentAllocator<uint8_t>()};
+        double ReceivedAt{};
+        ServerOpcode Opcode{};
+    };
+
+    static constexpr size_t kSceneChangesPerUpdate = 1;
+    static constexpr size_t kMessagesPerUpdate = 512;
+    static constexpr size_t kMaxMessages = 8192;
+    static constexpr size_t kMaxBytes = 32 * 1024 * 1024;
+
+    static bool IsSceneChange(ServerOpcode aOpcode) noexcept
+    {
+        return aOpcode == kAssignCharacterResponse || aOpcode == kCharacterSpawnRequest || aOpcode == kNotifyOwnershipTransfer;
+    }
+
+    bool Push(const void* apBytes, size_t aSize, double aReceivedAt, ServerOpcode aOpcode) noexcept
+    {
+        if (!apBytes || !aSize || m_packets.size() >= kMaxMessages || aSize > kMaxBytes - m_bytes)
+            return false;
+
+        Packet packet;
+        const auto* pBytes = static_cast<const uint8_t*>(apBytes);
+        packet.Bytes.assign(pBytes, pBytes + aSize);
+        packet.ReceivedAt = aReceivedAt;
+        packet.Opcode = aOpcode;
+        m_packets.push_back(std::move(packet));
+        m_bytes += aSize;
+        return true;
+    }
+
+    // Every message shares this FIFO. A live state update must never overtake an
+    // initial snapshot. Callbacks return false when their frame budget expires.
+    template <class TCallback> size_t Drain(TCallback&& aCallback) noexcept
+    {
+        if (m_draining)
+            return 0;
+
+        m_draining = true;
+        const uint64_t cGeneration = m_generation;
+        size_t count = 0;
+        size_t sceneChanges = 0;
+        while (!m_packets.empty() && count < kMessagesPerUpdate)
+        {
+            const bool cSceneChange = IsSceneChange(m_packets.front().Opcode);
+            if (cSceneChange && sceneChanges >= kSceneChangesPerUpdate)
+                break;
+
+            // No reference into the queue may survive a callback: disconnects
+            // clear it, and a nested callback can enqueue another message.
+            Packet packet = std::move(m_packets.front());
+            m_packets.pop_front();
+            m_bytes -= packet.Bytes.size();
+            ++count;
+            sceneChanges += cSceneChange ? 1 : 0;
+            if (!aCallback(packet) || cGeneration != m_generation)
+                break;
+        }
+        m_draining = false;
+        return count;
+    }
+
+    void Clear() noexcept
+    {
+        ++m_generation;
+        m_packets.clear();
+        m_bytes = 0;
+    }
+
+    // Playback may only advance through messages that have actually been
+    // applied. Socket polling alone is no longer a completed playback horizon.
+    [[nodiscard]] double GetHandledTime(double aPollTime) const noexcept
+    {
+        return m_packets.empty() ? aPollTime : std::min(aPollTime, m_packets.front().ReceivedAt);
+    }
+
+    [[nodiscard]] size_t Size() const noexcept { return m_packets.size(); }
+    [[nodiscard]] size_t Bytes() const noexcept { return m_bytes; }
+
+private:
+    TiltedPhoques::Deque<Packet> m_packets{PersistentAllocator<Packet>()};
+    size_t m_bytes{};
+    uint64_t m_generation{};
+    bool m_draining{};
+};
