+bool CharacterService::UpdateCorpseSpeech(const entt::entity aEntity, Actor* apActor) noexcept
+{
+    if (!apActor || !m_transport.IsConnected() || apActor->GetExtension()->IsPlayer())
+        return false;
+
+    bool dead = apActor->IsDead();
+    if (const auto* pRemote = m_world.try_get<RemoteComponent>(aEntity); pRemote && pRemote->AuthoritativeDeath.has_value())
+        dead = *pRemote->AuthoritativeDeath;
+
+    // Scripted scenes and an actual open conversation can intentionally voice
+    // an actor after death. Keep those on the existing scene/dialogue path.
+    if (dead)
+    {
+        const BGSScene* pScene = apActor->GetCurrentScene();
+        const UI* pUI = UI::Get();
+        if ((pScene && pScene->isPlaying) ||
+            (pUI && pUI->GetMenuOpen(BSFixedString("Dialogue Menu")) && MenuTopicManager::IsPlayerDialogueSpeaker(apActor)))
+            dead = false;
+    }
+
+    auto* pState = m_world.try_get<CorpseSpeechComponent>(aEntity);
+    if (!pState && !dead)
+        return false;
+    if (!pState)
+        pState = &m_world.emplace<CorpseSpeechComponent>(aEntity);
+
+    const uint64_t cMilliseconds = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+    const bool cMute = pState->Window.Observe(apActor->GetHandle().handle.iBits, dead, cMilliseconds);
+    ActorExtension* pExtension = apActor->GetExtension();
+    const bool cWasMuted = pExtension->IsDeadSpeechMuted();
+    pExtension->SetDeadSpeechMuted(cMute);
+    if (cMute && !cWasMuted)
+    {
+        // Publish the hook guard first so stopping the voice cannot enqueue
+        // another subtitle. End only this actor's line, once per death episode.
+        if (auto* pSubtitles = SubtitleManager::Get())
+            pSubtitles->HideSubtitle(apActor);
+        apActor->StopCurrentDialogue(true);
+        spdlog::info("STR corpse speech cleanup: actor {:X}, handle {:X}, remote {}, native_dead {}, grace_ms {}",
+            apActor->formID, apActor->GetHandle().handle.iBits, pExtension->IsRemote(), apActor->IsDead(), CorpseSpeechWindow::kGraceMilliseconds);
+    }
+    return cMute;
+}
+
+void CharacterService::RunCorpseSpeechUpdates() noexcept
+{
+    const auto cNow = std::chrono::steady_clock::now();
+    if (!m_transport.IsConnected() || cNow < m_nextCorpseSpeechUpdate)
+        return;
+    m_nextCorpseSpeechUpdate = cNow + std::chrono::milliseconds(250);
+
+    for (auto entity : m_world.view<FormIdComponent>(entt::exclude<ObjectComponent, PlayerComponent>))
+    {
+        if (!m_world.any_of<LocalComponent, RemoteComponent>(entity))
+            continue;
+        Actor* pActor = Cast<Actor>(TESForm::GetById(m_world.get<FormIdComponent>(entity).Id));
+        if (pActor && !pActor->IsDeleted() && pActor->GetNiNode())
+            UpdateCorpseSpeech(entity, pActor);
+    }
+}
