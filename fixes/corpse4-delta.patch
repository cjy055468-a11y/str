diff --git a/Code/client/Systems/CorpseAnimationSync.h b/Code/client/Systems/CorpseAnimationSync.h
new file mode 100644
index 0000000..e1729fa
--- /dev/null
+++ b/Code/client/Systems/CorpseAnimationSync.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <string_view>
+
+// A dead remote NPC's local Havok death path owns this switch. Replaying its
+// owner's value every movement/action update can put the local graph back into
+// animation-driven mode and prevent the ragdoll transition from settling.
+inline bool ShouldApplyCorpseAnimationVariable(const bool aPreserveCorpsePhysics, const std::string_view acName) noexcept
+{
+    return !aPreserveCorpsePhysics || acName != "bAnimationDriven";
+}
+
+inline bool ShouldResetCorpseAnimationDriven(const bool aPreserveCorpsePhysics, const bool aAlreadyReset) noexcept
+{
+    return aPreserveCorpsePhysics && !aAlreadyReset;
+}
diff --git a/Code/client/Systems/CorpseLifeState.h b/Code/client/Systems/CorpseLifeState.h
index 266c6be..e505f37 100644
--- a/Code/client/Systems/CorpseLifeState.h
+++ b/Code/client/Systems/CorpseLifeState.h
@@ -19,3 +19,21 @@ inline uint32_t PreserveConfirmedCorpseLifeState(uint32_t aNativeState, uint32_t
         return (aActionState & ~kLifeMask) | kDead;
     return aActionState;
 }
+
+// Actor action snapshots carry pose state, not a completed native Kill call.
+// Copying their dead bit onto a still-live replica makes IsDead skip KillImpl.
+inline uint32_t PreserveRemoteNpcDeathTransition(uint32_t aNative, uint32_t aIncoming, bool aConfirmed) noexcept
+{
+    constexpr uint32_t kMask = 0x01E00000;
+    const uint32_t nativeLife = (aNative & kMask) >> 21;
+    const uint32_t incomingLife = (aIncoming & kMask) >> 21;
+    if (nativeLife <= 2 && incomingLife <= 2)
+        return (aIncoming & ~kMask) | (aNative & kMask);
+    return PreserveConfirmedCorpseLifeState(aNative, aIncoming, aConfirmed);
+}
+
+inline bool IsNativeDeathTransition(uint32_t aNative) noexcept
+{
+    const uint32_t life = (aNative & 0x01E00000) >> 21;
+    return life == 1 || life == 2;
+}
